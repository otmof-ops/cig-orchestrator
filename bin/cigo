#!/bin/sh
# SPDX-FileCopyrightText: 2026 Jay Taylor (https://github.com/otmof-ops/cig-orchestrator)
# SPDX-License-Identifier: FSL-1.1-ALv2
# cigo: the launcher for cig-orchestrator. All the logic is in orchestrate.cig;
# this finds it, finds the project (the nearest directory up that has a
# cig-tasks.json), checks the cig it is about to hand the tool to, and passes
# cig the flags that are cig's own.
# A symlink to this file (ln -s <checkout>/bin/cigo ~/.local/bin/cigo) is
# followed to the checkout, hop by hop, with no readlink -f (macOS and the
# BSDs lack it). The installed copy has its tool= line rewritten below.
# `cig bench --timings` (cig-script#179) names a descriptor in CIG_TIMINGS_FD: the time
# this launcher takes goes there as one line, and the descriptor is handed on as
# CIGO_TIMINGS_FD for orchestrate.cig's own phases (cig-orchestrator#112). Nothing is
# timed, and no process started, when the variable is unset, or where `date` has no
# nanoseconds (macOS): then cig writes its own phases, as it does for any program.
t0=""
case "${CIG_TIMINGS_FD:-}" in
  [3-9]|[1-9][0-9])
    t0=$(date +%s%N 2>/dev/null)
    case "$t0" in ''|*[!0-9]*) t0="" ;; esac ;;
esac
self=$0
while [ -h "$self" ]; do
  link=$(readlink -- "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
# CDPATH= : with CDPATH exported, cd prints the directory and would land in tool=.
tool="$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)/orchestrate.cig"
# The cig this cigo is written for: the same floor as the `# cig` pin in the
# tool, checked here for cigs too old to read the pin themselves.
needs_major=1
needs_minor=20
needs_patch=0

cig_bin=$(command -v cig 2>/dev/null)
if [ -z "$cig_bin" ]; then
  echo "cigo: cig is not on PATH; install CigScript first: https://github.com/otmof-ops/cig-script" >&2
  exit 127
fi

# The cig a `cig --version` subprocess would reach: this file, followed
# through symlinks hop by hop (no readlink -f). The floor cache keys on it.
cig_real=$cig_bin
while [ -h "$cig_real" ]; do
  link=$(readlink -- "$cig_real")
  case "$link" in
    /*) cig_real=$link ;;
    *) cig_real=$(dirname -- "$cig_real")/$link ;;
  esac
done

# The launcher floor cache (#117 W3): CIGO_HOME/cig-floor, one line
# `<abs cig path>|<size>|<mtime>|<version>`. One stat (GNU `-c`, else
# BSD/macOS `-f`). A hit (path, size, mtime match) reuses the kept version
# and runs no subprocess; a miss asks `cig --version` and writes the cache
# atomically. An unwritable CIGO_HOME is the no-cache case: the fork runs
# every call. A failure is never cached, so `too_old` is recomputed on
# every call and a `needs_*` bump still refuses an old cig.
# `CIGO_FLOOR_CACHE=off` disables both the read and the write: the suite
# sets it so one test's writes do not land on another test's home.
floor_cache_on=1
case "${CIGO_FLOOR_CACHE:-on}" in
  off|0|no|false) floor_cache_on=0 ;;
esac
stat_line=""
stat_size=""
stat_mtime=""
if [ -n "$cig_real" ]; then
  stat_line=$(stat -c '%s %Y' -- "$cig_real" 2>/dev/null)
  if [ -z "$stat_line" ]; then
    stat_line=$(stat -f '%z %m' -- "$cig_real" 2>/dev/null)
  fi
  case "$stat_line" in
    [0-9]*' '[0-9]*)
      stat_size=${stat_line% *}
      stat_mtime=${stat_line##* } ;;
    *)
      stat_line="" ;;
  esac
fi
cigo_home=${CIGO_HOME:-$HOME/.cig-orchestrator}
cig_floor_cache=$cigo_home/cig-floor
version=""
cig_floor_hit=0
if [ "$floor_cache_on" -eq 1 ] && [ -n "$stat_line" ] && [ -f "$cig_floor_cache" ]; then
  cached_line=$(cat -- "$cig_floor_cache" 2>/dev/null)
  expect_prefix="$cig_real|$stat_size|$stat_mtime|"
  case "$cached_line" in
    "$expect_prefix"[0-9]*.[0-9]*.[0-9]*)
      cached_version=${cached_line#"$expect_prefix"}
      # A `[0-9]*.[0-9]*.[0-9]*` glob lets `1abc.2.3` through; the
      # version must be digits and dots and nothing else. A bad cached
      # line is dropped, no hit.
      case "$cached_version" in
        *[!0-9.]*|*..*|.*|*.) ;;
        *)
          version=$cached_version
          cig_floor_hit=1 ;;
      esac ;;
  esac
fi
if [ "$cig_floor_hit" -eq 0 ]; then
  version=$(cig --version 2>/dev/null | awk '{print $2}')
fi
case "$version" in
  [0-9]*.[0-9]*.[0-9]*)
    # Reject a version with anything but digits and dots: an awk split
    # on whitespace could pick up `1.2.3-abc` or stray punctuation.
    case "$version" in
      *[!0-9.]*|*..*|.*|*.)
        echo "cigo: could not read the version of cig (\`cig --version\` said: $version)" >&2
        exit 2 ;;
    esac
    major=${version%%.*}; rest=${version#*.}; minor=${rest%%.*}; patch=${rest#*.}; patch=${patch%%[!0-9]*}
    too_old=0
    if [ "$major" -lt "$needs_major" ]; then too_old=1
    elif [ "$major" -eq "$needs_major" ] && [ "$minor" -lt "$needs_minor" ]; then too_old=1
    elif [ "$major" -eq "$needs_major" ] && [ "$minor" -eq "$needs_minor" ] && [ "${patch:-0}" -lt "$needs_patch" ]; then too_old=1
    fi
    if [ "$too_old" -eq 1 ]; then
      echo "cigo: cig $version is too old; cig-orchestrator needs $needs_major.$needs_minor.$needs_patch or newer (cig update)" >&2
      exit 2
    fi
    if [ "$floor_cache_on" -eq 1 ] && [ "$cig_floor_hit" -eq 0 ] && [ -n "$stat_line" ] && mkdir -p -- "$cigo_home" 2>/dev/null; then
      cig_floor_tmp=$cig_floor_cache.$$.tmp
      if printf '%s\n' "$cig_real|$stat_size|$stat_mtime|$version" >"$cig_floor_tmp" 2>/dev/null; then
        mv -- "$cig_floor_tmp" "$cig_floor_cache" 2>/dev/null || rm -f -- "$cig_floor_tmp" 2>/dev/null
      else
        rm -f -- "$cig_floor_tmp" 2>/dev/null
      fi
    fi ;;
  *)
    echo "cigo: could not read the version of cig (\`cig --version\` said: $version)" >&2
    exit 2 ;;
esac

# Under Git Bash and MSYS2, arguments that look like POSIX paths (/prod) are
# rewritten for native programs; a task argument is handed over as typed.
# cig is a native program too, so the one path this launcher hands it, the
# tool's, is converted here by hand (D:/a/... reads on both sides).
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    MSYS2_ARG_CONV_EXCL='*'; export MSYS2_ARG_CONV_EXCL
    if command -v cygpath >/dev/null 2>&1; then tool=$(cygpath -m -- "$tool"); fi ;;
esac

global=""
run=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|--no-check|--no-rollback) run="$run $1"; shift ;;
    --max-steps=*)
      case "${1#--max-steps=}" in
        ''|*[!0-9]*) echo "cigo: --max-steps needs a number (--max-steps N or --max-steps=N)" >&2; exit 2 ;;
      esac
      run="$run $1"; shift ;;
    --max-steps)
      # A number and nothing else: the flag list is split into words below.
      case "${2:-}" in
        ''|*[!0-9]*) echo "cigo: --max-steps needs a number (--max-steps N or --max-steps=N)" >&2; exit 2 ;;
      esac
      run="$run $1 $2"; shift 2 ;;
    --json|--no-color|--no-doctor|--plain) global="$global $1"; shift ;;
    *) break ;;
  esac
done

# Is this the home folder itself (or /)? Compared as the system names the
# folders, not as they are spelled: a temp folder reads /var/... in $HOME and
# /private/var/... in the working directory on macOS, and a home behind a
# symlink reads differently in each too.
in_home() {
  case "$PWD" in "$HOME"|"$HOME/"|/) return 0 ;; esac
  [ -n "${HOME:-}" ] || return 1
  here_p=$(pwd -P 2>/dev/null) || return 1
  home_p=$(CDPATH='' cd -- "$HOME" 2>/dev/null && pwd -P) || return 1
  [ "$here_p" = "$home_p" ] || [ "$here_p" = / ]
}

case "${1:-help}" in
  adopt|help|version|toolchains|update|uninstall|doctor|crash|config|blacklist|quarantine|guard|undo|run-url|agent|approve|__dump-rules|--help|-h|--version)
    # From the home folder itself (or /), cig would take all of it as the
    # run's pack and watch every file in it around each step: these run
    # from an empty folder of cigo's instead, and the commands that work
    # where you are (a guarded call, an agent's command, run-url) are told
    # where that is.
    if in_home; then
      if [ "${1:-help}" != adopt ] && [ -n "${HOME:-}" ]; then
        here="${CIGO_HOME:-$HOME/.cig-orchestrator}/here"
        if mkdir -p "$here" 2>/dev/null; then
          CIGO_CALLER_DIR=$PWD
          export CIGO_CALLER_DIR
          cd "$here" || exit 1
        fi
      fi
    fi ;;
  *)
    dir=$PWD
    # Up to the root, or until dirname stops changing (// on MSYS stays //).
    while [ ! -f "$dir/cig-tasks.json" ]; do
      up=$(dirname -- "$dir")
      [ "$up" = "$dir" ] && break
      dir=$up
    done
    if [ -f "$dir/cig-tasks.json" ] && [ "$dir" != "$PWD" ]; then
      cd "$dir" || exit 1
    fi
    # The installer asks for `__doctor` from wherever it was run, a home
    # folder included: with no project above, it runs from cigo's own empty
    # folder like the commands above.
    if [ ! -f "$dir/cig-tasks.json" ] && [ "${1:-}" = __doctor ]; then
      if in_home && [ -n "${HOME:-}" ]; then
        here="${CIGO_HOME:-$HOME/.cig-orchestrator}/here"
        if mkdir -p "$here" 2>/dev/null; then
          CIGO_CALLER_DIR=$PWD
          export CIGO_CALLER_DIR
          cd "$here" || exit 1
        fi
      fi
    fi
    ;;
esac

# `cigo version --json` names the tool and the launcher that ran; `cigo
# __doctor` checks that they agree.
CIGO_TOOL=$tool
CIGO_LAUNCHER=$0
export CIGO_TOOL CIGO_LAUNCHER

if [ -n "$t0" ]; then
  t1=$(date +%s%N)
  d=$((t1 - t0))
  # shellcheck disable=SC2034  # read by the eval below
  line=$(printf '{"v":1,"product":"cigo","phase":"launcher","ms":%d.%03d}' $((d / 1000000)) $((d / 1000 % 1000)))
  # The descriptor is digits only (checked above), so the eval takes nothing else.
  if eval "printf '%s\\n' \"\$line\" >&$CIG_TIMINGS_FD" 2>/dev/null; then
    CIGO_TIMINGS_FD=$CIG_TIMINGS_FD
    CIGO_EXEC_NS=$t1
    CIGO_TIMINGS_END=${TMPDIR:-/tmp}/cigo-phases-$$
    export CIGO_TIMINGS_FD CIGO_EXEC_NS CIGO_TIMINGS_END
    unset CIG_TIMINGS_FD
    # Not exec: the time after the script ends is the last phase, `exit`.
    # shellcheck disable=SC2086
    cig $global run $run "$tool" -- "$@"
    rc=$?
    t2=$(date +%s%N)
    end_ms=$(cat -- "$CIGO_TIMINGS_END" 2>/dev/null)
    rm -f -- "$CIGO_TIMINGS_END"
    case "$end_ms" in
      ''|*[!0-9]*) ;;
      *)
        d=$((t2 - end_ms * 1000000))
        # shellcheck disable=SC2034  # read by the eval below
        line=$(printf '{"v":1,"product":"cigo","phase":"exit","ms":%d.%03d}' $((d / 1000000)) $((d / 1000 % 1000)))
        eval "printf '%s\\n' \"\$line\" >&$CIGO_TIMINGS_FD" 2>/dev/null ;;
    esac
    exit "$rc"
  fi
fi

# The flag lists are single words, split on purpose.
# shellcheck disable=SC2086
exec cig $global run $run "$tool" -- "$@"
