{
  "project": "demo-app",
  "tasks": {
    "lint":    {"cmd": "python3 scripts/lint.py src", "needs": []},
    "build":   {"cmd": "bash scripts/build.sh", "needs": ["lint"]},
    "test":    {"cmd": "bash scripts/test.sh", "needs": ["build"], "timeout_ms": 10000},
    "flaky":   {"cmd": "bash scripts/flaky.sh", "needs": ["build"], "retries": 3},
    "package": {"cmd": "bash scripts/package.sh", "needs": ["test", "flaky"]},
    "deploy":  {"cmd": "bash scripts/deploy.sh", "needs": ["package"], "undo": "bash scripts/undeploy.sh"},
    "notify":  {"cmd": "bash scripts/notify.sh", "needs": ["deploy"], "ok": [0, 1]}
  }
}
