# ----- the polyglot example ---------------------------------------------------------

pull has_node_and_python() {
  if proc.which("node") == null or proc.which("python3") == null {
    exhale "      (skipped: needs node and python3 on PATH)"
    snuff false
  }
  snuff true
}

test("the polyglot example releases: Python's numbers, Node's page, bash's deploy", pack() {
  if not has_node_and_python() {
    snuff
  }
  stick dir = fresh("examples/polyglot")
  exits(tool_in(dir, ["check"]), 0)
  stick r = tool_in(dir, ["run", "release"])
  exits(r, 0)
  in_order(r.out, ["] data:lint:", "] web:lint:", "] data:test:", "] web:test:", "] version:", "] stats:", "] site:", "] deploy:", "] announce:"])
  says(r.out, "live: public/2.3.0/index.html (196 bytes)")
  says(read(dir, "public/2.3.0/index.html"), "5 orders, 555.84 in total; the top region is north")
  stick id = last_run(dir).id
  stick undone = cig(dir, ["unburn", id])
  exits(undone, 0)
  says(undone.out + undone.err, "took 2.3.0 back from public")
  assert(not there(dir, "public/2.3.0/index.html"), "the deploy survived unburn")
})

test("the polyglot example rebuilds the page when Python's numbers change", pack() {
  if not has_node_and_python() {
    snuff
  }
  stick dir = fresh("examples/polyglot")
  exits(tool_in(dir, ["run", "site"]), 0)
  says(tool_in(dir, ["run", "site"]).out, "up to date")
  burn {
    fs.append_text(path.join(dir, "data/sales.csv"), "south,500.00\n")
  }
  stick again = tool_in(dir, ["run", "site"])
  exits(again, 0)
  says(again.out, "built ")
  says(read(dir, "web/dist/index.html"), "6 orders, 1055.84 in total; the top region is south")
})

# ----- the launcher ---------------------------------------------------------

test("cigo finds the project from a subdirectory and hands cig its own flags", pack() {
  stick dir = fresh("examples/demo-app")
  stick r = hop(path.join(dir, "scripts"), "sh", [launcher, "list"])
  exits(r, 0)
  says(r.out, "demo-app: 7 tasks")
  stick d = hop(dir, "sh", [launcher, "--dry-run", "run", "build"])
  exits(d, 0)
  says(d.err, "dry-run plan")
  assert(not there(dir, "build"), "a dry run through cigo built something")
})

