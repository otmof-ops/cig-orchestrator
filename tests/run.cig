test("__doctor finds each toolchain's tools and the project's pins", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick d = self_doctor(dir, {})
  stick node = finding_of(d, "pin:node-pnpm:node")
  assert(node.severity == "action", json.stringify(node))
  says(node.found, "99.1.0")
  says(node.because, "web/.nvmrc pins 20")
  assert(node.fix == "cigo versions switch", json.stringify(node))
  stick go = finding_of(d, "pin:go:go")
  assert(go.severity == "ok", json.stringify(go))
  says(go.because, "services/api/go.mod needs at least 1.22")
  assert(d.findings.filter(pack(f) => f.check.starts_with("tool:")).is_empty(), "a tool was reported missing: " + json.stringify(d.findings))
  edit_manifest(dir, pack(m) {
    m.components["numerics"] = {path: ".", toolchain: "fortran-fpm"}
  })
  stick missing = self_doctor(dir, {})
  stick fpm = finding_of(missing, "tool:fortran-fpm:fpm")
  assert(fpm.severity == "action", json.stringify(fpm))
  says(fpm.fix, "https://fpm.fortran-lang.org")
})

