# ----- versions: the cig, the project's pins, the tools (0.3.0) ------------------

test("version names this cigo and the cig it runs on, as text and as JSON", pack() {
  stick dir = fresh("tests/fixtures/chain")
  stick r = tool_in(dir, ["version"])
  exits(r, 0)
  says(r.out, "cig-orchestrator ")
  says(r.out, "(cig ")
  stick j = json.parse(tool_in(dir, ["version", "--json"]).out)
  assert(j.version != "" and j.cig != "" and j.cig_needs.starts_with(">="), "incomplete: ${json.stringify(j)}")
  assert(j.cig_ok == true, "this cig is outside cigo's range: ${json.stringify(j)}")
})

test("a cig pin the installed cig does not satisfy is flagged on every command, and --strict stops", pack() {
  stick dir = fresh("tests/fixtures/chain")
  burn {
    fs.write_text(path.join(dir, ".cig-version"), "9.9\n")
  }
  stick l = tool_in(dir, ["list"])
  exits(l, 0)
  says(l.err, ".cig-version pins cig 9.9; the installed cig is ")
  stick c = tool_in(dir, ["check"])
  exits(c, 0)
  says(c.out, "warning: .cig-version: .cig-version pins cig 9.9")
  stick strict = tool_in(dir, ["check", "--strict"])
  exits(strict, 1)
  says(strict.out, "error: .cig-version: .cig-version pins cig 9.9")
  stick run = tool_in(dir, ["run", "version", "--strict"])
  exits(run, 2)
  says(run.err, "1 version disagreement and --strict given")
  # Quiet when asked, and quiet when the pin fits.
  stick quiet = hop_env(dir, tool_prog("cig"), tool_args(["list"]), {CIGO_VERSIONS: "0"})
  exits(quiet, 0)
  never_says(quiet.err, "pins cig")
  burn {
    fs.write_text(path.join(dir, ".cig-version"), ">=1.2.0\n")
  }
  never_says(tool_in(dir, ["list"]).err, "pins cig")
})

test("the manifest's cig key and a script's # cig header are read as pins", pack() {
  stick dir = fresh("tests/fixtures/chain")
  # The pin is the installed cig's own major.minor, so it is satisfied by
  # whichever cig runs the suite; the old script's header is what is flagged.
  stick installed = json.parse(tool_in(dir, ["version", "--json"]).out).cig
  stick file = path.join(dir, "cig-tasks.json")
  stick m = json.load(file)
  m.cig = installed.split(".").slice(0, 2).join(".")
  m.tasks["old-script"] = {cmd: ["cig", "run", "old.cig"]}
  burn {
    json.save(file, m, 2)
  }
  burn {
    fs.write_text(path.join(dir, "old.cig"), "#!/usr/bin/env cig\n# cig 1.0.0\nexhale \"old\"\n")
  }
  stick l = tool_in(dir, ["list"])
  exits(l, 0)
  says(l.err, "old.cig pins cig 1.0.0; the installed cig is ")
  says(l.err, "humidor")
  never_says(l.err, "cig-tasks.json cig pins")
  edit_manifest(dir, pack(m) {
    m.cig = "banana"
  })
  stick c = tool_in(dir, ["check"])
  exits(c, 1)
  says(c.out, "`cig` is the cig version this project is written for")
})

test("toolchain pins are flagged before a run and in check, not only by __doctor", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick r = tool_stubbed(dir, ["run", "web:build"])
  exits(r, 0)
  says(r.err, "web: node is 99.1.0, web/.nvmrc pins 20")
  stick c = tool_stubbed(dir, ["check"])
  exits(c, 0)
  says(c.out, "warning: web: web: node is 99.1.0, web/.nvmrc pins 20")
  stick strict = tool_stubbed(dir, ["run", "web:build", "--strict"])
  exits(strict, 2)
  says(strict.err, "version disagreement")
  # plan looks at the files alone, so it never asks a tool its version.
  stick asked_before = stub_log(dir).len()
  stick p = tool_stubbed(dir, ["plan", "web:build"])
  exits(p, 0)
  never_says(stub_log(dir).slice(asked_before), "node --version")
  stick d = self_doctor(dir, {})
  assert(finding_of(d, "cig-floor").severity == "ok", json.stringify(finding_of(d, "cig-floor")))
  says(finding_of(d, "cig-floor").because, "needs cig >=")
  assert(finding_of(d, "pin:node-pnpm:node").severity == "action", "the node pin was not flagged")
})

# ----- the tin: what a task may change comes back (0.3.0, cig 1.2) -------------------

test("a task's touches are kept in the tin, so a file it rewrote comes back after a later failure", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    # On the tin, not in the box: this is the tin's path under test.
    m.tasks["rewrite"] = {cmd: ["bash", "-c", "echo changed > in.txt"], touches: ["in.txt"], box: false}
    m.tasks["then-fail"] = {cmd: ["bash", "-c", "exit 7"], needs: ["rewrite"]}
  })
  stick before = read(dir, "in.txt")
  stick r = tool_in(dir, ["run", "then-fail"])
  exits(r, 1)
  says(r.err, "restored hop modified")
  says(r.err, "(tin)")
  assert(read(dir, "in.txt") == before, "in.txt was not put back: ${read(dir, "in.txt")}")
  stick s = tool_in(dir, ["show", "rewrite"])
  exits(s, 0)
  says(s.out, "touches    in.txt")
  says(s.out, "kept in the tin before the task runs")
  stick p = tool_in(dir, ["plan", "rewrite"])
  exits(p, 0)
  says(p.out, "touches in.txt")
})

test("touches must be relative globs inside the project; a stage's come from the knowledge base", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    m.tasks["bad"] = {cmd: ["true"], touches: ["/etc/x", "../up"]}
    m.tasks["worse"] = {cmd: ["true"], touches: 7}
  })
  stick c = tool_in(dir, ["check"])
  exits(c, 1)
  says(c.out, "error: bad: `touches`: `/etc/x` must be a relative glob inside the project")
  says(c.out, "error: bad: `touches`: `../up` must be a relative glob inside the project")
  says(c.out, "error: worse: `touches` is a glob or a list of globs")
  stick mono = fresh("tests/fixtures/monorepo")
  exits(tool_in(mono, ["adopt", "--write"]), 0)
  stick s = tool_stubbed(mono, ["show", "ml:setup"])
  exits(s, 0)
  # The family's guesses are optional globs: a lockfile the project may not have yet.
  says(s.out, "touches    ?uv.lock ?poetry.lock ?pdm.lock ?Pipfile.lock")
  # A stage override's touches win over the family's.
  edit_manifest(mono, pack(m) {
    m.components.ml.stages = {setup: {touches: ["uv.lock"]}}
  })
  says(tool_stubbed(mono, ["show", "ml:setup"]).out, "touches    uv.lock\n")
})

# ----- crash reports and config: the same deal as cig's (0.3.0) ---------------------

pull cigo_home(dir) {
  snuff dir + "-cigo-home"
}

pull tool_crashing(dir, words, where) {
  snuff hop_env(dir, tool_prog("cig"), tool_args(words), {CIGO_HOME: cigo_home(dir), CIGO_INTERNAL_PANIC: where})
}

pull tool_home(dir, words) {
  snuff hop_env(dir, tool_prog("cig"), tool_args(words), {CIGO_HOME: cigo_home(dir)})
}

test("a bug inside cigo is a crash report, saved outside the project and kept through the rollback", pack() {
  stick dir = fresh("tests/fixtures/chain")
  stick r = tool_crashing(dir, ["run", "version"], "mid-run")
  exits(r, 1)
  says(r.err, "cigo hit a bug and had to stop: map has no key `this_key_does_not_exist`")
  says(r.err, "A crash report was saved locally:")
  says(r.err, "`ciginstaller crash list` shows it there")
  says(r.err, "To report it yourself: `ciginstaller bug cigo`")
  says(r.err, "https://github.com/otmof-ops/cig-orchestrator/issues/new?template=bug-report.yml")
  says(r.err, "rolling back")
  stick reports = fs.glob(path.join(cigo_home(dir), "crashes", "*.json"))
  assert(reports.len() == 1, "expected one report, found ${reports.len()}")
  stick report = json.load(reports[0])
  assert(report.tool == "cig-orchestrator" and report.fingerprint.len() == 8 and report.kind == "runtime", json.stringify(report))
  assert(report.command[0] == "run" and report.version != "" and report.cig != "", json.stringify(report))
  assert(report.panic_location.starts_with("orchestrate.cig:"), report.panic_location)
  assert(report.active_run_id != null, "the run id is missing: ${json.stringify(report)}")
  assert(not fs.exists(path.join(dir, ".cig-orchestrator")), "the run was not rolled back")
  # A task failing is not a crash.
  stick fail = tool_home(dir, ["run", "liar"])
  exits(fail, 1)
  never_says(fail.err, "cigo hit a bug")
  assert(fs.glob(path.join(cigo_home(dir), "crashes", "*.json")).len() == 1, "a task failure wrote a crash report")
})

test("config keeps crash_reports, issues_repo and update_channel, and never keeps a report local", pack() {
  stick dir = fresh("tests/fixtures/chain")
  stick all = tool_home(dir, ["config"])
  exits(all, 0)
  assert(text.matches(all.out, '(?m)^crash_reports +ask '), all.out)
  assert(text.matches(all.out, '(?m)^update_channel +stable '), all.out)
  exits(tool_home(dir, ["config", "crash_reports", "sometimes"]), 2)
  stick set = tool_home(dir, ["config", "crash_reports", "never"])
  exits(set, 0)
  says(set.err, "crash_reports = never")
  says(tool_home(dir, ["config", "crash_reports"]).out, "never")
  stick r = tool_crashing(dir, ["list"], "list")
  exits(r, 1)
  says(r.err, "crash_reports is \"never\": the report stays local")
  stick reports = fs.glob(path.join(cigo_home(dir), "crashes", "*.json"))
  assert(reports.len() == 1, "the report was not saved")
  exits(tool_home(dir, ["config", "crash_reports", "--unset"]), 0)
  says(tool_home(dir, ["config", "crash_reports"]).out, "ask")
})

# ----- update, uninstall and doctor: ciginstaller's now -------------------------------

# A ciginstaller that logs its arguments, says one line, and exits with
# $FAKE_EXIT: the directory it is in, to put on PATH.
pull write_fake_installer(dir) {
  stick bindir = dir + "-installer-bin"
  burn {
    fs.mkdir(bindir)
    fs.write_text(path.join(bindir, "ciginstaller"), [
      '#!/bin/sh',
      'echo "$*" >> "$FAKE_INSTALLER_LOG"',
      'echo fake-installer-says-hello',
      'exit "${FAKE_EXIT:-0}"',
    ].join("\n") + "\n")
    stick m = proc.run("chmod", ["755", path.join(bindir, "ciginstaller")], {timeout_ms: 10000})
    assert(m.code == 0, m.err)
  }
  snuff bindir
}

# cigo as a carton lays it down: the tool under share/ and the launcher under
# bin/, no .git and no bin/ beside the tool. The suite itself may be running
# from a checkout, through the launcher, so CIGO_TOOL is always set here, never
# inherited.
pull carton_env(dir) {
  stick prefix = dir + "-carton"
  stick share = path.join(prefix, "share", "cig-orchestrator")
  burn {
    fs.mkdir(prefix)
    fs.mkdir(path.join(prefix, "bin"))
    fs.mkdir(path.join(prefix, "share"))
    fs.mkdir(share)
    fs.cp(tool, path.join(share, "orchestrate.cig"))
    fs.cp(launcher, path.join(prefix, "bin", "cigo"))
  }
  snuff {CIGO_TOOL: path.join(share, "orchestrate.cig"), CIGO_LAUNCHER: path.join(prefix, "bin", "cigo")}
}

# No ciginstaller anywhere: PATH holds the stubs alone, and the folders the
# stub also looks in are empty ones.
pull no_installer_env(dir) {
  burn {
    fs.mkdir(dir + "-empty-home")
    fs.mkdir(dir + "-empty-cigscript")
  }
  snuff {PATH: stub_dir, HOME: dir + "-empty-home", CIGSCRIPT_HOME: dir + "-empty-cigscript"}
}

test("update, uninstall and doctor hand over to ciginstaller: the arguments and the exit code pass through", pack() {
  if on_windows {
    snuff
  }
  stick dir = fresh("tests/fixtures/chain")
  stick bindir = write_fake_installer(dir)
  stick log = dir + "-installer.log"
  stick more = {PATH: bindir + path_sep + env.get("PATH", ""), FAKE_INSTALLER_LOG: log, FAKE_EXIT: "5"}.merge(carton_env(dir))
  for c in [["update"], ["update", "--check"], ["uninstall"], ["uninstall", "--yes"], ["doctor"], ["doctor", "--json"]] {
    stick r = hop_env(dir, tool_prog("cig"), tool_args(c), more)
    exits(r, 5)
    says(r.out, "fake-installer-says-hello")
  }
  stick seen = fs.read_text(log).lines()
  assert(seen == ["update", "update --check", "uninstall cigo", "uninstall cigo --yes", "doctor --tools", "doctor --tools --json"], json.stringify(seen))
  exits(hop_env(dir, tool_prog("cig"), tool_args(["update", "--check"]), more.merge({FAKE_EXIT: "0"})), 0)
})

test("the stubs find ciginstaller in CIGSCRIPT_HOME/bin when it is not on PATH", pack() {
  if on_windows {
    snuff
  }
  stick dir = fresh("tests/fixtures/chain")
  stick bindir = write_fake_installer(dir)
  stick csh = dir + "-cigscript"
  burn {
    fs.mkdir(csh)
    fs.mv(bindir, path.join(csh, "bin"))
  }
  stick log = dir + "-installer.log"
  stick r = hop_env(dir, tool_prog(proc.which("cig")), tool_args(["update", "--check"]), no_installer_env(dir).merge(carton_env(dir)).merge({CIGSCRIPT_HOME: csh, FAKE_INSTALLER_LOG: log, FAKE_EXIT: "3"}))
  exits(r, 3)
  says(r.out, "fake-installer-says-hello")
  says(fs.read_text(log), "update --check")
})

test("without ciginstaller the stubs say whose job it is, how to get it, and exit 127", pack() {
  if on_windows {
    snuff
  }
  stick dir = fresh("tests/fixtures/chain")
  for c in [["update", "`cigo update` is ciginstaller's job now: ciginstaller update"], ["uninstall", "`cigo uninstall` is ciginstaller's job now: ciginstaller uninstall cigo"], ["doctor", "`cigo doctor` is ciginstaller's job now: ciginstaller doctor --tools"]] {
    stick r = hop_env(dir, tool_prog(proc.which("cig")), tool_args([c[0]]), no_installer_env(dir).merge(carton_env(dir)))
    exits(r, 127)
    says(r.err, c[1])
    says(r.err, "get ciginstaller: https://github.com/otmof-ops/cig-installer#install")
  }
})

# ----- crash and report: ciginstaller's now (F3) -----------------------------------

# Two tests for one stub, as the contract asks: a fake ciginstaller gets the
# mapped arguments and its exit code passes through; with none, the two lines
# and 127. `typed` is what the person ran, `mapped` what ciginstaller must see.
pull report_stub_tests(label, typed, mapped, says_line) {
  test("${label} hands over to ciginstaller: the arguments and the exit code pass through", pack() {
    if on_windows {
      snuff
    }
    stick dir = fresh("tests/fixtures/chain")
    stick bindir = write_fake_installer(dir)
    stick log = dir + "-installer.log"
    stick more = {PATH: bindir + path_sep + env.get("PATH", ""), FAKE_INSTALLER_LOG: log, FAKE_EXIT: "5"}
    stick r = hop_env(dir, tool_prog("cig"), tool_args(typed), more)
    exits(r, 5)
    says(r.out, "fake-installer-says-hello")
    assert(fs.read_text(log).lines() == [mapped], json.stringify(fs.read_text(log).lines()))
    exits(hop_env(dir, tool_prog("cig"), tool_args(typed), more.merge({FAKE_EXIT: "0"})), 0)
  })
  test("${label} without ciginstaller says whose job it is, how to get it, and exits 127", pack() {
    if on_windows {
      snuff
    }
    stick dir = fresh("tests/fixtures/chain")
    stick r = hop_env(dir, tool_prog(proc.which("cig")), tool_args(typed), no_installer_env(dir))
    exits(r, 127)
    says(r.err, says_line)
    says(r.err, "get ciginstaller: https://github.com/otmof-ops/cig-installer#install")
  })
}

report_stub_tests("crash list", ["crash", "list"], "crash list", "`cigo crash list` is ciginstaller's job now: ciginstaller crash list")
report_stub_tests("crash with no word and --json", ["crash", "--json"], "crash list --json", "`cigo crash list` is ciginstaller's job now: ciginstaller crash list --json")
report_stub_tests("crash show <id>", ["crash", "show", "abc"], "crash show abc", "`cigo crash show` is ciginstaller's job now: ciginstaller crash show abc")
report_stub_tests("crash send <id>", ["crash", "send", "abc"], "crash send abc", "`cigo crash send` is ciginstaller's job now: ciginstaller crash send abc")
report_stub_tests("crash send --all --via link (values keep their place)", ["crash", "send", "--all", "--via", "link"], "crash send --all --via link", "ciginstaller crash send --all --via link")
report_stub_tests("crash delete <id>", ["crash", "delete", "abc"], "crash delete abc", "`cigo crash delete` is ciginstaller's job now: ciginstaller crash delete abc")
report_stub_tests("crash delete --all", ["crash", "delete", "--all"], "crash delete --all", "ciginstaller crash delete --all")
report_stub_tests("report with no run", ["report"], "bug cigo", "`cigo report` is ciginstaller's job now: ciginstaller bug cigo")
report_stub_tests("report --send with no run", ["report", "--send"], "bug cigo --send", "ciginstaller bug cigo --send")
report_stub_tests("report <run>", ["report", "r-1"], "bug --run r-1 --part cigo", "`cigo report` is ciginstaller's job now: ciginstaller bug --run r-1 --part cigo")
report_stub_tests("report <run> --send", ["report", "r-1", "--send"], "bug --run r-1 --part cigo --send", "ciginstaller bug --run r-1 --part cigo --send")

test("crash and report refuse what they do not know before ciginstaller is asked", pack() {
  if on_windows {
    snuff
  }
  stick dir = fresh("tests/fixtures/chain")
  stick bindir = write_fake_installer(dir)
  stick log = dir + "-installer.log"
  stick more = {PATH: bindir + path_sep + env.get("PATH", ""), FAKE_INSTALLER_LOG: log}
  stick c = hop_env(dir, tool_prog("cig"), tool_args(["crash", "submit"]), more)
  exits(c, 2)
  says(c.err, "`cigo crash` takes list, show <id>, send <id> or delete <id>|--all")
  stick r = hop_env(dir, tool_prog("cig"), tool_args(["report", "--nope"]), more)
  exits(r, 2)
  says(r.err, "unknown flag `--nope` for `report`")
  stick two = hop_env(dir, tool_prog("cig"), tool_args(["report", "a", "b"]), more)
  exits(two, 2)
  says(two.err, "`cigo report` takes one run")
  assert(not fs.exists(log), "ciginstaller was run for a call the stub refuses")
})

# cig's ashtray under `cighome`, read as files. The ashtray is the family's interface
# (ciginstaller reads it the same way), and `cig crash list` hands over to ciginstaller in a cig
# that has the family's stubs, so these tests never ask cig for it.
pull ashtray_origins(cighome) {
  roll origins = []
  for f in fs.glob(path.join(cighome, "ashtray", "*.json")) {
    origins.push(str(json.load(f).origin))
  }
  snuff origins
}

pull ashtray_text(cighome) {
  roll all = []
  for f in fs.glob(path.join(cighome, "ashtray", "*.json")) {
    all.push(fs.read_text(f))
  }
  snuff all.join("\n")
}

test("a cigo crash is still saved and queued in cig's ashtray with no ciginstaller on the machine", pack() {
  if on_windows {
    snuff
  }
  stick dir = fresh("tests/fixtures/chain")
  stick onlycig = dir + "-only-cig"
  burn {
    fs.mkdir(onlycig)
    stick ln = proc.run("ln", ["-s", proc.which("cig"), path.join(onlycig, "cig")], {timeout_ms: 10000})
    assert(ln.code == 0, ln.err)
  }
  stick bare = no_installer_env(dir).merge({PATH: onlycig + path_sep + "/usr/bin" + path_sep + "/bin", CIGO_HOME: cigo_home(dir)})
  assert(not bare.PATH.contains("ciginstaller"), "the test PATH names an installer")
  stick r = hop_env(dir, tool_prog(proc.which("cig")), tool_args(["run", "version"]), bare.merge({CIGO_INTERNAL_PANIC: "mid-run", CIG_REPORTS: "ask"}))
  exits(r, 1)
  says(r.err, "A crash report was saved locally:")
  says(r.err, "Handing it to cig's ashtray")
  assert(fs.glob(path.join(cigo_home(dir), "crashes", "*.json")).len() == 1, "cigo's copy was not saved")
  stick origins = ashtray_origins(bare.CIGSCRIPT_HOME)
  assert(origins.len() == 1 and origins[0] == "cig-orchestrator", "cig's ashtray holds: ${origins.join(", ")}")
  # and the stub for reading it says what is missing
  stick l = hop_env(dir, tool_prog(proc.which("cig")), tool_args(["crash", "list"]), bare)
  exits(l, 127)
})

test("update names no cigo version, and refuses a flag it does not know", pack() {
