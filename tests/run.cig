  says(r.out, "E580")
  says(r.out, "not rehearsed: it is on your blacklist")
  stick j = guard_tool(dir, ["rehearse", "npm:evil-pkg@1.0.0", "--json"], l)
  exits(j, 3)
  assert(json.parse(j.out).rehearsed == false, j.out)
  stick why = guard_tool(dir, ["blacklist", "why", "npm:evil-pkg@2.0.0"], l)
  exits(why, 1)
  says(why.out, "a test entry")
  exits(guard_tool(dir, ["blacklist", "why", "npm:left-pad@1.3.0"], l), 0)
})

test("rehearse --fail-on: the exit code says the risk once it reaches the threshold, and never fails nothing", pack() {
  if not has_tin_mac() {
    exhale "      (skipped: this cig cannot sign a list)"
    snuff
  }
  stick dir = blacklist_project()
  stick l = lists(dir)
  exits(guard_tool(dir, ["blacklist", "add", "npm:evil-pkg", "--reason=a test entry"], l), 0)
  # A blacklisted package is critical: it fails at every threshold but never.
  exits(guard_tool(dir, ["rehearse", "npm:evil-pkg@1.0.0"], l), 3)
  exits(guard_tool(dir, ["rehearse", "npm:evil-pkg@1.0.0", "--fail-on=high"], l), 3)
  stick never = guard_tool(dir, ["rehearse", "npm:evil-pkg@1.0.0", "--fail-on=never"], l)
  exits(never, 0)
  says(never.out, "not rehearsed: it is on your blacklist")
  # The setting does what the flag does, and a bad value is refused.
  exits(guard_tool(dir, ["config", "rehearse_fail_on", "never"], {}), 0)
  exits(guard_tool(dir, ["rehearse", "npm:evil-pkg@1.0.0"], l), 0)
  exits(guard_tool(dir, ["config", "rehearse_fail_on", "auto"], {}), 0)
  stick bad = guard_tool(dir, ["rehearse", "npm:evil-pkg@1.0.0", "--fail-on=sometimes"], l)
  exits(bad, 2)
  says(bad.err, "--fail-on takes low, medium, high, critical, auto or never")
})

test("rehearse <bare name>: the registry is the one this project uses; two are asked about", pack() {
