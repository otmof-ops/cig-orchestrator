  assert(finding_of(none, "project").fix == "cigo adopt", json.stringify(finding_of(none, "project")))
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), "{nope")
  }
  stick broken = self_doctor(dir, {})
  stick stopped = finding_of(broken, "self-check")
  assert(stopped.severity == "action", json.stringify(stopped))
  says(stopped.found, "not valid JSON")
  finding_of(broken, "cig-floor")
})

test("__doctor through the launcher: the tool and the launcher agree, a checkout is said, and a home folder is left alone", pack() {
  if on_windows {
    snuff
  }
  stick dir = fresh("tests/fixtures/chain")
  stick r = launch(dir, launcher, ["__doctor", "--json"])
  exits(r, 0)
  stick d = json.parse(r.out)
  assert(finding_of(d, "launcher").severity == "ok", json.stringify(finding_of(d, "launcher")))
  says(finding_of(d, "tool-file").found, "runs from a checkout")
  # From the home folder with no project above, cig does not take all of it
  # as the pack: the check runs from cigo's own empty folder.
  # (A folder outside the repository: the repository's own cig-tasks.json
  # would count as a project above .test-work.)
  roll h = ""
  burn {
    stick made = proc.run("mktemp", ["-d"], {timeout_ms: 10000})
    assert(made.code == 0, made.err)
    h = made.out.trim()
  }
  stick home_run = launch_env(h, launcher, ["__doctor", "--json"], {HOME: h, CIGO_HOME: path.join(h, ".cig-orchestrator")})
  burn {
    fs.write_text(path.join(work, "home-run-seen"), str(fs.is_dir(path.join(h, ".cig-orchestrator", "here"))))
    proc.run("rm", ["-rf", "--", h], {timeout_ms: 10000})
  }
  exits(home_run, 0)
  assert(read(work, "home-run-seen") == "true", "the empty folder was not used: " + home_run.err)
  finding_of(json.parse(home_run.out), "cig-floor")
})

# ----- the tool itself on every machine (0.4.0): programs, paths, interpreters, encodings

test("a manifest and an env file with a byte-order mark load, and $CIG_OUTPUT that is not UTF-8 is said", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    m.tasks["from-env"] = {cmd: ["bash", "-c", "echo got-$FOO"], env_file: ".env"}
    m.tasks["utf16"] = {shell: "printf '\\377\\376n\\0=\\0v\\0\\n\\0' >> \"$CIG_OUTPUT\"; echo wrote"}
  })
  burn {
    # Notepad and PowerShell 5.1 write a BOM; the files are the same files.
    proc.shell("printf '\\357\\273\\277' > bom.json && cat cig-tasks.json >> bom.json && mv bom.json cig-tasks.json && printf '\\357\\273\\277FOO=bar\\n' > .env", {cwd: dir, timeout_ms: 10000})
  }
  stick l = tool_in(dir, ["list"])
  exits(l, 0)
  stick r = tool_in(dir, ["run", "from-env"])
  exits(r, 0)
  says(r.out, "got-bar")
  stick u = tool_in(dir, ["run", "utf16"])
  exits(u, 0)
  says(u.err, "is not UTF-8 text, so nothing was handed on")
})

test("a task whose output is not UTF-8 and exits 0 passes; strict encoding is a choice", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    # \351 in octal: BSD printf prints \xe9 as the letters x, e, 9.
    m.tasks["latin"] = {cmd: ["printf", "caf\\351\\n"]}
    m.tasks["strict"] = {cmd: ["printf", "caf\\351\\n"], encoding: "utf-8"}
    m.tasks["bad"] = {cmd: ["true"], encoding: "ebcdic"}
  })
  stick ok = tool_in(dir, ["run", "latin"])
  exits(ok, 0)
  says(ok.out, "caf")
  stick strict = tool_in(dir, ["run", "strict"])
  exits(strict, 1)
  says(strict.out + strict.err, "not valid utf-8 text")
  stick c = tool_in(dir, ["check"])
  exits(c, 1)
  says(c.out, "error: bad: `encoding` is one of utf-8, lossy, utf-16, latin1")
})

