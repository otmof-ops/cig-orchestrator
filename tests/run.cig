test("adopt --force finds the project again and keeps the tasks written by hand", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  edit_manifest(dir, pack(m) {
    m["tasks"] = {ship: {shell: "echo shipping", needs: ["build"]}}
    m.components.web["after"] = ["ml"]
  })
  edit_manifest(dir, pack(m) {
    m.components["jobs"] = m.components.worker
    m.components.remove("worker")
    m.components["docs"] = {path: "docs", toolchain: "shell", stages: {build: {shell: "echo docs"}}}
    m.components["gone"] = {path: "old-service", toolchain: "go"}
  })
  burn {
    fs.mkdir(path.join(dir, "services/billing"))
    fs.write_text(path.join(dir, "services/billing/go.mod"), "module billing\n\ngo 1.23\n")
  }
  stick again = tool_in(dir, ["adopt", "--write", "--force"])
  exits(again, 0)
  says(again.err, "billing: new since the manifest was written")
  says(again.err, "docs: kept as the manifest has it")
  says(again.err, "gone: dropped, because old-service is no longer a directory")
  stick m = json.load(path.join(dir, "cig-tasks.json"))
  assert(m.tasks.has("ship"), "adopt --force dropped the hand-written task: ${m.tasks}")
  assert(m.components.web.get("after", []) == ["ml"], "adopt --force dropped web's after: ${m.components.web}")
  assert(m.components.has("jobs") and not m.components.has("worker"), "the rename did not survive: ${m.components.keys()}")
  assert(m.components.has("billing") and m.components.has("docs") and not m.components.has("gone"), "components: ${m.components.keys()}")
  stick listed = tool_in(dir, ["list"]).out
  says(listed, "ship")
  stick checked = tool_in(dir, ["check"])
  exits(checked, 0)
  says(checked.out, "0 error(s)")
})

