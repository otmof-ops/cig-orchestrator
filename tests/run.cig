test("a value from an earlier task is an input too, and globs name inputs", pack() {
  stick dir = fresh("tests/fixtures/chain")
  burn {
    fs.mkdir(path.join(dir, "src/deep"))
    fs.write_text(path.join(dir, "src/deep/a.txt"), "a\n")
    fs.write_text(path.join(dir, "VERSION"), "1.0\n")
  }
  edit_manifest(dir, pack(m) {
    m.tasks["ver"] = {cmd: ["cat", "VERSION"], capture: "text"}
    m.tasks["stamp"] = {shell: "cat src/deep/*.txt > stamp.txt && echo stamped {{ver}}", inputs: ["src/**/*.txt"], produces: ["stamp.txt", "st*.txt"]}
    m.tasks["no-wheel"] = {cmd: ["true"], produces: ["dist/*.whl"]}
  })
  says(tool_in(dir, ["run", "stamp"]).out, "stamped 1.0")
  says(tool_in(dir, ["run", "stamp"]).out, "up to date")
  burn {
    fs.write_text(path.join(dir, "VERSION"), "1.1\n")
  }
  says(tool_in(dir, ["run", "stamp"]).out, "stamped 1.1")
  says(tool_in(dir, ["run", "stamp"]).out, "up to date")
  burn {
    fs.write_text(path.join(dir, "src/deep/b.txt"), "b\n")
  }
  says(tool_in(dir, ["run", "stamp"]).out, "stamped 1.1")
  assert(read(dir, "stamp.txt") == "a\nb\n", "stamp.txt: ${read(dir, "stamp.txt")}")
  stick none = tool_in(dir, ["run", "no-wheel"])
  exits(none, 1)
  says(none.err, "did not produce dist/*.whl")
})

test("a task must produce what it says, and capture what it promises", pack() {
  stick dir = fresh("tests/fixtures/chain")
  stick liar = tool_in(dir, ["run", "liar"])
  exits(liar, 1)
  says(liar.err, "task `liar` exited 0 but did not produce never.txt")
  stick bad = tool_in(dir, ["run", "bad-json"])
  exits(bad, 1)
  says(bad.err, "captures json, and its stdout is not JSON: not json")
})

