  says(v.out, ": versions = ask; 1 disagrees, answer: not yet")
  says(v.out, "node       20             web/.nvmrc")
  says(v.out, "installed 99.1.0")
  says(v.out, "switch via mise (has 20)")
  says(v.out, "at least 1.22")
  says(v.out, "agrees")
  says(v.out, "cigo versions switch | keep remembers the answer")
  stick d = tool_stubbed(dir, ["doctor"])
  exits(d, 0)
  says(d.out, "manager  node: mise has 20; cigo versions switch runs tasks on it")
  exits(tool_stubbed(dir, ["versions", "sideways"]), 2)
})

test("an unchanged project opens without a hop: the version probe is cached", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  exits(tool_stubbed(dir, ["check"]), 0)
  stick asked = text.find_all(stub_log(dir), "node --version").len()
  assert(asked >= 1, "the first check never asked node its version:\n" + stub_log(dir))
  exits(tool_stubbed(dir, ["check"]), 0)
  assert(text.find_all(stub_log(dir), "node --version").len() == asked, "the second check asked node again:\n" + stub_log(dir))
  assert(there(dir, ".cig-orchestrator/state/versions.json"), "no versions.json was kept")
})

# ----- 0.5.0: what the outside pass found (#43, #44, #45, and three more) -------

test("a captured value in a shell line is a check warning unless quoted with |sh, an error under --strict", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "TITLE"), "release v1.2\n")
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "t",
      tasks: {
        title: {cmd: ["cat", "TITLE"], capture: "text"},
        announce: {shell: "echo announcing {{title}}", needs: ["title"]},
        safe: {shell: "echo {{title|sh}}", needs: ["title"]},
        listed: {cmd: ["echo", "{{title}}"], needs: ["title"]},
        here: {shell: "echo {{root}}"},
      },
    }, 2))
  }
  stick c = tool_in(dir, ["check"])
  exits(c, 0)
  says(c.out, "warning: announce: {{title}} reaches a `shell` line unquoted, so a value holding shell syntax runs as shell; write {{title|sh}}, or put the value in `env` and read \"$TITLE\"")
  never_says(c.out, "safe:")
  never_says(c.out, "listed:")
  never_says(c.out, "here:")
  stick s = tool_in(dir, ["check", "--strict"])
  exits(s, 1)
  says(s.out, "error: announce: {{title}} reaches a `shell` line unquoted")
})

test("each as a plain list of globs runs once per file, and check refuses a malformed each", pack() {
  stick dir = fresh("tests/fixtures/chain")
  burn {
    fs.mkdir(path.join(dir, "src"))
    fs.write_text(path.join(dir, "src/a.py"), "print('A')\n")
    fs.write_text(path.join(dir, "src/b.py"), "print('B')\n")
  }
  edit_manifest(dir, pack(m) {
    m.tasks["every"] = {cmd: ["cat", "{file}"], each: ["src/*.py"]}
    m.tasks["malformed"] = {cmd: ["echo"], each: {skip: ["x"]}}
  })
  stick r = tool_in(dir, ["run", "every"])
  exits(r, 0)
  says(r.out, "print('A')")
  says(r.out, "print('B')")
  stick c = tool_in(dir, ["check"])
  exits(c, 1)
  says(c.out, "error: malformed: `each` is a list of globs")
  never_says(c.out, "error: every:")
})

test("a value read in cmds or rm is a need, and an unknown one is a check error", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "t",
      tasks: {
        producer: {cmd: ["echo", "hello"], capture: "text"},
        "consumer-cmds": {cmds: [["echo", "got", "{{producer}}"]]},
        "consumer-rm": {rm: ["out-{{producer}}"]},
        bad: {rm: ["{{nothing}}"]},
      },
    }, 2))
  }
  stick p = tool_in(dir, ["plan", "consumer-cmds"])
  exits(p, 0)
  in_order(p.out, ["producer", "consumer-cmds"])
  stick r = tool_in(dir, ["run", "consumer-cmds"])
  exits(r, 0)
  says(r.out, "got hello")
  in_order(tool_in(dir, ["plan", "consumer-rm"]).out, ["producer", "consumer-rm"])
  stick c = tool_in(dir, ["check"])
  exits(c, 1)
  says(c.out, "error: bad: {{nothing}} names no task")
})

test("a task whose exit code is outside ok says so, not that it printed output", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({project: "t", tasks: {"expect-fail": {cmd: ["cig", "--version"], ok: [1]}}}, 2))
  }
  stick r = tool_in(dir, ["run", "expect-fail"])
  exits(r, 1)
  says(r.err, "exited 0 (not in ok: 1)")
  never_says(r.err, "printed output it must not")
})

test("inputs over the limit always run and say why; plan and show say it too", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.mkdir(path.join(dir, "assets"))
    for i in [1, 2, 3, 4, 5] {
      fs.write_text(path.join(dir, "assets/a${i}.txt"), "x\n")
    }
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "t",
      defaults: {inputs_limit: 3},
      tasks: {build: {cmd: ["cig", "--version"], inputs: ["assets"]}},
    }, 2))
  }
  stick first = tool_in(dir, ["run", "build"])
  exits(first, 0)
  says(first.out, "inputs cover more than 3 files, so this task always runs; narrow `inputs`")
  stick second = tool_in(dir, ["run", "build"])
  exits(second, 0)
  says(second.out, "inputs cover more than 3 files")
  never_says(second.out, "up to date")
  says(tool_in(dir, ["plan", "build"]).out, "(inputs over 3 files: always runs)")
  says(tool_in(dir, ["show", "build"]).out, "over 3 files, so the task always runs")
  edit_manifest(dir, pack(m) {
    m.tasks.build.inputs_limit = 10
  })
  exits(tool_in(dir, ["run", "build"]), 0)
  says(tool_in(dir, ["run", "build"]).out, "up to date")
  edit_manifest(dir, pack(m) {
    m.tasks.build.inputs_limit = 0
  })
  stick c = tool_in(dir, ["check"])
  exits(c, 1)
  says(c.out, "`inputs_limit` is a whole number of files, 1 or more")
})

test("a failed undo is reported as not undone, by task name", pack() {
  if on_windows {
    exhale "      (skipped on Windows: the undo is an sh line)"
    snuff
  }
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "t",
      tasks: {
        deploy: {cmd: ["sh", "-c", "echo live > remote-site"], undo: ["sh", "-c", "echo undo-broke >&2; exit 7"]},
        verify: {cmd: ["sh", "-c", "exit 1"], needs: ["deploy"]},
      },
    }, 2))
  }
  stick r = tool_in(dir, ["run", "verify"])
  exits(r, 1)
  says(r.err, "deploy is NOT undone: its compensation failed: the undo `sh -c 'echo undo-broke >&2; exit 7'` exited 7; stderr: `undo-broke`; fix the undo, then `cig unburn <run>` runs it again")
  never_says(r.err, "at line")
  says(r.err, "not undone run sh -c 'echo live > remote-site'")
  never_says(r.err, "compensated run sh -c 'echo live")
  # The file the hop made is the kernel's to remove (it was watched); the
  # hop's effects beyond the pack are what the undo was for, and stand.
  assert(not there(dir, "remote-site"), "the file the hop created was not rolled back")
})

# ----- 0.5.1: what re-testing 0.5.0 found (#47, #48) -------------------------------

pull shell_values_project(dir, title) {
  burn {
    fs.write_text(path.join(dir, "TITLE"), title)
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "t",
      tasks: {
        title: {cmd: ["cat", "TITLE"], capture: "text"},
        announce: {shell: "echo announcing {{title}}", needs: ["title"]},
        safe: {shell: "echo announcing {{title|sh}}", needs: ["title"]},
      },
    }, 2))
  }
}

test("run warns about an unquoted value in a shell line, and refuses it with --strict or under CI", pack() {
  if on_windows {
    exhale "      (skipped on Windows: the shell line is for sh)"
    snuff
  }
  stick dir = fresh("tests/fixtures/empty")
  shell_values_project(dir, "release v1.2\n")
  stick r = tool_in(dir, ["run", "announce"])
  exits(r, 0)
  says(r.err, "announce: {{title}} reaches a `shell` line unquoted")
  says(r.err, "write {{title|sh}}")
  says(r.out, "announcing release v1.2")
  stick strict = tool_in(dir, ["run", "announce", "--strict"])
  exits(strict, 2)
  says(strict.err, "1 value reach a shell line unquoted and --strict given; nothing ran")
  stick ci = hop_env(dir, tool_prog("cig"), tool_args(["run", "announce"]), {CI: "true"})
  exits(ci, 2)
  says(ci.err, "CI is set, so nothing ran")
  # Quoted with |sh, nothing is said and the value is one word.
  stick quoted = tool_in(dir, ["run", "safe", "--strict"])
  exits(quoted, 0)
  never_says(quoted.err, "unquoted")
})

test("a value holding shell syntax is refused unquoted at substitution", pack() {
  if on_windows {
    exhale "      (skipped on Windows: the shell line is for sh)"
    snuff
  }
  stick dir = fresh("tests/fixtures/empty")
  shell_values_project(dir, "release v1.2; touch PWNED #\n")
  stick r = tool_in(dir, ["run", "announce"])
  exits(r, 1)
  says(r.err, "{{title}} in task `announce`: its value holds shell syntax (`;`) and reaches a `shell` line unquoted, so it would run as shell")
  assert(not there(dir, "PWNED"), "the injected command ran")
  # The same value, quoted: one word, no harm.
  stick safe = tool_in(dir, ["run", "safe"])
  exits(safe, 0)
  says(safe.out, "announcing release v1.2; touch PWNED #")
  assert(not there(dir, "PWNED"), "the quoted value ran as shell")
})

test("a new npm project sets up without a touches warning", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.mkdir(path.join(dir, "web"))
    fs.write_text(path.join(dir, "web/package.json"), "{\"name\":\"w\",\"version\":\"1.0.0\",\"scripts\":{\"test\":\"node -e 1\"}}\n")
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({project: "v", components: {web: {path: "web", toolchain: "node-npm"}}}, 2))
  }
  stick r = tool_stubbed(dir, ["run", "web:setup"])
  exits(r, 0)
  never_says(r.err, "match no file")
  never_says(r.err, "matches no file")
  says(stub_log(dir), "npm install")
  # The built-in guesses are optional globs; a task's own stay as written.
  stick s = tool_in(dir, ["show", "web:setup"])
  exits(s, 0)
  says(s.out, "?package-lock.json")
})

# ----- 1.0.0: the box, touches_sealed, cig 1.6.2 ------------------------------------

# `cig` is this suite's helper, not the module: Linux is told by its kernel.
stick on_linux = fs.is_file("/proc/sys/kernel/osrelease")

pull box_fell_back(err) {
  snuff err.contains("the box cannot be made here") or err.contains("the box could not be made here")
}

test("on Linux a task runs in cig's box: a file it rewrote without touches comes back after a later failure", pack() {
  if not on_linux {
    exhale "      (skipped: the box is Linux only; elsewhere the default is off)"
    snuff
  }
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    m.tasks["rewrite"] = {cmd: ["bash", "-c", "echo changed > in.txt; echo made > made.txt"]}
    m.tasks["then-fail"] = {cmd: ["bash", "-c", "exit 7"], needs: ["rewrite"]}
  })
  stick before = read(dir, "in.txt")
  stick r = tool_in(dir, ["run", "then-fail"])
  exits(r, 1)
  if box_fell_back(r.err) {
    exhale "      (the box could not be made on this machine; cig fell back and said so)"
    says(r.err, "E763")
    snuff
  }
  says(r.err, "box: `bash -c")
  says(r.err, "applied: 2 paths written, 0 removed")
  assert(read(dir, "in.txt") == before, "in.txt was not put back: ${read(dir, "in.txt")}")
  assert(not there(dir, "made.txt"), "made.txt survived the rollback")
  stick s = tool_in(dir, ["show", "rewrite"])
  exits(s, 0)
  says(s.out, "box        on")
})

test("box: false in defaults, --no-box and CIGO_BOX=0 keep a task on the tin; box: true on the task turns it back on", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    m.defaults = {box: false}
    m.tasks["plain"] = {cmd: ["bash", "-c", "echo changed > in.txt"]}
    m.tasks["boxed"] = {cmd: ["bash", "-c", "echo changed > in.txt"], box: true}
  })
  stick s = tool_in(dir, ["show", "plain"])
  exits(s, 0)
  never_says(s.out, "box        on")
  stick b = tool_in(dir, ["show", "boxed"])
  exits(b, 0)
  says(b.out, "box        on")
  # The flag and the variable, on a manifest that says nothing.
  edit_manifest(dir, pack(m) {
    m.defaults = {}
  })
  stick r = tool_in(dir, ["run", "plain", "--no-box"])
  exits(r, 0)
  never_says(r.err, "box: `")
  stick e = hop_env(dir, tool_prog("cig"), tool_args(["run", "plain"]), {CIGO_BOX: "0"})
  exits(e, 0)
  never_says(e.err, "box: `")
  if on_linux {
    stick y = tool_in(dir, ["run", "plain", "--box"])
    exits(y, 0)
    if not box_fell_back(y.err) {
      says(y.err, "box: `bash -c echo changed > in.txt` applied")
    }
  }
})

test("touches_sealed reaches cig: the before-bytes of a file under it are kept sealed", pack() {
  stick dir = fresh("tests/fixtures/chain")
  burn {
    fs.write_text(path.join(dir, "customers.db"), "rows-before-the-task\n")
  }
  edit_manifest(dir, pack(m) {
    m.tasks["rewrite"] = {cmd: ["bash", "-c", "echo rows-after > customers.db"], touches_sealed: ["customers.db"], box: false}
    m.tasks["then-fail"] = {cmd: ["bash", "-c", "exit 7"], needs: ["rewrite"]}
  })
  stick r = tool_in(dir, ["run", "then-fail"])
  exits(r, 1)
  says(r.err, "(sealed)")
  assert(read(dir, "customers.db") == "rows-before-the-task\n", "customers.db was not put back: ${read(dir, "customers.db")}")
  stick s = tool_in(dir, ["show", "rewrite"])
  exits(s, 0)
  says(s.out, "sealed     customers.db")
})

test("check refuses a box that is not true or false, and touches_sealed that are not globs", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    m.defaults = {box: "yes"}
    m.tasks["bad"] = {cmd: ["true"], box: "yes", touches_sealed: 7}
  })
  stick c = tool_in(dir, ["check"])
  assert(c.code != 0, "check passed a bad box: ${c.out}")
  says(c.out, "error: bad: `box` is true or false")
  says(c.out, "error: bad: `touches_sealed` is a glob or a list of globs")
  says(c.out, "error: defaults: `box` is true or false")
})

# ----- 1.1.0: reports through cig --------------------------------------------------

pull filed_under(tracker, repo_dir) {
  roll filed = []
  roll tries = 0
  while filed.is_empty() and tries < 600 {
    filed = fs.glob(path.join(tracker, repo_dir, "*.json"))
    if filed.is_empty() {
      tries += 1
      time.sleep_ms(100)
    }
  }
  snuff filed
}

test("a bug inside cigo is handed to cig's ashtray and filed under cigo's repository", pack() {
  stick dir = fresh("tests/fixtures/chain")
  stick tracker = dir + "-tracker"
  stick r = hop_env(dir, tool_prog("cig"), tool_args(["run", "version"]), {CIGO_HOME: cigo_home(dir), CIGO_INTERNAL_PANIC: "mid-run", CIG_REPORTS: "always", CIG_INTERNAL_TRACKER_DIR: tracker})
  exits(r, 1)
  says(r.err, "A crash report was saved locally:")
  says(r.err, "Handing it to cig's ashtray")
  # cig files it in the background, under cigo's repository, as cigo's.
  stick filed = filed_under(tracker, "otmof-ops__cig-orchestrator")
  assert(not filed.is_empty(), "cig did not file the report: ${r.err}")
  stick issue = json.load(filed[0])
  says(str(issue.title), "crash [")
  says(str(issue.title), "cig-orchestrator ")
  says(str(issue.body), "orchestrate.cig:")
  says(str(issue.body), "\"origin\": \"cig-orchestrator\"")
  # cigo's own copy stays where it was, and cig's ashtray knows the origin.
  assert(fs.glob(path.join(cigo_home(dir), "crashes", "*.json")).len() == 1, "cigo's copy is gone")
  stick ash = cig(dir, ["--json", "crash", "list"])
  says(ash.out, "\"origin\":\"cig-orchestrator\"")
})

test("crash_reports never keeps a cigo crash on this machine, out of cig's ashtray", pack() {
  stick dir = fresh("tests/fixtures/chain")
  tool_home(dir, ["config", "crash_reports", "never"])
  stick tracker = dir + "-tracker-never"
  stick r = hop_env(dir, tool_prog("cig"), tool_args(["run", "version"]), {CIGO_HOME: cigo_home(dir), CIGO_INTERNAL_PANIC: "mid-run", CIG_REPORTS: "always", CIG_INTERNAL_TRACKER_DIR: tracker})
  exits(r, 1)
  says(r.err, "crash_reports is \"never\"")
  never_says(r.err, "Handing it to cig")
  assert(not fs.exists(tracker), "a report was filed")
  stick ash = cig(dir, ["--json", "crash", "list"])
  never_says(ash.out, cigo_home(dir))
})

test("cigo report <run> --send bundles the run with the manifest's shape and files it through cig", pack() {
  stick dir = fresh("tests/fixtures/chain")
  stick tracker = dir + "-tracker-report"
  stick failing = tool_in(dir, ["run", "liar"])
  exits(failing, 1)
  stick id = str(last_run(dir).id)
  # Without --send: the file, and where it is.
  stick w = tool_home(dir, ["report", id])
  exits(w, 0)
  says(w.out, "reports")
  stick written = json.load(path.join(cigo_home(dir), "reports", id + ".json"))
  assert(written.kind == "report" and written.manifest.project != "" and written.cig_report.kind == "cigscript-report", json.stringify(written).slice(0, 300))
  never_says(json.stringify(written.manifest), "echo")
  # With --send: filed through cig, now.
  stick s = hop_env(dir, tool_prog("cig"), tool_args(["report", id, "--send"]), {CIGO_HOME: cigo_home(dir), CIG_INTERNAL_TRACKER_DIR: tracker})
  exits(s, 0)
  says(s.err, "filed at ")
  stick filed = fs.glob(path.join(tracker, "otmof-ops__cig-orchestrator", "*.json"))
  assert(filed.len() == 1, "expected one issue, found ${filed.len()}")
  stick issue = json.load(filed[0])
  says(str(issue.title), "report [")
  says(str(issue.body), "cigscript-report")
  says(str(issue.body), "\"origin\": \"cig-orchestrator\"")
})

test("cigo report --send carries no name of the person's: not a folder, a file, a task or the project", pack() {
  stick dir = fresh_at("tests/fixtures/chain", "zqx-clients/ZqxProject")
  edit_manifest(dir, pack(m) {
    m["project"] = "ZqxCorp"
    m.tasks["zqx-deploy"] = {cmd: ["sh", "-c", "echo zqx-secret"], produces: ["zqx-out/ZqxResult.txt"], desc: "ships zqx"}
  })
  stick tracker = dir + "-tracker-zqx"
  stick failing = tool_in(dir, ["run", "zqx-deploy"])
  exits(failing, 1)
  says(failing.err, "zqx-deploy")
  stick id = str(last_run(dir).id)
  stick s = hop_env(dir, tool_prog("cig"), tool_args(["report", id, "--send"]), {CIGO_HOME: cigo_home(dir), CIG_INTERNAL_TRACKER_DIR: tracker})
  exits(s, 0)
  says(s.err, "filed at ")
  stick filed = fs.glob(path.join(tracker, "otmof-ops__cig-orchestrator", "*.json"))
  assert(filed.len() == 1, "expected one issue, found ${filed.len()}")
  stick issue = json.load(filed[0])
  stick body = str(issue.body)
  never_says(body.lower(), "zqx")
  never_says(str(issue.title).lower(), "zqx")
  # The shape stays: the project and the task as placeholders, the task's
  # keys as the manifest's vocabulary, the error naming the task's placeholder.
  says(body, "\"project\": \"<project>\"")
  says(body, "\"produces\"")
  says(body, "did not produce")
  never_says(body, "echo")
  stick written = json.load(path.join(cigo_home(dir), "reports", id + ".json"))
  never_says(json.stringify(written).lower(), "zqx")
})

# ----- 1.2.0: the config model (#66): layers, the floor, locks, presets ------

pull tool_layers(dir, words, more) {
  snuff hop_env(dir, tool_prog("cig"), tool_args(words), {CIGO_HOME: cigo_home(dir), CIGO_SYSTEM_CONFIG: path.join(dir + "-sys", "cigo.conf")}.merge(more))
}

test("a project file cannot lower protection, and may tighten it", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    m.settings = {versions: "off"}
  })
  stick c = tool_layers(dir, ["check"], {})
  exits(c, 0)
  says(c.out + c.err, "`settings.versions` asks for `off`, looser than your `ask`")
  says(tool_layers(dir, ["config", "versions"], {}).out, "ask")
  edit_manifest(dir, pack(m) {
    m.settings = {versions: "always"}
  })
  stick tighter = tool_layers(dir, ["config", "versions"], {})
  says(tighter.out, "always")
  says(tool_layers(dir, ["config"], {}).out, "always          (project)")
})

test("a locked system setting cannot be overridden", pack() {
  stick dir = fresh("tests/fixtures/chain")
  burn {
    fs.mkdir(dir + "-sys")
    fs.write_text(path.join(dir + "-sys", "cigo.conf"), "versions = never !locked\n")
  }
  exits(tool_layers(dir, ["config", "install", "always"], {}), 0)
  stick refused = tool_layers(dir, ["config", "versions", "always"], {})
  exits(refused, 2)
  says(refused.err, "versions is locked by")
  stick listed = tool_layers(dir, ["config"], {})
  says(listed.out, "never")
  says(listed.out, "locked by")
  edit_manifest(dir, pack(m) {
    m.settings = {versions: "always"}
  })
  says(tool_layers(dir, ["config", "versions"], {}).out, "never")
})

test("a preset sets the keys it names, and config diff shows what differs from it", pack() {
  stick dir = fresh("tests/fixtures/chain")
  exits(tool_layers(dir, ["config", "preset", "paranoid"], {}), 0)
  says(tool_layers(dir, ["config", "versions"], {}).out, "always")
  # The suite turns the rehearsal and OSV off in the environment; not here.
  says(tool_layers(dir, ["config", "diff"], {CIGO_REHEARSE: "", CIGO_OSV: ""}).out, "every setting is as the paranoid preset has it")
  exits(tool_layers(dir, ["config", "install", "never"], {}), 0)
  stick d = tool_layers(dir, ["config", "diff"], {})
  says(d.out, "install")
  says(d.out, "preset paranoid says ask")
  stick bad = tool_layers(dir, ["config", "preset", "relaxed"], {})
  exits(bad, 2)
  says(bad.err, "presets are chill, balanced, strict, paranoid, ci, agent-heavy, research")
})

test("config explain names the default, the scale, the presets and the floor", pack() {
