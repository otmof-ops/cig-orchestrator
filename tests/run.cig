})

test("always switches without asking and says so; never warns only; off looks at nothing", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick a = tool_stubbed(dir, ["run", "web:build", "--versions=always"])
  exits(a, 0)
  says(a.err, "switching: node 20 (web/.nvmrc) via mise")
  never_says(a.err, "Switch to the pinned versions")
  says(stub_log(dir), "mise exec node@20 -- pnpm run build")
  stick n = tool_stubbed(dir, ["run", "web:build", "--versions=never"])
  exits(n, 0)
  never_says(n.err, "Switch to the pinned versions")
  says(n.err, "web/.nvmrc pins 20")
  stick o = tool_stubbed(dir, ["run", "web:build", "--versions=off"])
  exits(o, 0)
  never_says(o.err, "nvmrc")
  stick bad = tool_stubbed(dir, ["run", "web:build", "--versions=maybe"])
  exits(bad, 2)
  says(bad.err, "--versions is one of ask, always, never, off")
  # In CI nobody can answer, so nothing is asked.
  stick ci = hop_env(dir, "cig", ["run", tool, "--", "run", "web:build"], stubbed(dir).merge({CI: "true"}))
  exits(ci, 0)
  never_says(ci.err, "Switch to the pinned versions")
  says(ci.err, "web/.nvmrc pins 20")
})

test("the manifest's versions key and cigo config versions set the rule", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  edit_manifest(dir, pack(m) {
    m.versions = "always"
  })
  stick r = tool_stubbed(dir, ["run", "web:build"])
  exits(r, 0)
  says(r.err, "switching: node 20 (web/.nvmrc) via mise")
  edit_manifest(dir, pack(m) {
    m.versions = "sometimes"
  })
  stick c = tool_stubbed(dir, ["check"])
  exits(c, 1)
  says(c.out, "`versions` is one of ask, always, never, off")
  edit_manifest(dir, pack(m) {
    m.remove("versions")
  })
  exits(tool_home(dir, ["config", "versions", "sometimes"]), 2)
  stick set = tool_home(dir, ["config", "versions", "always"])
  exits(set, 0)
  says(set.err, "versions = always")
  stick through = hop_env(dir, "cig", ["run", tool, "--", "run", "web:build"], stubbed(dir).merge({CIGO_HOME: cigo_home(dir)}))
  exits(through, 0)
  says(through.err, "switching: node 20 (web/.nvmrc) via mise")
})

test("a missing pinned version asks before downloading; --install=always installs it", pack() {
  if on_windows {
    exhale "      (skipped on Windows: the test's own mise is a shell script)"
    snuff
  }
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  # A mise that lacks every version: `where` says no, and everything is logged.
  stick mgr = dir + "-mgr"
  burn {
    fs.mkdir(mgr)
    fs.write_text(path.join(mgr, "mise"), "#!/bin/sh\necho \"mise $* @$PWD\" >> \"$STUB_LOG\"\n[ \"$1\" = where ] && exit 1\nexit 0\n")
    proc.run("chmod", ["755", path.join(mgr, "mise")])
  }
  stick e = stubbed(dir)
  e.PATH = mgr + path_sep + e.PATH
  stick ask = hop_env(dir, "cig", ["run", tool, "--", "run", "web:build", "--versions=always"], e)
  exits(ask, 0)
  says(ask.err, "mise can install node 20 (mise install node@20); it downloads, so cigo does not do it on its own")
  never_says(stub_log(dir), "mise install")
  never_says(stub_log(dir), "mise exec")
  stick always = hop_env(dir, "cig", ["run", tool, "--", "run", "web:build", "--versions=always", "--install=always"], e)
  exits(always, 0)
  says(always.err, "installing node 20 through mise: mise install node@20")
  in_order(stub_log(dir), ["mise install node@20", "mise exec node@20 -- pnpm run build"])
  stick never = hop_env(dir, "cig", ["run", tool, "--", "run", "web:build", "--versions=always", "--install=never"], e)
  exits(never, 0)
  says(never.err, "mise does not have node 20 and `install` is never")
  # `cigo versions install` prints the commands; --yes runs them.
  stick v = hop_env(dir, "cig", ["run", tool, "--", "versions", "install"], e)
  exits(v, 0)
  says(v.out, "node 20 (web/.nvmrc): mise install node@20")
  says(v.out, "these download; `cigo versions install --yes` runs them")
  stick vy = hop_env(dir, "cig", ["run", tool, "--", "versions", "install", "--yes"], e)
  exits(vy, 0)
  says(vy.out, "installing node 20: mise install node@20")
})

test("no manager explains what to install and carries on", pack() {
  if on_windows {
