    m.tasks["shout"] = {cmd: ["tr", "a-z", "A-Z"], stdin: "commit {{version.commit}}"}
  })
  stick g = hop_env(dir, "cig", ["run", tool, "--", "run", "greet"], {TOWN: "Ballarat"})
  exits(g, 0)
  says(g.out, "hi there / chain / Ballarat / .")
  stick sh = tool_in(dir, ["run", "shout"])
  exits(sh, 0)
  says(sh.out, "COMMIT ABC123")
})

