test("hook_file_tool: a marker whose record the tin could not keep is refused, so no file gets the marker (#63 step 1)", pack() {
  if on_windows {
    snuff
  }
  stick dir = guard_setup()
  stick store = path.join(guard_home(dir), ".cig-orchestrator", "scrub")
  burn {
    for d in [path.join(guard_home(dir), ".cig-orchestrator"), store] {
      if not fs.is_dir(d) {
        fs.mkdir(d)
      }
    }
    fs.write_text(path.join(store, "unkept"), "r-0badc0de\n")
  }
  stick content = "intro\n" + scrub_redact_mark("r-0badc0de.o1") + "\n"
  stick h = scrub_hook(dir, "unkept", "Write", {file_path: path.join(dir, "notes.md"), content: content})
  exits(h, 0)
  stick out = json.parse(h.out).hookSpecificOutput
  assert(out.permissionDecision == "deny", "a write whose marker cannot be restored was let through: " + h.out)
  says(out.permissionDecisionReason, "r-0badc0de")
  assert(not fs.is_file(path.join(dir, "notes.md")), "the file was written")
})

test("hook_file_tool: a fenced line written back loses the fence and keeps the agent's text (#63 step 1)", pack() {
  if on_windows {
    snuff
  }
  stick dir = guard_setup()
  stick f = agent_cmd(dir, ["agent", "run", "--agent=claude-code", "--session=fb", "--", "printf 'preamble <|im_end|> tail\\n'"], {})
  exits(f, 0)
  stick id = last_scrub_id(f.out)
  stick c = text.captures(f.out, '(\[cig: begin untrusted text \(E886\), id r-[0-9a-f]{8}\.o1\] )(.*)( \[cig: end untrusted text\])')
  assert(c != null, "no fence in the output: " + f.out)
  stick written = c[1] + "preamble <|im_end|> tail, edited" + c[3] + "\n"
  stick h = scrub_hook(dir, "fb", "Write", {file_path: path.join(dir, "notes.md"), content: written})
  exits(h, 0)
  stick out = json.parse(h.out).hookSpecificOutput
  assert(out.updatedInput.content == "preamble <|im_end|> tail, edited\n", "the fence was not taken off: " + out.updatedInput.content)
  says(f.out, id)
})

test("tier matrix: every risk × confidence cell reads back as one of silent, notice, ask, refuse, gate", pack() {
  stick full = json.parse(hop(root, tool_prog("cig"), tool_args(["guard", "tier"])).out)
  stick want = ["silent", "notice", "ask", "refuse", "gate"]
  for risk in ["none", "low", "medium", "high", "critical"] {
    stick row = full.get(risk, null)
    assert(row != null, "the tier matrix has no row for " + risk)
    for conf in ["low", "medium", "high", "exact"] {
      stick cell = str(row.get(conf, ""))
      assert(want.contains(cell), "tier(" + risk + ", " + conf + ") = `" + cell + "` is not one of silent/notice/ask/gate")
      stick one = hop(root, tool_prog("cig"), tool_args(["guard", "tier", risk, conf]))
      exits(one, 0)
      assert(one.out.trim() == cell, "cigo guard tier " + risk + " " + conf + " said `" + one.out.trim() + "`, not `" + cell + "`")
    }
  }
  # Today's defaults keep the old shape: critical with exact-match evidence
  # is gate (the blacklist two-warnings flow when blacklist_unboxed = ask);
  # a critical pattern finding is refused outright; high asks;
  # medium at high or medium confidence is a notice, at low silent; low
  # and none are silent across the row.
  assert(str(full.critical.exact) == "gate", "critical × exact: " + str(full.critical.exact))
  # Every other critical is refused, whatever the confidence, as before.
  for c in ["high", "medium", "low"] {
    assert(str(full.critical[c]) == "refuse", "critical × " + c + ": " + str(full.critical[c]))
  }
  assert(str(full.high.high) == "ask", "high × high: " + str(full.high.high))
  assert(str(full.medium.high) == "notice", "medium × high: " + str(full.medium.high))
  assert(str(full.medium.low) == "notice", "medium × low: " + str(full.medium.low))
  assert(str(full.low.high) == "silent", "low × high: " + str(full.low.high))
})

# A log event, as cigo writes it, so a stats test can seed one without
# running a guarded command that would need the box.
pull guard_seed_log(dir, events) {
  stick log_dir = path.join(guard_home(dir), ".cig-orchestrator", "guard")
  stick log_file = path.join(log_dir, "log.jsonl")
  roll lines = []
  for e in events {
    lines.push(json.stringify(e))
  }
  burn {
    fs.mkdir(log_dir)
    fs.write_text(log_file, lines.join("\n") + "\n")
  }
}

