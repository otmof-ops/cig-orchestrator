  stick l = {CIGO_BLACKLIST_DIR: dir + "-lists"}
  exits(guard_cmd(dir, ["blacklist", "add", "npm:evil-pkg", "--reason=a test entry"], l), 0)
  stick r = guard_cmd(dir, ["guard", "exec", "--real=" + dir + "-bin/npm", "npm", "--", "install", "evil-pkg"], l)
  exits(r, 3)
  says(r.err, "E580")
  says(r.err, "is refused: rated critical")
