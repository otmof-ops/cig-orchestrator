test("two task runners in one directory: one runs the stages, so nothing runs twice", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "Makefile"), ".PHONY: build\nbuild:\n\techo make-build\n")
    fs.write_text(path.join(dir, "justfile"), "build:\n    echo just-build\n")
  }
  stick r = tool_in(dir, ["adopt", "--write"])
  exits(r, 0)
  says(r.err, "just: its targets are tasks (just:<target>), kept out of the stage groups because make already runs the stages")
  stick b = tool_stubbed(dir, ["run", "build"])
  exits(b, 0)
  says(stub_log(dir), "make build @")
  never_says(stub_log(dir), "just build")
  exits(tool_stubbed(dir, ["run", "just:build"]), 0)
  says(stub_log(dir), "just build @")
})

