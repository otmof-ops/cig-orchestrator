test("file: matches the exact name on every filesystem", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "exact",
      toolchains: {docker: {language: "Docker", family: "container", detect: ["file:Dockerfile"], tools: [], stages: {build: [["docker", "build", "."]]}}},
      components: {},
    }, 2))
    fs.write_text(path.join(dir, "dockerfile"), "FROM scratch\n")
  }
  stick before = tool_stubbed(dir, ["adopt"])
  exits(before, 0)
  never_says(before.out, "\"toolchain\": \"docker\"")
  # Not a rename: on a case-insensitive filesystem the two names are one file.
  burn {
    fs.rm(path.join(dir, "dockerfile"))
    fs.write_text(path.join(dir, "Dockerfile"), "FROM scratch\n")
  }
  stick after = tool_stubbed(dir, ["adopt"])
  exits(after, 0)
  says(after.out, "\"toolchain\": \"docker\"")
})

# ----- the knowledge base on every OS (0.4.0): os:, cmds, each, rm, fail_on_output, globs

test("an os: condition picks the command for this machine", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "oses",
      toolchains: {mine: {language: "Mine", family: "mine", detect: ["file:mine.toml"], tools: [],
        vars: {greet: [{when: ["os:windows"], value: "windows-hello"}, {when: ["os:unix"], value: "unix-hello"}, {value: "other"}]},
        stages: {build: [{when: ["os:windows"], cmd: ["echo", "on-windows"]}, {when: ["os:unix"], cmd: ["echo", "{greet}"]}]}}},
      components: {m: {path: ".", toolchain: "mine"}},
    }, 2))
    fs.write_text(path.join(dir, "mine.toml"), "x = 1\n")
  }
  stick r = tool_in(dir, ["run", "m:build"])
  exits(r, 0)
  # The suite's own `cig` helper shadows the module here; the OS from the environment.
  if env.get("OS", "") == "Windows_NT" {
    says(r.out, "on-windows")
  } else {
    says(r.out, "unix-hello")
  }
  stick c = tool_in(dir, ["check"])
  exits(c, 0)
})

test("cmds run in order and stop at the first failure; rm is journaled and undone", pack() {
  stick dir = fresh("tests/fixtures/chain")
  burn {
    fs.mkdir(path.join(dir, "dist"))
    fs.write_text(path.join(dir, "dist/out.txt"), "built\n")
  }
  edit_manifest(dir, pack(m) {
    m.tasks["steps"] = {cmds: [["echo", "one"], ["bash", "-c", "echo two; exit 4"], ["echo", "three"]]}
    m.tasks["clean"] = {rm: ["dist", "nothing-here"]}
    m.tasks["clean-then-fail"] = {cmd: ["bash", "-c", "exit 9"], needs: ["clean"]}
  })
  stick s = tool_in(dir, ["show", "steps"])
  exits(s, 0)
  says(s.out, "echo one  &&  bash -c 'echo two; exit 4'  &&  echo three")
  stick r = tool_in(dir, ["run", "steps"])
  exits(r, 1)
  says(r.out, "\n    one")
  says(r.out, "\n    two")
  never_says(r.out, "\n    three")
  says(r.err, "exited 4")
  stick c = tool_in(dir, ["run", "clean"])
  exits(c, 0)
  says(c.out, "removed dist")
  assert(not there(dir, "dist"), "dist is still there")
  stick u = cig(dir, ["unburn", last_run(dir).id])
  exits(u, 0)
  assert(read(dir, "dist/out.txt") == "built\n", "the removal was not undone")
  stick f = tool_in(dir, ["run", "clean-then-fail"])
  exits(f, 1)
  assert(read(dir, "dist/out.txt") == "built\n", "the removal was not rolled back with the run")
})

test("each runs a command once per file; fail_on_output fails a check that prints", pack() {
  stick dir = fresh("tests/fixtures/chain")
  burn {
    fs.mkdir(path.join(dir, "src"))
    fs.mkdir(path.join(dir, "src/fixtures"))
    fs.write_text(path.join(dir, "src/a.txt"), "A\n")
    fs.write_text(path.join(dir, "src/b.txt"), "B\n")
    fs.write_text(path.join(dir, "src/fixtures/c.txt"), "C\n")
  }
  edit_manifest(dir, pack(m) {
    m.tasks["each-file"] = {cmd: ["cat", "{file}"], each: {files: ["src/**/*.txt"], skip: ["fixtures"]}}
    m.tasks["quiet-ok"] = {cmd: ["true"], fail_on_output: true}
    m.tasks["noisy"] = {cmd: ["echo", "src/a.txt"], fail_on_output: true}
  })
  stick s = tool_in(dir, ["show", "each-file"])
  exits(s, 0)
  says(s.out, "once per file: src/**/*.txt")
  stick r = tool_in(dir, ["run", "each-file"])
  exits(r, 0)
  says(r.out, "A")
  says(r.out, "B")
  never_says(r.out, "C")
  exits(tool_in(dir, ["run", "quiet-ok"]), 0)
  stick n = tool_in(dir, ["run", "noisy"])
  exits(n, 1)
  says(n.err, "printed output it must not")
})

test("a var from a glob names the file a shell used to expand", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), json.stringify({
      project: "gem",
      toolchains: {gemmy: {language: "Gemmy", family: "ruby", detect: ["glob:*.gemspec"], tools: [],
        vars: {gemspec: [{glob: "*.gemspec"}]},
        stages: {package: [["echo", "build", "{gemspec}"]]}}},
      components: {g: {path: ".", toolchain: "gemmy"}},
    }, 2))
    fs.write_text(path.join(dir, "thing.gemspec"), "Gem::Specification.new\n")
  }
  stick s = tool_in(dir, ["show", "g:package"])
  exits(s, 0)
  says(s.out, "echo build thing.gemspec")
})

# ----- 0.4.1: what the debugging session found ------------------------------

test("a python project with neither requirements nor a build system runs on the python found", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "pyproject.toml"), "[project]\nname = \"x\"\n")
    fs.mkdir(path.join(dir, "tests"))
    fs.write_text(path.join(dir, "tests/test_a.py"), "")
  }
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick listed = tool_in(dir, ["list"]).out
  never_says(listed, "{python}")
  never_says(listed, "{py}")
  says(listed, "-m unittest discover")
  stick c = tool_in(dir, ["check"])
  never_says(c.out + c.err, "has no value")
})

test("an os: condition names a system cig reports, in any case, or check says which", pack() {
  stick dir = fresh("tests/fixtures/empty")
  stick manifest = pack(cond) => json.stringify({
    project: "oses",
    toolchains: {mine: {language: "Mine", family: "mine", detect: ["file:mine.toml"], tools: [],
      stages: {build: [{when: [cond], cmd: ["echo", "picked"]}, {cmd: ["echo", "other"]}]}}},
    components: {m: {path: ".", toolchain: "mine"}},
  }, 2)
  burn {
    fs.write_text(path.join(dir, "mine.toml"), "x = 1\n")
    fs.write_text(path.join(dir, "cig-tasks.json"), manifest("os:darwin"))
  }
  stick c = tool_in(dir, ["check"])
  exits(c, 1)
  says(c.out + c.err, "`os:darwin` names no operating system cig reports")
  says(c.out + c.err, "`macos` is the name for it")
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), manifest("os:UNIX"))
  }
  exits(tool_in(dir, ["check"]), 0)
  stick r = tool_in(dir, ["run", "m:build"])
  exits(r, 0)
  if env.get("OS", "") == "Windows_NT" {
    says(r.out, "other")
  } else {
    says(r.out, "picked")
  }
})

test("__doctor says what a rehearsal can use here: the isolation, each registry's tool, and what is kept (#56)", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick d = self_doctor(dir, {})
  stick box = finding_of(d, "rehearse-box")
  if fs.is_file("/proc/sys/kernel/osrelease") {
    assert(box.severity == "ok" or (box.severity == "note" and box.found.starts_with("no contained box: ")), json.stringify(box))
  } else {
    assert(box.severity == "note", json.stringify(box))
    says(box.found, "the rehearsal needs cig 1.12.0 or later on Linux")
  }
  # The stubs stand in for npm, pip and cargo.
  assert(finding_of(d, "rehearse-npm").severity == "ok", json.stringify(finding_of(d, "rehearse-npm")))
  says(finding_of(d, "rehearse-npm").found, "npm")
  says(finding_of(d, "rehearse-crates.io").found, "cargo")
  says(finding_of(d, "rehearse-kept").found, "verdict(s) in")
  says(finding_of(d, "rehearse-kept").found, "in the quarantine")
})

test("__doctor counts a python it cannot find as a missing tool", pack() {
  if on_windows {
    # cig searches the Windows directories after PATH, as CreateProcess does,
    # and C:\Windows\py.exe is always there to be found.
    exhale "      (skipped on Windows: py.exe lives in the Windows directory, which a program search always reaches)"
    snuff
  }
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.write_text(path.join(dir, "requirements.txt"), "requests\n")
    fs.mkdir(path.join(dir, "tests"))
    fs.write_text(path.join(dir, "tests/test_a.py"), "")
  }
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  # A PATH with no python on it: the stubs alone.
  # The hop's own PATH chooses its program (cig 1.4.0), so cig is named by its path.
  stick bare = hop_env(dir, tool_prog(proc.which("cig")), tool_args(["__doctor", "--json"]), {PATH: stub_dir})
  exits(bare, 0)
  stick missing = json.parse(bare.out).findings.filter(pack(f) => f.check.starts_with("tool:") and f.found.contains("none of python, python3, py is on PATH"))
  assert(missing.len() == 1, bare.out)
  assert(missing[0].severity == "action", json.stringify(missing[0]))
  says(missing[0].fix, "https://www.python.org/downloads/")
})


# ----- 0.5.0: toolchain versions, the switch (#31) -----------------------------
#
# The monorepo's web/.nvmrc pins node 20; the stubs answer 99.1.0 to every
# version question, and the stub `mise` has every version (`mise where`
# exits 0) and logs what it is asked to run.

test("opening a project with a node pin mismatch asks once, and runs on the installed version meanwhile", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick r = tool_stubbed(dir, ["run", "web:build"])
  exits(r, 0)
  says(r.err, "1 language disagrees with this machine")
  says(r.err, "node  20 pinned by web/.nvmrc   installed 99.1.0")
  says(r.err, "Switch to the pinned versions for cigo's tasks? mise has it.")
  says(r.err, "cigo versions switch")
  says(r.err, "cigo versions keep")
  never_says(stub_log(dir), "mise exec")
  says(stub_log(dir), "pnpm run build")
  # Asked once: the next run says one line, not the question again.
  stick again = tool_stubbed(dir, ["run", "web:build"])
  exits(again, 0)
  never_says(again.err, "Switch to the pinned versions")
  says(again.err, "`cigo versions` shows which")
})

test("yes runs the task through mise exec with the pinned version, and never touches the default", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick yes = tool_stubbed(dir, ["versions", "switch"])
  exits(yes, 0)
  says(yes.out, "remembered: cigo's tasks run on the pinned versions in this project (node 20)")
  stick r = tool_stubbed(dir, ["run", "web:build"])
  exits(r, 0)
  says(r.err, "switching: node 20 (web/.nvmrc) via mise")
  never_says(r.err, "web/.nvmrc pins 20")
  never_says(r.err, "Switch to the pinned versions")
  says(r.out, "pnpm run build   (in web)   on node 20 via mise (web/.nvmrc)")
  says(stub_log(dir), "mise exec node@20 -- pnpm run build @" + norm(dir) + "/web")
  never_says(stub_log(dir), "mise use")
  never_says(stub_log(dir), "mise settings")
  # The switch made the versions agree, so --strict passes.
  exits(tool_stubbed(dir, ["run", "web:build", "--strict"]), 0)
  # The run's record says which version each task ran on.
  stick report = json.load(fs.glob(path.join(dir, ".cig-orchestrator/reports/*.json")).sort().last())
  stick build = report.tasks.filter(pack(t) => t.task == "web:build").first()
  assert(build.versions == ["node 20 via mise (web/.nvmrc)"], "the report does not say the version: ${json.stringify(build)}")
})

test("no runs on the installed version and is not asked again until a pin changes", pack() {
