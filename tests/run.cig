test("check reads a project's own toolchains: keys, conditions, stages and vars", pack() {
  stick dir = fresh("tests/fixtures/empty")
  stick m = {
    toolchains: {
      mine: {
        language: "Mine", detcet: ["file:x"], detect: ["fiel:mine.toml"],
        stages: {biuld: [["make"]], test: [{when: ["tool:x"]}], lint: "make lint", check: [{when: [["glob:*.x", "grepp:a:b"]], cmd: ["x"]}]},
        vars: {flag: [{when: ["file:a"]}], other: "x"},
      },
      fine: {language: "Fine", detect: ["file:fine.toml", ["glob:*.f", "not:file:skip"]], stages: {build: [["make", "{flag}"], {when: ["json:package.json:a.b"], shell: "x"}]}, vars: {flag: [{value: "-j2"}]}},
    },
    tasks: {x: {cmd: ["true"]}},
  }
  burn {
    json.save(path.join(dir, "cig-tasks.json"), m, 2)
  }
  stick r = tool_in(dir, ["check"])
  exits(r, 1)
  for piece in [
    "toolchain mine: unknown key `detcet`, ignored; did you mean `detect`?",
    "toolchain mine: `detect`: `fiel:mine.toml` is not a condition",
    "toolchain mine: `stages.biuld` is not a stage; did you mean `build`?",
    "toolchain mine: `stages.test`: an alternative needs `cmd`, `cmds`, `rm` or `shell`",
    "toolchain mine: `stages.lint` must be a list of alternatives",
    "toolchain mine: `stages.check`: `grepp:a:b` is not a condition",
    "toolchain mine: `vars.flag`: each alternative needs a `value`",
    "toolchain mine: `vars.other` must be a list of alternatives",
  ] {
    says(r.out, piece)
  }
  never_says(r.out, "toolchain fine:")
})

