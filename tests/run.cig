  stick r = tool_in(dir, ["toolchains", "node-npm"])
  exits(r, 0)
  says(r.out, "footprints")
  says(r.out, "registry.npmjs.org")
  stick m = tool_in(dir, ["toolchains", "make"])
  says(m.out, "task runner")
})

# ----- known-bad packages, from OSV (#55 step 3) ---------------------------------

# OSV's answers for the osv fixture, served from disk: a POST to a file://
# URL reads the file. The wrapper writes down what curl was handed (its
# words, and its stdin, the batch) and passes it on to the real curl.
pull osv_online_env(dir) {
  stick bin = dir + "-bin"
  stick log = dir + "-curl"
  burn {
    fs.mkdir(bin)
    fs.mkdir(log)
    fs.write_text(path.join(bin, "curl"), [
      '#!/bin/sh',
      'cat > "$CURL_LOG/in.$$"',
      'printf "%s\n" "$*" >> "$CURL_LOG/words"',
      'exec "$REAL_CURL" "$@" < "$CURL_LOG/in.$$"',
    ].join("\n") + "\n")
    stick m = proc.run("chmod", ["755", path.join(bin, "curl")], {timeout_ms: 10000})
    assert(m.code == 0, m.err)
  }
  snuff {CIGO_OSV: "online", CIGO_OSV_API: "file://" + path.join(dir, "api"), CURL_LOG: log, REAL_CURL: proc.which("curl"), PATH: bin + path_sep + env.get("PATH", "")}
}

# What went out to OSV: each batch curl read on stdin.
pull osv_batches(dir) {
  roll sent = []
  for f in fs.list(dir + "-curl") {
    if path.base(f).starts_with("in.") and fs.read_text(f).trim() != "" {
      sent.push(json.parse(fs.read_text(f)))
    }
  }
  snuff sent
}

pull has_sh_and_curl() {
  if on_windows or proc.which("curl") == null {
    exhale "      (skipped: needs sh and curl)"
    snuff false
  }
  snuff true
}

test("OSV online: a malicious package is refused, a vulnerable one reported, and only ecosystem, name and version go out", pack() {
  if not has_sh_and_curl() {
    snuff
  }
  stick dir = fresh("tests/fixtures/osv")
  stick osv = osv_online_env(dir)
  stick a = guard_tool(dir, ["audit", "install"], osv)
  exits(a, 0)
  says(a.out, "install: critical")
  says(a.out, "E870")
  says(a.out, "event-stream@3.3.6")
  says(a.out, "a known malicious package (MAL-0000-test-1)")
  says(a.out, "E885")
  says(a.out, "lodash@4.17.15")
  says(a.out, "1 known vulnerability, the worst high (GHSA-test-0002); fixed in 4.17.21")
  assert(not a.out.contains("left-pad"), "a clean package was reported:\n" + a.out)
  # One batch went out, and in it each package's ecosystem, name and version, nothing else.
  stick sent = osv_batches(dir)
  assert(sent.len() == 1, "expected one batch, got ${sent.len()}")
  stick qs = sent[0].queries
  assert(qs.map(pack(q) => q.package.name).sort() == ["event-stream", "left-pad", "lodash"], json.stringify(qs))
  for q in qs {
    assert(q.keys().sort() == ["package", "version"], json.stringify(q))
    assert(q.package.keys().sort() == ["ecosystem", "name"], json.stringify(q))
    assert(q.package.ecosystem == "npm", json.stringify(q))
  }
  assert(not json.stringify(sent).contains(path.base(dir)), "the project's path went out: " + json.stringify(sent))
  # The run is refused before anything is installed, on the answers kept: OSV is not asked again.
  stick r = guard_tool(dir, ["run", "install"], osv)
  exits(r, 1)
  says(r.out, "E870")
  says(r.err, "refused")
  assert(not there(dir, "done.txt"), "the refused install ran")
  assert(osv_batches(dir).len() == 1, "OSV was asked again within the day")
})

test("OSV offline: the database built from OSV's dump finds the same, by version and by range, and asks OSV nothing", pack() {
  if not has_sh_and_curl() {
    snuff
  }
  if proc.which("python3") == null {
    exhale "      (skipped: needs python3 to zip the dump)"
    snuff
  }
  stick dir = fresh("tests/fixtures/osv")
  stick dumps = dir + "-dumps"
  burn {
    fs.mkdir(path.join(dumps, "npm"))
    stick z = proc.run("python3", ["-c", "import os, sys, zipfile\nsrc, out = sys.argv[1], sys.argv[2]\nwith zipfile.ZipFile(out, 'w') as z:\n    for f in sorted(os.listdir(src)):\n        z.write(os.path.join(src, f), f)\n", path.join(root, "tests", "fixtures", "osv-dump", "npm"), path.join(dumps, "npm", "all.zip")], {timeout_ms: 30000})
    assert(z.code == 0, z.err)
  }
  # OSV's API is a folder that does not exist: asking it would be said.
  stick off = {CIGO_OSV_DUMPS: "file://" + dumps, CIGO_OSV_API: "file://" + path.join(dir, "no-api")}
  stick u = guard_tool(dir, ["audit", "--update-db", "npm"], off)
  exits(u, 0)
  says(u.out, "osv: npm: 3 advisories: 1 versions named, 2 packages by range, 0 bad in every version")
  stick a = guard_tool(dir, ["audit", "install"], off.merge({CIGO_OSV: "offline"}))
  exits(a, 0)
  says(a.out, "install: critical")
  says(a.out, "a known malicious package (MAL-0000-test-1)")
  says(a.out, "lodash@4.17.15")
  says(a.out, "the worst high (GHSA-test-0002); fixed in 4.17.21")
  assert(not a.out.contains("left-pad"), "left-pad 1.3.0 is where the fix landed, not affected:\n" + a.out)
  assert(not a.err.contains("could not be reached"), "offline asked OSV:\n" + a.err)
  # --offline asks for the same for one audit, whatever the setting.
  stick once = guard_tool(dir, ["audit", "--offline", "install"], off)
  exits(once, 0)
  says(once.out, "install: critical")
  # A dump that cannot be fetched is said, and no database is made of it.
  stick missing = guard_tool(dir, ["audit", "--update-db", "PyPI"], off)
  exits(missing, 2)
  says(missing.err, "osv: PyPI: the dump could not be fetched or unpacked")
})

test("OSV: a project cannot turn it off, off asks nothing, and OSV out of reach is said once while the run goes on", pack() {
  stick dir = fresh("tests/fixtures/osv")
  edit_manifest(dir, pack(m) {
    m.settings = {osv: "off"}
  })
  stick chk = tool_layers(dir, ["check"], {CIGO_OSV: ""})
  says(chk.out + chk.err, "`settings.osv` asks for `off`, looser than your `online`")
  says(tool_layers(dir, ["config", "osv"], {CIGO_OSV: ""}).out, "online")
  # Off by the user's own choice: nothing is read against OSV.
  stick quiet = guard_tool(dir, ["audit", "install"], {})
  exits(quiet, 0)
  says(quiet.out, "install: none")
  # Online and out of reach: said once, and the run goes on with the rest of the guard.
  stick far = guard_tool(dir, ["run", "install"], {CIGO_OSV: "online"})
  exits(far, 0)
  says(far.err, "known-bad packages were not checked: OSV could not be reached")
  assert(there(dir, "done.txt"), "the task did not run")
})

# ----- typosquats and registry metadata (#55 E881..E884) -----------------------

# Every finding of a given code against a given package name.
pull findings_of(audit_json, code, pkg_name) {
  stick list = audit_json.tasks.install.findings
  snuff list.filter(pack(f) => f.code == code and str(f.get("pkg", "")) == pkg_name)
}

pull has_pkg_finding(audit_json, code, pkg_name) {
  snuff not findings_of(audit_json, code, pkg_name).is_empty()
}

test("typosquats in a lockfile are flagged E881; the top package and an unrelated name are not", pack() {
  stick dir = fresh("tests/fixtures/typosquat")
  stick r = guard_tool(dir, ["audit", "install", "--json"], {})
  exits(r, 0)
  stick j = json.parse(r.out)
  stick findings = j.tasks.install.findings
  roll squats = findings.filter(pack(f) => f.code == "E881").map(pack(f) => str(f.get("pkg", "")))
  assert(squats.contains("expresss"), "expresss missed:\n" + r.out)
  assert(squats.contains("lodahs"), "lodahs missed:\n" + r.out)
  assert(not squats.contains("lodash"), "lodash wrongly flagged:\n" + r.out)
  assert(not squats.contains("my-local-project-widget"), "unrelated name flagged:\n" + r.out)
  # The near one is named in the finding (its what-to-do).
  stick e = findings.find(pack(f) => f.code == "E881" and str(f.get("pkg", "")) == "lodahs")
  says(str(e.get("says", "")), "two letters from lodash")
  stick x = findings.find(pack(f) => f.code == "E881" and str(f.get("pkg", "")) == "expresss")
  says(str(x.get("says", "")), "one letter from express")
})

test("registry metadata reads produce E882, E883 and E884 from fixtures; a clean name has none", pack() {
  if not has_sh_and_curl() {
    snuff
  }
  stick dir = fresh("tests/fixtures/registry-meta")
  stick npm_dir = path.join(dir, "npm")
  stick today = time.now_iso().slice(0, 10) + "T00:00:00Z"
  stick way_back = "2026-01-01T00:00:00Z"
  burn {
    fs.mkdir(npm_dir)
    fs.write_text(path.join(npm_dir, "freshbox-util"), json.stringify({
      versions: {"1.0.0": {scripts: {}, repository: {url: "git+https://github.com/x/freshbox-util.git"}}},
      time: {created: way_back, modified: today, "1.0.0": today}
    }))
    fs.write_text(path.join(npm_dir, "freshbox-added-script"), json.stringify({
      versions: {
        "1.0.0": {scripts: {}, repository: {url: "git+https://github.com/x/foo.git"}},
        "2.0.0": {scripts: {postinstall: "node install.js"}, repository: {url: "git+https://github.com/x/foo.git"}}
      },
      time: {created: way_back, modified: today, "1.0.0": way_back, "2.0.0": today}
    }))
    fs.write_text(path.join(npm_dir, "freshbox-no-repo"), json.stringify({
      versions: {"1.0.0": {scripts: {}}},
      time: {created: way_back, modified: way_back, "1.0.0": way_back}
    }))
    fs.write_text(path.join(npm_dir, "freshbox-clean"), json.stringify({
      versions: {"1.0.0": {scripts: {}, repository: {url: "git+https://github.com/x/clean.git"}}},
      time: {created: way_back, modified: way_back, "1.0.0": way_back}
    }))
  }
  stick on = {CIGO_REGISTRY_META: "online", CIGO_REGISTRY_NPM: "file://" + npm_dir}
  stick r = guard_tool(dir, ["audit", "install", "--json"], on)
  exits(r, 0)
  stick j = json.parse(r.out)
  assert(has_pkg_finding(j, "E882", "freshbox-util"), "E882 missed on freshbox-util:\n" + r.out)
  assert(has_pkg_finding(j, "E882", "freshbox-added-script"), "E882 missed on freshbox-added-script:\n" + r.out)
  assert(has_pkg_finding(j, "E883", "freshbox-added-script"), "E883 missed on freshbox-added-script:\n" + r.out)
  assert(has_pkg_finding(j, "E884", "freshbox-no-repo"), "E884 missed on freshbox-no-repo:\n" + r.out)
  # The clean name has none of the three.
  assert(not has_pkg_finding(j, "E882", "freshbox-clean"), "E882 wrongly on freshbox-clean:\n" + r.out)
  assert(not has_pkg_finding(j, "E883", "freshbox-clean"), "E883 wrongly on freshbox-clean:\n" + r.out)
  assert(not has_pkg_finding(j, "E884", "freshbox-clean"), "E884 wrongly on freshbox-clean:\n" + r.out)
  # freshbox-no-repo is old: E882 does not fire on it.
  assert(not has_pkg_finding(j, "E882", "freshbox-no-repo"), "E882 wrongly on old freshbox-no-repo:\n" + r.out)
  # The E883 finding names the previous version.
  stick e = findings_of(j, "E883", "freshbox-added-script").first()
  says(str(e.get("says", "")), "1.0.0 ran no install script")
})

test("registry_meta off makes no registry read", pack() {
  if not has_sh_and_curl() {
    snuff
  }
  stick dir = fresh("tests/fixtures/registry-meta")
  # No fixture files written: if the code asked the registry at this file:// URL
  # it would fail, so any metadata finding would mean something was tried.
  stick off = {CIGO_REGISTRY_META: "off", CIGO_REGISTRY_NPM: "file:///nonexistent/registry-npm"}
  stick r = guard_tool(dir, ["audit", "install", "--json"], off)
  exits(r, 0)
  stick j = json.parse(r.out)
  stick findings = j.tasks.install.findings
  for f in findings {
    stick code = str(f.get("code", ""))
    assert(code != "E882" and code != "E883" and code != "E884", "metadata code with registry_meta off: " + json.stringify(f))
  }
  # curl was not run, so the warning OSV-style was never raised.
  assert(not r.err.contains("registry metadata was not checked"), "registry asked anyway: " + r.err)
})

# ----- reports for code scanning and pull requests (#56 step 6) -------------------

# The line of a file that holds a piece of text, from 1.
pull line_of(file, needle) {
  roll n = 0
  for line in fs.read_text(file).lines() {
    n += 1
    if line.contains(needle) {
      snuff n
    }
  }
  snuff 0
}

pull sarif_result(doc, code, where_has) {
  for r in doc.runs[0].results {
    if r.ruleId == code and json.stringify(r).contains(where_has) {
      snuff r
    }
  }
  snuff null
}

test("audit --sarif: a result per finding at its line in the project, a rule per code with the registry's title", pack() {
  stick dir = fresh("tests/fixtures/guard")
  stick r = guard_tool(dir, ["audit", "--sarif"], {})
  exits(r, 0)
  stick sarif = json.parse(r.out)
  assert(sarif.version == "2.1.0", "version ${sarif.version}")
  stick driver = sarif.runs[0].tool.driver
  assert(driver.name == "cig-orchestrator", driver.name)
  stick rule = driver.rules.filter(pack(x) => x.id == "E879").first()
  assert(rule != null, json.stringify(driver.rules))
  assert(rule.name == "eyes cigo or the tin", rule.name)
  assert(rule.properties["security-severity"] == "9.5", json.stringify(rule))
  # An inline command sits at its task's line in the manifest; a script finding at its own line.
  stick tin = sarif_result(sarif, "E879", "cig-tasks.json")
  assert(tin != null, r.out)
  assert(tin.level == "error", json.stringify(tin))
  stick at = tin.locations[0].physicalLocation
  assert(at.artifactLocation.uri == "cig-tasks.json", json.stringify(at))
  assert(at.region.startLine == line_of(path.join(dir, "cig-tasks.json"), "\"tin\""), json.stringify(at))
  stick key = sarif_result(sarif, "E871", "install.sh")
  assert(key != null, r.out)
  assert(key.locations[0].physicalLocation.region.startLine == line_of(path.join(dir, "install.sh"), "id_ed25519"), json.stringify(key))
  # Nothing but the project's own paths: no home, no absolute path.
  assert(not r.out.contains(fs.home()), "a path from the home went into the report")
})

test("audit --markdown: one table for a pull request, the heaviest finding first", pack() {
  stick dir = fresh("tests/fixtures/guard")
  stick r = guard_tool(dir, ["audit", "--markdown"], {})
  exits(r, 0)
  says(r.out, "### cigo audit: critical")
  says(r.out, "| level | in | finding | where | what |")
  stick rows = r.out.lines().filter(pack(l) => l.starts_with("| ") and not l.starts_with("| level"))
  assert(rows.first().starts_with("| critical | tin | `E879` eyes cigo or the tin | `cig-tasks.json:"), rows.first())
  # A pipe in the evidence is escaped, so the table holds together.
  says(r.out, "id_ed25519 \\| curl")
  stick clean = guard_tool(dir, ["audit", "--markdown", "clean"], {})
  says(clean.out, "### cigo audit: none")
  says(clean.out, "nothing found")
})

test("audit --sarif places a known-bad package at its entry in the lockfile", pack() {
