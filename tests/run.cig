test("one language's output becomes another's arguments, environment and input", pack() {
  stick dir = fresh("tests/fixtures/chain")
  stick r = tool_in(dir, ["run", "report"])
  exits(r, 0)
  says(r.out, "v=1.4.0 c=abc123 n=3")
  says(r.out, "from python: 1.4.0 3")
  says(tool_in(dir, ["run", "each"]).out, "[a][b][c]")
  says(tool_in(dir, ["run", "json-arg"]).out, "abc123")
  says(tool_in(dir, ["run", "env-pass"]).out, "v1.4.0 from env-pass")
  says(tool_in(dir, ["run", "notes"]).out, "line two|")
  stick shown = tool_in(dir, ["show", "report"]).out
  says(shown, "uses       the output of version, stats")
})

test("|sh quotes a value for a shell line, so a value cannot run as a command", pack() {
  stick dir = fresh("tests/fixtures/chain")
  edit_manifest(dir, pack(m) {
    m.tasks["evil"] = {cmd: ["printf", "x; echo INJECTED $(echo too) {a,b}"], capture: "text"}
    m.tasks["safe"] = {shell: "printf '<%s>' {{evil|sh}} {{words|sh}}"}
  })
  stick r = tool_in(dir, ["run", "safe"])
  exits(r, 0)
  says(r.out, "<x; echo INJECTED $(echo too) {a,b}><b><a><c>")
  never_says(r.out, "\n    INJECTED")
})

test("with --only, a value from a task that didn't run says why", pack() {
