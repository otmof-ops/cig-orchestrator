})

test("adopt --force follows a project that changed package managers, keeping its settings", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.mkdir(path.join(dir, "web"))
    fs.write_text(path.join(dir, "web/package.json"), "{\"name\": \"web\", \"scripts\": {\"build\": \"echo b\"}}\n")
    fs.write_text(path.join(dir, "web/package-lock.json"), "{}\n")
  }
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  assert(json.load(path.join(dir, "cig-tasks.json")).components.web.toolchain == "node-npm", "the first adopt should say npm")
  edit_manifest(dir, pack(m) {
    m.components.web["desc"] = "the front end"
  })
  burn {
    fs.rm(path.join(dir, "web/package-lock.json"))
    fs.write_text(path.join(dir, "web/pnpm-lock.yaml"), "lockfileVersion: '9.0'\n")
  }
  stick again = tool_in(dir, ["adopt", "--write", "--force"])
  exits(again, 0)
  says(again.err, "web: node-npm no longer fits web, so it is node-pnpm now")
  stick c = json.load(path.join(dir, "cig-tasks.json")).components.web
  assert(c.toolchain == "node-pnpm" and c.get("desc", "") == "the front end", "web: ${c}")
})

