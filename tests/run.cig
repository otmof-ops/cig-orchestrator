  stick e = tool_layers(dir, ["config", "explain", "versions"], {})
  exits(e, 0)
  says(e.out, "default   ask")
  says(e.out, "values    off < never < ask < always")
  says(e.out, "presets   ")
  says(e.out, "floor     a project may only tighten this")
  stick free = tool_layers(dir, ["config", "explain", "issues_repo"], {})
