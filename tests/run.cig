# ----- the rehearsal (#55, #56) -------------------------------------------------

# The rehearsal needs cig 1.12.0's contained box: Linux, user namespaces,
# mount_setattr. Where the box cannot be had the run says so (E777) and the
# test steps aside.
pull rehearsal_here() {
  # `cig` here is the suite's helper, not the module: the version is asked.
  stick v = text.captures(cig(root, ["--version"]).out, '(\d+)\.(\d+)')
  snuff fs.exists("/proc/self/ns/user") and v != null and (int(v[1]) > 1 or (int(v[1]) == 1 and int(v[2]) >= 12))
}

pull no_box_here(r) {
  stick seen = r.out + r.err
  if seen.contains("E777") or seen.contains("the rehearsal is not possible here") or seen.contains("the contained box is not possible here") {
    exhale "        (the contained box cannot be had here; the rehearsal tests step aside)"
    snuff true
  }
  snuff false
}

test("the rehearsal applies a stage that stays within its footprint, and approves it", pack() {
  if not rehearsal_here() {
    snuff
  }
  stick dir = fresh("tests/fixtures/rehearse")
  stick r = guard_tool(dir, ["run", "within"], {CIGO_REHEARSE: "auto"})
  if no_box_here(r) {
    snuff
  }
  exits(r, 0)
  says(r.out, "rehearsed in the box")
  says(r.out, "rehearsed: nothing outside its footprint")
  assert(there(dir, "made.txt"), "the rehearsal's layer was not applied")
  # Approved as it is: the next run pays one lookup, no rehearsal.
  stick again = guard_tool(dir, ["run", "within"], {CIGO_REHEARSE: "auto"})
  exits(again, 0)
  if has_tin_mac() {
    never_says(again.out, "rehearsed in the box")
  }
})

test("the rehearsal holds what a stage did beyond its footprint; --accept-risk=<task> applies it", pack() {
  if not rehearsal_here() {
    snuff
  }
  stick dir = fresh("tests/fixtures/rehearse")
  stick r = guard_tool(dir, ["run", "beyond"], {CIGO_REHEARSE: "auto"})
  if no_box_here(r) {
    snuff
  }
  exits(r, 1)
  says(r.out, "E873")
  says(r.out, ".git/hooks/pre-commit")
  says(r.out + r.err, "is held: its rehearsal is rated high")
  assert(not there(dir, ".git/hooks/pre-commit"), "the held rehearsal reached the project")
  assert(not there(dir, "made.txt"), "the held rehearsal's run was not rolled back")
  stick ok = guard_tool(dir, ["run", "beyond", "--accept-risk=beyond"], {CIGO_REHEARSE: "auto"})
  exits(ok, 0)
  says(ok.out, "what it did is applied")
  assert(there(dir, ".git/hooks/pre-commit"), "--accept-risk did not apply the rehearsal")
  assert(there(dir, "made.txt"), "--accept-risk did not apply the rehearsal")
})

test("a rehearsal names a write outside the footprint, and keeps it in the box (E880)", pack() {
  if not rehearsal_here() {
    snuff
  }
  stick dir = fresh("tests/fixtures/rehearse")
  stick r = guard_tool(dir, ["rehearse", "./outside.sh"], {})
  if no_box_here(r) {
    snuff
  }
  says(r.out, "E880")
  says(r.out, "outside its footprint")
})

test("cigo rehearse rates a script by what it did, and applies none of it", pack() {
  if not rehearsal_here() {
    snuff
  }
  stick dir = fresh("tests/fixtures/rehearse")
  # A high verdict fails here as it does under CI (rehearse_fail_on).
  exits(guard_tool(dir, ["config", "rehearse_fail_on", "high"], {}), 0)
  stick bad = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  if no_box_here(bad) {
    snuff
  }
  exits(bad, 2)
  says(bad.out, "E873")
  says(bad.out, "rated high")
  assert(not there(dir, ".git/hooks/pre-commit"), "cigo rehearse applied what it rehearsed")
  # Finding nothing is not clean while the box cannot see reads and
  # connections (#80): E898, low, and nothing kept.
  stick good = guard_tool(dir, ["rehearse", "./clean.sh"], {})
  exits(good, 0)
  says(good.out, "E898")
  says(good.out, "verdict low, and nothing is kept")
  assert(not there(dir, ".cigo-rehearse"), "cigo rehearse applied what it rehearsed")
  stick j = guard_tool(dir, ["rehearse", "./replica.sh", "--json"], {})
  exits(j, 2)
  stick v = json.parse(j.out)
  assert(v.risk == "high", "the JSON verdict is ${v.risk}")
  stick usage = guard_tool(dir, ["rehearse", "left-pad"], {})
  exits(usage, 2)
  says(usage.out + usage.err, "npm:left-pad")
})

test("a verdict is kept for the same bytes: asked again it is not rehearsed, --fresh rehearses, a forged one is refused", pack() {
  if not rehearsal_here() {
    snuff
  }
  if not has_tin_mac() {
    exhale "      (skipped: this cig cannot sign a verdict)"
    snuff
  }
  stick dir = fresh("tests/fixtures/rehearse")
  # A high verdict fails here as it does under CI (rehearse_fail_on).
  exits(guard_tool(dir, ["config", "rehearse_fail_on", "high"], {}), 0)
  stick first = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  if no_box_here(first) {
    snuff
  }
  exits(first, 2)
  says(first.out, "rehearsing ./replica.sh")
  stick again = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  exits(again, 2)
  says(again.out, "rehearsed ./replica.sh before")
  assert(not again.out.contains("rehearsing ./replica.sh"), "the same bytes were rehearsed twice:\n" + again.out)
  says(guard_tool(dir, ["rehearse", "./replica.sh", "--fresh"], {}).out, "rehearsing ./replica.sh")
  # A rehearsal that saw nothing keeps nothing (E898): asked again, rehearsed again.
  exits(guard_tool(dir, ["rehearse", "./clean.sh"], {}), 0)
  stick blind = guard_tool(dir, ["rehearse", "./clean.sh"], {})
  says(blind.out, "rehearsing ./clean.sh")
  never_says(blind.out, "rehearsed ./clean.sh before")
  # One byte more is another script.
  burn {
    fs.append_text(path.join(dir, "replica.sh"), ": one more line\n")
  }
  says(guard_tool(dir, ["rehearse", "./replica.sh"], {}).out, "rehearsing ./replica.sh")
  # A kept high verdict edited to read clean does not verify: refused, and rehearsed again.
  roll forged_one = false
  burn {
    for f in fs.list(path.join(cigo_home(dir), "rehearsals")) {
      if f.ends_with(".json") and fs.read_text(f).contains("\"high\"") {
        fs.write_text(f, fs.read_text(f).replace("\"high\"", "\"none\""))
        forged_one = true
      }
    }
  }
  assert(forged_one, "no kept high verdict to forge")
  stick forged = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  says(forged.err, "not signed by your key")
  exits(forged, 2)
  says(forged.out, "rated high")
})

