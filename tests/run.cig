test("the environment loosens a setting only at a terminal, never under CI", pack() {
  stick dir = fresh("tests/fixtures/chain")
  says(tool_layers(dir, ["config", "versions"], {CIGO_VERSIONS: "off"}).out, "off")
  # Under CI the ci preset applies (versions never) and a looser environment value is ignored.
  stick ci = tool_layers(dir, ["config", "versions"], {CI: "1", CIGO_VERSIONS: "off"})
  says(ci.out, "never")
  stick listed = tool_layers(dir, ["config"], {CI: "1"})
  says(listed.out, "ci")
  # A value the key does not know is not a setting: ignored by the layer.
  says(tool_layers(dir, ["config", "versions"], {CIGO_VERSIONS: "0"}).out, "ask")
})

# ----- 1.3.0: the guard, first half (#55): the trust store, the static read, the verdict ------

pull guard_tool(dir, words, more) {
  # The static read's tests run without the rehearsal or OSV, at a terminal
  # or not: `rehearse = never` and `osv = off` in this test's own cigo home
  # (the environment's loosening is ignored under CI). A test that wants
  # either passes CIGO_REHEARSE or CIGO_OSV, which tightens it back.
  stick marker = path.join(cigo_home(dir), ".rehearse-off")
  if not fs.exists(marker) {
    hop_env(dir, tool_prog("cig"), tool_args(["config", "rehearse", "never"]), {CIGO_HOME: cigo_home(dir)})
    hop_env(dir, tool_prog("cig"), tool_args(["config", "osv", "off"]), {CIGO_HOME: cigo_home(dir)})
    burn {
      fs.write_text(marker, "")
    }
  }
  snuff hop_env(dir, tool_prog("cig"), tool_args(words), {CIGO_HOME: cigo_home(dir)}.merge(more))
}

# cig 1.11.0 signs the trust store (`cig tin mac`); an older cig cannot, and
# the guard says so and checks every run.
pull proc_uid() {
  roll u = ""
  burn {
    u = proc.run("id", ["-u"]).out.trim()
  }
  snuff u
}

pull has_tin_mac() {
  snuff cig(root, ["tin", "mac", "--help"]).code == 0
}

test("the guard lets a clean task run, and holds a persistence write until it is approved", pack() {
  stick dir = fresh("tests/fixtures/guard")
  stick r = guard_tool(dir, ["run", "clean"], {})
  exits(r, 0)
  never_says(r.out + r.err, "rated")
  stick h = guard_tool(dir, ["run", "rc-write"], {})
  exits(h, 1)
  says(h.out, "E873")
  says(h.out, "rated high")
  says(h.err, "cigo trust rc-write")
  assert(not there(dir, "note.txt"), "a held task ran")
  stick a = guard_tool(dir, ["run", "rc-write", "--accept-risk=rc-write"], {})
  exits(a, 0)
  assert(there(dir, "note.txt"), "the accepted task did not run")
})

test("the guard: medium takes --accept-risk alone, high needs the task's name", pack() {
  stick dir = fresh("tests/fixtures/guard")
  stick m = guard_tool(dir, ["run", "curl-sh"], {})
  exits(m, 1)
  says(m.out, "E874")
  says(m.out, "rated medium")
  stick m2 = guard_tool(dir, ["run", "curl-sh", "--accept-risk"], {})
  exits(m2, 0)
  assert(there(dir, "plan.txt"), "the accepted medium task did not run")
  stick h = guard_tool(dir, ["run", "rc-write", "--accept-risk"], {})
  exits(h, 1)
  says(h.err, "--accept-risk=rc-write")
  assert(not there(dir, "note.txt"), "a high task ran on a bare --accept-risk")
})

test("the guard refuses critical, and --run-untrusted=<task> runs it at a terminal only", pack() {
  stick dir = fresh("tests/fixtures/guard")
  stick c = guard_tool(dir, ["run", "tin"], {})
  exits(c, 1)
  says(c.out, "E879")
  says(c.err, "refused")
  assert(not there(dir, "tin.txt"), "a refused task ran")
  stick u = guard_tool(dir, ["run", "tin", "--run-untrusted=tin"], {})
  exits(u, 0)
  assert(there(dir, "tin.txt"), "--run-untrusted did not run the task")
  says(u.err, "no backup of the tin")
  stick ci = guard_tool(dir, ["run", "obf", "--run-untrusted=obf"], {CI: "1"})
  # Unattended, --run-untrusted means nothing; obf is medium and strict runs it with the report.
  exits(ci, 0)
  says(ci.out, "E875")
  stick ci2 = guard_tool(dir, ["run", "tin", "--run-untrusted=tin"], {CI: "1"})
  exits(ci2, 1)
  says(ci2.err, "refused")
})

test("the guard reads a script the task names: credentials with exfiltration is critical, with the file and line", pack() {
