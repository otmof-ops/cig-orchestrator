test("the guard: trust and footprint are checked in the manifest, and --no-guard skips the read", pack() {
  stick dir = fresh("tests/fixtures/guard")
  edit_manifest(dir, pack(m) {
    m.tasks["never"].trust = "always"
    m.tasks["clean"].footprint = {writes: "x", nope: []}
  })
