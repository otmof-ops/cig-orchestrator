#!/usr/bin/env cig
# SPDX-FileCopyrightText: 2026 Jay Taylor (https://github.com/otmof-ops/cig-orchestrator)
# SPDX-License-Identifier: Apache-2.0
# The test suite for cig-orchestrator, written in CigScript. Every test copies
# a fixture into .test-work/, runs the tool there as a child `cig` with its own
# CIGSCRIPT_HOME (so nothing reaches your run history), and checks what it
# printed and what it left on disk. From the repository root:
#
#   cig run tests/run.cig              every test
#   cig run tests/run.cig -- adopt     the tests whose name contains "adopt"
#   cigo run test                      the same, through the tool itself
#
# A failing suite rolls itself back, .test-work/ included; to look around
# after a failure, run it with `cig run --no-rollback tests/run.cig`.

pack { "./.test-work" }

stick root = fs.cwd()
stick tool = path.join(root, "orchestrate.cig")
stick launcher = path.join(root, "bin", "cigo")
stick work = path.join(root, ".test-work")
stick home = path.join(work, "cig-home")
stick only = args.get(0, "")

if not fs.is_file(tool) {
  log.error("run this from the repository root: cig run tests/run.cig")
  exit(2)
}

roll passed = 0
roll failed = []
roll copies = 0

pull test(name, body) {
  if only != "" and not name.contains(only) {
    snuff
  }
  try {
    body()
    passed += 1
    exhale "ok    ${name}"
  } ashtray e {
    failed.push(name)
    exhale "FAIL  ${name}"
    for line in e.message.lines() {
      exhale "        ${line}"
    }
  }
}

# A fresh copy of a fixture, under .test-work/.
pull fresh(fixture) {
  copies += 1
  stick dir = path.join(work, "${copies}-${path.base(fixture)}")
  burn {
    fs.cp(path.join(root, fixture), dir)
  }
  snuff dir
}

# Any program, in `dir`, with this suite's own cig home: {code, out, err}.
pull hop_env(dir, program, words, more) {
  roll r = null
  burn {
    r = proc.run(program, words, {
      cwd: dir,
      env: {CIGSCRIPT_HOME: home, NO_COLOR: "1", CIG_DOCTOR: "0", DEMO_REMOTE: dir + "-remote"}.merge(more),
      timeout_ms: 120000,
    })
  }
  snuff r
}

pull hop(dir, program, words) {
  snuff hop_env(dir, program, words, {})
}

# The stub toolchain first on PATH: every npm, cargo, go, uv... it runs is
# recorded in <dir>-stub.log with its arguments and directory, and succeeds.
pull stubbed(dir) {
  snuff {PATH: path.join(root, "tests/fixtures/stub-bin") + ":" + env.get("PATH", ""), STUB_LOG: dir + "-stub.log"}
}

pull tool_stubbed(dir, words) {
  snuff hop_env(dir, "cig", ["run", tool, "--"] + words, stubbed(dir))
}

pull stub_log(dir) {
  if fs.exists(dir + "-stub.log") {
    snuff fs.read_text(dir + "-stub.log")
  }
  snuff ""
}

# `pieces` appear in `textv` in this order.
pull in_order(textv, pieces) {
  roll at = -1
  for piece in pieces {
    stick i = textv.find(piece)
    assert(i >= 0, "expected `${piece}` in:\n${textv}")
    assert(i > at, "`${piece}` came too early in:\n${textv}")
    at = i
  }
}

pull edit_manifest(dir, change) {
  stick file = path.join(dir, "cig-tasks.json")
  stick m = json.load(file)
  change(m)
  burn {
    json.save(file, m, 2)
  }
}

pull cig(dir, words) {
  snuff hop(dir, "cig", words)
}

# The tool, the way a dev runs it without the launcher.
pull tool_in(dir, words) {
  snuff cig(dir, ["run", tool, "--"] + words)
}

pull last_run(dir) {
  snuff json.parse(cig(dir, ["--json", "runs"]).out)[0]
}

pull exits(r, want) {
  assert(r.code == want, "exit ${r.code}, wanted ${want}\n--- stdout\n${r.out}--- stderr\n${r.err}")
}

pull says(textv, piece) {
  assert(textv.contains(piece), "expected `${piece}` in:\n${textv}")
}

pull never_says(textv, piece) {
  assert(not textv.contains(piece), "did not expect `${piece}` in:\n${textv}")
}

pull there(dir, rel) {
  snuff fs.exists(path.join(dir, rel))
}

pull read(dir, rel) {
  snuff fs.read_text(path.join(dir, rel))
}

if fs.exists(work) {
  burn {
    fs.rm(work)
  }
}

# ----- the basics -----------------------------------------------------------

test("help and version answer anywhere, manifest or not", pack() {
  stick dir = fresh("tests/fixtures/empty")
  stick r = tool_in(dir, ["help"])
  exits(r, 0)
  says(r.out, "cigo adopt")
  says(tool_in(dir, ["version"]).out, "cig-orchestrator ")
})

test("without a manifest, the error says how to start", pack() {
  stick dir = fresh("tests/fixtures/empty")
  stick r = tool_in(dir, ["list"])
  exits(r, 2)
  says(r.err, "no cig-tasks.json")
  says(r.err, "cigo adopt")
})

test("an unknown command, flag or task is a usage error", pack() {
  stick dir = fresh("examples/demo-app")
  exits(tool_in(dir, ["frobnicate"]), 2)
  stick r = tool_in(dir, ["run", "deploy", "--frob"])
  exits(r, 2)
  says(r.err, "unknown flag `--frob`")
  stick q = tool_in(dir, ["run", "deplyo"])
  exits(q, 2)
  says(q.err, "no task named `deplyo`; did you mean deploy?")
})

test("list shows each task's command, needs and extras", pack() {
  stick dir = fresh("examples/demo-app")
  stick r = tool_in(dir, ["list"])
  exits(r, 0)
  says(r.out, "demo-app: 7 tasks")
  says(r.out, "bash scripts/deploy.sh   needs package  [undo]")
  says(r.out, "[retries 3]")
  says(r.out, "# the built app must greet")
})

test("plan resolves dependencies, each task once, in order", pack() {
  stick dir = fresh("examples/demo-app")
  stick r = tool_in(dir, ["plan", "deploy"])
  exits(r, 0)
  says(r.out, "6 tasks, in this order:")
  says(r.out, " 1. lint")
  says(r.out, " 6. deploy")
  never_says(r.out, "notify")
  says(tool_in(dir, ["plan", "--only", "deploy"]).out, "1 task, in this order:")
})

test("check passes a good manifest", pack() {
  stick dir = fresh("examples/demo-app")
  stick r = tool_in(dir, ["check"])
  exits(r, 0)
  says(r.out, "7 task(s), 0 error(s), 0 warning(s)")
})

test("check finds what is wrong before anything runs", pack() {
  stick dir = fresh("tests/fixtures/broken")
  stick r = tool_in(dir, ["check"])
  exits(r, 1)
  for piece in [
    "dependency loop: a > b > a",
    "`definitely-not-installed-xyz` is not on PATH",
    "`scripts/nope.sh` does not exist",
    "never reaches a shell",
    "unknown key `need`, ignored; did you mean `needs`?",
    "has both `cmd` and `shell`",
    "has nothing to run",
    "needs `nobody`, which is not a task",
    "`ok` must be exit codes",
    "got a string",
    "unknown key `colour` at the top",
  ] {
    says(r.out, piece)
  }
  stick p = tool_in(dir, ["plan", "a"])
  exits(p, 2)
  says(p.err, "dependency loop")
})

# ----- running --------------------------------------------------------------

test("run deploy runs the closure, retries the flaky script, deploys outside", pack() {
  stick dir = fresh("examples/demo-app")
  stick r = tool_in(dir, ["run", "deploy"])
  exits(r, 0)
  says(r.out, "demo-app: lint > build > test > flaky > package > deploy")
  says(r.out, "[4/6] flaky: bash scripts/flaky.sh")
  says(r.out, "exit 7; trying again (3 of 4)")
  says(r.out, "(attempt 3)")
  says(r.out, "done: 6 tasks")
  assert(read(dir + "-remote", "current").trim() == "0.1.0", "the deploy did not land")
  assert(read(dir, "build/.flaky-count").trim() == "3", "flaky ran a different number of times")
  says(read(dir, ".cig-orchestrator/logs/flaky.log"), "attempt 3")
  assert(fs.list(path.join(dir, ".cig-orchestrator/reports")).len() == 1, "no report")
})

test("cig unburn undoes a whole run: outputs removed, the deploy's undo run", pack() {
  stick dir = fresh("examples/demo-app")
  exits(tool_in(dir, ["run", "deploy"]), 0)
  stick u = cig(dir, ["unburn", last_run(dir).id])
  exits(u, 0)
  says(u.out + u.err, "undoing deploy: bash scripts/undeploy.sh")
  says(u.out + u.err, "undeployed v0.1.0")
  assert(not there(dir + "-remote", "current"), "the undo did not run")
  assert(not there(dir, "build/app"), "build/app is still there")
  assert(not there(dir, "dist/app-0.1.0.tar.gz"), "the package is still there")
  assert(not there(dir, ".cig-orchestrator"), "the logs are still there")
})

test("a failing task rolls the whole run back, and nothing is deployed", pack() {
  stick dir = fresh("examples/demo-app")
  burn {
    fs.write_text(path.join(dir, "src/greeting.txt"), "goodbye from demo-app\n")
  }
  stick r = tool_in(dir, ["run", "deploy"])
  exits(r, 1)
  says(r.out, "test: FAILED")
  says(r.out, "stopped at test")
  says(r.err, "task `test` failed: bash scripts/test.sh exited 1")
  says(r.err, "rolling back")
  assert(not there(dir, "build/app"), "build/app survived the rollback")
  assert(not there(dir + "-remote", "current"), "something was deployed")
})

test("a later failure runs the deploy's undo during the rollback", pack() {
  stick dir = fresh("examples/demo-app")
  stick manifest = path.join(dir, "cig-tasks.json")
  stick m = json.load(manifest)
  m.tasks["verify"] = {cmd: ["bash", "-c", "echo remote looks wrong >&2; exit 4"], needs: ["deploy"]}
  burn {
    json.save(manifest, m, 2)
  }
  stick r = tool_in(dir, ["run", "verify"])
  exits(r, 1)
  says(r.out, "deployed v0.1.0")
  says(r.out + r.err, "undoing deploy")
  assert(not there(dir + "-remote", "current"), "the deploy was not undone")
})

test("--no-rollback keeps what the finished tasks made, and unburn still undoes it", pack() {
  stick dir = fresh("examples/demo-app")
  burn {
    fs.write_text(path.join(dir, "src/greeting.txt"), "goodbye from demo-app\n")
  }
  exits(cig(dir, ["run", "--no-rollback", tool, "--", "run", "deploy"]), 1)
  assert(there(dir, "build/app"), "build/app was rolled back anyway")
  exits(cig(dir, ["unburn", last_run(dir).id]), 0)
  assert(not there(dir, "build/app"), "unburn left build/app")
})

test("--dry-run plans every task and executes none", pack() {
  stick dir = fresh("examples/demo-app")
  stick r = cig(dir, ["run", "--dry-run", tool, "--", "run", "deploy"])
  exits(r, 0)
  says(r.out, "dry run: 6 tasks planned, none executed")
  says(r.err, "compensated")
  says(r.err, "run bash scripts/deploy.sh")
  says(r.err, "nothing was changed")
  assert(not there(dir, "build"), "a dry run built something")
  assert(not there(dir + "-remote", "current"), "a dry run deployed")
})

test("arguments after -- reach the last task named, quoted for a shell", pack() {
  stick dir = fresh("tests/fixtures/edge")
  stick r = tool_in(dir, ["run", "echo", "--", "a", "b c", "it's"])
  exits(r, 0)
  says(r.out, "[a]\n    [b c]\n    [it's]")
  stick s = tool_in(dir, ["run", "echo-shell", "--", "a", "b c", "it's"])
  exits(s, 0)
  says(s.out, "<a><b c><it's>")
})

test("a timeout is a failed attempt, and retries apply to it", pack() {
  stick dir = fresh("tests/fixtures/edge")
  stick r = tool_in(dir, ["run", "slow"])
  exits(r, 1)
  says(r.out, "ran longer than 300 ms")
  says(r.out, "trying again (2 of 2)")
  says(r.err, "task `slow` failed: sleep 5 exited -1 after 2 attempts")
})

test("retries end, and the error says how many attempts it took", pack() {
  stick dir = fresh("tests/fixtures/edge")
  stick r = tool_in(dir, ["run", "stubborn"])
  exits(r, 1)
  says(r.out, "trying again (3 of 3)")
  says(r.err, "exited 3 after 3 attempts")
})

test("ok, env and cwd reach the task", pack() {
  stick dir = fresh("tests/fixtures/edge")
  exits(tool_in(dir, ["run", "answers-one"]), 0)
  says(tool_in(dir, ["run", "greets"]).out, "hi from greets")
  stick r = tool_in(dir, ["run", "in-sub"])
  exits(r, 0)
  says(r.out, "/sub\n")
})

test("--only skips the dependencies", pack() {
  stick dir = fresh("tests/fixtures/edge")
  stick r = tool_in(dir, ["run", "--only", "after-files"])
  exits(r, 1)
  never_says(r.out, "makes-files")
})

test("files a script creates are rolled back when a later task fails", pack() {
  stick dir = fresh("tests/fixtures/edge")
  stick r = tool_in(dir, ["run", "after-files"])
  exits(r, 1)
  says(r.err, "hop created")
  assert(not there(dir, "out/file.txt"), "out/file.txt survived")
})

# ----- adopt: scripts and task runners ------------------------------------------

test("adopt turns a scripts, make, npm, just and Taskfile project into components", pack() {
  stick dir = fresh("tests/fixtures/polyglot")
  stick r = tool_in(dir, ["adopt"])
  exits(r, 0)
  stick comps = json.parse(r.out).components
  assert(comps.node.toolchain == "node-npm", "node: ${comps}")
  for runner in ["make", "just", "task", "scripts"] {
    assert(comps.has(runner), "adopt missed ${runner}: ${comps.keys()}")
    assert(comps[runner].groups == false, "${runner} sits beside package.json and should stay out of the groups")
  }
  says(r.err, "kept out of the stage groups")
  assert(not there(dir, "cig-tasks.json"), "adopt without --write wrote the file")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick all = tool_in(dir, ["list", "--all"]).out
  for task in ["scripts:hello", "scripts:gen-docs", "scripts:deploy", "make:build", "make:clean", "just:fmt", "just:release", "task:hello", "node:lint", "node:test", "node:start"] {
    says(all, task)
  }
  for hidden in ["node:pretest", "scripts:hidden", "scripts:notes", "just:_private", "just:set"] {
    never_says(all, hidden + " ")
  }
})

test("adopt --write saves it, refuses to overwrite, and unburn takes it back", pack() {
  stick dir = fresh("tests/fixtures/polyglot")
  stick w = tool_in(dir, ["adopt", "--write"])
  exits(w, 0)
  says(w.out, "wrote cig-tasks.json: 5 components")
  stick first = last_run(dir).id
  stick again = tool_in(dir, ["adopt", "--write"])
  exits(again, 2)
  says(again.err, "already exists")
  exits(tool_in(dir, ["adopt", "--write", "--force"]), 0)
  exits(cig(dir, ["unburn", last_run(dir).id]), 0)
  assert(there(dir, "cig-tasks.json"), "unburning --force should put the first write back")
  exits(cig(dir, ["unburn", first]), 0)
  assert(not there(dir, "cig-tasks.json"), "unburning the first write should remove it")
})

test("an adopted project runs its scripts as they are, with arguments", pack() {
  stick dir = fresh("tests/fixtures/polyglot")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick r = tool_in(dir, ["run", "scripts:hello", "--", "from", "cig"])
  exits(r, 0)
  says(r.out, "hello from python from cig")
  if proc.which("make") != null {
    says(tool_in(dir, ["run", "make:test"]).out, "testing")
  }
})

test("adopt in a project with nothing to adopt says so", pack() {
  stick dir = fresh("tests/fixtures/empty")
  stick r = tool_in(dir, ["adopt"])
  exits(r, 0)
  says(r.err, "found no toolchain")
})

# ----- many languages, one chain -------------------------------------------------

test("adopt finds every language in a monorepo and keeps the old glue out of the groups", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  stick r = tool_in(dir, ["adopt"])
  exits(r, 0)
  stick comps = json.parse(r.out).components
  stick want = {
    make: ".|make", scripts: ".|scripts", infra: "infra|terraform", ml: "ml|python-uv",
    api: "services/api|go", "api-docker": "services/api|docker", worker: "services/worker|rust-cargo", web: "web|node-pnpm",
  }
  for name in want {
    assert(comps.has(name), "adopt missed ${name}: ${comps.keys()}")
    assert("${comps[name].path}|${comps[name].toolchain}" == want[name], "${name}: ${comps[name]}")
  }
  assert(comps.len() == want.len(), "extra components: ${comps.keys()}")
  assert(comps.make.groups == false and comps.scripts.groups == false, "the root glue should stay out of the groups")
  says(r.err, "make, scripts: at the root of a project with components below it, these usually chain the others")
})

test("adopt leaves out test data, a component's own tests, and stray script folders", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.mkdir(path.join(dir, "app/tests"))
    fs.write_text(path.join(dir, "app/go.mod"), "module app\n\ngo 1.22\n")
    fs.write_text(path.join(dir, "app/tests/package.json"), "{\"name\": \"e2e\"}\n")
    fs.mkdir(path.join(dir, "tests/fixtures/sample"))
    fs.write_text(path.join(dir, "tests/fixtures/sample/Cargo.toml"), "[package]\nname = \"sample\"\n")
    fs.mkdir(path.join(dir, "skills/one/scripts"))
    fs.write_text(path.join(dir, "skills/one/scripts/run.sh"), "#!/bin/sh\necho one\n")
  }
  stick r = tool_in(dir, ["adopt"])
  exits(r, 0)
  stick comps = json.parse(r.out).components
  assert(comps.keys() == ["app"], "expected only app: ${comps.keys()}")
})

test("one stage runs in every language, in dependency order, each in its own directory", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick r = tool_stubbed(dir, ["run", "build"])
  exits(r, 0)
  says(r.out, "done: 6 tasks")
  in_order(stub_log(dir), [
    "go mod download @" + path.join(dir, "services/api"),
    "go build ./... @" + path.join(dir, "services/api"),
    "cargo fetch --locked @" + path.join(dir, "services/worker"),
    "cargo build --workspace --locked @" + path.join(dir, "services/worker"),
    "pnpm install --frozen-lockfile @" + path.join(dir, "web"),
    "pnpm run build @" + path.join(dir, "web"),
  ])
  never_says(stub_log(dir), "make ")
  stick listed = tool_in(dir, ["list"]).out
  in_order(listed, ["ml:setup", "ml:format", "ml:lint", "ml:test", "api:setup", "web:setup", "web:lint", "web:check", "web:build"])
  says(listed, "api:format-check     out=$(find . -name")
  says(listed, "...   (in services/api)")
  says(tool_in(dir, ["show", "api:format-check"]).out, "exit 1; fi")
})

test("ci runs format-check, lint, check, build and test in every language", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick r = tool_stubbed(dir, ["run", "ci"])
  exits(r, 0)
  says(r.out, "done: 24 tasks")
  in_order(stub_log(dir), [
    "terraform fmt -check -recursive -diff", "uv run --locked ruff format --check .", "cargo fmt --all --check",
    "uv run --locked ruff check .", "cargo clippy --workspace --all-targets --locked -- -D warnings", "pnpm run lint",
    "terraform validate", "go vet ./...", "pnpm run typecheck",
    "go build ./...", "pnpm run build",
    "uv run --locked pytest", "go test ./...", "cargo test --workspace --locked", "pnpm run test",
  ])
})

test("after puts one component's stages behind another's", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  edit_manifest(dir, pack(m) {
    m.components.api["after"] = ["web"]
  })
  says(tool_in(dir, ["show", "api:build"]).out, "needs      api:setup, web:build")
  in_order(tool_in(dir, ["plan", "build"]).out, ["web:build", "api:build"])
})

test("a failure in one language stops the chain and rolls it back", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  edit_manifest(dir, pack(m) {
    m.components.web["stages"] = {build: ["pnpm", "run", "build", "fail-please"]}
    m["tasks"] = {stamp: {shell: "echo built > stamp.txt", needs: ["api:build"]}, ship: {needs: ["stamp", "build"]}}
  })
  stick r = tool_stubbed(dir, ["run", "ship"])
  exits(r, 1)
  says(r.err, "task `web:build` failed: pnpm run build fail-please exited 3")
  says(stub_log(dir), "go build ./...")
  assert(not there(dir, "stamp.txt"), "stamp.txt survived the rollback")
})

test("a project's own toolchain settings, stage overrides and toolchains win", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  edit_manifest(dir, pack(m) {
    m["toolchains"] = {
      "python-uv": {stages: {test: [["uv", "run", "pytest", "-x"]]}},
      gen: {extends: "go", language: "Go with generate", stages: {build: [{shell: "go generate ./... && go build ./..."}]}},
    }
    m.components.ml["stages"] = {lint: false}
    m.components.api["toolchain"] = "gen"
  })
  stick r = tool_stubbed(dir, ["run", "test"])
  exits(r, 0)
  says(stub_log(dir), "uv run pytest -x @")
  stick listed = tool_in(dir, ["list"]).out
  never_says(listed, "ml:lint")
  says(listed, "go generate ./... && go build ./...")
})

test("pip's setup installs what the project's tests need", pack() {
  stick dir = fresh("tests/fixtures/empty")
  stick head = "[build-system]\nrequires = [\"setuptools\"]\n\n[project]\nname = \"x\"\n\n"
  burn {
    fs.write_text(path.join(dir, "cig-tasks.json"), "{\"components\": {\"py\": {\"path\": \".\", \"toolchain\": \"python-pip\"}}}\n")
  }
  stick cases = [
    [head + "[project.optional-dependencies]\ndocs = [\n  \"sphinx[x]>=7\",\n]\ndev = [\"pytest\"]\n", "pip install -e '.[dev]'"],
    [head + "[dependency-groups]\ndev = [\"pytest\"]\n", "pip install -e . --group dev"],
    [head + "[project.optional-dependencies]\ntest = [\"pytest\"]\n\n[tool.other]\ndev = 1\n", "pip install -e '.[test]'"],
    [head + "[tool.other]\ndev = 1\n", "pip install -e .\n"],
  ]
  for c in cases {
    burn {
      fs.write_text(path.join(dir, "pyproject.toml"), c[0])
    }
    says(tool_in(dir, ["show", "py:setup"]).out + "\n", c[1])
  }
})

test("adopt --force follows a project that changed package managers, keeping its settings", pack() {
  stick dir = fresh("tests/fixtures/empty")
  burn {
    fs.mkdir(path.join(dir, "web"))
    fs.write_text(path.join(dir, "web/package.json"), "{\"name\": \"web\", \"scripts\": {\"build\": \"echo b\"}}\n")
    fs.write_text(path.join(dir, "web/package-lock.json"), "{}\n")
  }
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  assert(json.load(path.join(dir, "cig-tasks.json")).components.web.toolchain == "node-npm", "the first adopt should say npm")
  edit_manifest(dir, pack(m) {
    m.components.web["desc"] = "the front end"
  })
  burn {
    fs.rm(path.join(dir, "web/package-lock.json"))
    fs.write_text(path.join(dir, "web/pnpm-lock.yaml"), "lockfileVersion: '9.0'\n")
  }
  stick again = tool_in(dir, ["adopt", "--write", "--force"])
  exits(again, 0)
  says(again.err, "web: node-npm no longer fits web, so it is node-pnpm now")
  stick c = json.load(path.join(dir, "cig-tasks.json")).components.web
  assert(c.toolchain == "node-pnpm" and c.get("desc", "") == "the front end", "web: ${c}")
})

test("a toolchain var with no value stops the task instead of reaching the command", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
