  says(r.out, "outside its footprint")
})

test("cigo rehearse rates a script by what it did, and applies none of it", pack() {
  if not rehearsal_here() {
    snuff
  }
  stick dir = fresh("tests/fixtures/rehearse")
  # A high verdict fails here as it does under CI (rehearse_fail_on).
  exits(guard_tool(dir, ["config", "rehearse_fail_on", "high"], {}), 0)
  stick bad = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  if no_box_here(bad) {
    snuff
  }
  exits(bad, 2)
  says(bad.out, "E873")
  says(bad.out, "rated high")
  assert(not there(dir, ".git/hooks/pre-commit"), "cigo rehearse applied what it rehearsed")
  # Finding nothing is not clean while the box cannot see reads and
  # connections (#80): E898, low, and nothing kept.
  stick good = guard_tool(dir, ["rehearse", "./clean.sh"], {})
  exits(good, 0)
  says(good.out, "E898")
  says(good.out, "verdict low, and nothing is kept")
  assert(not there(dir, ".cigo-rehearse"), "cigo rehearse applied what it rehearsed")
  stick j = guard_tool(dir, ["rehearse", "./replica.sh", "--json"], {})
  exits(j, 2)
  stick v = json.parse(j.out)
  assert(v.risk == "high", "the JSON verdict is ${v.risk}")
  stick usage = guard_tool(dir, ["rehearse", "left-pad"], {})
  exits(usage, 2)
  says(usage.out + usage.err, "npm:left-pad")
})

test("a verdict is kept for the same bytes: asked again it is not rehearsed, --fresh rehearses, a forged one is refused", pack() {
  if not rehearsal_here() {
    snuff
  }
  if not has_tin_mac() {
    exhale "      (skipped: this cig cannot sign a verdict)"
    snuff
  }
  stick dir = fresh("tests/fixtures/rehearse")
  # A high verdict fails here as it does under CI (rehearse_fail_on).
  exits(guard_tool(dir, ["config", "rehearse_fail_on", "high"], {}), 0)
  stick first = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  if no_box_here(first) {
    snuff
  }
  exits(first, 2)
  says(first.out, "rehearsing ./replica.sh")
  stick again = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  exits(again, 2)
  says(again.out, "rehearsed ./replica.sh before")
  assert(not again.out.contains("rehearsing ./replica.sh"), "the same bytes were rehearsed twice:\n" + again.out)
  says(guard_tool(dir, ["rehearse", "./replica.sh", "--fresh"], {}).out, "rehearsing ./replica.sh")
  # A rehearsal that saw nothing keeps nothing (E898): asked again, rehearsed again.
  exits(guard_tool(dir, ["rehearse", "./clean.sh"], {}), 0)
  stick blind = guard_tool(dir, ["rehearse", "./clean.sh"], {})
  says(blind.out, "rehearsing ./clean.sh")
  never_says(blind.out, "rehearsed ./clean.sh before")
  # One byte more is another script.
  burn {
    fs.append_text(path.join(dir, "replica.sh"), ": one more line\n")
  }
  says(guard_tool(dir, ["rehearse", "./replica.sh"], {}).out, "rehearsing ./replica.sh")
  # A kept high verdict edited to read clean does not verify: refused, and rehearsed again.
  roll forged_one = false
  burn {
    for f in fs.list(path.join(cigo_home(dir), "rehearsals")) {
      if f.ends_with(".json") and fs.read_text(f).contains("\"high\"") {
        fs.write_text(f, fs.read_text(f).replace("\"high\"", "\"none\""))
        forged_one = true
      }
    }
  }
  assert(forged_one, "no kept high verdict to forge")
  stick forged = guard_tool(dir, ["rehearse", "./replica.sh"], {})
  says(forged.err, "not signed by your key")
  exits(forged, 2)
  says(forged.out, "rated high")
})

