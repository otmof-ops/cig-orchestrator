  stick to = hop_env(dir, tool_prog("cig"), tool_args(["update", "--to=9.0.0"]), more)
  exits(to, 2)
  says(to.err, "updates come by carton")
  says(to.err, "ciginstaller carton list")
  says(to.err, "ciginstaller update --to <carton>")
  stick spaced = hop_env(dir, tool_prog("cig"), tool_args(["update", "--to", "9.0.0"]), more)
  exits(spaced, 2)
  says(spaced.err, "updates come by carton")
  exits(hop_env(dir, tool_prog("cig"), tool_args(["update", "--frob"]), more), 2)
  assert(not fs.exists(log), "ciginstaller was run for a call the stub refuses")
  # The download, checksum and attestation code is gone with its test hook.
