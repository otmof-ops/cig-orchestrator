  burn {
    fs.mkdir(bare)
    for name in ["node", "pnpm"] {
      proc.run("ln", ["-s", path.join(stub_dir, "stub"), path.join(bare, name)])
    }
  }
  stick e = {PATH: bare + path_sep + "/usr/bin:/bin", STUB_LOG: dir + "-stub.log"}
  stick r = hop_env(dir, tool_prog(proc.which("cig")), tool_args(["run", "web:build"]), e)
  exits(r, 0)
  says(r.err, "node 20 is pinned by web/.nvmrc, 99.1.0 is installed, and no version manager was found. To let cigo switch for you: install mise or fnm")
  says(stub_log(dir), "pnpm run build")
})

test("cigo versions lists each pin against this machine, and doctor names the manager", pack() {
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
