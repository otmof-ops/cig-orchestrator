  assert(ps.trim_end().ends_with("exit 1"), "install.ps1 does not end by exiting 1")
  assert(not ps.contains("Copy-Item"), "install.ps1 still installs")
})

# ----- `cigo __doctor --json`: the installer's read of this cigo -------------------------

test("__doctor answers in the installer's shape, and never calls ciginstaller", pack() {
  if on_windows {
    snuff
  }
  stick dir = fresh("tests/fixtures/monorepo")
  exits(tool_in(dir, ["adopt", "--write"]), 0)
  stick bindir = write_fake_installer(dir)
  stick log = dir + "-installer.log"
  stick d = self_doctor(dir, {PATH: bindir + path_sep + stub_dir + path_sep + env.get("PATH", ""), FAKE_INSTALLER_LOG: log})
  assert(d.tool == "cigo" and str(d.version) != "" and type_of(d.version) == type_of("x"), json.stringify(d))
  assert(not d.findings.is_empty(), "no findings")
  for f in d.findings {
    assert(f.keys().sort() == ["because", "check", "fix", "found", "severity"], "the finding's keys: " + json.stringify(f))
    assert(["ok", "note", "action"].contains(f.severity), "severity " + str(f.severity))
    assert(str(f.check) != "" and type_of(f.found) == type_of("x") and type_of(f.because) == type_of("x"), json.stringify(f))
    assert(f.fix == null or type_of(f.fix) == type_of("x"), json.stringify(f))
  }
  for check in ["cig-floor", "launcher", "guard-level", "rehearse-kept"] {
    finding_of(d, check)
  }
  assert(finding_of(d, "cig-floor").severity == "ok", json.stringify(finding_of(d, "cig-floor")))
  assert(not fs.exists(log), "__doctor called ciginstaller")
  # The same with ciginstaller missing: it is not needed.
  stick bare = hop_env(dir, tool_prog(proc.which("cig")), tool_args(["__doctor", "--json"]), no_installer_env(dir))
  exits(bare, 0)
  assert(json.parse(bare.out).tool == "cigo", bare.out)
})

test("__doctor takes only --json, and it still answers with a broken manifest or none", pack() {
