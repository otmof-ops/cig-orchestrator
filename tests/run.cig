  stick f = agent_cmd(dir, ["agent", "run", "--agent=tester", "--session=sc", "--", line], {})
  exits(f, 0)
  stick id = last_scrub_id(f.out)
  assert(id != "", "the notice did not name a scrub id: " + f.out)
  stick show = agent_cmd(dir, ["scrub", "show", id], {})
  exits(show, 0)
  says(show.out, "Ignore all previous instructions")
  says(show.out, "redact")
  says(show.out, id)
  says(show.out, "tester")
  says(show.out, "sc")
  stick in_agent = guard_cmd(dir, ["scrub", "show", id], {CIGO_AGENT: "tester"})
  exits(in_agent, 2)
  says(in_agent.err, "cigo scrub show is for your terminal, not an agent's")
  stick missing = agent_cmd(dir, ["scrub", "show", "r-deadbeef"], {})
  exits(missing, 2)
  says(missing.err, "no scrub is kept under")
})

