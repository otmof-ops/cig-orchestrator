# Toolchains with no footprint of their own: they run the project's own
# code (task runners), or hand their work to a daemon the box cannot see.
stick FOOTPRINTLESS = {
  "cigscript": "cig check reads the project's own .cig files; no dependencies",
  "earthly": "task runner: runs the project's own Earthfile targets; its builds also run in BuildKit outside the sandbox, as with docker",
  "just": "task runner: runs the project's own recipes",
  "make": "task runner: runs the project's own targets",
  "powershell": "no install or build stage: lint and test run PSScriptAnalyzer and Pester already installed",
  "rake": "task runner: runs the project's own Rakefile tasks",
  "scripts": "script folder: runs the project's own scripts",
  "shell": "shellcheck and shfmt read the project's own scripts; no dependencies",
  "task": "task runner: runs the project's own Taskfile tasks",
  "xcode": "macOS only (detected only on macos) and the rehearsal sandbox is Linux; its SwiftPM resolution, macros and build-tool plugins would follow swift-spm once a macOS sandbox exists",
}

# ----- the command line -------------------------------------------------------

stick command = args.get(0, "help")
roll words = []
roll extra = []
roll passing = false
# `--jobs N` and `--max N` are read as `--jobs=N` and `--max=N` (cigo rehearse);
# `--sarif <file>` and `--sarif=<file>` name the file the SARIF log is written to.
roll joins = ""
for a in args.slice(1) {
  if passing {
    extra.push(a)
  } else if a == "--" {
    passing = true
  } else if joins != "" and text.matches(a, '^[0-9]+$|^auto$') {
    words.push(joins + "=" + a)
    joins = ""
  } else if joins == "--sarif" and text.matches(a, '^[A-Za-z0-9._/~+-]+\.(sarif|sarif\.json|json)$') {
    words.push("--sarif")
    words.push("--sarif-file=" + a)
    joins = ""
  } else {
    if joins != "" {
      words.push(joins)
    }
    joins = ""
    if command == "rehearse" and (a == "--jobs" or a == "--max" or a == "--sarif") {
      joins = a
    } else if command == "rehearse" and a.starts_with("--sarif=") {
      words.push("--sarif")
      words.push("--sarif-file=" + a.slice(8))
    } else {
      words.push(a)
    }
  }
}
if joins != "" {
  words.push(joins)
}
stick flags = words.filter(pack(w) => w.starts_with("--"))
stick targets = words.filter(pack(w) => not w.starts_with("--"))

# ----- small helpers ----------------------------------------------------------

# `cigo __doctor` turns a usage error into a throw (FAIL_THROWS), so it can
# still answer in its one JSON shape.
roll FAIL_THROWS = false

pull fail(message) {
  if FAIL_THROWS {
    cough message
  }
  log.error(message)
  exit(2)
}

pull pick(condition, yes, no) {
  if condition {
    snuff yes
  }
  snuff no
}

pull flag_value(name, fallback) {
  for f in flags {
    if f.starts_with(name + "=") {
      snuff f.slice(name.len() + 1)
    }
  }
  snuff fallback
}

pull expect_flags(allowed) {
  for f in flags {
    stick bare = pick(f.contains("="), f.slice(0, f.find("=")), f)
    if not allowed.contains(bare) {
      if allowed.is_empty() {
        fail("`${command}` takes no flags; got `${f}`")
      }
      fail("unknown flag `${f}` for `${command}`; it takes ${allowed.join(", ")}")
    }
  }
}

pull expect_no_targets() {
  if not targets.is_empty() {
    fail("`${command}` takes no task names; got ${targets.join(", ")}")
  }
}

pull duration(ms) {
  if ms < 1000 {
    snuff "${ms} ms"
  }
  snuff "${math.round(ms / 1000.0, 1)} s"
}

pull tidy(textv) {
  roll t = str(textv).trim()
  if t.len() > 100 {
    t = t.slice(0, 97) + "..."
  }
  snuff t
}

# A word as a shell would need it to read it back as one word.
pull quote(word) {
  if word != "" and text.matches(word, '^[A-Za-z0-9_./=:,+@%{}-]+$') {
    snuff word
  }
  snuff "'" + word.replace("'", "'\\''") + "'"
}

# A word any POSIX shell reads back as exactly this text: `|sh` in a template.
# Stricter than `quote`, which is for showing commands: no braces, no commas.
pull sh_quote(word) {
  if word != "" and text.matches(word, '^[A-Za-z0-9_./=:+@%-]+$') {
    snuff word
  }
  snuff "'" + word.replace("'", "'\\''") + "'"
}

pull slug(name) {
  roll s = text.replace(str(name).lower(), '[^a-z0-9]+', "-")
  while s.starts_with("-") {
    s = s.slice(1)
  }
  while s.ends_with("-") {
    s = s.slice(0, s.len() - 1)
  }
  # con, nul, com1...: a device on Windows, so the log and state files a
  # task of that name gets are named after the task, not the device.
  if ["con", "prn", "aux", "nul"].contains(s) or text.matches(s, '^(com|lpt)[1-9]$') {
    s = "task-" + s
  }
  snuff pick(s == "", "x", s)
}

pull as_list(v) {
  if v == null {
    snuff []
  }
  if type_of(v) == "list" {
    snuff v
  }
  snuff [v]
}

# `cmd` as a list is the argv; as a string it is split on whitespace. Neither
# goes through a shell: that is what `shell` is for, by name.
pull argv_of(value) {
  if type_of(value) == "list" {
    snuff value.map(pack(w) => str(w))
  }
  if type_of(value) == "string" {
    snuff value.split()
  }
  snuff null
}

pull dig(value, keys) {
  roll v = value
  for k in keys {
    if type_of(v) == "map" and v.has(k) {
      v = v[k]
    } else if type_of(v) == "list" and text.matches(k, '^[0-9]+$') and int(k) < v.len() {
      v = v[int(k)]
    } else {
      snuff null
    }
  }
  snuff v
}

pull to_text(v) {
  if v == null {
    snuff ""
  }
  if type_of(v) == "string" {
    snuff v
  }
  if type_of(v) == "list" or type_of(v) == "map" {
    snuff json.stringify(v)
  }
  snuff str(v)
}

# The edits that turn one name into the other, a swap of two neighboring
# letters counting as one ("biuld" is one edit from "build"): the optimal
# string alignment distance.
pull distance(a, b) {
  stick xs = a.chars()
  stick ys = b.chars()
  roll before = []
  roll prev = range(ys.len() + 1)
  for i in range(xs.len()) {
    roll row = [i + 1]
    for j in range(ys.len()) {
      roll d = math.min(prev[j + 1] + 1, row[j] + 1, prev[j] + pick(xs[i] == ys[j], 0, 1))
      if i > 0 and j > 0 and xs[i] == ys[j - 1] and xs[i - 1] == ys[j] {
        d = math.min(d, before[j - 1] + 1)
      }
      row.push(d)
    }
    before = prev
    prev = row
  }
  snuff prev.last()
}

# The names `wanted` was probably meant to be, closest first: a name, one of
# its parts (`rust` in rust-cargo, `build` in api:build) or an alias within a
# third of its length in edits, or a name that contains it.
pull similar(names, wanted, aliases) {
  stick w = wanted.lower()
  stick allowed = math.max(1, math.floor(w.len() / 3))
  roll scored = []
  for name in names {
    stick lower = name.lower()
    stick forms = [lower] + text.split(lower, "[-:_./]") + as_list(aliases.get(name, [])).map(pack(a) => str(a).lower())
    roll best = forms.filter(pack(f) => not f.is_empty()).map(pack(f) => distance(w, f)).min()
    if w.len() >= 3 and lower.contains(w) {
      best = 0
    }
    if best <= allowed {
      scored.push([best, name])
    }
  }
  snuff scored.sort_by(pack(pair) => pair[0]).map(pack(pair) => pair[1]).slice(0, 4)
}

# ----- looking at a directory ---------------------------------------------------

stick PROBE = {}

pull cached(key, compute) {
  if PROBE.has(key) {
    snuff PROBE[key]
  }
  stick v = compute()
  PROBE[key] = v
  snuff v
}

pull entries_of(dir) {
  snuff cached("ls:" + dir, pack() {
    if not fs.is_dir(dir) {
      snuff []
    }
    snuff fs.list(dir).map(pack(p) => path.base(p))
  })
}

# `*` wildcards in a file name; nothing else is special.
pull wild(pattern, name) {
  if not pattern.contains("*") {
    snuff pattern == name
  }
  stick parts = pattern.split("*")
  if not name.starts_with(parts.first()) or not name.ends_with(parts.last()) {
    snuff false
  }
  roll at = parts.first().len()
  stick stop = name.len() - parts.last().len()
  if stop < at {
    snuff false
  }
  for part in parts.slice(1, parts.len() - 1) {
    stick i = name.slice(at, stop).find(part)
    if i < 0 {
      snuff false
    }
    at = at + i + part.len()
  }
  snuff true
}

pull text_of(dir, file) {
  snuff cached("txt:" + dir + "/" + file, pack() {
    stick p = path.join(dir, file)
    if not fs.is_file(p) or fs.size(p) > 2000000 {
      snuff null
    }
    roll t = null
    try {
      t = unbom(fs.read_text(p))
    } ashtray e {
      t = null
    }
    snuff t
  })
}

pull json_of(dir, file) {
  snuff cached("json:" + dir + "/" + file, pack() {
    stick t = text_of(dir, file)
    if t == null {
      snuff null
    }
    roll v = null
    try {
      v = json.parse(t)
    } ashtray e {
      v = null
    }
    snuff v
  })
}

pull which(program) {
  snuff cached("which:" + program, pack() => proc.which(program))
}

# One condition, in `dir`. A list is "any of these".
pull holds(dir, cond) {
  if type_of(cond) == "list" {
    snuff cond.any(pack(c) => holds(dir, c))
  }
  stick c = str(cond)
  if c.starts_with("not:") {
    snuff not holds(dir, c.slice(4))
  }
  stick at = c.find(":")
  if at < 0 {
    snuff false
  }
  stick kind = c.slice(0, at)
  stick arg = c.slice(at + 1)
  if kind == "file" {
    # The exact name, on every filesystem: a case-insensitive one would
    # make file:Dockerfile true for dockerfile here and false on Linux.
    if arg.contains("/") {
      snuff fs.exists(path.join(dir, arg)) and entries_of(path.dir(path.join(dir, arg))).contains(path.base(arg))
    }
    snuff entries_of(dir).contains(arg)
  }
  if kind == "dir" {
    snuff fs.is_dir(path.join(dir, arg))
  }
  if kind == "glob" {
    snuff entries_of(dir).any(pack(n) => wild(arg, n))
  }
  if kind == "tool" {
    snuff which(arg) != null
  }
  if kind == "os" {
    # windows, macos, linux, freebsd...: cig.os(); bsd is any of them, unix
    # is everything but Windows. Spelled in any case.
    stick here = cig.os()
    stick want = arg.lower()
    if want == "unix" {
      snuff here != "windows"
    }
    if want == "bsd" {
      snuff here.ends_with("bsd")
    }
    snuff here == want
  }
  if kind == "grep" or kind == "json" {
    stick sep = arg.find(":")
    if sep < 0 {
      snuff false
    }
    stick file = arg.slice(0, sep)
    stick rest = arg.slice(sep + 1)
    if kind == "json" {
      snuff dig(json_of(dir, file), rest.split(".")) != null
    }
    stick files = pick(file.contains("/"), [file], entries_of(dir).filter(pack(n) => wild(file, n)))
    for name in files {
      stick t = text_of(dir, name)
      if t != null and not text.find_all(t, rest).is_empty() {
        snuff true
      }
    }
    snuff false
  }
  snuff false
}

pull holds_all(dir, conds) {
  snuff as_list(conds).all(pack(c) => holds(dir, c))
}

# The first alternative that applies in `dir`.
pull choose(dir, alternatives) {
  for alt in as_list(alternatives) {
    if type_of(alt) == "list" {
      snuff {cmd: alt}
    }
    if type_of(alt) == "map" and holds_all(dir, alt.get("when", [])) {
      snuff alt
    }
  }
  snuff null
}

pull vars_for(dir, tc, component) {
  roll v = {component: component, dir: dir}
  stick defs = tc.get("vars", {})
  for name in defs {
    stick alt = choose(dir, defs[name])
    if alt != null {
      if alt.has("glob") {
        # The first file a glob names (*.gemspec, *.rockspec), so the command
        # need not go through a shell to expand it.
        stick hits = glob_under(dir, str(alt.glob))
        if not hits.is_empty() {
          v[name] = path.base(hits.first())
        }
      } else if alt.has("files") {
        # Every file the globs name, relative to the component, minus the
        # skipped folders: a file list for a formatter, built here instead
        # of by find and xargs.
        stick skip = as_list(alt.get("skip", []))
        roll found = []
        for g in as_list(alt.files) {
          for hit in glob_under(dir, str(g)) {
            stick rel = pick(dir == "." or dir == "", hit, hit.slice(dir.len() + 1))
            if not rel.replace("\\", "/").split("/").any(pack(part) => skip.contains(part)) and not found.contains(rel) {
              found.push(rel)
            }
          }
        }
        v[name] = found
      } else {
        v[name] = alt.get("value", "")
      }
    }
  }
  # A value may name another var: `{py}` falls back to `{python}` when the
  # project has no venv. Values are filled from the others until nothing
  # changes, so the order the vars are declared in decides nothing; a value
  # that is exactly another var takes that var's value, a list included.
  roll names = []
  for name in v {
    names.push(name)
  }
  roll rounds = 0
  roll settled = false
  while not settled and rounds < 4 {
    settled = true
    rounds += 1
    for name in names {
      stick val = v[name]
      if type_of(val) != "string" or not val.contains("{") {
        continue
      }
      stick bare = pick(val.starts_with("{") and val.ends_with("}") and not val.starts_with("{{"), val.slice(1, val.len() - 1), "")
      if bare != "" and bare != name and v.has(bare) {
        v[name] = v[bare]
        settled = false
      } else {
        stick filled = fill_text(val, v)
        if filled != val {
          v[name] = filled
          settled = false
        }
      }
    }
  }
  snuff v
}

pull fill_text(s, vars) {
  roll t = str(s)
  for k in vars {
    if type_of(vars[k]) != "list" {
      t = t.replace("{" + k + "}", str(vars[k]))
    }
  }
  snuff t
}

# `{name}` in a toolchain command; a word that is only a list var splices it.
pull fill(words, vars) {
  roll out = []
  for w in words {
    stick s = str(w)
    stick inner = pick(s.starts_with("{") and s.ends_with("}") and not s.starts_with("{{"), s.slice(1, s.len() - 1), "")
    if inner != "" and vars.has(inner) and type_of(vars[inner]) == "list" {
      out = out + vars[inner].map(pack(x) => str(x))
    } else {
      out.push(fill_text(s, vars))
    }
  }
  snuff out
}

# ----- task runners and script folders --------------------------------------------

pull first_existing(dir, names) {
  for n in names {
    if fs.is_file(path.join(dir, n)) {
      snuff n
    }
  }
  snuff null
}

pull comment_of(line) {
  stick s = line.trim()
  if s.starts_with("#") {
    snuff tidy(s.replace("#", ""))
  }
  snuff ""
}

# The first comment in a script, as its description.
pull describe(lines) {
  roll start = 0
  if lines.get(0, "").starts_with("#!") {
    start = 1
  }
  for line in lines.slice(start, start + 12) {
    stick s = line.trim()
    if s == "" or s.starts_with("set ") or s.starts_with("# -*-") or s.starts_with("# shellcheck") or s.contains("SPDX-") or s.contains("Copyright") {
      continue
    }
    roll found = null
    if s.starts_with("#") {
      found = s.slice(1)
    } else if s.starts_with("//") {
      found = s.slice(2)
    } else if s.starts_with("\"\"\"") or s.starts_with("'''") {
      found = s.slice(3).replace("\"\"\"", "").replace("'''", "")
    }
    if found == null {
      snuff ""
    }
    stick d = tidy(found.replace("#", ""))
    if d != "" {
      snuff d
    }
  }
  snuff ""
}

# One file in a script folder: how to run it (its shebang, else its
# extension), or null when it is not a script.
pull script_target(dir, rel) {
  stick p = path.join(dir, rel)
  stick base = path.base(rel)
  if base.starts_with(".") or not fs.is_file(p) or fs.size(p) > 1000000 {
    snuff null
  }
  roll lines = null
  try {
    lines = fs.read_lines(p)
  } ashtray e {
    lines = null
  }
  if lines == null {
    # Not text: a compiled program in bin/ runs as it is.
    if path.dir(rel) == "bin" {
      snuff {name: slug(path.stem(rel)), cmd: [rel], desc: "a compiled program"}
    }
    snuff null
  }
  stick first = lines.get(0, "")
  stick ext = path.ext(rel).lower()
  roll cmd = null
  if first.starts_with("#!") {
    roll parts = first.slice(2).trim().split()
    if not parts.is_empty() and path.base(parts[0]) == "env" {
      parts = parts.slice(1).filter(pack(w) => not w.starts_with("-"))
    }
    # #!/bin/bash where bash lives elsewhere (FreeBSD, Termux, NixOS,
    # Windows): the same program, found on PATH instead.
    if not parts.is_empty() and (path.is_abs(parts[0]) or parts[0].starts_with("/")) and not fs.exists(parts[0]) {
      parts[0] = path.base(parts[0])
    }
    if not parts.is_empty() {
      cmd = parts + [rel]
    }
  }
  if cmd == null and INTERPRETERS.has(ext) {
    cmd = INTERPRETERS[ext] + [rel]
  }
  if cmd == null {
    snuff null
  }
  cmd = interpreter_here(cmd)
  roll desc = describe(lines)
  if ext == "cig" {
    # Said once at adoption: a .cig file runs as a cig run of its own, and is
    # undone through its run id when this run rolls back (see the task runner).
    desc = pick(desc == "", "", desc + " · ") + "a cig run of its own; undone through its run id on rollback"
  }
  snuff {name: slug(path.stem(rel)), cmd: cmd, desc: desc}
}

# The interpreter this machine has: python3, else python, else the Windows
# launcher; pwsh, else Windows PowerShell. Decided at adoption, where the
# machine is known, so the manifest names what runs here.
pull interpreter_here(cmd) {
  stick prog = str(cmd.first())
  if prog == "python3" and which("python3") == null {
    if which("python") != null {
      snuff ["python"] + cmd.slice(1)
    }
    if which("py") != null {
      snuff ["py", "-3"] + cmd.slice(1)
    }
  }
  if prog == "pwsh" and which("pwsh") == null and which("powershell") != null {
    snuff ["powershell"] + cmd.slice(1)
  }
  snuff cmd
}

# A byte-order mark at the start of a text file (Notepad, PowerShell 5.1)
# is not part of the text.
pull unbom(textv) {
  snuff text.replace(str(textv), '^\x{FEFF}', "")
}

# The targets a runner file declares: [{name, desc, cmd?}].
pull read_targets(dir, kind) {
  roll found = []
  roll seen = {}
  pull add(name, desc, cmd) {
    if not seen.has(name) {
      seen[name] = true
      found.push({name: name, desc: desc, cmd: cmd})
    }
  }
  if kind == "scripts" {
    for entry in entries_of(dir).sort() {
      if LOOSE_SCRIPT_EXTS.contains(path.ext(entry).lower()) {
        stick t = script_target(dir, entry)
        if t != null {
          add(t.name, t.desc, t.cmd)
        }
      }
    }
    for folder in SCRIPT_DIRS {
      if fs.is_dir(path.join(dir, folder)) {
        for entry in entries_of(path.join(dir, folder)).sort() {
          stick t = script_target(dir, folder + "/" + entry)
          if t != null {
            add(t.name, t.desc, t.cmd)
          }
        }
      }
    }
    snuff found
  }
  if kind == "make" {
    stick file = first_existing(dir, ["GNUmakefile", "makefile", "Makefile"])
    if file == null {
      snuff found
    }
    stick lines = fs.read_lines(path.join(dir, file))
    roll phony = []
    for line in lines {
      stick c = text.captures(line, '^\.PHONY[ \t]*:(.*)$')
      if c != null {
        phony = phony + c[1].split()
      }
    }
    roll prev = ""
    for line in lines {
      # `build test: deps` is a rule for two targets.
      stick c = text.captures(line, '^([A-Za-z0-9][A-Za-z0-9_-]*(?:[ \t]+[A-Za-z0-9][A-Za-z0-9_-]*)*)[ \t]*:([^=].*)?$')
      if c != null {
        stick rest = c.get(2, null) ?? ""
        stick at = rest.find("##")
        stick d = pick(at >= 0, tidy(rest.slice(at + 2)), comment_of(prev))
        for target in c[1].split() {
          if phony.is_empty() or phony.contains(target) {
            add(target, d, null)
          }
        }
      }
      prev = line
    }
    snuff found
  }
  if kind == "just" {
    stick file = first_existing(dir, ["justfile", "Justfile", ".justfile"])
    if file == null {
      snuff found
    }
    roll prev = ""
    for line in fs.read_lines(path.join(dir, file)) {
      stick c = text.captures(line, '^@?([A-Za-z_][A-Za-z0-9_-]*)([^:]*):([^=].*)?$')
      if c != null and not c[1].starts_with("_") and not ["set", "alias", "export", "import", "mod"].contains(c[1]) {
        stick params = (c.get(2, null) ?? "").trim()
        roll d = comment_of(prev)
        if params != "" {
          d = tidy(d + pick(d == "", "", " ") + "(takes ${params})")
        }
        add(c[1], d, null)
      }
      prev = line
    }
    snuff found
  }
  if kind == "taskfile" {
    stick file = first_existing(dir, ["Taskfile.yml", "Taskfile.yaml", "taskfile.yml", "taskfile.yaml"])
    if file == null {
      snuff found
    }
    roll inside = false
    roll current = null
    for line in fs.read_lines(path.join(dir, file)) {
      if text.matches(line, '^tasks:\s*$') {
        inside = true
        continue
      }
      if inside and text.matches(line, '^\S') {
        inside = false
      }
      if not inside {
        continue
      }
      stick c = text.captures(line, '^  ([A-Za-z0-9_.:-]+):\s*$')
      if c != null {
        current = c[1]
        add(current, "", null)
        continue
      }
      stick d = text.captures(line, '^    desc:\s*(.+)$')
      if d != null and current != null {
        found = found.map(pack(t) => pick(t.name == current, {name: t.name, desc: tidy(d[1].replace("\"", "")), cmd: null}, t))
      }
    }
    snuff found
  }
  if kind == "rake" {
    stick file = first_existing(dir, ["Rakefile", "rakefile"])
    if file == null {
      snuff found
    }
    roll desc = ""
    for line in fs.read_lines(path.join(dir, file)) {
      stick d = text.captures(line, '^\s*desc\s+["\x27](.+)["\x27]')
      if d != null {
        desc = tidy(d[1])
        continue
      }
      stick c = text.captures(line, '^\s*task\s+:?"?([A-Za-z0-9_]+)')
      if c != null {
        add(c[1], desc, null)
        desc = ""
      }
    }
    snuff found
  }
  if kind == "earthly" {
    stick t = text_of(dir, "Earthfile")
    if t != null {
      for line in t.lines() {
        stick c = text.captures(line, '^([a-z][A-Za-z0-9_-]*):\s*$')
        if c != null {
          add(c[1], "", null)
        }
      }
    }
    snuff found
  }
  snuff found
}

pull targets_of(dir, kind) {
  snuff cached("targets:" + kind + ":" + dir, pack() => read_targets(dir, kind))
}

# Which stage each alias table maps to, from the names that are present.
pull map_names(names, aliases) {
  roll mapped = {}
  for stage in STAGES {
    for alias in aliases.get(stage, []) {
      if names.contains(alias) and not mapped.has(stage) {
        mapped[stage] = alias
      }
    }
  }
  snuff mapped
}

# ----- the toolchains a project uses ------------------------------------------------

# The built-in table, with the project's own additions and overrides:
# {"toolchains": {"python-uv": {"stages": {...}}, "my-tool": {"extends": "go", ...}}}.
pull toolchains_for(m) {
  roll kb = {}
  for id in TOOLCHAINS {
    kb[id] = TOOLCHAINS[id]
  }
  stick given = m.get("toolchains", {})
  if type_of(given) != "map" {
    snuff kb
  }
  for id in given {
    stick own = given[id]
    if type_of(own) != "map" {
      continue
    }
    stick base = kb.get(own.get("extends", id), {})
    roll merged = base.merge(own)
    merged.stages = base.get("stages", {}).merge(own.get("stages", {}))
    merged.vars = base.get("vars", {}).merge(own.get("vars", {}))
    kb[id] = merged
  }
  snuff kb
}

# The toolchains found in one directory: the best of each family.
pull detect_here(dir, kb) {
  roll best = {}
  for id in kb {
    stick tc = kb[id]
    if tc.get("auto", true) and not as_list(tc.get("detect", [])).is_empty() and holds_all(dir, tc.detect) {
      stick fam = tc.get("family", id)
      if not best.has(fam) or tc.get("priority", 10) > kb[best[fam]].get("priority", 10) {
        best[fam] = id
      }
    }
  }
  snuff best.values()
}

# ----- one component ------------------------------------------------------------------

pull spec_of(alt, vars, source) {
  roll spec = {source: source}
  if alt.has("shell") {
    spec.shell = fill_text(alt.shell, vars)
  } else if alt.has("cmds") {
    spec.cmds = as_list(alt.cmds).map(pack(c) => fill(argv_of(c) ?? [], vars))
  } else if alt.has("rm") {
    spec.rm = as_list(alt.rm).map(pack(x) => fill_text(str(x), vars))
  } else {
    spec.cmd = fill(alt.cmd, vars)
  }
  if alt.has("each") {
    spec.each = alt.each
  }
  if alt.has("fail_on_output") {
    spec.fail_on_output = alt.fail_on_output
  }
  if alt.has("env") {
    spec.env = alt.env
  }
  snuff spec
}

# Everything a component can run: its stages, and its other targets.
pull resolve_component(name, comp, kb) {
  stick dir = str(comp.get("path", "."))
  stick tc_id = comp.get("toolchain", null)
  if tc_id == null or not kb.has(tc_id) {
    snuff {dir: dir, toolchain: tc_id, stages: {}, extras: {}, order: STAGE_NEEDS, error: pick(tc_id == null, "has no toolchain", "names an unknown toolchain `${tc_id}`")}
  }
  stick tc = kb[tc_id]
  stick vars = vars_for(dir, tc, name)
  roll stages = {}
  roll extras = {}
  # 1. The toolchain's own commands.
  stick defs = tc.get("stages", {})
  for stage in defs {
    stick alt = choose(dir, defs[stage])
    if alt != null {
      stages[stage] = spec_of(alt, vars, tc_id)
    }
  }
  stick ex = tc.get("extras", {})
  for x in ex {
    stick alt = choose(dir, ex[x])
    if alt != null {
      extras[x] = spec_of(alt, vars, tc_id)
    }
  }
  # 2. Its script table: package.json scripts, composer scripts, deno tasks.
  stick sc = tc.get("scripts", null)
  if sc != null {
    stick table = dig(json_of(dir, sc.file), [sc.key])
    if type_of(table) == "map" {
      stick run = fill(sc.run, vars)
      stick mapped = map_names(table.keys(), SCRIPT_ALIASES)
      for stage in mapped {
        stages[stage] = {cmd: run + [mapped[stage]], source: "${sc.file} \"${mapped[stage]}\""}
      }
      pull hook(script) {
        snuff HOOK_SCRIPTS.contains(script) or (script.starts_with("pre") and table.has(script.slice(3))) or (script.starts_with("post") and table.has(script.slice(4)))
      }
      for script in table {
        if not STAGES.contains(script) and not hook(script) {
          extras[script] = {cmd: run + [script], source: "${sc.file} \"${script}\"", desc: tidy(to_text(table[script]))}
        }
      }
    }
  }
  # 3. Its targets: make, just, Taskfile, rake, Earthfile, script folders.
  stick tk = tc.get("targets", null)
  if tk != null {
    stick found = targets_of(dir, tk)
    stick mapped = map_names(found.map(pack(t) => t.name), pick(tk == "make", MAKE_ALIASES, SCRIPT_ALIASES))
    stick run = fill(as_list(tc.get("targets_run", [])), vars)
    pull command_for(t) {
      if t.cmd != null {
        snuff t.cmd
      }
      if run.any(pack(w) => w.contains("{target}")) {
        snuff fill(run, vars.merge({target: t.name}))
      }
      snuff fill(run, vars) + [t.name]
    }
    for t in found {
      roll spec = {cmd: command_for(t), source: "${tk} target \"${t.name}\""}
      if t.desc != "" {
        spec.desc = t.desc
      }
      for stage in mapped {
        if mapped[stage] == t.name {
          stages[stage] = spec
        }
      }
      if not STAGES.contains(t.name) {
        extras[t.name] = spec
      }
    }
  }
  # 4. What the project says, which always wins. Its commands take the same
  # vars as the toolchain's ({component}, {py}, {locked}...).
  roll problems = []
  stick given = comp.get("stages", {})
  for stage in given {
    stick ov = given[stage]
    stick home = pick(STAGES.contains(stage), stages, extras)
    if ov == false or ov == null {
      home.remove(stage)
    } else if type_of(ov) == "list" or type_of(ov) == "string" {
      home[stage] = {cmd: fill(argv_of(ov) ?? [], vars), source: MANIFEST}
    } else if type_of(ov) == "map" {
      if ov.has("shell") {
        home[stage] = ov.merge({source: MANIFEST, shell: fill_text(ov.shell, vars)})
      } else if ov.has("cmd") {
        home[stage] = ov.merge({source: MANIFEST, cmd: fill(argv_of(ov.cmd) ?? [], vars)})
      } else if home.has(stage) {
        home[stage] = home[stage].merge(ov)
      } else {
        problems.push("stages.${stage} adds options, but ${tc_id} has no " + pick(STAGES.contains(stage), "${stage} stage", "`${stage}` target") + " here; give it `cmd` or `shell`")
      }
    }
  }
  # 5. What each stage may change, for the tin: the override's `touches`,
  # else the toolchain's, else the family's for format and setup.
  stick tc_touches = tc.get("touches", {})
  stick fam = FAMILY_TOUCHES.get(str(tc.get("family", "")), {})
  for s in stages {
    if not stages[s].has("touches") {
      stick own_t = pick(type_of(tc_touches) == "map", tc_touches.get(s, null), null)
      if own_t != null {
        stages[s].touches = own_t
      } else if fam.get(s, null) != null {
        # The family's list is a guess at what might change (every lockfile
        # kind, every source extension), not a promise: a glob that matches
        # nothing yet (`?package-lock.json`) is no typo, and cig stays quiet.
        stages[s].touches = as_list(fam[s]).map(pack(g) => pick(str(g).starts_with("?"), str(g), "?" + str(g)))
      }
    }
  }
  # A var none of whose alternatives applies has no value here, and would
  # reach the command as the literal text {name}.
  stick declared = tc.get("vars", {}).keys()
  for table in [stages, extras] {
    for s in table {
      stick spec = table[s]
      stick words = as_list(spec.get("cmd", [])).map(pack(w) => str(w)) + pick(spec.has("shell"), [str(spec.get("shell", ""))], [])
      for v in declared {
        if words.any(pack(w) => w.contains("{" + v + "}")) and not spec.has("unresolved") {
          spec.unresolved = "{${v}} has no value in ${dir}: none of its alternatives apply here, so give the var one without `when`"
          problems.push("${s}: ${spec.unresolved}")
        }
      }
    }
  }
  snuff {dir: dir, toolchain: tc_id, stages: stages, extras: extras, order: STAGE_NEEDS.merge(tc.get("order", {})), note: tc.get("note", ""), problems: problems}
}

# The stages `stage` waits for inside its component, skipping the ones the
# component does not have.
pull stage_deps(present, stage, order) {
  roll out = []
  roll seen = {}
  pull walk(s) {
    for dep in order.get(s, []) {
      if not seen.has(dep) {
        seen[dep] = true
        if present.has(dep) {
          out.push(dep)
        } else {
          walk(dep)
        }
      }
    }
  }
  walk(stage)
  snuff out
}

# ----- the manifest ---------------------------------------------------------------

stick TOP_KEYS = ["project", "cig", "versions", "defaults", "settings", "components", "toolchains", "tasks"]
stick DEFAULT_KEYS = ["timeout_ms", "retries", "retry_delay_ms", "inputs_limit", "box"]
stick COMPONENT_KEYS = ["path", "toolchain", "after", "stages", "env", "env_file", "groups", "timeout_ms", "retries", "retry_delay_ms", "desc"]
stick TASK_KEYS = ["cmd", "shell", "needs", "desc", "source", "cwd", "env", "env_file", "timeout_ms", "retries", "retry_delay_ms", "ok", "undo", "undo_shell", "capture", "stdin", "stdin_from", "inputs", "inputs_limit", "produces", "touches", "touches_sealed", "box", "encoding", "cmds", "rm", "each", "fail_on_output", "trust", "footprint"]
stick CAPTURES = ["text", "json", "lines", "kv"]
stick TOOLCHAIN_KEYS = ["language", "short", "extends", "detect", "family", "priority", "auto", "kind", "workspace", "claims_subtree",
  "stages", "extras", "order", "vars", "scripts", "targets", "targets_run", "tools", "versions", "pins", "touches", "install", "note"]
stick CONDITION_KINDS = ["file", "dir", "glob", "grep", "json", "tool", "os", "not"]
# What cig.os() reports, plus the two groups; any other word matches no
# machine, and a stage behind it would vanish without a word.
stick OS_NAMES = ["windows", "macos", "linux", "freebsd", "netbsd", "openbsd", "dragonfly", "android", "ios", "solaris", "illumos", "bsd", "unix"]
stick OS_NEAR = {darwin: "macos", osx: "macos", mac: "macos", macosx: "macos", win: "windows", win32: "windows", win64: "windows", windows_nt: "windows", posix: "unix", gnu: "linux"}

# The first condition in `c` (a condition, or a list of them, nested for
# "any of") that is not one cigo knows how to check, or null.
pull bad_condition(c) {
  if type_of(c) == "list" {
    for x in c {
      stick b = bad_condition(x)
      if b != null {
        snuff b
      }
    }
    snuff null
  }
  stick s = str(c)
  stick at = s.find(":")
  if at <= 0 {
    snuff s
  }
  stick kind = s.slice(0, at)
  if kind == "not" {
    snuff pick(bad_condition(s.slice(at + 1)) == null, null, s)
  }
  if not CONDITION_KINDS.contains(kind) or s.slice(at + 1) == "" {
    snuff s
  }
  if (kind == "grep" or kind == "json") and s.slice(at + 1).find(":") <= 0 {
    snuff s
  }
  if kind == "os" and not OS_NAMES.contains(s.slice(at + 1).lower()) {
    snuff s
  }
  snuff null
}
stick NEAR_MISSES = {
  need: "needs", deps: "needs", depends: "needs", depends_on: "needs", requires: "needs", dependencies: "needs",
  command: "cmd", commands: "cmd", run: "cmd", script: "cmd", exec: "cmd", argv: "cmd",
  sh: "shell", bash: "shell",
  description: "desc", help: "desc", summary: "desc",
  timeout: "timeout_ms", retry: "retries", attempts: "retries",
  dir: "cwd", workdir: "cwd", working_dir: "cwd", directory: "path",
  environment: "env", envfile: "env_file", dotenv: "env_file",
  rollback: "undo", revert: "undo", cleanup: "undo",
  touch: "touches", changes: "touches", modifies: "touches", writes: "touches", rewrites: "touches",
  output: "capture", outputs: "produces", artifacts: "produces", artifact: "produces", sources: "inputs", input: "inputs",
  lang: "toolchain", language: "toolchain", tool: "toolchain", tooling: "toolchain",
}

pull load() {
  if not fs.is_file(MANIFEST) {
    fail("no ${MANIFEST} in ${ROOT}; `cigo adopt` finds the languages and scripts this project already has and proposes one")
  }
  roll m = null
  try {
    m = json.parse(unbom(fs.read_text(MANIFEST)))
  } ashtray e {
    fail("${MANIFEST} is not valid JSON: ${e.message}")
  }
  if type_of(m) != "map" or (type_of(m.get("tasks", null)) != "map" and type_of(m.get("components", null)) != "map") {
    fail("${MANIFEST} needs `components` or `tasks`, like {\"components\": {\"api\": {\"path\": \"api\", \"toolchain\": \"go\"}}}")
  }
  # The project's own settings join the layers (a project can only tighten).
  if type_of(m.get("settings", null)) == "map" {
    PROJECT_SETTINGS = m.settings
  }
  snuff m
}

pull project_of(m) {
  snuff str(m.get("project", path.base(ROOT)))
}

pull needs_of(t) {
  stick n = t.get("needs", [])
  if type_of(n) == "string" {
    snuff [n]
  }
  if type_of(n) != "list" {
    snuff []
  }
  snuff n.map(pack(x) => str(x))
}

pull ok_codes(t) {
  stick ok = t.get("ok", [0])
  if type_of(ok) == "int" {
    snuff [ok]
  }
  snuff ok
}

pull component_task(comp_name, r, stage, spec, needs) {
  stick c = r.spec
  roll t = {}
  if spec.has("shell") {
    t.shell = str(spec.shell)
  } else if not spec.has("cmds") and not spec.has("rm") {
    t.cmd = argv_of(spec.get("cmd", null)) ?? []
  }
  t.cwd = r.dir
  t.env = c.get("env", {}).merge(spec.get("env", {}))
  t.env_files = as_list(c.get("env_file", null)).map(pack(f) => path.join(r.dir, str(f))) + as_list(spec.get("env_file", null)).map(pack(f) => path.join(r.dir, str(f)))
  t.needs = needs + needs_of(spec)
  for key in ["timeout_ms", "retries", "retry_delay_ms"] {
    if spec.has(key) {
      t[key] = spec[key]
    } else if c.has(key) {
      t[key] = c[key]
    }
  }
  for key in ["ok", "undo", "undo_shell", "capture", "stdin", "stdin_from", "inputs", "inputs_limit", "produces", "touches", "touches_sealed", "box", "desc", "unresolved", "cmds", "rm", "each", "fail_on_output", "trust", "footprint"] {
    if spec.has(key) {
      t[key] = spec[key]
    }
  }
  t.component = comp_name
  t.stage = stage
  t.toolchain = r.toolchain
  t.origin = "component ${comp_name} (${r.toolchain}): ${spec.get("source", "")}"
  snuff t
}

pull manifest_task(t) {
  roll out = {}
  for key in t {
    out[key] = t[key]
  }
  out.cwd = str(t.get("cwd", "."))
  out.env_files = as_list(t.get("env_file", null)).map(pack(f) => path.join(out.cwd, str(f)))
  out.needs = needs_of(t)
  if not t.has("cmd") and not t.has("shell") and not out.needs.is_empty() {
    out.group = true
  }
  out.origin = MANIFEST
  snuff out
}

# ----- templates: values between tasks, across languages ------------------------------
#
#   {{version}}             the output of task `version`: its captured stdout,
#                           or the name=value lines it wrote to $CIG_OUTPUT
#   {{schema.tables.0}}     a path into that output
#   {{version|json}}        the value as JSON text
#   {{notes|sh}}            the value quoted for a `shell` line (a list: each item)
#   {{env.HOME}}  {{root}}  {{project}}
# A task that uses another task's output waits for it: the reference is a need.

stick TEMPLATE = '\{\{[^{}]*\}\}'

# Four braces are two: `{{{{.X}}}}` reaches the program as `{{.X}}`, for tools
# with templates of their own (go list -f, docker --format, gh --template).
# They are hidden while a string is read for templates and shown again after.
stick ESCAPED_OPEN = "<<cigo:open>>"
stick ESCAPED_CLOSE = "<<cigo:close>>"

pull hide_escapes(s) {
  snuff str(s).replace("{{{{", ESCAPED_OPEN).replace("}}}}", ESCAPED_CLOSE)
}

pull show_escapes(s) {
  snuff str(s).replace(ESCAPED_OPEN, "{{").replace(ESCAPED_CLOSE, "}}")
}
stick EXPOSED = {}
stick RAW = {}
roll DRY = false
# Set while a `shell` or `undo_shell` line is rendered: a value pasted into
# one is shell code, so a value holding shell syntax is refused unless `|sh`
# made it one word.
roll RENDER_SHELL = false
stick SHELL_SYNTAX = [";", "|", "&", "`", "$(", "\n", "<", ">"]
# `cigo run --only`: the tasks a template reads from may not have run.
roll ONLY = false
roll PROJECT_NAME = path.base(ROOT)

pull strings_of(t) {
  roll out = []
  for w in as_list(t.get("cmd", null)) {
    out.push(str(w))
  }
  # Every word of every command in `cmds`, and every path in `rm`: a value
  # read there is a need and a reference like any other.
  for c in as_list(t.get("cmds", null)) {
    for w in argv_of(c) ?? [] {
      out.push(str(w))
    }
  }
  for w in as_list(t.get("rm", null)) {
    out.push(str(w))
  }
  for key in ["shell", "stdin", "cwd", "undo_shell"] {
    if t.has(key) and type_of(t[key]) == "string" {
      out.push(t[key])
    }
  }
  if type_of(t.get("env", null)) == "map" {
    for k in t.env {
      out.push(str(t.env[k]))
    }
  }
  if type_of(t.get("undo", null)) == "list" {
    for w in t.undo {
      out.push(str(w))
    }
  }
  snuff out
}

pull template_exprs(s) {
  snuff text.find_all(hide_escapes(s), TEMPLATE).map(pack(m) => m.slice(2, m.len() - 2).trim())
}

pull expr_base(expr) {
  stick bar = expr.find("|")
  snuff pick(bar < 0, expr, expr.slice(0, bar)).trim()
}

pull is_builtin_ref(base) {
  snuff base == "root" or base == "project" or base == "home" or base.starts_with("env.")
}

# Which task a template path names: the longest leading part that is a task.
pull task_named(base, table) {
  stick parts = base.split(".")
  roll n = parts.len()
  while n > 0 {
    stick cand = parts.slice(0, n).join(".")
    if table.has(cand) {
      snuff {task: cand, rest: parts.slice(n)}
    }
    n -= 1
  }
  snuff null
}

pull refs_of(t, tasks) {
  roll out = []
  if t.has("stdin_from") {
    out.push(str(t.stdin_from))
  }
  for s in strings_of(t) {
    for expr in template_exprs(s) {
      stick base = expr_base(expr)
      if not is_builtin_ref(base) {
        stick hit = task_named(base, tasks)
        if hit != null and not out.contains(hit.task) {
          out.push(hit.task)
        }
      }
    }
  }
  snuff out
}

pull lookup(expr, where) {
  stick bar = expr.find("|")
  stick base = expr_base(expr)
  stick filter = pick(bar < 0, "", expr.slice(bar + 1).trim())
  roll value = null
  if base == "root" {
    value = ROOT
  } else if base == "project" {
    value = PROJECT_NAME
  } else if base == "home" {
    value = fs.home()
  } else if base.starts_with("env.") {
    value = env.get(base.slice(4), "")
  } else {
    stick hit = task_named(base, EXPOSED)
    if hit == null {
      if DRY {
        snuff "{{" + expr + "}}"
      }
      if ONLY {
        cough "{{${expr}}} in ${where}: no task by that name has produced output in this run; with --only, the tasks it reads from don't run: name them too, or leave out --only"
      }
      cough "{{${expr}}} in ${where}: no task by that name has produced output in this run; give it `capture`, or have it write name=value lines to $CIG_OUTPUT"
    }
    value = dig(EXPOSED[hit.task], hit.rest)
    if value == null and not hit.rest.is_empty() {
      if DRY {
        snuff "{{" + expr + "}}"
      }
      cough "{{${expr}}} in ${where}: the output of `${hit.task}` has no `${hit.rest.join(".")}`; it is ${tidy(to_text(EXPOSED[hit.task]))}"
    }
  }
  if filter == "" {
    if RENDER_SHELL and not is_builtin_ref(base) or (RENDER_SHELL and base.starts_with("env.")) {
      # Unquoted in a shell line: a value that holds shell syntax would run.
      stick textv = to_text(value)
      stick found = SHELL_SYNTAX.filter(pack(c) => textv.contains(c))
      if not found.is_empty() {
        cough "{{${expr}}} in ${where}: its value holds shell syntax (`${found.first().replace("\n", "\\n")}`) and reaches a `shell` line unquoted, so it would run as shell; write {{${base}|sh}} to make it one word, or put the value in `env` and read it as \"$NAME\""
      }
    }
    snuff value
  }
  if filter == "json" {
    snuff json.stringify(value)
  }
  if filter == "sh" {
    if type_of(value) == "list" {
      snuff value.map(pack(x) => sh_quote(to_text(x))).join(" ")
    }
    snuff sh_quote(to_text(value))
  }
  cough "{{${expr}}} in ${where}: unknown filter `|${filter}`; the filters are |json and |sh"
}

pull render_shell(s, where) {
  RENDER_SHELL = true
  roll out = ""
  try {
    out = render(s, where)
  } finally {
    RENDER_SHELL = false
  }
  snuff out
}

# The templates in a task's `shell` and `undo_shell` lines that reach the
# shell unquoted: every one without `|sh`, except the paths cigo itself
# supplies (root, project, home). One per key and expression.
pull unquoted_shell_templates(t) {
  roll out = []
  for key in ["shell", "undo_shell"] {
    if t.has(key) and type_of(t[key]) == "string" {
      for expr in template_exprs(t[key]) {
        stick bar = expr.find("|")
        stick filter = pick(bar < 0, "", expr.slice(bar + 1).trim())
        stick base = expr_base(expr)
        if filter != "sh" and base != "root" and base != "project" and base != "home" {
          out.push({key: key, expr: expr, base: base})
        }
      }
    }
  }
  snuff out
}

pull unquoted_advice(u) {
  stick var_name = u.base.split(".").last().upper().replace("-", "_")
  snuff "{{${u.expr}}} reaches a `${u.key}` line unquoted, so a value holding shell syntax runs as shell; write {{${u.base}|sh}}, or put the value in `env` and read \"$${var_name}\" (a `cmd` list never reaches a shell)"
}

pull render(s, where) {
  stick src = hide_escapes(s)
  if not src.contains("{{") {
    snuff show_escapes(src)
  }
  roll out = ""
  roll rest = src
  while true {
    stick i = rest.find("{{")
    if i < 0 {
      break
    }
    stick j = rest.slice(i + 2).find("}}")
    if j < 0 {
      break
    }
    stick expr = rest.slice(i + 2, i + 2 + j).trim()
    out = out + rest.slice(0, i) + to_text(lookup(expr, where))
    rest = rest.slice(i + 2 + j + 2)
  }
  snuff show_escapes(out + rest)
}

# An argv word that is one whole template and names a list becomes that many words.
pull render_argv(words, where) {
  roll out = []
  for w in words {
    stick s = hide_escapes(w)
    stick whole = text.captures(s, '^\{\{([^{}]*)\}\}$')
    if whole != null {
      stick v = lookup(whole[1].trim(), where)
      if type_of(v) == "list" {
        out = out + v.map(pack(x) => to_text(x))
      } else {
        out.push(to_text(v))
      }
    } else {
      out.push(render(s, where))
    }
  }
  snuff out
}

# ----- the task graph ---------------------------------------------------------------

pull build_graph(m) {
  stick kb = toolchains_for(m)
  PROJECT_NAME = project_of(m)
  roll tasks = {}
  roll comps = {}
  stick defined = m.get("components", {})
  if type_of(defined) == "map" {
    for name in defined {
      stick c = defined[name]
      if type_of(c) == "map" {
        comps[name] = resolve_component(name, c, kb).merge({name: name, spec: c})
      }
    }
  }
  for name in comps {
    stick r = comps[name]
    stick after = as_list(r.spec.get("after", [])).map(pack(x) => str(x))
    for stage in r.stages {
      roll needs = stage_deps(r.stages, stage, r.order).map(pack(d) => "${name}:${d}")
      for other in after {
        if comps.has(other) and comps[other].stages.has(stage) {
          needs.push("${other}:${stage}")
        }
      }
      tasks["${name}:${stage}"] = component_task(name, r, stage, r.stages[stage], needs)
    }
    for x in r.extras {
      stick needs = pick(r.stages.has("setup"), ["${name}:setup"], [])
      tasks["${name}:${x}"] = component_task(name, r, x, r.extras[x], needs).merge({extra: true})
    }
  }
  for stage in GROUP_STAGES {
    stick members = comps.keys().filter(pack(n) => comps[n].spec.get("groups", true) != false and comps[n].stages.has(stage)).map(pack(n) => "${n}:${stage}")
    if not members.is_empty() {
      tasks[stage] = {group: true, needs: members, desc: "${stage}, in every component that has it", origin: "stage group"}
    }
  }
  stick own = m.get("tasks", {})
  if type_of(own) == "map" {
    for name in own {
      stick t = own[name]
      if type_of(t) == "map" {
        tasks[name] = manifest_task(t)
      } else {
        tasks[name] = {bad: true, needs: [], origin: MANIFEST, value: t}
      }
    }
  }
  # `ci` is every CI stage there is, a stage group or a task of the same name
  # written by hand; a `ci` of the project's own wins.
  stick ci = CI_STAGES.filter(pack(s) => tasks.has(s) and not tasks[s].get("bad", false))
  if not ci.is_empty() and not tasks.has("ci") {
    tasks["ci"] = {group: true, needs: ci, desc: "format-check, lint, check, build and test, everywhere", origin: "stage group"}
  }
  for name in tasks {
    stick t = tasks[name]
    for ref in refs_of(t, tasks) {
      if ref != name and not t.needs.contains(ref) {
        t.needs.push(ref)
      }
    }
  }
  snuff {tasks: tasks, components: comps, kb: kb, manifest: m}
}

pull known(tasks, wanted) {
  stick names = tasks.keys()
  stick close = similar(names, wanted, {})
  if not close.is_empty() {
    snuff "did you mean ${close.slice(0, 3).join(" or ")}?"
  }
  if names.is_empty() {
    snuff "there are no tasks yet"
  }
  snuff "tasks here: ${names.slice(0, 8).join(", ")}" + pick(names.len() > 8, ", ...", "")
}

# The tasks to run for `wanted`, dependencies first, each once. Groups are in
# the order too, as markers; they run nothing.
pull resolve(tasks, wanted, only) {
  for name in wanted {
    if not tasks.has(name) {
      cough "no task named `${name}`; ${known(tasks, name)}"
    }
  }
  if only {
    roll flat = []
    pull expand(name) {
      stick t = tasks[name]
      if t.get("group", false) {
        for n in t.needs {
          if tasks.has(n) {
            expand(n)
          }
        }
      } else if not flat.contains(name) {
        flat.push(name)
      }
    }
    for name in wanted {
      expand(name)
    }
    snuff flat
  }
  roll order = []
  roll done = {}
  pull visit(name, trail) {
    if done.has(name) {
      snuff
    }
    if trail.contains(name) {
      cough "dependency loop: ${(trail + [name]).join(" > ")}"
    }
    if not tasks.has(name) {
      cough "`${trail.last()}` needs `${name}`, and there is no task by that name; ${known(tasks, name)}"
    }
    for dep in tasks[name].get("needs", []) {
      visit(dep, trail + [name])
    }
    done[name] = true
    order.push(name)
  }
  for name in wanted {
    visit(name, [])
  }
  snuff order
}

pull resolve_or_fail(tasks, wanted, only) {
  roll order = null
  try {
    order = resolve(tasks, wanted, only)
  } ashtray e {
    fail(e.message)
  }
  snuff order
}

pull runnable(tasks, order) {
  snuff order.filter(pack(n) => not tasks[n].get("group", false))
}

pull label_of(t) {
  if t.get("group", false) {
    snuff "(group: " + t.needs.join(", ") + ")"
  }
  if t.has("shell") {
    snuff str(t.shell)
  }
  if t.has("rm") {
    snuff "remove " + as_list(t.rm).map(pack(x) => str(x)).join(" ") + "   (journaled, undone on rollback)"
  }
  if t.has("cmds") {
    snuff as_list(t.cmds).map(pack(c) => (argv_of(c) ?? []).map(quote).join(" ")).join("  &&  ")
  }
  stick argv = argv_of(t.get("cmd", null))
  if argv == null or argv.is_empty() {
    snuff "(nothing to run)"
  }
  roll per_file = ""
  if t.has("each") {
    # pick() runs both arms, so the lookups stay behind an if.
    roll each_globs = []
    if type_of(t.each) == "map" {
      each_globs = as_list(t.each.get("files", []))
    } else {
      each_globs = as_list(t.each)
    }
    per_file = "   (once per file: ${each_globs.map(pack(x) => str(x)).join(" ")})"
  }
  snuff argv.map(quote).join(" ") + per_file
}

# ----- running one task ---------------------------------------------------------------

stick RUN_DIR = path.join(STATE, "run")
stick OUTPUTS_FILE = path.join(ROOT, STATE, "run", "outputs.json")
roll FORCE = false

# name=value lines, and name<<DELIM ... DELIM blocks, as a task wrote them to
# the file named by $CIG_OUTPUT (the format GitHub Actions uses for steps).
pull read_named(file) {
  roll out = {}
  if not fs.is_file(file) {
    snuff out
  }
  roll lines = []
  try {
    lines = unbom(fs.read_text(file)).lines()
  } ashtray e {
    log.warn("${file} is not UTF-8 text, so nothing was handed on from it (Windows PowerShell 5.1 writes UTF-16 with >>; use PowerShell 7, or Out-File -Encoding ascii)")
    snuff out
  }
  roll i = 0
  while i < lines.len() {
    stick line = lines[i]
    stick block = text.captures(line, '^([A-Za-z_][A-Za-z0-9_-]*)<<(.+)$')
    if block != null {
      roll body = []
      i += 1
      while i < lines.len() and lines[i] != block[2] {
        body.push(lines[i])
        i += 1
      }
      out[block[1]] = body.join("\n")
    } else {
      stick kv = text.captures(line, '^([A-Za-z_][A-Za-z0-9_-]*)=(.*)$')
      if kv != null {
        out[kv[1]] = kv[2]
      }
    }
    i += 1
  }
  snuff out
}

# KEY=value lines from an env file (.env style).
pull read_env_file(file) {
  roll out = {}
  if not fs.is_file(file) {
    snuff out
  }
  for line in unbom(fs.read_text(file)).lines() {
    roll s = line.trim()
    if s == "" or s.starts_with("#") {
      continue
    }
    if s.starts_with("export ") {
      s = s.slice(7).trim()
    }
    stick eq = s.find("=")
    if eq <= 0 {
      continue
    }
    roll v = s.slice(eq + 1).trim()
    if v.len() >= 2 and ((v.starts_with("\"") and v.ends_with("\"")) or (v.starts_with("'") and v.ends_with("'"))) {
      v = v.slice(1, v.len() - 1)
    }
    out[s.slice(0, eq).trim()] = v
  }
  snuff out
}

pull hop_options(name, t, cwd, defaults, where) {
  roll e = {}
  for f in as_list(t.get("env_files", [])) {
    stick vals = read_env_file(f)
    for k in vals {
      e[k] = vals[k]
    }
  }
  stick given = t.get("env", {})
  if type_of(given) == "map" {
    for k in given {
      e[k] = render(to_text(given[k]), where)
    }
  }
  e.CIG_TASK = name
  e.CIG_PROJECT_ROOT = ROOT
  e.CIG_OUTPUT = path.join(ROOT, RUN_DIR, slug(name) + ".out")
  e.CIG_OUTPUTS = OUTPUTS_FILE
  if t.has("component") {
    e.CIG_COMPONENT = t.component
  }
  # Output is read with bad bytes replaced unless the task asks for strict
  # text: a Windows console code page or a Latin-1 path must not turn a
  # task that exited 0 into a failure.
  roll o = {timeout_ms: int(t.get("timeout_ms", defaults.get("timeout_ms", 600000))), env: e, encoding: str(t.get("encoding", "lossy"))}
  if cwd != "." {
    o.cwd = cwd
  }
  # The task's globs are relative to its directory; the tin takes them
  # relative to the pack root, which is the project root.
  stick globs = touches_of(t)
  if not globs.is_empty() {
    o.touches = globs.map(pack(x) => touch_under(cwd, x))
  }
  stick sealed = globs_of(t, "touches_sealed")
  if not sealed.is_empty() {
    o.touches_sealed = sealed.map(pack(x) => touch_under(cwd, x))
  }
  # The box (cig 1.6): the task runs over a copy-on-write layer on the
  # project, so a task that cannot start or is killed leaves nothing, and
  # one that ran has every change it made journaled with its before-bytes,
  # `touches` or not. Linux only; elsewhere cig would fall back to the tin
  # and say so at every task, so the default there is off.
  if boxed(t, defaults) {
    o.box = true
  }
  snuff o
}

# Does this task run in the box? Its own `box`, then `--box` or `--no-box`,
# then CIGO_BOX, then the manifest's `defaults.box`, then the platform.
pull boxed(t, defaults) {
  if t.has("box") {
    snuff t.box == true
  }
  if flags.contains("--no-box") {
    snuff false
  }
  if flags.contains("--box") {
    snuff true
  }
  stick e = env.get("CIGO_BOX", "")
  if e == "0" {
    snuff false
  }
  if e == "1" {
    snuff true
  }
  if defaults.has("box") {
    snuff defaults.box == true
  }
  snuff cig.os() == "linux"
}

# A touches glob under the task's directory; a leading `?` (may match
# nothing) stays in front.
pull touch_under(cwd, g) {
  stick optional = g.starts_with("?")
  stick bare = pick(optional, g.slice(1), g)
  stick joined = pick(cwd == "." or path.is_abs(bare), bare, path.join(cwd, bare))
  snuff pick(optional, "?" + joined, joined)
}

pull touches_of(t) {
  snuff globs_of(t, "touches")
}

pull globs_of(t, key) {
  if not t.has(key) {
    snuff []
  }
  snuff as_list(t[key]).map(pack(x) => str(x)).filter(pack(x) => x != "")
}

pull captured(kind, out, name) {
  if kind == "text" {
    snuff out.replace("\r\n", "\n").trim()
  }
  if kind == "lines" {
    snuff out.lines().filter(pack(l) => l.trim() != "")
  }
  if kind == "kv" {
    roll m = {}
    for line in out.lines() {
      stick c = text.captures(line.trim(), '^(?:export\s+)?([A-Za-z_][A-Za-z0-9_.-]*)\s*=\s*(.*)$')
      if c != null {
        m[c[1]] = c[2]
      }
    }
    snuff m
  }
  if kind == "json" {
    roll v = null
    try {
      v = json.parse(out)
    } ashtray e {
      cough {message: "task `${name}` captures json, and its stdout is not JSON: ${tidy(out)}", task: name, exit_code: 0}
    }
    snuff v
  }
  cough {message: "task `${name}`: capture must be one of ${CAPTURES.join(", ")}", task: name, exit_code: 0}
}

pull exposure(value, named) {
  if named.is_empty() {
    snuff value
  }
  if value == null {
    snuff named
  }
  snuff named.merge({value: value})
}

pull remember(name, value, named, raw) {
  RAW[name] = raw
  if value != null or not named.is_empty() {
    EXPOSED[name] = exposure(value, named)
  }
}

# Files matching a glob under `cwd`. (cig 1.1.1 matches nothing for a pattern
# that starts with `./`, and can list "" among the matches.)
pull glob_under(cwd, pattern) {
  # Built with a slash, not path.join: a glob is matched against
  # slash-separated candidates on every platform.
  stick p = pick(cwd == "." or cwd == "", pattern, cwd + "/" + pattern)
  snuff fs.glob(pick(p.starts_with("./"), p.slice(2), p)).filter(pack(x) => x != "").sort()
}

# What a task's last success depended on: the command as rendered (so a value
# from an earlier task that changed runs it again), its environment and stdin,
# and every input file's size and time. Inputs can be files, directories or
# globs (`src/**/*.ts`).
# The most files an inputs fingerprint reads before it gives up. Past it the
# task always runs, and says so; `inputs_limit` on the task or in `defaults`
# raises it.
stick INPUTS_LIMIT = 20000
# Set by `fingerprint` when its inputs covered more than the limit.
roll FINGERPRINT_OVER = false

# How many files the inputs name, counted up to `limit` + 1, without hashing.
pull inputs_count(cwd, inputs, limit) {
  roll count = 0
  pull walk(p) {
    if count > limit {
      snuff
    }
    if fs.is_dir(p) {
      for child in fs.list(p).sort() {
        if not FINGERPRINT_SKIP.contains(path.base(child)) {
          walk(child)
        }
      }
    } else if fs.is_file(p) {
      count += 1
    }
  }
  for i in inputs {
    stick pattern = str(i)
    if pattern.contains("*") or pattern.contains("?") or pattern.contains("[") {
      for m in glob_under(cwd, pattern) {
        walk(m)
      }
    } else {
      walk(path.join(cwd, pattern))
    }
  }
  snuff count
}

pull inputs_limit_of(t, defaults) {
  snuff int(t.get("inputs_limit", defaults.get("inputs_limit", INPUTS_LIMIT)))
}

pull fingerprint(cwd, inputs, salt, limit) {
  roll parts = [salt]
  roll count = 0
  FINGERPRINT_OVER = false
  pull walk(p, rel) {
    if count > limit {
      snuff
    }
    if fs.is_dir(p) {
      for child in fs.list(p).sort() {
        stick b = path.base(child)
        if not FINGERPRINT_SKIP.contains(b) {
          walk(child, rel + "/" + b)
        }
      }
    } else if fs.is_file(p) {
      count += 1
      parts.push("${rel}\t${fs.size(p)}\t${fs.modified_ms(p)}")
    } else {
      parts.push("${rel}\tabsent")
    }
  }
  for i in inputs {
    stick pattern = str(i)
    if pattern.contains("*") or pattern.contains("?") or pattern.contains("[") {
      stick matches = glob_under(cwd, pattern)
      if matches.is_empty() {
        parts.push("${pattern}\tno match")
      }
      for m in matches {
        walk(m, m)
      }
    } else {
      walk(path.join(cwd, pattern), pattern)
    }
  }
  if count > limit {
    FINGERPRINT_OVER = true
    snuff null
  }
  snuff hash.sha256(parts.join("\n"))
}

pull state_file(name) {
  snuff path.join(STATE, "state", slug(name) + ".json")
}

pull state_of(name) {
  stick f = state_file(name)
  if not fs.is_file(f) {
    snuff null
  }
  roll st = null
  try {
    st = json.load(f)
  } ashtray e {
    st = null
  }
  snuff st
}

# Is `p` (a path or a glob, like dist/*.whl) there after the task?
pull made(cwd, p) {
  if p.contains("*") or p.contains("?") or p.contains("[") {
    snuff not glob_under(cwd, p).is_empty()
  }
  snuff fs.exists(path.join(cwd, p))
}

pull produced(cwd, t) {
  snuff as_list(t.get("produces", [])).all(pack(p) => made(cwd, str(p)))
}

pull undo_of(t, where) {
  if t.has("undo_shell") {
    stick line = render_shell(str(t.undo_shell), where)
    snuff {shell: line, label: line}
  }
  if t.has("undo") {
    stick argv = render_argv(argv_of(t.undo) ?? [], where)
    if not argv.is_empty() {
      snuff {argv: argv, label: argv.map(quote).join(" ")}
    }
  }
  snuff null
}

# One attempt: the hop, its log, its output shown, its verdict. A command that
# cannot start, or runs out of time, is a failed attempt like any other.
pull attempt(name, t, cmd, opts, n) {
  stick started = time.now_ms()
  roll r = null
  # What a rehearsed hop's box returned: the layers it held back, what they
  # hold outside the footprint, the hosts it refused. An error's value
  # carries them too (a contained hop's layer is kept as evidence).
  roll held = []
  roll outside = []
  roll refused = []
  pull absorb(one) {
    if type_of(one) != "map" {
      snuff
    }
    if one.get("layer", null) != null {
      held.push(one.layer)
    }
    outside = outside + as_list(one.get("outside", []))
    for h in as_list(one.get("refused", [])) {
      if not refused.contains(h) {
        refused.push(h)
      }
    }
  }
  burn {
    if fs.exists(opts.env.CIG_OUTPUT) {
      fs.rm(opts.env.CIG_OUTPUT)
    }
    try {
      if cmd.has("shell") {
        r = proc.shell(cmd.shell, opts)
      } else if cmd.has("rm") {
        roll gone = []
        for p in cmd.rm {
          roll at = p
          if opts.has("cwd") {
            at = path.join(opts.cwd, p)
          }
          if fs.exists(at) {
            fs.rm(at)
            gone.push(p)
          }
        }
        r = {code: 0, out: pick(gone.is_empty(), "nothing to remove\n", "removed " + gone.join(" ") + "\n"), err: "", duration_ms: time.now_ms() - started, simulated: false}
      } else if cmd.has("argvs") {
        # Each command's output is kept in order; the first failure ends the run of them.
        roll out = ""
        roll err = ""
        roll code = 0
        if cmd.argvs.is_empty() {
          out = "nothing matched " + as_list(cmd.get("files", [])).join(" ") + "\n"
        }
        for argv in cmd.argvs {
          stick one = proc.run(argv.first(), argv.slice(1), opts)
          absorb(one)
          out = out + one.out
          err = err + one.err
          code = one.code
          if one.get("simulated", false) {
            r = one
          }
          if not ok_codes(t).contains(one.code) {
            err = err + "(" + argv.map(quote).join(" ") + " exited " + str(one.code) + ")\n"
            break
          }
        }
        if r == null {
          r = {code: code, out: out, err: err, duration_ms: time.now_ms() - started}
        }
      } else {
        r = proc.run(cmd.argv.first(), cmd.argv.slice(1), opts)
      }
      if cmd.has("shell") or cmd.has("argv") {
        absorb(r)
      }
    } ashtray e {
      absorb(e)
      roll said = e.message
      # E557: the output is not text in the encoding asked for.
      if e.message.contains(" is not valid ") and e.message.contains(" at byte ") {
        said = "the task's output is not valid ${opts.encoding} text; encoding: \"lossy\" replaces the bad bytes (" + e.message + ")"
      }
      r = {code: -1, out: "", err: said + "\n", duration_ms: time.now_ms() - started}
    }
    fs.append_text("${STATE}/logs/${slug(name)}.log",
      "== ${time.now_iso()} attempt ${n}: ${cmd.label}\n" + r.out + r.err +
      "== exit ${r.code} in ${r.duration_ms} ms\n\n")
  }
  stick simulated = r.get("simulated", false)
  if simulated {
    DRY = true
  }
  for line in r.out.trim_end().lines() {
    exhale "    " + line
  }
  for line in r.err.trim_end().lines() {
    exhale "    " + line
  }
  # A formatter's check prints the files it would change and exits 0:
  # with fail_on_output, printing anything is the failure.
  roll ok = ok_codes(t).contains(r.code)
  roll printed = false
  if ok and t.get("fail_on_output", false) and not simulated and r.out.trim() != "" {
    ok = false
    printed = true
    exhale "    (the task printed output, which it must not; the lines above are the reason)"
  }
  snuff {code: r.code, ok: ok, printed: printed, ok_codes: ok_codes(t), ms: time.now_ms() - started, out: r.out, err: r.err, simulated: simulated, held: held, outside: outside, refused: refused}
}

pull failure(name, cmd, result, n) {
  stick why = pick(result.get("printed", false), "printed output it must not", "exited ${result.code}" + pick(result.code == 0, " (not in ok: ${ok_text(result)})", ""))
  snuff {
    message: "task `${name}` failed: ${clip(cmd.label, 100)} " + why + pick(n > 1, " after ${n} attempts", ""),
    task: name,
    exit_code: result.code,
  }
}

pull ok_text(result) {
  snuff as_list(result.get("ok_codes", [])).join(", ")
}

pull run_task(ctx, name, index, total) {
  stick t = ctx.tasks[name]
  stick where = "task `${name}`"
  stick d = ctx.defaults
  stick cwd = render(str(t.get("cwd", ".")), where)
  stick more = pick(name == ctx.last, extra, [])
  roll cmd = null
  if t.has("shell") {
    roll line = render_shell(str(t.shell), where)
    for w in more {
      line = line + " " + quote(w)
    }
    cmd = {shell: line, label: line}
  } else if t.has("rm") {
    # A built-in removal: journaled by cig, so rollback and unburn put it back.
    stick paths = as_list(t.rm).map(pack(x) => render(str(x), where))
    cmd = {rm: paths, label: label_of(t)}
  } else if t.has("cmds") {
    # Several commands in a row, no shell between them; the first failure ends the task.
    stick argvs = as_list(t.cmds).map(pack(c) => render_argv(argv_of(c) ?? [], where))
    if argvs.is_empty() or argvs.any(pack(a) => a.is_empty()) {
      cough {message: "task `${name}` has an empty command in `cmds`; `cigo check` looks it over", task: name, exit_code: -1}
    }
    cmd = {argvs: argvs, label: label_of(t)}
  } else {
    stick argv = render_argv(argv_of(t.get("cmd", null)) ?? [], where) + more
    if argv.is_empty() {
      cough {message: "task `${name}` has nothing to run; `cigo check` looks it over", task: name, exit_code: -1}
    }
    if t.has("each") {
      # One command per file the globs name, {file} standing for each:
      # `each: ["**/*.cig"]`, or `each: {files: [...], skip: ["fixtures"]}`.
      stick spec_each = t.each
      # Not pick(): both arms would run, and a list has no `get("files")`.
      roll globs = []
      roll skip = []
      if type_of(spec_each) == "map" {
        globs = as_list(spec_each.get("files", []))
        skip = as_list(spec_each.get("skip", []))
      } else {
        globs = as_list(spec_each)
      }
      roll files = []
      for g in globs {
        for hit in glob_under(cwd, str(g)) {
          stick rel = pick(cwd == "." or cwd == "", hit, hit.slice(cwd.len() + 1))
          if not files.contains(rel) and not rel.replace("\\", "/").split("/").any(pack(part) => skip.contains(part)) {
            files.push(rel)
          }
        }
      }
      stick argvs = files.map(pack(f) => argv.map(pack(w) => w.replace("{file}", f)))
      cmd = {argvs: argvs, label: label_of(t), files: files}
    } else {
      cmd = {argv: argv, label: argv.map(quote).join(" ")}
    }
  }
  stick opts = hop_options(name, t, cwd, d, where)
  stick rehearsal = REHEARSE.get(name, null)
  if rehearsal != null {
    opts.box = rehearsal_box(rehearsal.fp, cwd, opts.env)
  }
  if t.has("stdin_from") {
    opts.stdin = RAW.get(str(t.stdin_from), "")
  } else if t.has("stdin") {
    opts.stdin = render(str(t.stdin), where)
  }
  # On the pinned version, through the manager: words before the command,
  # or variables the tool's own shims and proxies read. The command as the
  # task wrote it stays on the line; the version note follows it.
  roll on_versions = []
  for sw in SWITCHES.get(t.get("component", ""), []) {
    for k in sw.how.env {
      opts.env[k] = sw.how.env[k]
    }
    if not sw.how.wrap.is_empty() {
      if cmd.has("argv") {
        cmd.plain = cmd.argv
        cmd.argv = sw.how.wrap + cmd.argv
      } else if cmd.has("argvs") {
        cmd.argvs = cmd.argvs.map(pack(a) => sw.how.wrap + a)
      } else if cmd.has("shell") {
        cmd = {argv: sw.how.wrap + shell_words(cmd.shell), label: cmd.label, plain: shell_words(cmd.shell)}
      }
    }
    on_versions.push("${sw.var} ${sw.version} via ${sw.how.manager} (${sw.source})")
  }
  exhale "[${index}/${total}] ${name}: ${cmd.label}" + pick(cwd == ".", "", "   (in ${cwd})") + pick(on_versions.is_empty(), "", "   on ${on_versions.join(", ")}")
  if rehearsal != null {
    exhale "    rehearsed in the box: its writes judged against its footprint, its network the registries it names"
  }
  # Up to date: its inputs are as they were after its last success, and what
  # it produces is still there.
  roll before = null
  stick salt = json.stringify({cmd: cmd.label, env: opts.env, stdin: opts.get("stdin", null)})
  stick limit = inputs_limit_of(t, d)
  if t.has("inputs") {
    before = fingerprint(cwd, as_list(t.inputs), salt, limit)
    if FINGERPRINT_OVER {
      exhale "    inputs cover more than ${limit} files, so this task always runs; narrow `inputs` (\"assets/**/*.png\") or raise `inputs_limit`"
    }
    stick st = state_of(name)
    if not FORCE and before != null and st != null and st.get("fingerprint", "") == before and produced(cwd, t) {
      remember(name, st.get("value", null), st.get("named", {}), st.get("raw", ""))
      exhale "    up to date; `--force` runs it anyway"
      snuff {task: name, exit_code: 0, ms: 0, attempts: 0, skipped: true, simulated: false}
    }
  }
  stick tries = int(t.get("retries", d.get("retries", 0))) + 1
  stick delay = int(t.get("retry_delay_ms", d.get("retry_delay_ms", 0)))
  roll result = null
  roll n = 0
  pull attempts() {
    while n < tries and (result == null or not result.ok) {
      n += 1
      if n > 1 and delay > 0 {
        time.sleep_ms(delay)
      }
      result = attempt(name, t, cmd, opts, n)
      if not result.ok and n < tries {
        # A failed rehearsed attempt's layers go before the next attempt.
        if rehearsal != null and not result.get("held", []).is_empty() {
          burn {
            for layer in result.held {
              proc.discard_layer(layer)
            }
          }
        }
        exhale "    exit ${result.code}; trying again (${n + 1} of ${tries})"
      }
    }
    if rehearsal != null and not result.get("simulated", false) {
      settle_rehearsal(name, t, result, rehearsal)
    }
  }
  stick undo = undo_of(t, where)
  # A task that runs another CigScript file (`cig run …`, how the `scripts`
  # toolchain adopts a .cig file) is a second cig run with a journal of its
  # own, which this run's rollback cannot reach. Its run id, printed on the
  # hop's "burned … run <id>" line, gives this run the compensation instead:
  # `cig unburn <id>` at this task's place in the newest-first order, so the
  # inner burns are undone by the inner run and hop watching has nothing left
  # to remove for it.
  stick plain_argv = cmd.get("plain", cmd.get("argv", []))
  stick nested_cig = undo == null and cmd.has("argv") and not plain_argv.is_empty() and path.stem(plain_argv.first()).lower() == "cig" and plain_argv.get(1, "") == "run"
  if undo == null and not nested_cig {
    attempts()
    if not result.ok {
      cough failure(name, cmd, result, n)
    }
  } else {
    # The undo is journaled as a compensation once the task succeeds: a later
    # failure in this run, or `cig unburn` weeks from now, runs it with this
    # state. A task that failed has nothing to undo, so none is recorded.
    burn (s, name) {
      s.task = name
      s.undo = undo
      s.cwd = cwd
      s.env = opts.env
      s.timeout_ms = opts.timeout_ms
      attempts()
      if not result.ok {
        cough failure(name, cmd, result, n)
      }
      if nested_cig and not result.simulated {
        # the inner cig prints its run summary on stderr
        stick found = text.captures(result.out + "\n" + result.get("err", ""), "burned [^\\n]*, run ([0-9A-Za-z-]+)")
        if found != null {
          s.undo = {argv: ["cig", "unburn", found[1]], label: "cig unburn " + found[1]}
          exhale "    a cig run of its own (" + found[1] + "); undone through `cig unburn` at this task's place"
        }
      }
    } unburn {
      if s.undo == null {
        log.warn("undoing ${s.task}: the inner cig run printed no run id, so there is nothing to undo through")
        snuff null
      }
      log.warn("undoing ${s.task}: ${s.undo.label}")
      stick how = {cwd: s.cwd, env: s.env, timeout_ms: s.timeout_ms}
      roll done = null
      if s.undo.has("shell") {
        done = proc.shell(s.undo.shell, how)
      } else {
        done = proc.run(s.undo.argv.first(), s.undo.argv.slice(1), how)
      }
      for line in (done.out + done.err).trim_end().lines() {
        exhale "    " + line
      }
      if done.code != 0 {
        # Named for the task, not for a line of this file: what is still out
        # there is the task's work, and the retry is `cig unburn <run>`. (A
        # compensation sees its state, modules and builtins only, so no
        # helper of this file is called here.)
        stick tail = done.err.trim_end().lines().last() ?? ""
        roll said = "the undo `${s.undo.label}` exited ${done.code}"
        if tail != "" {
          said = said + "; stderr: `${tail}`"
        }
        cough said + "; fix the undo, then `cig unburn <run>` runs it again"
      }
    }
  }
  # What it made, and what it said.
  if not result.simulated {
    stick missing = as_list(t.get("produces", [])).map(pack(p) => str(p)).filter(pack(p) => not made(cwd, p))
    if not missing.is_empty() {
      cough {message: "task `${name}` exited ${result.code} but did not produce ${missing.join(", ")}", task: name, exit_code: result.code}
    }
  }
  roll value = null
  if t.has("capture") and not result.simulated {
    value = captured(str(t.capture), result.out, name)
  }
  stick named = pick(result.simulated, {}, read_named(opts.env.CIG_OUTPUT))
  remember(name, value, named, result.out)
  roll after = null
  if before != null and not result.simulated {
    after = fingerprint(cwd, as_list(t.inputs), salt, limit)
  }
  if EXPOSED.has(name) or after != null {
    burn {
      json.save(OUTPUTS_FILE, EXPOSED, 2)
      if after != null {
        json.save(state_file(name), {fingerprint: after, value: value, named: named, raw: pick(result.out.len() <= 1000000, result.out, "")}, 2)
      }
    }
  }
  roll said = ""
  if EXPOSED.has(name) {
    said = "; output: " + tidy(to_text(EXPOSED[name])).slice(0, 60)
  }
  exhale "    ok, ${duration(result.ms)}" + pick(n > 1, " (attempt ${n})", "") + said
  snuff {task: name, exit_code: result.code, ms: result.ms, attempts: n, skipped: false, simulated: result.simulated, versions: on_versions}
}

pull do_run(g, wanted) {
  expect_flags(["--only", "--force", "--strict", "--versions", "--install", "--box", "--no-box", "--accept-risk", "--run-untrusted", "--light-it", "--no-guard", "--plain"])
  if wanted.is_empty() {
    fail("run what? `cigo run <task>`, or one stage everywhere: `cigo run test`; `cigo list` shows them")
  }
  FORCE = flags.contains("--force")
  stick tasks = g.tasks
  ONLY = flags.contains("--only")
  stick order = resolve_or_fail(tasks, wanted, ONLY)
  stick names = runnable(tasks, order)
  for n in names {
    if tasks[n].get("bad", false) {
      fail("task `${n}` is not a map; `cigo check` says what is wrong with it")
    }
  }
  if names.is_empty() {
    exhale "nothing to run: no component here has ${wanted.join(", ")}"
    snuff
  }
  stick last = wanted.last()
  if not extra.is_empty() and tasks[last].get("group", false) {
    fail("arguments after `--` go to one task, and `${last}` is a group; name one of ${tasks[last].needs.join(", ")}")
  }
  for n in names {
    if tasks[n].has("unresolved") {
      fail("task `${n}` cannot run: ${tasks[n].unresolved}; `cigo check` lists every problem")
    }
  }
  # A value pasted into a shell line unquoted is shell code: said before the
  # run starts, as `cigo check` says it; with --strict, or under CI (where
  # values come from PR titles and commit messages), the run stops instead.
  roll unquoted = []
  for n in names {
    for u in unquoted_shell_templates(tasks[n]) {
      unquoted.push("${n}: " + unquoted_advice(u))
    }
  }
  if not unquoted.is_empty() {
    for line in unquoted {
      log.warn(line)
    }
    if flags.contains("--strict") {
      fail("${unquoted.len()} value" + pick(unquoted.len() == 1, "", "s") + " reach a shell line unquoted and --strict given; nothing ran")
    }
    if env.get("CI", "") != "" {
      fail("${unquoted.len()} value" + pick(unquoted.len() == 1, "", "s") + " reach a shell line unquoted and CI is set, so nothing ran; write {{name|sh}}, or pass the value through `env`")
    }
  }
  # The guard: what each task is about to run, read before anything runs.
  guard_run(tasks, names, g.manifest.get("defaults", {}))
  # Versions: where the project's pins and this machine disagree, switch
  # through a manager when the answer is yes, and warn about the rest.
  stick comps = components_of(tasks, names)
  stick setting = versions_setting(g)
  roll switched = []
  if setting != "off" {
    stick found = disagreements(g, comps)
    stick answer = versions_answer(g, found, setting)
    if answer == "switch" {
      switched = apply_switches(found)
    }
    warn_versions_except(g, comps, flags.contains("--strict"), true, switched)
  }
  stick ctx = {tasks: tasks, defaults: g.manifest.get("defaults", {}), last: last}
  burn {
    fs.mkdir(RUN_DIR)
    json.save(OUTPUTS_FILE, {}, 2)
  }
  exhale "${PROJECT_NAME}: ${names.join(" > ")}"
  stick started = time.now_ms()
  stick steps = names.enumerate().map(pack(pair) => pack() => run_task(ctx, pair[1], pair[0] + 1, names.len()))
  roll report = null
  roll failed = null
  try {
    report = light(steps, {names: names, quiet: true})
  } ashtray e {
    failed = e
  }
  if failed != null {
    stick cause = failed.get("cause", {})
    exhale ""
    exhale "stopped at ${failed.get("step", "a task")}; cig puts back what this run changed, newest first"
    # Coughing is what makes cig roll the run back, and its report quotes this
    # line, so the line says what happened.
    stick the_run_failed = {message: cause.get("message", failed.message), task: cause.get("task", failed.get("step", ""))}
    cough the_run_failed
  }
  stick results = report.steps.map(pack(step) => step.result)
  stick skipped = results.filter(pack(r) => r.skipped).len()
  burn {
    json.save("${STATE}/reports/${time.stamp()}.json", {
      project: PROJECT_NAME, targets: wanted, order: names, ok: true,
      ms: time.now_ms() - started, tasks: results, outputs: EXPOSED, finished: time.now_iso(),
    }, 2)
  }
  exhale ""
  if DRY {
    exhale "dry run: ${names.len()} task" + pick(names.len() == 1, "", "s") + " planned, none executed; the plan follows"
  } else {
    exhale "done: ${names.len()} task" + pick(names.len() == 1, "", "s") + pick(skipped > 0, " (${skipped} up to date)", "") + " in ${duration(time.now_ms() - started)}. Output is in ${STATE}/logs; `cig unburn <run>` undoes all of it."
  }
}

# ----- adopt: find every language in the project -----------------------------------

stick INFRA_FAMILIES = ["container", "compose", "helm", "terraform"]
stick SHELL_CHARS = ["|", "&", ";", ">", "<", "$", "`", "*", "?", "'", "\"", "~"]

pull discover(kb, depth_limit) {
  roll comps = {}
  roll notes = []
  pull add(name, spec) {
    roll n = name
    roll i = 2
    while comps.has(n) {
      n = "${name}-${i}"
      i += 1
    }
    comps[n] = spec
    snuff n
  }
  pull visit(dir, depth, inherited) {
    stick found = detect_here(dir, kb)
    roll ws = inherited.copy()
    roll natives = []
    roll runners = []
    roll claimed = null
    for id in found {
      stick tc = kb[id]
      stick fam = tc.get("family", id)
      if inherited.has(fam) {
        continue
      }
      if tc.get("kind", "native") == "runner" {
        # A script folder's scripts belong to the directory above it.
        if tc.get("targets", "") == "scripts" and (targets_of(dir, "scripts").is_empty() or SCRIPT_DIRS.contains(path.base(dir))) {
          continue
        }
        runners.push(id)
      } else {
        natives.push(id)
        if tc.get("claims_subtree", false) {
          claimed = id
        }
      }
      if holds(dir, as_list(tc.get("workspace", []))) {
        ws[fam] = dir
      }
    }
    # A folder of scripts is the project's (at the root) or a language's (beside
    # its manifest); elsewhere it is somebody's tooling, not a component.
    if dir != "." and natives.is_empty() {
      runners = runners.filter(pack(id) => kb[id].get("targets", "") != "scripts")
    }
    # Languages first, then images, charts and infrastructure.
    stick ordered = natives.filter(pack(id) => not INFRA_FAMILIES.contains(kb[id].get("family", ""))) + natives.filter(pack(id) => INFRA_FAMILIES.contains(kb[id].get("family", "")))
    stick base = slug(pick(dir == ".", PROJECT_NAME, path.base(dir)))
    for pair in ordered.enumerate() {
      stick short = kb[pair[1]].get("short", pair[1])
      add(pick(dir == ".", short, pick(pair[0] == 0, base, base + "-" + short)), {path: dir, toolchain: pair[1]})
    }
    # Only one runner per directory joins the stage groups, so a build that a
    # Makefile and a justfile both define does not run twice.
    roll grouped = null
    for id in runners {
      stick short = kb[id].get("short", id)
      roll spec = {path: dir, toolchain: id}
      if not natives.is_empty() or grouped != null {
        spec.groups = false
      }
      stick label = add(pick(dir == ".", short, base + "-" + short), spec)
      if not natives.is_empty() {
        notes.push({about: [label], text: "${label}: its targets are tasks (${label}:<target>), kept out of the stage groups because ${kb[ordered.first()].get("short", "")} commands already cover ${pick(dir == ".", "the project root", dir)}; set \"groups\": true to use them instead"})
      } else if grouped != null {
        notes.push({about: [label], text: "${label}: its targets are tasks (${label}:<target>), kept out of the stage groups because ${grouped} already runs the stages in ${pick(dir == ".", "the project root", dir)}; set \"groups\": true to run both"})
      } else {
        grouped = label
      }
    }
    if claimed != null {
      notes.push({about: [], text: "${pick(dir == ".", "the project", dir)} is built by ${kb[claimed].get("short", claimed)}; nothing below it was looked at"})
      snuff
    }
    if depth < depth_limit {
      for child in entries_of(dir).sort() {
        stick p = pick(dir == ".", child, dir + "/" + child)
        if not child.starts_with(".") and not WALK_SKIP.contains(child) and not (not natives.is_empty() and TEST_DIRS.contains(child)) and fs.is_dir(p) {
          visit(p, depth + 1, ws)
        }
      }
    }
  }
  visit(".", 0, {})
  # A task runner at the root of a project with components below it usually
  # chains them: the stage groups do that now, so its targets stay out of them.
  stick deeper = comps.values().any(pack(c) => c.path != ".")
  roll at_root = []
  if deeper {
    for name in comps {
      stick c = comps[name]
      if c.path == "." and kb[c.toolchain].get("kind", "native") == "runner" {
        c.groups = false
        at_root.push(name)
      }
    }
  }
  if at_root.is_empty() {
    snuff {components: comps, notes: notes}
  }
  # One reason covers them all, so it replaces what was said about each.
  roll kept = notes.filter(pack(n) => not n.about.any(pack(k) => at_root.contains(k)))
  kept.push({about: at_root, text: "${at_root.join(", ")}: at the root of a project with components below it, these usually chain the others, which the stage groups now do; their targets stay available as <name>:<target>"})
  snuff {components: comps, notes: kept}
}

pull soft_manifest() {
  roll m = {}
  if fs.is_file(MANIFEST) {
    try {
      m = json.parse(unbom(fs.read_text(MANIFEST)))
    } ashtray e {
      m = {}
    }
  }
  snuff pick(type_of(m) == "map", m, {})
}

# Does the toolchain a manifest names still fit `dir` at least as well as the
# one adopt would choose now? A project that moved from npm to pnpm, or from
# pip to uv, no longer does; a toolchain of the project's own always does.
pull fits_as_well(kb, old_id, new_id, dir) {
  stick old = kb.get(old_id, {})
  snuff holds_all(dir, as_list(old.get("detect", []))) and old.get("priority", 10) >= kb.get(new_id, {}).get("priority", 10)
}

# Adopting again finds the project again and keeps what the manifest already
# says: a component found again (same directory, same kind of toolchain) keeps
# its name and settings, and one written by hand stays while its directory does.
# The same place, written two ways: `services\\api` is `services/api`, and
# on a case-insensitive filesystem `Services/API` is too.
pull same_path(a, b) {
  pull tidy_path(p) {
    roll q = str(p).replace("\\", "/")
    while q.starts_with("./") {
      q = q.slice(2)
    }
    while q.len() > 1 and q.ends_with("/") {
      q = q.slice(0, q.len() - 1)
    }
    if q == "" {
      q = "."
    }
    snuff pick(cig.os() == "linux", q, q.lower())
  }
  snuff tidy_path(a) == tidy_path(b)
}

pull merge_components(found, before, kb) {
  pull family_of(id) {
    snuff pick(kb.has(id), kb.get(id, {}).get("family", id), id)
  }
  roll out = {}
  roll used = []
  roll matched = []
  roll notes = []
  for name in found {
    stick c = found[name]
    roll hit = null
    for oldname in before {
      stick was = before[oldname]
      if not used.contains(oldname) and type_of(was) == "map" and same_path(str(was.get("path", ".")), c.path) and family_of(str(was.get("toolchain", ""))) == family_of(c.toolchain) {
        hit = oldname
        break
      }
    }
    if hit != null {
      used.push(hit)
      matched.push(name)
      stick was = before[hit]
      stick old_id = str(was.get("toolchain", ""))
      if old_id != c.toolchain and TOOLCHAINS.has(old_id) and not fits_as_well(kb, old_id, c.toolchain, c.path) {
        out[hit] = was.merge({toolchain: c.toolchain})
        notes.push({about: [], text: "${hit}: ${old_id} no longer fits ${c.path}, so it is ${c.toolchain} now; if ${old_id} was on purpose, set it back in ${MANIFEST}"})
      } else {
        out[hit] = was
      }
    } else {
      roll n = name
      roll i = 2
      while out.has(n) or before.has(n) {
        n = "${name}-${i}"
        i += 1
      }
      out[n] = c
      if not before.is_empty() {
        notes.push({about: [], text: "${n}: new since the manifest was written"})
      }
    }
  }
  for oldname in before {
    stick was = before[oldname]
    if used.contains(oldname) or type_of(was) != "map" {
      continue
    }
    if fs.is_dir(str(was.get("path", "."))) {
      out[oldname] = was
      notes.push({about: [], text: "${oldname}: kept as the manifest has it; adopt would not have found it"})
    } else {
      notes.push({about: [], text: "${oldname}: dropped, because ${was.get("path", ".")} is no longer a directory"})
    }
  }
  snuff {components: out, matched: matched, notes: notes}
}

pull do_adopt() {
  expect_flags(["--write", "--force", "--depth"])
  expect_no_targets()
  stick depth = int(flag_value("--depth", "3"))
  stick old = soft_manifest()
  stick kb = toolchains_for(old)
  stick found = discover(kb, depth)
  stick before = old.get("components", {})
  stick merged = merge_components(found.components, pick(type_of(before) == "map", before, {}), kb)
  stick comps = merged.components
  # Advice about components the manifest already describes is not repeated.
  stick notes = (found.notes.filter(pack(n) => n.about.is_empty() or not n.about.all(pack(k) => merged.matched.contains(k))) + merged.notes).map(pack(n) => n.text)
  roll manifest = {project: PROJECT_NAME, components: comps}
  for key in ["defaults", "toolchains", "tasks"] {
    if old.has(key) {
      manifest[key] = old[key]
    }
  }
  stick body = json.stringify(manifest, 2) + "\n"
  if comps.is_empty() {
    log.warn("found no toolchain, task runner or script folder here; ${MANIFEST} can still be written by hand (the README has the format)")
  } else {
    stick width = comps.keys().map(pack(k) => k.len()).max()
    log.info("found ${comps.len()} component" + pick(comps.len() == 1, "", "s") + ":")
    for name in comps {
      stick r = resolve_component(name, comps[name], kb)
      stick stages = STAGES.filter(pack(s) => r.stages.has(s))
      log.info("  ${name.pad_right(width)}  ${str(comps[name].toolchain).pad_right(14)}  ${comps[name].path.pad_right(16)}  ${pick(stages.is_empty(), "no stages", stages.join(" "))}" + pick(r.extras.is_empty(), "", " +${r.extras.len()} more"))
    }
  }
  for note in notes {
    log.info(note)
  }
  if not flags.contains("--write") {
    exhale body.trim_end()
    log.info("`cigo adopt --write` saves this as ${MANIFEST}; then `cigo check`, and `after` puts components in order")
    snuff
  }
  if fs.exists(MANIFEST) and not flags.contains("--force") {
    fail("${MANIFEST} already exists; `cigo adopt` prints what it would write, and `--force` writes it: components found again keep their names and settings, and its tasks, toolchains and defaults are kept")
  }
  burn {
    fs.write_text(MANIFEST, body)
  }
  exhale "wrote ${MANIFEST}: ${comps.len()} component" + pick(comps.len() == 1, "", "s")
  exhale "next: `cigo check`, `cigo list`, then `cigo run ci` or any stage everywhere"
  exhale "logs, reports and outputs go in ${STATE}/; add it to .gitignore"
}

# ----- looking at the graph ------------------------------------------------------------

pull do_help() {
  exhale "cig-orchestrator ${VERSION}: every language in the project, one chain, no glue script."
  exhale ""
  exhale "  cigo adopt [--write] [--force] [--depth=N]"
  exhale "                              find every language, task runner and script folder here;"
  exhale "                              propose ${MANIFEST}"
  exhale "  cigo list [--all]           components, stage groups and tasks"
  exhale "  cigo run <task>... [--only] [--force] [--strict] [--box|--no-box] [--versions=ask|always|never|off] [-- <args for the last task named>]"
  exhale "                              `cigo run test` tests every language, `cigo run ci` does"
  exhale "                              format-check, lint, check, build and test everywhere"
  exhale "  cigo plan [<task>...] [--only]"
  exhale "                              the order a run would take"
  exhale "  cigo show <task>            where a task comes from and everything it will do"
  exhale "  cigo audit [<task>...] [--json|--sarif|--markdown] [--offline]"
  exhale "                              what the guard reads before a task runs: install hooks, findings, and"
  exhale "                              the lockfiles' packages against OSV (name@version alone is sent)"
  exhale "  cigo audit --update-db [<ecosystem>...]"
  exhale "                              build the offline OSV database (npm, PyPI, crates.io, Go, RubyGems, Packagist, Maven, NuGet)"
  exhale "  cigo rehearse <npm:name[@version]|pypi:name[==version]|crates:name[@version]|./script.sh> [--json] [--keep]"
  exhale "                              install it in cig's contained box (Linux) and say what it did beyond its footprint"
  exhale "  cigo rehearse --changed [--base=<rev>] [--list] [--max=N] [--jobs=N] [--isolation=<level>] [--fresh] [--json|--sarif|--markdown]"
  exhale "                              every package the lockfiles add or change since the default branch, rehearsed"
  exhale "  cigo rehearse               in a project, with nothing named: the manifest's direct dependencies"
  exhale "  cigo blacklist [list | add <thing> [--reason=...] [--expires=90d] | remove <entry> | why <thing> | reload]"
  exhale "  cigo blacklist [allow <entry> --reason=... | unallow <entry> | allows]"
  exhale "                              overrides of a blacklist entry for this user (OS-authenticated)"
  exhale "  cigo blacklist [export <file> | import <file> | exceptions]"
  exhale "                              your entries and allows as one signed file; the one-off runs in force"
  exhale "  cigo quarantine [list | show <sha256> | clear [--all]]   what run-url downloaded, kept to read again"
  exhale "                              your own blacklist: packages, files, domains, ranges and URLs the guard refuses"
  exhale "  cigo guard [setup | scope <1-5> [--yes] | preset <name> | pause [30m] | off | on | allow <program> | log | stats [--since=30d] | cache [stats | clear] | uninstall [--yes]]"
  exhale "                              how much of this machine the guard covers: level 2 puts every package"
  exhale "                              manager behind it (npm install, pip install, cargo build, npx...) anywhere"
  exhale "  cigo undo last              undo the newest guarded call (cig unburn)"
  exhale "  cigo agent [run -- <command> | log | undo --session=<id>|--since=2h [--yes]]"
  exhale "                              what your AI agents run: boxed, read first, a person approves the risky ones"
  exhale "  cigo scrub show <id>        what was scrubbed from an agent's output under that id (kept locally; not for an agent's terminal)"
  exhale "  cigo approve <id>           approve one agent command rated high (outside the agent's session)"
  exhale "  cigo run-url <url> [--trust] [-- <args>]"
  exhale "                              the safe way to curl | sh: downloaded, read, rehearsed in the box, then run"
  exhale "  cigo trust [<task>|list|show <task>|revoke <task>|revoke --all]"
  exhale "                              approve a task as it is now (signed with the tin's key), or see and drop approvals"
  exhale "  cigo check [--strict]       the manifest, checked before anything runs"
  exhale "  cigo doctor                 ciginstaller doctor --tools: each tool's findings, cigo's toolchains and pins included"
  exhale "  cigo versions [switch|keep|install [--yes]]"
  exhale "                              each language's pin against this machine, and whether tasks run on"
  exhale "                              the pinned version through mise, asdf, rustup, uv, fnm... (never your default)"
  exhale "  cigo outputs [<task>...]    what the last run's tasks handed on"
  exhale "  cigo toolchains [<name>] [--markdown]"
  exhale "                              the toolchains this knows"
  exhale "  cigo version [--json]       this cigo and the cig it runs on"
  exhale "  cigo update [--check]       ciginstaller update: the installer checks, verifies and installs the new carton"
  exhale "  cigo uninstall [--yes]      ciginstaller uninstall cigo"
  exhale "  cigo crash [list|show|send|delete <id>]"
  exhale "                              ciginstaller crash: the ashtray's reports, from every tool; cigo's own crashes join it through cig"
  exhale "  cigo report [<run>] [--send]"
  exhale "                              ciginstaller bug --run <run> --part cigo (no run: ciginstaller bug cigo): write up a bug, see what is sent first"
  exhale "  cigo config [<key> [<value>|--unset]]"
  exhale "                              every setting through its layers (cigo config explain <key>)"
  exhale "  cigo digest [--clear|--json]"
  exhale "                              ask-tier questions the prompt budget shunted aside, each with its safe default answered"
  exhale "  cigo self [where | verify | build]"
  exhale "                              cigo's signed record of its own install (sensitive parts sealed); build writes it, verify checks it. Restore ships with W25; meanwhile, ciginstaller repair reinstalls cigo from the carton"
  exhale ""
  exhale "Every command that opens a project says where versions disagree: the installed cig against"
  exhale "the project's pins (.cig-version, the manifest's `cig`, a script's `# cig` header) and each"
  exhale "toolchain against its pins (.nvmrc, go.mod...). `--strict` on check and run stops on one; `cigo versions`"
  exhale "runs tasks on the pinned versions through a version manager already here, per task, never your default."
  exhale "Stages: ${STAGES.join(", ")}."
  exhale "cig's own flags go before the command: `cigo --dry-run run ci`, `cigo --no-rollback run build`."
  exhale "Afterwards: `cig runs` lists every run, `cig unburn <run>` undoes one."
}

# Tasks as a person reads them: each component's in stage order with its other
# targets after, components in manifest order, then the manifest's own tasks.
pull list_order(tasks, comps, names) {
  stick comp_names = comps.keys()
  roll keyed = []
  for pair in names.enumerate() {
    stick name = pair[1]
    stick t = tasks[name]
    stick ci = comp_names.index_of(str(t.get("component", name.split(":").first())))
    stick si = STAGES.index_of(str(t.get("stage", name.split(":").last())))
    stick c_rank = pick(ci < 0, comp_names.len(), ci)
    stick s_rank = pick(si < 0 or t.get("extra", false), STAGES.len(), si)
    keyed.push([c_rank * 1000000000 + s_rank * 1000000 + pair[0], name])
  }
  snuff keyed.sort_by(pack(k) => k[0]).map(pack(k) => k[1])
}

# One line per task in a listing; `cigo show <task>` prints the whole command.
pull clip(line, n) {
  if line.len() <= n {
    snuff line
  }
  snuff line.slice(0, n - 3) + "..."
}

pull do_list(g) {
  expect_flags(["--all"])
  expect_no_targets()
  warn_versions(g, g.components.keys(), false, false)
  stick all = flags.contains("--all")
  stick tasks = g.tasks
  stick comps = g.components
  stick shown = list_order(tasks, comps, tasks.keys().filter(pack(n) => not tasks[n].get("group", false) or tasks[n].origin == MANIFEST).filter(pack(n) => all or not tasks[n].get("extra", false)))
  stick hidden = tasks.keys().filter(pack(n) => tasks[n].get("extra", false)).len()
  if comps.is_empty() {
    exhale "${PROJECT_NAME}: ${shown.len()} task" + pick(shown.len() == 1, "", "s") + " in ${MANIFEST}"
  } else {
    stick runnable_count = tasks.keys().filter(pack(n) => not tasks[n].get("group", false)).len()
    exhale "${PROJECT_NAME}: ${comps.len()} component" + pick(comps.len() == 1, "", "s") + ", ${runnable_count} tasks in ${MANIFEST}"
    exhale ""
    exhale "components"
    stick cw = comps.keys().map(pack(k) => k.len()).max()
    for name in comps {
      stick r = comps[name]
      roll line = "  ${name.pad_right(cw)}  ${str(r.toolchain).pad_right(14)}  ${r.dir}"
      stick after = as_list(r.spec.get("after", []))
      if not after.is_empty() {
        line = line + "   after ${after.join(", ")}"
      }
      if r.spec.get("groups", true) == false {
        line = line + "   (not in the stage groups)"
      }
      if r.has("error") {
        line = line + "   " + r.error
      }
      exhale line
      if r.spec.get("desc", "") != "" {
        exhale "  ${" ".repeat(cw)}  # ${r.spec.desc}"
      }
    }
    exhale ""
    exhale "stage groups: `cigo run <stage>` runs it in every component"
    for stage in GROUP_STAGES + ["ci"] {
      if tasks.has(stage) and tasks[stage].get("group", false) and tasks[stage].origin != MANIFEST {
        stick who = pick(stage == "ci", tasks[stage].needs, tasks[stage].needs.map(pack(n) => n.split(":").first()))
        exhale "  ${stage.pad_right(12)}  ${who.join(", ")}"
      }
    }
    exhale ""
    exhale "tasks"
  }
  if shown.is_empty() {
    exhale "  (none)"
    snuff
  }
  stick width = shown.map(pack(x) => x.len()).max()
  for name in shown {
    stick t = tasks[name]
    if t.get("bad", false) {
      exhale "  ${name.pad_right(width)}  (not a task; `cigo check` says why)"
      continue
    }
    roll line = "  ${name.pad_right(width)}  ${clip(label_of(t), 72)}"
    if t.get("cwd", ".") != "." {
      line = line + "   (in ${t.cwd})"
    }
    if t.origin == MANIFEST {
      stick needs = needs_of(t)
      if not needs.is_empty() and not t.get("group", false) {
        line = line + "   needs ${needs.join(", ")}"
      }
    }
    if t.has("undo") or t.has("undo_shell") {
      line = line + "  [undo]"
    }
    if t.has("retries") {
      line = line + "  [retries ${t.retries}]"
    }
    if t.has("capture") {
      line = line + "  [captures ${t.capture}]"
    }
    exhale line
    if t.has("desc") and t.desc != "" {
      exhale "  ${" ".repeat(width)}  # ${t.desc}"
    }
  }
  if not all and hidden > 0 {
    exhale "  ... and ${hidden} more from scripts and task runners; `cigo list --all` shows them"
  }
}

pull do_show(g) {
  expect_flags([])
  if targets.len() != 1 {
    fail("show which task? `cigo show <task>`")
  }
  warn_versions(g, g.components.keys(), false, false)
  stick name = targets.first()
  stick tasks = g.tasks
  if not tasks.has(name) {
    fail("no task named `${name}`; ${known(tasks, name)}")
  }
  stick t = tasks[name]
  exhale name
  exhale "  from       ${t.get("origin", "")}"
  if t.has("desc") and t.desc != "" {
    exhale "  about      ${t.desc}"
  }
  if t.get("group", false) {
    exhale "  runs       every one of: ${t.needs.join(", ")}"
    snuff
  }
  exhale "  runs       ${label_of(t)}"
  exhale "  in         ${t.get("cwd", ".")}"
  stick uses = refs_of(t, tasks)
  stick needs = t.get("needs", [])
  exhale "  needs      ${pick(needs.is_empty(), "nothing", needs.join(", "))}"
  if not uses.is_empty() {
    exhale "  uses       the output of ${uses.join(", ")}"
  }
  for key in ["capture", "stdin", "stdin_from", "inputs", "produces", "ok", "timeout_ms", "retries", "retry_delay_ms"] {
    if t.has(key) {
      exhale "  ${key.pad_right(10)} ${to_text(t[key])}"
    }
  }
  if t.has("inputs") {
    stick limit = inputs_limit_of(t, g.manifest.get("defaults", {}))
    if inputs_count(str(t.get("cwd", ".")), as_list(t.inputs), limit) > limit {
      exhale "             over ${limit} files, so the task always runs; narrow `inputs` or raise `inputs_limit`"
    }
  }
  stick globs = touches_of(t)
  if not globs.is_empty() {
    exhale "  touches    ${globs.join(" ")}"
    exhale "             kept in the tin before the task runs: a file it modifies or deletes comes back on rollback"
  }
  stick sealed = globs_of(t, "touches_sealed")
  if not sealed.is_empty() {
    exhale "  sealed     ${sealed.join(" ")}"
    exhale "             kept sealed (encrypted at rest) in the tin and the run's record"
  }
  if boxed(t, g.manifest.get("defaults", {})) {
    exhale "  box        on: the task runs over a copy-on-write layer on the project; a task that cannot start or is killed leaves nothing, and every change one that ran made comes back on rollback, `touches` or not"
  }
  if type_of(t.get("env", null)) == "map" and not t.env.is_empty() {
    exhale "  env        ${t.env.keys().join(", ")}"
  }
  if not as_list(t.get("env_files", [])).is_empty() {
    exhale "  env files  ${t.env_files.join(", ")}"
  }
  if t.has("undo") or t.has("undo_shell") {
    exhale "  undo       ${to_text(t.get("undo_shell", null) ?? argv_of(t.undo).join(" "))}"
  }
}

pull do_plan(g, wanted) {
  expect_flags(["--only"])
  warn_versions(g, g.components.keys(), false, false)
  stick tasks = g.tasks
  stick want = pick(wanted.is_empty(), tasks.keys().filter(pack(n) => not tasks[n].get("group", false) and not tasks[n].get("extra", false)), wanted)
  stick order = runnable(tasks, resolve_or_fail(tasks, want, flags.contains("--only")))
  if order.is_empty() {
    exhale "nothing to run"
    snuff
  }
  stick width = order.map(pack(x) => x.len()).max()
  exhale "${order.len()} task" + pick(order.len() == 1, "", "s") + ", in this order:"
  for pair in order.enumerate() {
    stick t = tasks[pair[1]]
    stick globs = touches_of(t)
    roll always = ""
    if t.has("inputs") {
      stick limit = inputs_limit_of(t, g.manifest.get("defaults", {}))
      if inputs_count(str(t.get("cwd", ".")), as_list(t.inputs), limit) > limit {
        always = "   (inputs over ${limit} files: always runs)"
      }
    }
    exhale "  ${str(pair[0] + 1).pad_left(2)}. ${pair[1].pad_right(width)}  ${label_of(t)}" + pick(t.get("cwd", ".") == ".", "", "   (in ${t.cwd})") + pick(globs.is_empty(), "", "   touches ${globs.join(" ")}") + always
  }
}

pull close_toolchains(kb, id) {
  roll aliases = {}
  for k in kb {
    aliases[k] = [str(kb[k].get("short", k))]
  }
  stick close = similar(kb.keys(), str(id), aliases)
  if not close.is_empty() {
    snuff "did you mean ${close.slice(0, 4).join(" or ")}?"
  }
  snuff "`cigo toolchains` lists them"
}

pull do_check(g) {
  expect_flags(["--strict"])
  expect_no_targets()
  stick m = g.manifest
  stick tasks = g.tasks
  roll problems = []
  pull problem(level, where, message) {
    problems.push({level: level, where: where, message: message})
  }
  if m.has("cig") and (type_of(m.cig) != "string" or cig_pin_ok(m.cig, "1.0.0") == null) {
    problem("error", MANIFEST, "`cig` is the cig version this project is written for: 1.2 (any 1.2.x), 1.2.0 (exactly) or >=1.2.0")
  }
  # The project's settings: known keys, known values, and only ever tighter
  # than what the person running cigo has (the security floor).
  if m.has("settings") {
    if type_of(m.settings) != "map" {
      problem("error", MANIFEST, "`settings` is a map of setting names to values (cigo config lists them)")
    } else {
      for k in m.settings {
        if not SETTINGS.has(k) {
          problem("warning", MANIFEST, "`settings.${k}` is not a setting cigo knows; the keys are ${SETTINGS.keys().join(", ")}")
        } else if SETTINGS[k].values != null and not SETTINGS[k].values.contains(str(m.settings[k])) {
          problem("error", MANIFEST, "`settings.${k}` must be one of ${SETTINGS[k].values.join(", ")}, not `${m.settings[k]}`")
        }
      }
    }
  }
  config_full()
  for f in FLOORED {
    if f.layer == "project" and f.get("machine", false) {
      problem("warning", MANIFEST, "`settings.${f.key}` is this machine's setting, not a project's (it changes what is installed outside the project); ignored: cigo guard scope sets it")
    } else if f.layer == "project" {
      problem("warning", MANIFEST, "`settings.${f.key}` asks for `${f.wanted}`, looser than your `${f.kept}` (from ${f.from}); ignored: a project can only tighten")
    }
  }
  if env.get("CIGO_VERSIONS", "1") != "0" {
    for f in version_findings(g, g.components.keys(), true) {
      problem(pick(flags.contains("--strict"), "error", "warning"), f.where, f.message)
    }
  }
  pull hint_for(key) {
    if NEAR_MISSES.has(key) {
      snuff "; did you mean `${NEAR_MISSES[key]}`?"
    }
    snuff ""
  }
  stick CONDITIONS_ARE = "conditions are file:, dir:, glob:, grep:FILE:REGEX, json:FILE:key, tool:, os:(windows|macos|linux|freebsd|netbsd|openbsd|android|bsd|unix) and not:"
  pull check_conditions(where, key, conds) {
    stick b = bad_condition(as_list(conds))
    if b != null {
      stick bare = str(b).replace("not:", "")
      if bare.starts_with("os:") {
        stick word = bare.slice(3).lower()
        stick near = pick(OS_NEAR.has(word), "; `${OS_NEAR.get(word, "")}` is the name for it", "")
        problem("error", where, "`${key}`: `${b}` names no operating system cig reports, so it matches no machine; os: takes ${OS_NAMES.join(", ")}${near}")
      } else {
        problem("error", where, "`${key}`: `${b}` is not a condition; ${CONDITIONS_ARE}")
      }
    }
  }
  pull check_toolchain(where, tc) {
    for key in tc.keys() {
      if not TOOLCHAIN_KEYS.contains(key) {
        stick near = similar(TOOLCHAIN_KEYS, key, {})
        if near.is_empty() {
          problem("warning", where, "unknown key `${key}`, ignored")
        } else {
          problem("warning", where, "unknown key `${key}`, ignored; did you mean `${near.first()}`?")
        }
      }
    }
    for key in ["detect", "workspace"] {
      if tc.has(key) {
        check_conditions(where, key, tc[key])
      }
    }
    for table in ["stages", "extras"] {
      stick defs = tc.get(table, {})
      if type_of(defs) != "map" {
        problem("error", where, "`${table}` must be a map of names to lists of alternatives")
        continue
      }
      for name in defs {
        if table == "stages" and not STAGES.contains(name) {
          stick near = similar(STAGES, name, {})
          if near.is_empty() {
            problem("warning", where, "`stages.${name}` is not a stage; a task that isn't a stage goes under `extras`")
          } else {
            problem("warning", where, "`stages.${name}` is not a stage; did you mean `${near.first()}`? (a task that isn't a stage goes under `extras`)")
          }
        }
        stick alts = defs[name]
        if type_of(alts) != "list" {
          problem("error", where, "`${table}.${name}` must be a list of alternatives, like [[\"make\", \"${name}\"]]")
          continue
        }
        for alt in alts {
          if type_of(alt) == "map" {
            if not alt.has("cmd") and not alt.has("shell") and not alt.has("cmds") and not alt.has("rm") {
              problem("error", where, "`${table}.${name}`: an alternative needs `cmd`, `cmds`, `rm` or `shell`")
            }
            if alt.has("each") and not alt.has("cmd") {
              problem("error", where, "`${table}.${name}`: `each` runs `cmd` once per file, so it needs `cmd`")
            }
            if alt.has("when") {
              check_conditions(where, "${table}.${name}", alt.when)
            }
          } else if type_of(alt) != "list" {
            problem("error", where, "`${table}.${name}`: an alternative is a command list or a map with `cmd` or `shell`")
          }
        }
      }
    }
    stick vars = tc.get("vars", {})
    if type_of(vars) != "map" {
      problem("error", where, "`vars` must be a map of names to lists of alternatives")
    } else {
      for v in vars {
        stick alts = vars[v]
        if type_of(alts) != "list" {
          problem("error", where, "`vars.${v}` must be a list of alternatives, like [{\"when\": [\"file:Cargo.lock\"], \"value\": [\"--locked\"]}, {\"value\": []}]")
          continue
        }
        if not alts.all(pack(a) => type_of(a) == "map" and (a.has("value") or a.has("glob") or a.has("files"))) {
          problem("error", where, "`vars.${v}`: each alternative needs a `value`, a `glob` (the first file it names) or `files` (every file the globs name)")
        }
        for a in alts {
          if type_of(a) == "map" and a.has("when") {
            check_conditions(where, "vars.${v}", a.when)
          }
        }
      }
    }
  }
  pull check_touches(name, t) {
    check_globs(name, t, "touches")
    check_globs(name, t, "touches_sealed")
    if t.has("box") and type_of(t.box) != "bool" {
      problem("error", name, "`box` is true or false: whether the task runs over a copy-on-write layer on the project (cig's box, Linux)")
    }
    if t.has("trust") and str(t.trust) != "never" {
      problem("error", name, "`trust` is \"never\": the guard checks this task on every run, approved or not")
    }
    if t.has("footprint") {
      if type_of(t.footprint) != "map" {
        problem("error", name, "`footprint` is a map of lists: writes, reads, network, execs (what this task is known to do beyond its toolchain's)")
      } else {
        for k in t.footprint.keys() {
          if not ["writes", "reads", "network", "execs"].contains(k) {
            problem("error", name, "`footprint.${k}` is not a footprint key (writes, reads, network, execs)")
          } else if type_of(t.footprint[k]) != "list" {
            problem("error", name, "`footprint.${k}` is a list")
          }
        }
      }
    }
  }
  pull check_globs(name, t, key) {
    if not t.has(key) {
      snuff
    }
    stick tv = t[key]
    if type_of(tv) != "string" and (type_of(tv) != "list" or not tv.all(pack(x) => type_of(x) == "string")) {
      problem("error", name, "`${key}` is a glob or a list of globs, relative to the task's directory, like [\"src/**\", \"package.json\"]")
      snuff
    }
    for given in as_list(tv) {
      # A leading `?` says the glob may match nothing; the rest is the glob.
      stick g = pick(given.starts_with("?"), given.slice(1), given)
      stick rooted = g.starts_with("/") or g.starts_with("\\") or (g.len() >= 2 and g.slice(1, 2) == ":")
      if g.trim() == "" or path.is_abs(g) or rooted or g.starts_with("~") or g.replace("\\", "/").split("/").contains("..") {
        problem("error", name, "`${key}`: `${given}` must be a relative glob inside the project; cig keeps what a task may change under its own directory")
      }
    }
  }
  pull check_program(name, argv, cwd, level) {
    stick prog = argv.first()
    if prog.contains("{{") {
      snuff
    }
    if prog.contains("/") or prog.contains("\\") {
      if not fs.exists(path.join(cwd, prog)) {
        problem(level, name, "`${prog}` does not exist")
      }
    } else if which(prog) == null {
      problem(level, name, "`${prog}` is not on PATH")
    }
    for w in argv.slice(1) {
      if not w.starts_with("-") and not w.contains("{{") and INTERPRETERS.has(path.ext(w).lower()) and not fs.exists(path.join(cwd, w)) {
        problem("error", name, "`${w}` does not exist")
      }
    }
  }
  for key in m.keys() {
    if not TOP_KEYS.contains(key) {
      problem("warning", MANIFEST, "unknown key `${key}` at the top; it is ignored")
    }
  }
  stick defaults = m.get("defaults", {})
  if type_of(defaults) != "map" {
    problem("error", MANIFEST, "`defaults` must be a map")
  } else {
    for key in defaults.keys() {
      if not DEFAULT_KEYS.contains(key) {
        problem("warning", "defaults", "unknown key `${key}`; defaults can set ${DEFAULT_KEYS.join(", ")}")
      }
    }
    if defaults.has("inputs_limit") and (type_of(defaults.inputs_limit) != "int" or defaults.inputs_limit < 1) {
      problem("error", "defaults", "`inputs_limit` is a whole number of files, 1 or more")
    }
    if defaults.has("box") and type_of(defaults.box) != "bool" {
      problem("error", "defaults", "`box` is true or false: whether tasks run over a copy-on-write layer on the project (cig's box, Linux; on by default there)")
    }
  }
  if m.has("versions") and not VERSION_SETTINGS.contains(str(m.versions)) {
    problem("error", MANIFEST, "`versions` is one of ${VERSION_SETTINGS.join(", ")}: what to do when a toolchain's installed version disagrees with the project's pin")
  }
  stick own_tc = m.get("toolchains", {})
  if type_of(own_tc) != "map" {
    problem("error", MANIFEST, "`toolchains` must be a map of names to definitions")
  } else {
    for id in own_tc {
      stick tc = own_tc[id]
      if type_of(tc) != "map" {
        problem("error", "toolchain ${id}", "must be a map")
        continue
      }
      if tc.has("extends") and not TOOLCHAINS.has(str(tc.extends)) and not own_tc.has(str(tc.extends)) {
        problem("error", "toolchain ${id}", "extends `${tc.extends}`, which is not a toolchain; ${close_toolchains(g.kb, str(tc.extends))}")
      }
      check_toolchain("toolchain ${id}", tc)
    }
  }
  stick defined = m.get("components", {})
  if type_of(defined) != "map" {
    problem("error", MANIFEST, "`components` must be a map")
  } else {
    roll told = {}
    for name in defined {
      stick c = defined[name]
      if type_of(c) != "map" {
        problem("error", name, "a component is a map like {\"path\": \"api\", \"toolchain\": \"go\"}, got a ${type_of(c)}")
        continue
      }
      for key in c.keys() {
        if not COMPONENT_KEYS.contains(key) {
          problem("warning", name, "unknown key `${key}`, ignored${hint_for(key)}")
        }
      }
      stick dir = str(c.get("path", "."))
      if not fs.is_dir(dir) {
        problem("error", name, "path `${dir}` is not a directory")
      }
      stick tc_id = c.get("toolchain", null)
      if tc_id == null {
        problem("error", name, "has no toolchain; `cigo toolchains` lists them")
      } else if not g.kb.has(str(tc_id)) {
        problem("error", name, "toolchain `${tc_id}` is not one this knows; ${close_toolchains(g.kb, str(tc_id))}")
      } else {
        stick tc = g.kb[str(tc_id)]
        for tool in as_list(tc.get("tools", [])) {
          stick key = "${tc_id}:${tool}"
          if which(str(tool)) == null and not told.has(key) {
            told[key] = true
            problem("warning", name, "`${tool}` is not on PATH, so ${tc_id} tasks cannot run here" + pick(tc.has("install"), "; install: ${tc.get("install", "")}", ""))
          }
        }
      }
      for other in as_list(c.get("after", [])) {
        if not defined.has(str(other)) {
          problem("error", name, "is after `${other}`, which is not a component")
        }
      }
      if c.has("stages") and type_of(c.stages) != "map" {
        problem("error", name, "`stages` must be a map of stage names to commands")
      }
      if g.components.has(name) {
        for trouble in as_list(g.components[name].get("problems", [])) {
          problem("error", name, trouble)
        }
      }
      if c.has("groups") and type_of(c.groups) != "bool" {
        problem("error", name, "`groups` is true or false")
      }
      for f in as_list(c.get("env_file", null)) {
        if not fs.is_file(path.join(dir, str(f))) {
          problem("warning", name, "env_file `${f}` does not exist")
        }
      }
    }
  }
  for name in tasks {
    stick t = tasks[name]
    if t.get("bad", false) {
      problem("error", name, "a task is a map like {\"cmd\": [...]}, got a ${type_of(t.value)}")
      continue
    }
    stick own = t.origin == MANIFEST
    if t.get("group", false) and not own {
      continue
    }
    if own {
      for key in t.keys() {
        if not TASK_KEYS.contains(key) and not ["env_files", "origin", "group"].contains(key) {
          problem("warning", name, "unknown key `${key}`, ignored${hint_for(key)}")
        }
      }
      stick ways = ["cmd", "shell", "cmds", "rm"].filter(pack(k) => t.has(k))
      if t.has("each") and not t.has("cmd") {
        problem("error", name, "`each` runs `cmd` once per file, so it needs `cmd`")
      }
      if t.has("each") {
        stick e = t.each
        stick list_ok = type_of(e) == "list" and not e.is_empty() and e.all(pack(x) => type_of(x) == "string")
        stick map_ok = type_of(e) == "map" and e.has("files") and type_of(e.files) == "list" and not e.files.is_empty() and e.files.all(pack(x) => type_of(x) == "string") and (not e.has("skip") or (type_of(e.skip) == "list" and e.skip.all(pack(x) => type_of(x) == "string")))
        if not list_ok and not map_ok {
          problem("error", name, "`each` is a list of globs, like [\"src/**/*.py\"], or a map {\"files\": [...], \"skip\": [\"fixtures\"]}")
        }
      }
      if t.has("inputs_limit") and (type_of(t.inputs_limit) != "int" or t.inputs_limit < 1) {
        problem("error", name, "`inputs_limit` is a whole number of files, 1 or more")
      }
      if t.has("cmds") and (type_of(t.cmds) != "list" or t.cmds.is_empty() or not t.cmds.all(pack(c) => argv_of(c) != null and not argv_of(c).is_empty())) {
        problem("error", name, "`cmds` is a list of commands, each a list like [\"go\", \"vet\", \"./...\"]")
      }
      if t.has("rm") and not as_list(t.rm).all(pack(x) => type_of(x) == "string" and x != "" and not path.is_abs(x) and not x.split("/").contains("..")) {
        problem("error", name, "`rm` is a list of paths inside the project to remove, like [\"dist\", \"build\"]")
      }
      if ways.len() > 1 {
        problem("error", name, "has both ${ways.map(pack(k) => "`" + k + "`").join(" and ")}; keep one")
      } else if ways.is_empty() and needs_of(t).is_empty() {
        problem("error", name, "has nothing to run: give it `cmd`, `cmds`, `rm` or `shell`, or `needs` to make it a group")
      } else if t.has("shell") {
        if type_of(t.shell) != "string" or t.shell.trim() == "" {
          problem("error", name, "`shell` must be a command line (a string)")
        }
      } else if t.has("cmd") {
        stick argv = argv_of(t.cmd)
        if argv == null or argv.is_empty() {
          problem("error", name, "`cmd` must be a list like [\"bash\", \"scripts/build.sh\"], or a string")
        } else if type_of(t.cmd) == "string" and SHELL_CHARS.any(pack(c) => t.cmd.contains(c)) {
          problem("warning", name, "`cmd` is split on spaces and never reaches a shell, so its quotes, pipes and globs are passed as they are; use `shell` for a command line, or write `cmd` as a list")
        }
      }
      stick would_group = pick(name == "ci", CI_STAGES.any(pack(x) => x != name and g.tasks.has(x)), GROUP_STAGES.contains(name) and g.components.values().any(pack(c) => c.spec.get("groups", true) != false and c.stages.has(name)))
      if would_group {
        problem("warning", name, "replaces the stage group `${name}`; the components' own ${name} tasks still run when named")
      }
      if t.has("needs") and type_of(t.needs) != "list" and type_of(t.needs) != "string" {
        problem("error", name, "`needs` must be a list of task names")
      }
      if t.has("ok") {
        stick ok = ok_codes(t)
        if type_of(ok) != "list" or ok.is_empty() or not ok.all(pack(c) => type_of(c) == "int") {
          problem("error", name, "`ok` must be exit codes, like [0, 1]")
        }
      }
      for key in ["timeout_ms", "retries", "retry_delay_ms"] {
        if t.has(key) and (type_of(t[key]) != "int" or t[key] < 0) {
          problem("error", name, "`${key}` must be a whole number, 0 or more")
        }
      }
      if t.has("env") and type_of(t.env) != "map" {
        problem("error", name, "`env` must be a map of names to values")
      }
      if t.has("capture") and not CAPTURES.contains(to_text(t.capture)) {
        problem("error", name, "`capture` is one of ${CAPTURES.join(", ")}")
      }
      if t.has("encoding") and not ["utf-8", "utf8", "lossy", "utf-16", "utf16", "latin1", "latin-1"].contains(str(t.encoding)) {
        problem("error", name, "`encoding` is one of utf-8, lossy, utf-16, latin1")
      }
      for key in ["inputs", "produces"] {
        if t.has(key) and not as_list(t[key]).all(pack(x) => type_of(x) == "string") {
          problem("error", name, "`${key}` is a list of paths")
        }
      }
      if t.has("cwd") and not t.cwd.contains("{{") and not fs.is_dir(t.cwd) {
        problem("error", name, "`cwd` ${t.cwd} is not a directory")
      }
      check_touches(name, t)
      for f in as_list(t.get("env_files", [])) {
        if not fs.is_file(f) {
          problem("warning", name, "env_file `${f}` does not exist")
        }
      }
      if t.has("undo") and t.has("undo_shell") {
        problem("error", name, "has both `undo` and `undo_shell`; keep one")
      } else if t.has("undo") {
        stick argv = argv_of(t.undo)
        if argv == null or argv.is_empty() {
          problem("error", name, "`undo` must be a list like [\"bash\", \"scripts/undeploy.sh\"], or a string")
        } else {
          check_program(name, argv, t.cwd, "error")
        }
      }
    }
    if not own {
      check_touches(name, t)
    }
    if not t.get("group", false) {
      stick argv = argv_of(t.get("cmd", null))
      if argv != null and not argv.is_empty() {
        check_program(name, argv, str(t.get("cwd", ".")), pick(own, "error", "warning"))
      } else if t.has("cmds") {
        for c in as_list(t.cmds) {
          stick a = argv_of(c)
          if a != null and not a.is_empty() {
            check_program(name, a, str(t.get("cwd", ".")), pick(own, "error", "warning"))
          }
        }
      } else if not own and not t.has("shell") and not t.has("rm") and not t.get("bad", false) {
        problem("error", name, "has nothing to run: its stage or target gives it no `cmd`, `cmds`, `rm` or `shell`")
      }
    }
    for s in strings_of(t) {
      for expr in template_exprs(s) {
        stick base = expr_base(expr)
        stick bar = expr.find("|")
        if bar >= 0 and not ["json", "sh"].contains(expr.slice(bar + 1).trim()) {
          problem("error", name, "{{${expr}}}: unknown filter; the filters are |json and |sh")
        }
        if not is_builtin_ref(base) and task_named(base, tasks) == null {
          problem("error", name, "{{${expr}}} names no task; ${known(tasks, base.split(".").first())}. A literal {{ for the program itself is written with four braces: {{{{...}}}}")
        }
      }
    }
    # A value pasted into a shell line as text is shell code: a captured
    # title holding `; rm -rf` runs. `|sh` makes it one word; `cmd` lists
    # never reach a shell. A warning, an error under --strict; `cigo run`
    # says the same before it starts, and stops under --strict or CI.
    for u in unquoted_shell_templates(t) {
      problem(pick(flags.contains("--strict"), "error", "warning"), name, unquoted_advice(u))
    }
    if t.has("stdin_from") {
      if not tasks.has(str(t.stdin_from)) {
        problem("error", name, "stdin_from `${t.stdin_from}` is not a task")
      }
      if t.has("stdin") {
        problem("error", name, "has both `stdin` and `stdin_from`; keep one")
      }
    }
    for dep in needs_of(t) {
      if not tasks.has(dep) {
        problem("error", name, "needs `${dep}`, which is not a task; ${known(tasks, dep)}")
      }
    }
  }
  roll loops = []
  for name in tasks {
    try {
      resolve(tasks, [name], false)
    } ashtray e {
      if e.message.starts_with("dependency loop") and not loops.contains(e.message) {
        loops.push(e.message)
        problem("error", name, e.message)
      }
    }
  }
  stick errors = problems.filter(pack(p) => p.level == "error")
  stick warnings = problems.filter(pack(p) => p.level == "warning")
  stick count = tasks.keys().filter(pack(n) => not tasks[n].get("group", false) or tasks[n].origin == MANIFEST).len()
  exhale "${MANIFEST}: " + pick(g.components.is_empty(), "", "${g.components.len()} component(s), ") + "${count} task(s), ${errors.len()} error(s), ${warnings.len()} warning(s)"
  for p in errors + warnings {
    exhale "  ${p.level}: ${p.where}: ${p.message}"
  }
  if not errors.is_empty() {
    exit(1)
  }
}

# ----- versions: the cig, the project's pins, the tools ----------------------------
#
# Every command that opens a project looks at the versions it depends on and
# says, on stderr, where they disagree: the cig this runs under against the
# range cigo supports, against the project's `.cig-version` or the manifest's
# `cig`, and against the `# cig` header of every script a task hands to cig;
# each toolchain's installed version against the pins the project keeps
# (.nvmrc, .python-version, go.mod, rust-toolchain.toml...). `cigo doctor`
# prints the whole table; `--strict` on check and run makes a disagreement
# an error. CIGO_VERSIONS=0 keeps the warnings quiet.

pull version_parts(v) {
  stick c = text.captures(str(v ?? ""), '^v?(\d+)\.(\d+)(?:\.(\d+))?')
  if c == null {
    snuff null
  }
  snuff [int(c[1]), int(c[2]), int(c.get(3, null) ?? "0")]
}

# A cig pin as cig reads it: 1.2 (any 1.2.x), 1.2.0 (exactly), >=1.2.0 (that
# or newer, same major), 1 (any 1.x). null when the text is not a pin.
pull cig_pin_ok(constraint, have) {
  stick want = str(constraint).trim()
  stick h = version_parts(have)
  if h == null {
    snuff null
  }
  if want.starts_with(">=") {
    stick w = version_parts(want.slice(2).trim())
    if w == null or not text.matches(want.slice(2).trim(), '^v?\d+\.\d+\.\d+$') {
      snuff null
    }
    snuff h[0] == w[0] and (h[1] > w[1] or (h[1] == w[1] and h[2] >= w[2]))
  }
  stick core = pick(want.starts_with("v"), want.slice(1), want)
  stick parts = core.split(".")
  if parts.is_empty() or parts.len() > 3 or not parts.all(pack(x) => text.matches(x, '^\d+$')) {
    snuff null
  }
  for pair in parts.enumerate() {
    if h[pair[0]] != int(pair[1]) {
      snuff false
    }
  }
  snuff true
}

# The `# cig X` header of a script: a comment before the first statement.
pull script_pin(file) {
  if not fs.is_file(file) {
    snuff null
  }
  for line in fs.read_text(file).lines() {
    stick l = line.trim()
    if l == "" or l.starts_with("#!") {
      continue
    }
    if not l.starts_with("#") {
      break
    }
    stick c = text.captures(l, '^#\s*cig:?\s+(\S+)\s*$')
    if c != null and cig_pin_ok(c[1], "1.0.0") != null {
      snuff c[1]
    }
  }
  snuff null
}

# Every cig pin the project carries: the manifest's `cig`, `.cig-version`,
# and the header of each script a task runs through cig or a CigScript
# component holds.
pull cig_pins(g) {
  roll pins = []
  stick m = g.manifest
  if m.has("cig") {
    pins.push({from: "${MANIFEST} cig", pin: str(m.cig)})
  }
  if fs.is_file(".cig-version") {
    stick first = fs.read_text(".cig-version").lines().map(pack(l) => l.trim()).filter(pack(l) => l != "" and not l.starts_with("#")).get(0, null)
    if first != null {
      pins.push({from: ".cig-version", pin: first})
    }
  }
  roll files = []
  for name in g.tasks {
    stick t = g.tasks[name]
    stick argv = (argv_of(t.get("cmd", null)) ?? []).map(pack(w) => str(w))
    if argv.len() >= 3 and path.base(argv[0]) == "cig" and argv[1] == "run" {
      stick script = argv.slice(2).filter(pack(w) => w.ends_with(".cig")).get(0, null)
      if script != null {
        stick f = path.normalize(path.join(str(t.get("cwd", ".")), script))
        if not files.contains(f) {
          files.push(f)
        }
      }
    }
  }
  for cname in g.components {
    stick comp = g.components[cname]
    if to_text(comp.toolchain) == "cigscript" {
      for f in glob_under(comp.dir, "**/*.cig") {
        stick rel = path.normalize(path.join(comp.dir, f))
        stick parts = rel.split("/")
        if not files.contains(rel) and not parts.any(pack(x) => FINGERPRINT_SKIP.contains(x) or WALK_SKIP.contains(x)) and files.len() < 200 {
          files.push(rel)
        }
      }
    }
  }
  for f in files {
    stick p = script_pin(f)
    if p != null {
      pins.push({from: f, pin: p})
    }
  }
  snuff pins
}

# One `tool --version` per tool per command, however many components share it,
# and across commands while the tool's file is the same: the answer is kept in
# .cig-orchestrator/state/versions.json with the program's path, size and
# time, so a project whose tools have not changed opens without a hop.
roll PROBED = {}
pull probe_version(argv) {
  stick key = argv.join(" ")
  if PROBED.has(key) {
    snuff PROBED[key]
  }
  roll v = null
  stick at = which(argv.first())
  if at != null {
    stick stamp = "${fs.size(at)}:${fs.modified_ms(at)}"
    stick st = versions_state()
    stick kept = st.probes.get(key, null)
    if type_of(kept) == "map" and kept.get("path", "") == at and kept.get("stamp", "") == stamp {
      PROBED[key] = kept.get("version", null)
      snuff PROBED[key]
    }
    roll said = ""
    roll simulated = false
    burn {
      try {
        stick r = proc.run(argv.first(), argv.slice(1), {timeout_ms: 30000})
        said = r.out + r.err
        simulated = r.get("simulated", false)
      } ashtray e {
        said = ""
      }
    }
    if not simulated {
      v = version_in(said)
      if v != null {
        st.probes[key] = {path: at, stamp: stamp, version: v}
        save_versions_state(st)
      }
    }
  }
  PROBED[key] = v
  snuff v
}

# The pin for a toolchain's version probe in a component: the component's
# own file first, the project root's second.
pull pin_of(tc, vname, dir) {
  roll pin = null
  for source in as_list(tc.get("pins", {}).get(vname, [])) {
    if pin == null {
      pin = read_pin(dir, source) ?? read_pin(".", source)
    }
  }
  snuff pin
}

# Where the versions disagree, for these components: a list of findings,
# each with `where` and `message`. The cig pins are files and always read;
# the tools are asked their version only when `probe` is set, because each
# answer is a hop and a hop is a burn: `run`, `check` and `doctor` ask,
# `list`, `plan` and `show` look at the files alone.
pull version_findings(g, comp_names, probe) {
  roll found = []
  stick have = cig.version()
  if cig_pin_ok(CIG_NEEDS, have) == false {
    found.push({where: "cig", message: "cig ${have} is outside the range cig-orchestrator ${VERSION} supports (${CIG_NEEDS}); `cig update`, or an older cigo"})
  }
  for p in cig_pins(g) {
    stick ok = cig_pin_ok(p.pin, have)
    if ok == false {
      found.push({where: p.from, message: "${p.from} pins cig ${p.pin}; the installed cig is ${have}" + pick(p.from.ends_with(".cig"), " (cig hands that script to a matching version from the humidor when it has one: `cig versions`)", " (`cig pin` and `.cig-version` are CigScript's; `cig versions add ${p.pin}` fetches one)")})
    } else if ok == null {
      found.push({where: p.from, message: "${p.from}: `${p.pin}` is not a cig version pin; write 1.2 (any 1.2.x), 1.2.0 (exactly) or >=1.2.0"})
    }
  }
  # The cig on PATH is the one tasks run (`cig run script.cig`, the cigscript
  # toolchain's `cig check`); the one running cigo may be another.
  stick uses_cig = comp_names.any(pack(c) => to_text(g.components[c].toolchain) == "cigscript") or g.tasks.keys().any(pack(n) => (argv_of(g.tasks[n].get("cmd", null)) ?? []).map(pack(w) => path.base(str(w))).get(0, "") == "cig")
  if probe and uses_cig and which("cig") != null {
    stick on_path = probe_version(["cig", "--version"])
    if on_path != null and on_path != have {
      found.push({where: "cig", message: "the cig on PATH (${which("cig")}) is ${on_path}; cigo runs under cig ${have}, so tasks that call cig run on a different one"})
    }
  }
  roll seen = []
  for cname in pick(probe, comp_names, []) {
    stick comp = g.components[cname]
    stick id = to_text(comp.toolchain)
    if not g.kb.has(id) {
      continue
    }
    stick tc = g.kb[id]
    stick versions = tc.get("versions", {})
    for vname in versions {
      stick pin = pin_of(tc, vname, comp.dir)
      if pin == null {
        continue
      }
      stick mark = "${vname} ${pin.from}"
      if seen.contains(mark) {
        continue
      }
      seen.push(mark)
      stick v = probe_version(fill(versions[vname], vars_for(comp.dir, tc, comp.name)))
      if pin_matches(pin.value, v, pin.minimum) == false {
        found.push({where: cname, mark: mark, message: "${cname}: ${vname} is ${v}, ${pin.from} " + pick(pin.minimum, "needs at least", "pins") + " ${pin.value} (`cigo doctor`, `cigo versions`)"})
      }
    }
  }
  snuff found
}

# Say where the versions disagree, on stderr; with `strict`, stop instead.
pull warn_versions(g, comp_names, strict, probe) {
  snuff warn_versions_except(g, comp_names, strict, probe, [])
}

# `warn_versions`, quiet about the toolchain vars in `except` (their marks):
# the ones a switch made agree.
pull warn_versions_except(g, comp_names, strict, probe, except) {
  if env.get("CIGO_VERSIONS", "1") == "0" {
    snuff 0
  }
  stick found = version_findings(g, comp_names, probe).filter(pack(f) => not except.contains(f.get("mark", "")))
  for f in found {
    log.warn(f.message)
  }
  if strict and not found.is_empty() {
    fail("${found.len()} version disagreement" + pick(found.len() == 1, "", "s") + " and --strict given; `cigo doctor` shows every version")
  }
  snuff found.len()
}

# The components the named tasks belong to.
pull components_of(tasks, names) {
  roll out = []
  for n in names {
    stick c = tasks[n].get("component", null)
    if c != null and not out.contains(c) {
      out.push(c)
    }
  }
  snuff out
}

# ----- toolchain versions: the switch (0.5.0) ------------------------------------------
#
# A project pins its languages (.nvmrc, .python-version, rust-toolchain.toml,
# go.mod...). When the installed version disagrees, cigo can run the task on
# the pinned one through a version manager already on the machine, per task
# and never by changing anyone's default: mise or asdf for whatever they
# manage; rustup, uv or pyenv, fnm or volta, rbenv, and Go's own GOTOOLCHAIN
# for one language each. The `versions` setting (--versions=, the manifest's
# `versions`, `cigo config versions`) says what to do on a disagreement: ask
# (the default) prints the question and the two commands that answer it,
# since a script cannot read a prompt, and runs on the installed versions
# meanwhile; always switches and says so; never warns only; off does not look.
# In CI, with nothing set, it is never. The answer is remembered per project
# in .cig-orchestrator/state/versions.json, keyed by the pins and versions it
# was asked about, so a changed pin asks again.

pull versions_state() {
  roll st = null
  if fs.is_file(VERSIONS_FILE) {
    try {
      st = json.load(VERSIONS_FILE)
    } ashtray e {
      st = null
    }
  }
  if type_of(st) != "map" {
    st = {}
  }
  if type_of(st.get("asked", null)) != "map" {
    st.asked = {}
  }
  if type_of(st.get("probes", null)) != "map" {
    st.probes = {}
  }
  snuff st
}

pull save_versions_state(st) {
  burn {
    fs.mkdir(path.join(STATE, "state"))
    json.save(VERSIONS_FILE, st, 2)
  }
}

pull versions_setting(g) {
  stick given = flag_value("--versions", null)
  if given != null {
    if not VERSION_SETTINGS.contains(given) {
      fail("--versions is one of ${VERSION_SETTINGS.join(", ")}, not `${given}`")
    }
    snuff given
  }
  if env.get("CIGO_VERSIONS", "1") == "0" {
    snuff "off"
  }
  stick m = g.manifest
  if m.has("versions") and VERSION_SETTINGS.contains(str(m.versions)) {
    snuff str(m.versions)
  }
  if config_sets("versions") {
    stick c = str(config().versions)
    if VERSION_SETTINGS.contains(c) {
      snuff c
    }
  }
  # Nobody said: a CI run cannot answer a question, so it never switches.
  if not attended() {
    snuff "never"
  }
  snuff "ask"
}

pull install_setting() {
  stick given = flag_value("--install", null)
  if given != null {
    if not INSTALL_SETTINGS.contains(given) {
      fail("--install is one of ${INSTALL_SETTINGS.join(", ")}, not `${given}`")
    }
    snuff given
  }
  stick c = str(config().get("install", "ask"))
  snuff pick(INSTALL_SETTINGS.contains(c), c, "ask")
}

# The version managers on this machine, in the order one is chosen per tool.
pull managers_here() {
  snuff ["mise", "asdf", "rustup", "uv", "pyenv", "fnm", "volta", "rbenv"].filter(pack(m) => which(m) != null)
}

# The name a manager calls a tool, from the toolchain's pin sources:
# `mise.toml:node` names it for mise, `.tool-versions:nodejs` for asdf.
pull manager_name(tc, vname, manager) {
  stick prefix = pick(manager == "mise", "mise.toml:", ".tool-versions:")
  for source in as_list(tc.get("pins", {}).get(vname, [])) {
    if str(source).starts_with(prefix) {
      snuff str(source).slice(prefix.len())
    }
  }
  snuff null
}

# How a task runs on `version` of `vname` through `manager`: the words put
# before the command (`wrap`), the variables set (`env`), the command that
# says whether the version is installed (`has`, exit 0), the one that installs
# it, and whether the manager fetches a version on first use by itself. null
# when this manager has no way for this tool.
pull switch_via(manager, tc, vname, version) {
  stick name = manager_name(tc, vname, manager)
  roll e = {}
  if manager == "mise" and name != null {
    snuff {manager: "mise", wrap: ["mise", "exec", "${name}@${version}", "--"], env: {}, has: ["mise", "where", "${name}@${version}"], install: ["mise", "install", "${name}@${version}"], fetches: false, site: "https://mise.jdx.dev"}
  }
  if manager == "asdf" and name != null {
    e["ASDF_" + name.upper().replace("-", "_") + "_VERSION"] = version
    snuff {manager: "asdf", wrap: [], env: e, has: ["asdf", "where", name, version], install: ["asdf", "install", name, version], fetches: false, site: "https://asdf-vm.com"}
  }
  if manager == "rustup" and (vname == "rustc" or vname == "cargo") {
    e.RUSTUP_TOOLCHAIN = version
    snuff {manager: "rustup", wrap: [], env: e, has: ["rustup", "run", version, "rustc", "--version"], install: ["rustup", "toolchain", "install", version], fetches: false, site: "https://rustup.rs"}
  }
  if manager == "uv" and vname == "python" {
    e.UV_PYTHON = version
    snuff {manager: "uv", wrap: [], env: e, has: ["uv", "python", "find", version], install: ["uv", "python", "install", version], fetches: false, site: "https://docs.astral.sh/uv/"}
  }
  if manager == "pyenv" and vname == "python" {
    e.PYENV_VERSION = version
    snuff {manager: "pyenv", wrap: [], env: e, has: ["pyenv", "prefix", version], install: ["pyenv", "install", "-s", version], fetches: false, site: "https://github.com/pyenv/pyenv"}
  }
  if manager == "fnm" and vname == "node" {
    snuff {manager: "fnm", wrap: ["fnm", "exec", "--using", version, "--"], env: {}, has: ["fnm", "exec", "--using", version, "node", "--version"], install: ["fnm", "install", version], fetches: false, site: "https://github.com/Schniz/fnm"}
  }
  if manager == "volta" and vname == "node" {
    # volta fetches a version it lacks on first use, by its own design.
    snuff {manager: "volta", wrap: ["volta", "run", "--node", version], env: {}, has: null, install: null, fetches: true, site: "https://volta.sh"}
  }
  if manager == "rbenv" and vname == "ruby" {
    e.RBENV_VERSION = version
    snuff {manager: "rbenv", wrap: [], env: e, has: ["rbenv", "prefix", version], install: ["rbenv", "install", "-s", version], fetches: false, site: "https://github.com/rbenv/rbenv"}
  }
  snuff null
}

# The first manager here with a way to run `vname` on `version`; Go runs its
# own toolchains (GOTOOLCHAIN) and needs none.
pull switch_for(tc, vname, version) {
  for m in managers_here() {
    stick how = switch_via(m, tc, vname, version)
    if how != null {
      snuff how
    }
  }
  if vname == "go" and which("go") != null {
    roll e = {}
    e.GOTOOLCHAIN = "go" + version
    snuff {manager: "go", wrap: [], env: e, has: null, install: null, fetches: true, site: "https://go.dev/doc/toolchain"}
  }
  snuff null
}

# The managers that would do for `vname`, for the line that says what to install.
pull managers_for(vname) {
  stick by_tool = {node: ["mise", "fnm"], python: ["mise", "uv"], ruby: ["mise", "rbenv"], rustc: ["rustup"], cargo: ["rustup"]}
  snuff by_tool.get(vname, ["mise", "asdf"])
}

# Does the manager have this version? A manager that fetches on first use
# always does; a dry run takes every answer as yes.
pull manager_has(how) {
  if how.has == null {
    snuff true
  }
  roll ok = false
  burn {
    try {
      stick r = proc.run(how.has.first(), how.has.slice(1), {timeout_ms: 30000})
      ok = r.code == 0 or r.get("simulated", false)
    } ashtray e {
      ok = false
    }
  }
  snuff ok
}

# Every pinned toolchain version in these components: one row per (var, pin
# source), with the installed version, whether they agree, and the way to
# switch when a manager here has one.
pull pin_rows(g, comp_names) {
  roll out = []
  roll seen = []
  for cname in comp_names {
    stick comp = g.components[cname]
    stick id = to_text(comp.toolchain)
    if not g.kb.has(id) {
      continue
    }
    stick tc = g.kb[id]
    stick versions = tc.get("versions", {})
    if versions.is_empty() {
      continue
    }
    stick vars = vars_for(comp.dir, tc, comp.name)
    for vname in versions {
      stick pin = pin_of(tc, vname, comp.dir)
      if pin == null {
        continue
      }
      stick mark = "${vname} ${pin.from}"
      if seen.contains(mark) {
        continue
      }
      seen.push(mark)
      stick installed = probe_version(fill(versions[vname], vars))
      stick ok = pin_matches(pin.value, installed, pin.minimum)
      out.push({component: cname, toolchain: id, var: vname, pinned: pin.value, source: pin.from, minimum: pin.minimum, installed: installed, agrees: ok != false, mark: mark, how: switch_for(tc, vname, pin.value)})
    }
  }
  snuff out
}

pull disagreements(g, comp_names) {
  snuff pin_rows(g, comp_names).filter(pack(r) => not r.agrees)
}

# The manager a row would switch through, or "none".
pull manager_of(r) {
  if r.how == null {
    snuff "none"
  }
  snuff r.how.manager
}

# The disagreements as one key: the same pins and versions ask once.
pull disagreement_key(found) {
  stick lines = found.map(pack(r) => "${r.var}\t${r.pinned}\t${r.installed ?? "none"}\t${r.source}\t${manager_of(r)}").sort()
  snuff hash.sha256(lines.join("\n")).slice(0, 16)
}

pull pinned_text(r) {
  snuff pick(r.minimum, "at least ${r.pinned}", r.pinned)
}

# The question, printed on stderr; a script cannot wait for the answer, so
# the two commands that give it are printed with it.
pull ask_about(found, first_time) {
  stick n = found.len()
  if not first_time {
    log.warn("${PROJECT_NAME}: ${n} language" + pick(n == 1, " disagrees", "s disagree") + " with this machine; `cigo versions` shows which, `cigo versions switch` or `cigo versions keep` answers")
    snuff
  }
  stick width = found.map(pack(r) => r.var.len()).max()
  stick swidth = found.map(pack(r) => pinned_text(r).len()).max()
  log.warn("${PROJECT_NAME}: ${n} language" + pick(n == 1, " disagrees", "s disagree") + " with this machine")
  for r in found {
    log.warn("  ${r.var.pad_right(width)}  ${pinned_text(r).pad_right(swidth)} pinned by ${r.source}   installed ${r.installed ?? "none"}")
  }
  stick with = found.filter(pack(r) => r.how != null)
  stick without = found.filter(pack(r) => r.how == null)
  if not with.is_empty() {
    stick managers = []
    for r in with {
      if not managers.contains(r.how.manager) {
        managers.push(r.how.manager)
      }
    }
    log.warn("Switch to the pinned versions for cigo's tasks? ${managers.join(" and ")} " + pick(with.len() == found.len(), pick(with.len() == 1, "has it", "has them all"), "has ${with.len()} of them") + ".")
    log.warn("  cigo versions switch         yes: run them on the pinned versions, and remember it for this project")
    log.warn("  cigo versions keep           no: run on the installed versions, and remember it")
    log.warn("  cigo config versions always  switch without asking, in every project")
  }
  for r in without {
    stick names = managers_for(r.var)
    log.warn("${r.var} ${pinned_text(r)} is pinned by ${r.source}, ${r.installed ?? "none"} is installed, and no version manager was found. To let cigo switch for you: install ${names.join(" or ")} (mise: https://mise.jdx.dev), then run cigo again.")
  }
}

# What to do about these disagreements: "switch", "keep" or "off".
pull versions_answer(g, found, setting) {
  if setting == "off" {
    snuff "off"
  }
  if found.is_empty() or setting == "never" {
    snuff "keep"
  }
  if setting == "always" {
    snuff "switch"
  }
  stick st = versions_state()
  stick key = disagreement_key(found)
  stick remembered = st.asked.get(key, null)
  if remembered == "switch" or remembered == "keep" {
    snuff remembered
  }
  ask_about(found, remembered == null)
  if remembered == null {
    st.asked[key] = "asked"
    save_versions_state(st)
  }
  snuff "keep"
}

# Set the run's switches from the disagreements a manager can act on, and say
# so. A version the manager lacks is installed, offered or left as the
# `install` setting says. Returns the marks of the vars that are switched.
pull apply_switches(found) {
  roll marks = []
  roll said = []
  stick install = install_setting()
  for r in found {
    if r.how == null {
      log.warn("${r.var} ${pinned_text(r)} is pinned by ${r.source}, ${r.installed ?? "none"} is installed, and no version manager was found; install ${managers_for(r.var).join(" or ")} to let cigo switch")
      continue
    }
    roll ready = manager_has(r.how)
    if not ready and r.how.install != null {
      stick cmd_text = r.how.install.map(quote).join(" ")
      if install == "always" {
        log.warn("installing ${r.var} ${r.pinned} through ${r.how.manager}: ${cmd_text}")
        roll ok = false
        burn {
          try {
            stick ran = proc.run(r.how.install.first(), r.how.install.slice(1), {timeout_ms: 900000})
            ok = ran.code == 0 or ran.get("simulated", false)
            if not ok {
              log.warn((ran.out + ran.err).trim_end().lines().last() ?? "")
            }
          } ashtray e {
            log.warn(e.message)
          }
        }
        ready = ok
      } else if install == "ask" {
        log.warn("${r.how.manager} can install ${r.var} ${r.pinned} (${cmd_text}); it downloads, so cigo does not do it on its own: `cigo versions install --yes` runs it, or `cigo config install always`")
      } else {
        log.warn("${r.how.manager} does not have ${r.var} ${r.pinned} and `install` is never; ${r.var} runs on ${r.installed ?? "what is installed"}")
      }
    }
    if not ready {
      continue
    }
    if not SWITCHES.has(r.component) {
      SWITCHES[r.component] = []
    }
    SWITCHES[r.component].push({var: r.var, version: r.pinned, source: r.source, how: r.how})
    marks.push(r.mark)
    said.push("${r.var} ${r.pinned} (${r.source}) via ${r.how.manager}" + pick(r.how.fetches, " (it fetches the version itself the first time)", ""))
  }
  if not said.is_empty() {
    log.warn("switching: ${said.join(", ")}")
  }
  snuff marks
}

# The command line `sh -c <line>` as words, for a shell task a manager wraps.
pull shell_words(line) {
  if which("sh") != null {
    snuff ["sh", "-c", line]
  }
  snuff ["cmd", "/d", "/s", "/c", line]
}

pull do_versions(g) {
  expect_flags(["--yes", "--versions", "--install"])
  stick sub = targets.get(0, "")
  if not ["", "switch", "keep", "install"].contains(sub) {
    fail("`cigo versions` takes switch, keep or install; got `${sub}`")
  }
  stick rows = pin_rows(g, g.components.keys())
  stick found = rows.filter(pack(r) => not r.agrees)
  if sub == "switch" or sub == "keep" {
    if found.is_empty() {
      exhale "every pinned version agrees with this machine; nothing to remember"
      snuff
    }
    stick st = versions_state()
    st.asked[disagreement_key(found)] = sub
    save_versions_state(st)
    exhale pick(sub == "switch", "remembered: cigo's tasks run on the pinned versions in this project (${found.map(pack(r) => r.var + " " + r.pinned).join(", ")}); a changed pin asks again", "remembered: cigo's tasks run on the installed versions in this project; a changed pin asks again")
    snuff
  }
  if sub == "install" {
    stick todo = found.filter(pack(r) => r.how != null and r.how.install != null and not manager_has(r.how))
    if todo.is_empty() {
      exhale "every pinned version a manager here can run is installed already"
      snuff
    }
    for r in todo {
      stick cmd_text = r.how.install.map(quote).join(" ")
      if flags.contains("--yes") {
        exhale "installing ${r.var} ${r.pinned}: ${cmd_text}"
        burn {
          stick ran = proc.run(r.how.install.first(), r.how.install.slice(1), {timeout_ms: 900000})
          for line in (ran.out + ran.err).trim_end().lines() {
            exhale "    " + line
          }
          if ran.code != 0 and not ran.get("simulated", false) {
            fail("${cmd_text} exited ${ran.code}")
          }
        }
      } else {
        exhale "${r.var} ${r.pinned} (${r.source}): ${cmd_text}"
      }
    }
    if not flags.contains("--yes") {
      exhale "these download; `cigo versions install --yes` runs them"
    }
    snuff
  }
  if rows.is_empty() {
    exhale "no toolchain in ${MANIFEST} keeps a version pin this knows (.nvmrc, .python-version, rust-toolchain.toml, go.mod, .tool-versions, mise.toml...)"
    snuff
  }
  stick setting = versions_setting(g)
  stick st = versions_state()
  stick answer = pick(found.is_empty(), "", str(st.asked.get(disagreement_key(found), "not yet")))
  exhale "${PROJECT_NAME}: versions = ${setting}" + pick(found.is_empty(), "; every pin agrees with this machine", "; ${found.len()} disagree" + pick(found.len() == 1, "s", "") + ", answer: ${answer}")
  for r in rows {
    roll tail = "agrees"
    if not r.agrees {
      if r.how == null {
        tail = "no version manager found (${managers_for(r.var).join(" or ")} would do)"
      } else if manager_has(r.how) {
        tail = "switch via ${r.how.manager} (has ${r.pinned})"
      } else {
        tail = "switch via ${r.how.manager} (does not have ${r.pinned}; cigo versions install)"
      }
    }
    exhale "  ${r.var.pad_right(10)} ${pinned_text(r).pad_right(14)} ${r.source.pad_right(28)} installed ${(r.installed ?? "none").pad_right(12)} " + tail
  }
  if not found.is_empty() {
    exhale "cigo versions switch | keep remembers the answer for this project; --versions=always|never|off, the manifest's \"versions\" or `cigo config versions` sets the rule"
  }
}

# ----- doctor: the toolchains themselves -----------------------------------------------

pull version_in(textv) {
  stick c = text.captures(str(textv), '(\d+(?:\.\d+)+)')
  if c == null {
    snuff null
  }
  snuff c[1]
}

pull read_pin(dir, source) {
  stick at = source.find(":")
  stick file = pick(at < 0, source, source.slice(0, at))
  stick key = pick(at < 0, "", source.slice(at + 1))
  stick t = text_of(dir, file)
  if t == null {
    snuff null
  }
  roll v = null
  if file == ".tool-versions" {
    for line in t.lines() {
      stick parts = line.trim().split()
      if parts.len() >= 2 and parts[0] == key {
        v = parts[1]
      }
    }
  } else if file == "mise.toml" or file == "cigar.toml" {
    stick c = text.captures(t, '(?m)^\s*"?' + key + '"?\s*=\s*"([^"]+)"')
    if c != null {
      v = c[1]
    }
  } else if file == "go.mod" {
    stick c = text.captures(t, '(?m)^go\s+(\S+)')
    if c != null {
      v = c[1]
    }
  } else if file == "build.zig.zon" {
    stick c = text.captures(t, '\.minimum_zig_version\s*=\s*"([^"]+)"')
    if c != null {
      v = c[1]
    }
  } else if file == "global.json" {
    v = dig(json_of(dir, file), key.split("."))
  } else if file == ".sdkmanrc" {
    stick c = text.captures(t, '(?m)^' + key + '=(\S+)')
    if c != null {
      v = c[1]
    }
  } else if file == "rust-toolchain.toml" {
    stick c = text.captures(t, 'channel\s*=\s*"([^"]+)"')
    if c != null {
      v = c[1]
    }
  } else {
    v = t.lines().filter(pack(l) => l.trim() != "" and not l.trim().starts_with("#")).first()
  }
  if v == null {
    snuff null
  }
  roll s = to_text(v).trim()
  if s.starts_with("v") {
    s = s.slice(1)
  }
  # go.mod's go line and Zig's minimum_zig_version are floors, not pins.
  stick minimum = file == "go.mod" or file == "build.zig.zon"
  snuff {value: s, from: pick(dir == ".", file, dir + "/" + file), minimum: minimum}
}

# Does an installed version satisfy a pin? null when the pin is not a number
# (lts/*, stable, system) and cannot be compared.
pull pin_matches(pin, actual, minimum) {
  stick p = text.captures(pin, '^(\d+(?:\.\d+)*)')
  if p == null or actual == null {
    snuff null
  }
  stick want = p[1].split(".").map(pack(x) => int(x))
  stick have = actual.split(".").map(pack(x) => int(x))
  for pair in want.enumerate() {
    stick h = have.get(pair[0], 0)
    if h != pair[1] {
      snuff minimum and h > pair[1]
    }
  }
  snuff true
}

# The programs named by `tool:` conditions in `c` (a condition, or a list of
# them, nested for "any of").
pull tool_words(c) {
  roll out = []
  if type_of(c) == "list" {
    for x in c {
      for w in tool_words(x) {
        out.push(w)
      }
    }
    snuff out
  }
  stick s = str(c)
  if s.starts_with("tool:") {
    out.push(s.slice(5))
  }
  snuff out
}

# The program a var's value starts: the first word of a list, the string
# itself, or "" when the value is neither.
pull program_of(val) {
  if type_of(val) == "list" {
    snuff str(val.get(0, ""))
  }
  if type_of(val) == "string" {
    snuff val
  }
  snuff ""
}

# The programs a var's alternatives ask for, in order, once each: those
# behind `tool:` conditions, and the one a fallback without `when` runs.
pull tools_named(alts) {
  roll out = []
  for alt in as_list(alts) {
    if type_of(alt) != "map" {
      continue
    }
    roll words = tool_words(alt.get("when", []))
    if as_list(alt.get("when", [])).is_empty() and alt.has("value") {
      # A fallback that is another var (`{python}`) answers for that var.
      stick p = program_of(alt.value)
      if not p.starts_with("{") {
        words.push(p)
      }
    }
    for w in words {
      if w != "" and not out.contains(w) {
        out.push(w)
      }
    }
  }
  snuff out
}

# ----- the self-check the installer reads: `cigo __doctor --json` ----------------------
#
# One hidden, read-only entry that never calls ciginstaller (the installer's
# `doctor --tools` calls this, so a call back would loop): the cig floor, the
# launcher and the tool it runs, the guard, what a rehearsal can use, and the
# project's toolchains against its pins. Each finding is
# {check, severity: ok|note|action, found, because, fix: string|null}.

pull doctor_finding(check, severity, found, because, fix) {
  snuff {check: check, severity: severity, found: found, because: because, fix: fix}
}

pull doctor_cig() {
  stick have = cig.version()
  stick ok = cig_pin_ok(CIG_NEEDS, have)
  if ok == false {
    snuff [doctor_finding("cig-floor", "action", "cig ${have}", "cigo ${VERSION} needs cig ${CIG_NEEDS}", "ciginstaller update")]
  }
  if ok == null {
    snuff [doctor_finding("cig-floor", "note", "cig ${have}", "the version could not be compared with cigo's floor, ${CIG_NEEDS}", null)]
  }
  snuff [doctor_finding("cig-floor", "ok", "cig ${have}", "cigo ${VERSION} needs cig ${CIG_NEEDS}", null)]
}

# The launcher and the tool it started, as the launcher exports them.
pull doctor_launcher() {
  stick tool = env.get("CIGO_TOOL", "")
  stick launcher = env.get("CIGO_LAUNCHER", "")
  if tool == "" or launcher == "" {
    snuff [doctor_finding("launcher", "note", "cigo was not started through its launcher", "it was run as `cig run orchestrate.cig`, so the launcher and the installed tool were not looked at", null)]
  }
  roll out = []
  stick checkout = fs.is_dir(path.join(path.dir(tool), ".git")) or fs.is_file(path.join(path.dir(tool), "bin", "cigo"))
  if not fs.is_file(tool) {
    out.push(doctor_finding("tool-file", "action", "${tilde(tool)} is missing", "the launcher started cigo from a tool file that is not there", "ciginstaller install stick cigo"))
  } else if checkout {
    out.push(doctor_finding("tool-file", "note", "cigo runs from a checkout at ${tilde(path.dir(tool))}", "a checkout is updated with `git pull`, not by the installer", null))
  } else {
    out.push(doctor_finding("tool-file", "ok", tilde(tool), "the tool file the launcher runs", null))
  }
  # A launcher named by a relative path is read from where it was started,
  # and the launcher has moved to the project since: not found is not a fault.
  stick absolute = launcher.starts_with("/") or text.matches(launcher, '^[A-Za-z]:[\\/]')
  if not fs.is_file(launcher) {
    out.push(doctor_finding("launcher", pick(absolute, "action", "note"), "${tilde(launcher)} could not be read", "the launcher cigo was started by", pick(absolute, "ciginstaller install stick cigo", null)))
    snuff out
  }
  stick lower = launcher.lower()
  roll named = null
  if not lower.ends_with(".ps1") and not lower.ends_with(".cmd") {
    stick m = text.captures(fs.read_text(launcher).replace("\r\n", "\n"), "(?m)^tool='(.*)'$")
    if m != null {
      named = m[1].replace("'\\''", "'")
    }
  }
  if named != null and not fs.is_file(named) and not checkout {
    out.push(doctor_finding("launcher", "action", "${tilde(launcher)} names ${tilde(named)}, which is gone", "a launcher left from an older install points at a tool file that was removed", "ciginstaller install stick cigo"))
  } else if named != null and named.replace("\\", "/") != tool.replace("\\", "/") {
    out.push(doctor_finding("launcher", "note", "${tilde(launcher)} names ${tilde(named)}, and cigo is running ${tilde(tool)}", "two copies of cigo are installed; the one the launcher names is not the one that ran", null))
  } else {
    out.push(doctor_finding("launcher", "ok", tilde(launcher), "the launcher and the tool agree", null))
  }
  snuff out
}

# The project's toolchains against its pins, and the cig it pins.
pull doctor_project() {
  if not fs.is_file(MANIFEST) {
    snuff [doctor_finding("project", "note", "no ${MANIFEST} in ${tilde(ROOT)}", "there are no project toolchains or version pins to look at here", "cigo adopt")]
  }
  stick g = build_graph(load())
  roll out = []
  stick comps = g.components
  roll by_tc = {}
  for name in comps {
    stick id = to_text(comps[name].toolchain)
    if not by_tc.has(id) {
      by_tc[id] = []
    }
    by_tc[id].push(name)
  }
  for id in by_tc {
    if not g.kb.has(id) {
      out.push(doctor_finding("toolchain:${id}", "action", "${id} is not a toolchain cigo knows (${by_tc[id].join(", ")})", "the manifest names it", "cigo toolchains lists the ones it knows"))
      continue
    }
    stick tc = g.kb[id]
    stick first = comps[by_tc[id].first()]
    stick where = "${id} (${tc.get("language", "")}): ${by_tc[id].join(", ")}"
    stick install_fix = pick(tc.has("install"), str(tc.get("install", "")), null)
    roll all_found = true
    for tool in as_list(tc.get("tools", [])) {
      if which(str(tool)) == null {
        all_found = false
        out.push(doctor_finding("tool:${id}:${tool}", "action", "${tool} is not on PATH", "${where} needs it", install_fix))
      }
    }
    stick vars = vars_for(first.dir, tc, first.name)
    stick defs = tc.get("vars", {})
    for vname in defs {
      stick wanted = tools_named(defs[vname])
      if wanted.is_empty() {
        continue
      }
      stick program = program_of(vars.get(vname, null))
      if program == "" or which(program) == null {
        all_found = false
        out.push(doctor_finding("tool:${id}:${vname}", "action", "none of ${wanted.join(", ")} is on PATH", "${where} needs one of them as ${vname}", install_fix))
      }
    }
    if all_found {
      out.push(doctor_finding("toolchain:${id}", "ok", where, "every tool it needs is on PATH", null))
    }
    stick versions = tc.get("versions", {})
    for vname in versions {
      stick v = probe_version(fill(versions[vname], vars))
      for cname in by_tc[id] {
        stick pin = pin_of(tc, vname, comps[cname].dir)
        if pin == null {
          continue
        }
        stick ok = pin_matches(pin.value, v, pin.minimum)
        stick what = pick(pin.minimum, "needs at least", "pins")
        stick found = "${vname} ${v ?? "unknown"}"
        stick because = "${pin.from} ${what} ${pin.value}"
        if ok == null {
          out.push(doctor_finding("pin:${id}:${vname}", "note", found, because + ": not a version number, not compared", null))
        } else if ok {
          out.push(doctor_finding("pin:${id}:${vname}", "ok", found, because, null))
        } else {
          stick how = switch_for(tc, vname, pin.value)
          roll fix = "install ${managers_for(vname).join(" or ")}, then cigo versions switch"
          if how != null {
            fix = pick(manager_has(how), "cigo versions switch", "cigo versions install")
          }
          out.push(doctor_finding("pin:${id}:${vname}", "action", found, because + ": does not match", fix))
        }
      }
    }
  }
  for p in cig_pins(g) {
    stick have = cig.version()
    stick ok = cig_pin_ok(p.pin, have)
    stick because = "${p.from} pins cig ${p.pin}"
    if ok == null {
      out.push(doctor_finding("pin:cig", "note", "cig ${have}", because + ": not a version pin, not compared", null))
    } else if ok {
      out.push(doctor_finding("pin:cig", "ok", "cig ${have}", because, null))
    } else {
      out.push(doctor_finding("pin:cig", "action", "cig ${have}", because + ": does not match", "ciginstaller update"))
    }
  }
  snuff out
}

# Every finding, in the order a person reads them. A check that cannot finish
# is a finding too: the entry always answers in the shape.
pull doctor_findings() {
  roll out = doctor_cig()
  for part in [pack() => doctor_launcher(), pack() => doctor_guard_findings(), pack() => doctor_rehearse_findings(), pack() => doctor_project()] {
    try {
      out = out + part()
    } ashtray e {
      out.push(doctor_finding("self-check", "action", "a check stopped: ${str(e.get("message", e))}", "cigo could not finish looking at itself", "cigo check"))
    }
  }
  snuff out
}

# `cigo __doctor --json`: read-only, and it never calls ciginstaller.
pull do_self_doctor() {
  expect_flags(["--json"])
  expect_no_targets()
  # A usage error deep in a check throws here instead of ending the process,
  # so the answer is still the one JSON document.
  FAIL_THROWS = true
  stick findings = doctor_findings()
  FAIL_THROWS = false
  exhale json.stringify({tool: "cigo", version: VERSION, findings: findings})
}

pull do_outputs() {
  expect_flags([])
  if not fs.is_file(OUTPUTS_FILE) {
    exhale "no outputs yet: tasks with `capture`, or that write name=value lines to $CIG_OUTPUT, leave theirs here after `cigo run`"
    snuff
  }
  stick all = json.load(OUTPUTS_FILE)
  if targets.is_empty() {
    exhale json.stringify(all, 2)
    snuff
  }
  for name in targets {
    if not all.has(name) {
      fail("no output from `${name}` in the last run; ${pick(all.is_empty(), "nothing handed anything on", "outputs from: " + all.keys().join(", "))}")
    }
    exhale json.stringify(all[name], 2)
  }
}

# ----- the toolchains, listed -------------------------------------------------------------

pull cond_text(c) {
  if type_of(c) == "list" {
    snuff c.map(pack(x) => cond_text(x)).join(" or ")
  }
  stick s = str(c)
  if s.starts_with("not:") {
    snuff "no " + cond_text(s.slice(4))
  }
  stick at = s.find(":")
  if at < 0 {
    snuff s
  }
  stick kind = s.slice(0, at)
  stick arg = s.slice(at + 1)
  if kind == "tool" {
    snuff "`${arg}` on PATH"
  }
  if kind == "grep" or kind == "json" {
    stick sep = arg.find(":")
    snuff "`${arg.slice(0, sep)}` " + pick(kind == "grep", "matching", "with") + " `${arg.slice(sep + 1)}`"
  }
  snuff "`${arg}`"
}

pull stages_text(tc) {
  roll names = STAGES.filter(pack(s) => tc.get("stages", {}).has(s))
  if tc.has("scripts") {
    names.push("${tc.scripts.file} ${tc.scripts.key}")
  }
  if tc.has("targets") {
    names.push("${tc.targets} targets")
  }
  snuff names.join(", ")
}

pull do_toolchains() {
  expect_flags(["--markdown"])
  stick kb = toolchains_for(soft_manifest())
  if not targets.is_empty() {
    for id in targets {
      if not kb.has(id) {
        fail("no toolchain `${id}`; ${close_toolchains(kb, id)}")
      }
      roll shown = kb[id]
      if FOOTPRINTS.has(id) {
        shown = shown.merge({footprints: FOOTPRINTS[id]})
      } else if FOOTPRINTLESS.has(id) {
        shown = shown.merge({footprints: FOOTPRINTLESS[id]})
      }
      exhale "${id}: " + json.stringify(shown, 2)
    }
    snuff
  }
  if flags.contains("--markdown") {
    exhale "# Toolchains"
    exhale ""
    exhale "The ${kb.len()} toolchains cig-orchestrator ${VERSION} knows, written by `cigo toolchains --markdown`"
    exhale "from the knowledge base in `orchestrate.cig`; regenerate it with `cigo run toolchains-doc`"
    exhale "rather than editing it."
    exhale ""
    exhale "A component is a directory and one of these. `cigo adopt` chooses them from"
    exhale "what each directory holds (the *recognized by* column: a comma is *and*, `or`"
    exhale "is *or*), and a project changes any of them or adds its own under `toolchains`"
    exhale "in `cig-tasks.json`. `cigo toolchains <name>` prints one in full: each stage's"
    exhale "commands with the conditions that choose between them, the tools `cigo doctor`"
    exhale "looks for, and the version pins it compares."
    exhale ""
    exhale "| toolchain | language | recognized by | stages |"
    exhale "|---|---|---|---|"
    for id in kb {
      stick tc = kb[id]
      stick seen_by = pick(tc.get("auto", true), as_list(tc.get("detect", [])).map(pack(c) => cond_text(c)).join(", "), "added by hand")
      exhale "| `${id}` | ${tc.get("language", "")} | ${seen_by.replace("|", "\\|")} | ${stages_text(tc)} |"
    }
    stick noted = kb.keys().filter(pack(id) => str(kb[id].get("note", "")) != "")
    if not noted.is_empty() {
      exhale ""
      exhale "## Notes"
      exhale ""
      for id in noted {
        exhale "- `${id}`: ${kb[id].note}."
      }
    }
    snuff
  }
  stick width = kb.keys().map(pack(k) => k.len()).max()
  exhale "${kb.len()} toolchains; `cigo toolchains <name>` shows one in full"
  for id in kb {
    stick tc = kb[id]
    exhale "  ${id.pad_right(width)}  ${str(tc.get("language", "")).pad_right(28)}  ${stages_text(tc)}"
  }
}

# ----- cigo's own state: ~/.cig-orchestrator ----------------------------------------------
#
# cig keeps its runs, crashes and config under ~/.cigscript; cigo keeps its
# crash reports, config and update downloads under ~/.cig-orchestrator
# (CIGO_HOME). The script's pack is the project, so anything written there
# goes through a hop (`sh -c`), outside the pack and outside the journal: a
# crash report has to survive the rollback that follows the crash.

stick CIGO_HOME = env.get("CIGO_HOME", path.join(fs.home(), ".cig-orchestrator"))

# ----- the guard: what a task is about to run, read before it runs -----------------------
#
# Before a task runs, the guard asks cheap questions in order. Is this exact
# task approved already (its command as written, the scripts it names, its
# component's lockfiles, hashed into one key)? What do its own text and its
# install hooks say, against patterns real attacks use (the rules, as data,
# scored per category)? The verdict's friction matches the risk: none and
# low run; medium and high are held at a terminal until approved (`cigo
# trust <task>`, or `--accept-risk` for one run) and run with the report
# unattended (security = strict fails high there); critical is refused, and
# `--run-untrusted=<task>` runs it anyway at a terminal. An approval is one
# of cig's passes, made under a key derived from the tin's, which nothing a
# task runs can reach: in the box the keys folder is empty.

stick TRUST_DIR = path.join(CIGO_HOME, "trust")
stick TRUST_LABEL = "cigo-trust"
# Bytes a person allowed (cigo guard allow <file|sha256>, #57).
stick ALLOW_DIR = path.join(CIGO_HOME, "allowed")
stick ALLOW_LABEL = "cigo-allow"
# Answers to ask-tier questions, kept by the sha256 of the bytes the
# question was about (a command line, a file's new text). A later ask for
# the same bytes reads here first and does not ask again. Each record is
# signed with the tin's key under its own label, so a task cannot write
# its own permission slip (the key folder is empty in the box).
stick REMEMBER_DIR = path.join(CIGO_HOME, "remembered")
stick REMEMBER_LABEL = "cigo-remembered"

# ----- passes (cig-script#186): what cigo keeps, held by cig ---------------------------
#
# Every yes cigo keeps, and every file it must not take from anyone else, is
# held by one of cig's passes: made in process under a key derived from the
# tin's, which nothing a task runs can reach (in the box the keys folder is
# an empty tmpfs), and checked in process. An approval of a task records the
# files the task names as the pass's inputs, so a changed byte in any of
# them stops it holding. A file cigo writes (a blacklist list, its allows,
# the one-off exceptions, an allowance, a remembered answer, an agent's
# approval, a kept verdict) is held by a pass over its bytes, named beside it
# in `<file>.pass`. Records from before passes, signed by `cig tin mac`
# beside a `.mac`, are checked once and moved onto a pass.

# A yes is about the bytes or the task it names, not about the cig or the
# cigo that asked.
stick PASS_OPTS = {code: false, cig: false}
roll PASS_NOTED = false

# Said once a run: cig's pass state cannot be read here.
pull pass_note(e) {
  if not PASS_NOTED {
    PASS_NOTED = true
    log.warn("cig's passes cannot be read here (" + clip(str(e.message), 200) + "), so nothing cigo kept counts this run; cig doctor says why")
  }
}

# The newest pass of `kind` for `subject` that holds now, or null.
pull pass_found(kind, subject) {
  try {
    snuff pass.find(kind, subject, PASS_OPTS)
  } ashtray e {
    pass_note(e)
    snuff null
  }
}

# `cig pass revoke <id>`: true when it took (a dry run takes nothing).
pull pass_revoke(id) {
  if str(id ?? "") == "" {
    snuff false
  }
  roll r = null
  burn {
    try {
      r = proc.run("cig", ["pass", "revoke", str(id)], {timeout_ms: 30000})
    } ashtray e {
      r = {code: -1}
    }
  }
  snuff r.code == 0 or r.get("simulated", false)
}

# A file's pass is about the file, by its full path, under the label of the
# store it belongs to.
pull signed_subject(label, file) {
  snuff {v: "cigo-signed-1", label: label, file: path.abs(file)}
}

# Where a file's signature from before passes was kept: `<key>.mac` beside a
# record `<key>.json`, `<file>.mac` beside anything else (a list).
pull legacy_mac(file) {
  if file.ends_with(".json") {
    snuff file.slice(0, file.len() - 5) + ".mac"
  }
  snuff file + ".mac"
}

# What a signed file's pass reads: the file, whole, as bytes.
pull signed_work(s) {
  snuff {file: s.file, sha256: hash.sha256_file(s.file)}
}

# The id of the pass a `<file>.pass` beside a file names, or "" unless it is
# a pass of `kind` whose one file input is that very file: a `.pass` written
# by hand or copied from elsewhere names nothing cigo will revoke.
pull sidecar_id(file, kind) {
  stick side = file + ".pass"
  if not fs.is_file(side) {
    snuff ""
  }
  try {
    stick sh = pass.show(fs.read_text(side).trim())
    stick files = as_list(sh.get("inputs", [])).filter(pack(i) => str(i.get("kind", "")) == "file")
    if sh.kind == kind and files.len() == 1 and str(files[0].get("name", "")) == path.abs(file) {
      snuff str(sh.id)
    }
  } ashtray e {
  }
  snuff ""
}

# A file whose signature from before passes moved onto a pass is marked by
# a pass of its own, which reads nothing and so holds until it is revoked:
# a `.mac` put back for that file later is never honored again.
pull legacy_moved_subject(label, file) {
  snuff {v: "cigo-legacy-moved-1", label: label, file: path.abs(file)}
}

pull legacy_moved(label, file) {
  snuff pass_found("approval", legacy_moved_subject(label, file)) != null
}

pull mark_legacy_moved(label, file) {
  try {
    pass.issue("approval", legacy_moved_subject(label, file), pack(s) => {moved: s.file}, PASS_OPTS)
  } ashtray e {
    snuff false
  }
  snuff true
}

# Sign a file as it is now: a pass of `kind` over its bytes, named beside it
# in `<file>.pass` (its token). The pass it was signed with before is revoked
# first, so an older copy of the file put back does not verify again; its
# signature from before passes goes. {ok, err}.
pull sign_file(file, label, kind) {
  stick side = file + ".pass"
  stick old = sidecar_id(file, kind)
  if old != "" and not pass_revoke(old) {
    snuff {ok: false, err: "the pass it was signed with before could not be revoked (cig pass revoke)"}
  }
  roll p = null
  try {
    p = pass.issue(kind, signed_subject(label, file), pack(s) => signed_work(s), PASS_OPTS)
  } ashtray e {
    snuff {ok: false, err: str(e.message)}
  }
  if not write_outside(side, str(p.get("token", null) ?? "") + "\n") {
    snuff {ok: false, err: "could not write " + tilde(side)}
  }
  if fs.is_file(legacy_mac(file)) {
    remove_outside(legacy_mac(file))
  }
  snuff {ok: true, err: ""}
}

# Is this file signed as it is now? "ok" (a pass for it holds, or a `.mac`
# from before passes verified and the file moved onto a pass), "changed" (the
# file changed since it was signed, or the `.pass` beside it is not this
# file's), "revoked" (its pass was revoked or ran out: cig pass revoke, a
# rekey, a new cig for a verdict), "forged" (a `.mac` that does not verify
# under this machine's key), "unchecked" (a `.mac` this cig cannot check) or
# "gone" (no file, or no signature beside it).
pull signed_state(file, label, kind) {
  if not fs.is_file(file) {
    snuff "gone"
  }
  if pass_found(kind, signed_subject(label, file)) != null {
    snuff "ok"
  }
  stick mac = legacy_mac(file)
  if fs.is_file(mac) {
    # Moved onto a pass already: a `.mac` put back is not honored again.
    if legacy_moved(label, file) {
      snuff "forged"
    }
    stick before = hash.sha256_file(file)
    stick r = tin_mac_as(file, fs.read_text(mac).trim(), label)
    if r.code == 1 {
      snuff "forged"
    }
    if r.code != 0 {
      snuff "unchecked"
    }
    # The `.mac` vouched for these bytes, and they move onto a pass. If the
    # file changed between the check and the pass, neither is trusted.
    roll p = null
    try {
      p = pass.issue(kind, signed_subject(label, file), pack(s) => signed_work(s), PASS_OPTS)
    } ashtray e {
      # Honored this once; the `.mac` stays until a pass can be made.
      snuff "ok"
    }
    if str(dig(p, ["result", "sha256"]) ?? "") != before {
      pass_revoke(p.get("id", null))
      snuff "forged"
    }
    # Without the mark, a copy of the `.mac` put back later would verify
    # again: the `.mac` stays (honored this once) until the mark is made.
    if mark_legacy_moved(label, file) and write_outside(file + ".pass", str(p.get("token", null) ?? "") + "\n") {
      remove_outside(mac)
    }
    snuff "ok"
  }
  stick side = file + ".pass"
  if fs.is_file(side) {
    roll c = null
    try {
      c = pass.check(fs.read_text(side).trim())
    } ashtray e {
      # Not a pass at all: written by hand.
      snuff "changed"
    }
    # It holds, but not for this file: a `.pass` from somewhere else.
    if c.get("ok", false) {
      snuff "changed"
    }
    snuff pick(str(c.get("why", "") ?? "").contains(path.base(file)), "changed", "revoked")
  }
  snuff "gone"
}

# How a signed file that no longer verifies came to be, for its E587 line.
pull unverified_how(file, label, kind) {
  if signed_state(file, label, kind) == "revoked" {
    snuff "its pass was revoked (cig pass revoke, or cig tin rekey)"
  }
  snuff "was changed outside cigo blacklist"
}

# The pass a signed file names beside it (`<file>.pass`), revoked: the file
# itself may be restored from a copy, and its pass must not hold again.
# False when the revoke did not take (the `.pass` stays).
pull unsign_file(file, kind) {
  stick side = file + ".pass"
  stick id = sidecar_id(file, kind)
  if id != "" and not pass_revoke(id) {
    snuff false
  }
  if fs.is_file(side) {
    remove_outside(side)
  }
  if fs.is_file(legacy_mac(file)) {
    remove_outside(legacy_mac(file))
  }
  snuff true
}

# ----- the tier matrix: risk × confidence → silent / notice / ask / refuse / gate
#
# One table, read at every place the guard would ask or refuse. The tier
# is what reaches the user: silent (nothing, in the log), notice (one line,
# no question, the work carries on), ask (a question with a safe default),
# refuse (refused, said in one line: #66's "act + notice"), gate (the
# question plus OS authentication: today, running something on your own
# blacklist). The caller applies the tier; the agent hook has no terminal,
# so a gate is refused there. These defaults are what cigo did before the
# table existed, cell for cell: #66's own table asks or gates some critical
# findings it is less sure of, and makes a confident high or medium one a
# refusal, which changes what the guard lets through, so it waits for the
# operator's word (otmof-ops/cig-script#153).

stick TIER_MATRIX = {
  critical: {exact: "gate",   high: "refuse", medium: "refuse", low: "refuse"},
  high:     {exact: "ask",    high: "ask",    medium: "ask",    low: "ask"},
  medium:   {exact: "notice", high: "notice", medium: "notice", low: "notice"},
  low:      {exact: "silent", high: "silent", medium: "silent", low: "silent"},
  none:     {exact: "silent", high: "silent", medium: "silent", low: "silent"},
}
stick TIER_CONFIDENCES = ["exact", "high", "medium", "low"]
stick TIER_RISKS = ["none", "low", "medium", "high", "critical"]

# The confidence in a set of findings: exact (a blacklist hit: the user
# named it, no inference), high (a heavy pattern or a known-bad package
# at weight 1.0), medium (weight at least 0.5), low (a lighter pattern).
# The top finding sets it. A known-bad package (E870) is not "exact":
# exact carries the two-warnings gate flow, which is for the user's own
# blacklist; an OSV malicious-package finding refuses outright.
pull confidence_of(findings) {
  if findings.is_empty() {
    snuff "low"
  }
  for f in findings {
    stick c = str(f.get("code", ""))
    if c == "E580" {
      snuff "exact"
    }
  }
  roll top = 0.0
  for f in findings {
    stick w = f.get("w", 0.0)
    if w > top {
      top = w
    }
  }
  if top >= 0.8 {
    snuff "high"
  }
  if top >= 0.5 {
    snuff "medium"
  }
  snuff "low"
}

# The tier for a verdict: TIER_MATRIX[risk][confidence], silent for an
# unknown risk (so nothing is prompted on a signal that cannot be read).
pull tier_for(risk, findings) {
  stick row = TIER_MATRIX.get(str(risk), null)
  if row == null {
    snuff "silent"
  }
  snuff row.get(confidence_of(findings), "silent")
}

# The key a remembered answer is kept under: the sha256 of the bytes the
# question was about. One byte of a difference is a different key, so a
# changed command or a changed file is asked again.
pull remember_key(content) {
  snuff hash.sha256(str(content))
}

pull remember_files(key) {
  snuff {json: path.join(REMEMBER_DIR, key + ".json"), mac: path.join(REMEMBER_DIR, key + ".mac")}
}

# Is this content remembered? The record counts only while its pass holds
# (its bytes as cigo wrote them, under this machine's key), so one written
# from outside the machine, or by a task, does not count. One from before
# passes whose `.mac` does not verify is said (E889).
pull remembered(content) {
  stick f = remember_files(remember_key(content))
  stick st = signed_state(f.json, REMEMBER_LABEL, "approval")
  if st == "forged" or st == "changed" {
    log.warn("E889 a remembered answer is not signed by your key (${tilde(f.json)}); ignored")
  }
  snuff st == "ok"
}

# Write a remembered yes and keep it with a pass. False when it could not be
# kept: the caller falls through to its own flow.
pull remember_yes(content, scope, by, reason) {
  stick key = remember_key(content)
  stick f = remember_files(key)
  stick rec = {key: key, scope: scope, by: by, reason: reason, at: time.now_iso(), size: str(content).len()}
  if not write_outside(f.json, json.stringify(rec, 2) + "\n") {
    snuff false
  }
  if not sign_file(f.json, REMEMBER_LABEL, "approval").ok {
    remove_outside(f.json)
    snuff false
  }
  snuff true
}
stick SCRIPT_EXTS = [".sh", ".bash", ".zsh", ".py", ".js", ".mjs", ".cjs", ".ts", ".rb", ".pl", ".ps1", ".cig"]
# The scripts whose text the static read looks into: a CigScript file is
# left to cig (its effects run under cig's own journal), and a rule table
# would match itself.
stick SCAN_EXTS = [".sh", ".bash", ".zsh", ".py", ".js", ".mjs", ".cjs", ".ts", ".rb", ".pl", ".ps1"]
stick LOCKFILES = ["package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb", "deno.lock", "uv.lock", "poetry.lock", "pdm.lock", "Pipfile.lock", "requirements.txt", "Cargo.lock", "go.sum", "Gemfile.lock", "composer.lock", "gradle.lockfile", "packages.lock.json"]
stick RISKS = ["none", "low", "medium", "high", "critical"]

# The static read's rules: a pattern real attacks use, its code, its
# category and its weight. Scored per category, never summed blindly.
stick RULES = [
  {id: "fetch-run-sh", code: "E874", cat: "fetch-and-run", w: 0.6, re: '(curl|wget)\s[^|\n]*\|\s*(sudo\s+)?(ba|z|da)?sh\b', says: "downloads and runs whatever that server sends today"},
  {id: "fetch-run-iex", code: "E874", cat: "fetch-and-run", w: 0.6, re: '(?i)\b(iwr|invoke-webrequest|invoke-restmethod)\b[^|\n]*\|\s*iex\b', says: "downloads and runs whatever that server sends today"},
  {id: "fetch-run-python", code: "E874", cat: "fetch-and-run", w: 0.6, re: 'python3?\s+-c\s+.{0,4}\$\((curl|wget)\s', says: "runs code fetched from the network"},
  {id: "fetch-run-http", code: "E874", cat: "fetch-and-run", w: 0.8, re: '(curl|wget)\s[^|\n]*\bhttp://[^|\n]*\|\s*(sudo\s+)?(ba|z|da)?sh\b', says: "downloads and runs a script over plain http, which anyone on the way can swap"},
  {id: "fetch-run-staged", code: "E874", cat: "fetch-and-run", w: 0.7, re: '(curl|wget)\s[^\n]*(-o|-O|--output(-document)?)[=\s]*\S+[^\n]*&&\s*chmod\s+([ugoa]*\+x|[0-7]{3,4})\s+\S+[^\n]*&&\s*["\x27]?(\.{0,2}/|\$)', says: "downloads a program, marks it executable and runs it"},
  {id: "fetch-run-code", code: "E874", cat: "fetch-and-run", w: 0.7, re: '\b(exec|eval|compile)\s*\(\s*(urllib\.request\.)?urlopen\(|\b(exec|eval)\s*\(\s*requests\.get\(|\beval\s*\(\s*await\b[^\n]*\bfetch\(|\bnew\s+Function\s*\([^\n]*\bfetch\(', says: "runs code it fetched from the network"},
  {id: "obf-decode-run", code: "E875", cat: "obfuscation", w: 0.7, re: 'base64\s+(-d|--decode)[^\n]*\|\s*(sudo\s+)?(ba|z|da)?sh\b|\beval\s*\(\s*(atob|Buffer\.from)\s*\(|\bexec\s*\(\s*(base64\.b64decode|bytes\.fromhex|codecs\.decode)', says: "decodes something and runs it, so the text cannot be read as it is"},
  {id: "obf-charcodes", code: "E875", cat: "obfuscation", w: 0.6, re: 'String\.fromCharCode\((\s*\d+\s*,){8,}|(\\x[0-9a-fA-F]{2}){16,}', says: "code assembled from character codes or hex escapes"},
  {id: "cred-ssh", code: "E871", cat: "credentials", w: 0.8, re: '(~|\$HOME|%USERPROFILE%)[/\\]+\.ssh([/\\]*(\*|id_[A-Za-z0-9_]+)?)(\s|$|["\x27;|&)])|/\.ssh/id_[A-Za-z0-9_]+(\s|$|["\x27;|&)])', says: "names an SSH private key, or the whole folder"},
  {id: "cred-cloud", code: "E871", cat: "credentials", w: 0.8, re: '\.aws[/\\]credentials|\.config[/\\]gcloud|\.azure[/\\]|\.kube[/\\]config|\.docker[/\\]config\.json|\.git-credentials|(~|\$HOME)[/\\]\.netrc\b|(~|\$HOME)[/\\]\.npmrc\b|\.pypirc\b|\.cargo[/\\]credentials', says: "names a cloud, registry or git credential file"},
  {id: "cred-browser", code: "E871", cat: "credentials", w: 0.7, re: '(Login Data|logins\.json|key[34]\.db|Local State|[Cc]ookies(\.sqlite)?)\b|\.mozilla[/\\]firefox[/\\]|google-chrome[/\\]|chromium[/\\]|BraveSoftware[/\\]|Microsoft[/\\]Edge[/\\]|Library[/\\](Safari|Keychains)\b|\.password-store\b|\b(1Password|Bitwarden|KeePassXC?)\b', says: "names a browser's profile or credential store, a keychain or a password manager's"},
  {id: "persist-rc", code: "E873", cat: "persistence", w: 0.8, re: '>>?\s*(~|\$HOME|%USERPROFILE%)[/\\]\.(bashrc|bash_profile|profile|zshrc|zprofile|zshenv)\b|\.config[/\\]fish[/\\]config\.fish', says: "writes a shell startup file, which runs again at every login"},
  {id: "persist-sched", code: "E873", cat: "persistence", w: 0.8, re: '\bcrontab\s+-|/etc/cron\.|[/\\]systemd[/\\]user[/\\]|LaunchAgents[/\\]|CurrentVersion\\Run\b|\\Startup\\|schtasks\s+/create', says: "schedules itself to run again later"},
  {id: "persist-hook", code: "E873", cat: "persistence", w: 0.8, re: '\.git[/\\]hooks[/\\]', says: "writes a git hook, which runs on the next commit or push"},
  {id: "exfil-sites", code: "E872", cat: "exfiltration", w: 0.8, re: '(?i)(pastebin\.com|transfer\.sh|ngrok\.io|requestbin|webhook\.site|pipedream\.net|hooks\.slack\.com|discord(app)?\.com/api/webhooks|api\.telegram\.org/bot|burpcollaborator|oastify\.com)', says: "talks to a paste site, a webhook catcher or a chat webhook"},
  {id: "exfil-env", code: "E872", cat: "exfiltration", w: 0.9, re: '\b(env|printenv)\b\s*\|\s*(curl|wget|nc|ncat|socat)\b|\b(curl|wget)\s[^\n]*(-d|--data[a-z-]*|-F|--form|--post-data)[=\s]*["\x27]?[^"\x27\n]*\$\{?[A-Za-z_]*(TOKEN|SECRET|PASSWORD|API_?KEY|ACCESS_?KEY)', says: "sends the environment, or a secret from it, to the network"},
  {id: "cred-env", code: "E871", cat: "credentials", w: 0.9, re: '\b(env|printenv)\b\s*\|\s*(curl|wget|nc|ncat|socat)\b|\b(curl|wget)\s[^\n]*(-d|--data[a-z-]*|-F|--form|--post-data)[=\s]*["\x27]?[^"\x27\n]*\$\{?[A-Za-z_]*(TOKEN|SECRET|PASSWORD|API_?KEY|ACCESS_?KEY)', says: "reads the environment's secrets to send them"},
  {id: "exfil-socket", code: "E872", cat: "exfiltration", w: 0.6, re: '\|\s*(nc|ncat|socat|telnet)\s|\bopenssl\s+s_client\b', says: "pipes into a raw network connection"},
  {id: "rev-shell", code: "E872", cat: "remote-control", w: 1.0, re: '/dev/(tcp|udp)/|\b(ba|z|da)?sh\s+-i\b[^\n]*[<>]&|\bpty\.spawn\(', says: "opens a shell to someone else's machine: a reverse shell"},
  {id: "exfil-rawip", code: "E872", cat: "exfiltration", w: 0.6, re: 'https?://(\d{1,3}\.){3}\d{1,3}(:\d+)?(/|\s|$)', says: "talks to a raw address rather than a named host"},
  {id: "destr-rm", code: "E877", cat: "destructive", w: 0.9, re: '\brm\s+(-[a-zA-Z]*r[a-zA-Z]*\s+|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*\s+)(--\s+)?["\x27]?(/\*?|~/?\*?|\$\{?HOME\}?/?\*?|\*)(\s|$|["\x27;&|])', says: "removes the home, the root or everything here, recursively"},
  {id: "priv-sudo", code: "E878", cat: "privilege", w: 0.6, re: '(^|[;&|(\s])(sudo|doas)\s|\bchmod\s+[ugoa]*\+s\b|\bsetuid\s*\(', says: "asks for root in a step that has no business becoming root"},
  {id: "priv-setid", code: "E878", cat: "privilege", w: 0.8, re: '\bchmod\s+([ugoa]*\+[rwx]*s[rwx]*|0?[2-7][0-7]{3})\s|\bsetcap\s', says: "makes a set-id file, or gives a program capabilities: it runs with rights its caller does not have"},
  {id: "priv-setid-shell", code: "E878", cat: "backdoor", w: 1.0, re: '\bcp\s+/(usr/)?bin/(ba|z|da|k)?sh\s+\S+[^\n]*\bchmod\s+[ugoa]*\+[rwx]*s', says: "makes a set-id copy of a shell: a way back in with its owner's rights"},
  {id: "self-tin", code: "E879", cat: "self-defense", w: 1.0, re: '\b(rm|unlink|mv|cp|chmod|chown|truncate|shred|rmdir|del|tee)\s[^\n]*\.cig(script|-orchestrator)[/\\](tin|runs|keys|config|inbox|trust)\b|>\s*[^\s]*\.cig(script|-orchestrator)[/\\](tin|runs|keys|config|inbox|trust)\b|\b(p?kill|killall)\s+[^\n]*\b(cig|cigo)\b', says: "acts on cig's or cigo's own state, or kills them by name"},
  {id: "self-guard", code: "E897", cat: "self-defense", w: 1.0, re: '(?:\b(?:sed\s+(?:-[a-zA-Z]*i[a-zA-Z]*|--in-place)\S*|rm|unlink|mv|cp|tee|truncate|shred|chmod|chown|chattr|ln|install|rsync|dd|perl\s+-[a-zA-Z]*i\S*)\b[^\n;|&]*|>>?\s*)["\x27]?(?:~|\$HOME|\$\{HOME\}|/home/[^/\s"\x27]+|/root)?/?\.?(?:claude/settings(?:\.local)?\.json|config/cigscript\b|cig-orchestrator\b|cigscript\b|local/share/cig-orchestrator\b|local/bin/cigo?\b)', says: "changes the guard's own files (the hook's settings, cigscript's config and blacklists, cig's and cigo's own folders)"},
  {id: "pi-addressed", code: "E886", cat: "prompt-injection", w: 0.7, re: '(?i)\b(ignore|disregard)\s+(all\s+|any\s+|the\s+)?(previous|prior|above|earlier)\s+(instructions|prompts|rules)|\byou are (an?|the) (ai|assistant|language model)\b|\bas an ai\b|\bsystem prompt\b|<\|im_start\|>|\[INST\]|<<SYS>>', says: "text addressed to an AI agent, telling it what to do"},
  {id: "pi-invisible", code: "E887", cat: "prompt-injection", w: 0.8, re: '[\x{E0020}-\x{E007F}]{4,}|[\x{200B}\x{200C}\x{200D}\x{2060}]{3,}|[\x{202A}-\x{202E}\x{2066}-\x{2069}]', says: "invisible Unicode text, which a reader cannot see and an agent can"},
  {id: "pi-template", code: "E886", cat: "prompt-injection", w: 0.7, re: '<\|(start_header_id|end_header_id|eot_id|system|user|assistant|tool_call|im_end)\|>|</?(tool_call|function_calls|tool_use)>', says: "a chat template or a tool call written into text, to pass as the agent's own conversation"},
  {id: "pi-image", code: "E886", cat: "prompt-injection", w: 0.7, re: '!\[[^\]\n]*\]\(\s*https?://[^)\s]*[?&][^)\s=]+=[^)\s]*(\$\{?[A-Za-z_]|\{\{|%7[Bb])', says: "a Markdown image whose address carries data out the moment an agent shows it"},
  {id: "pi-homoglyph", code: "E887", cat: "prompt-injection", w: 0.6, re: '\b[A-Za-z_]+[\x{0370}-\x{03FF}\x{0400}-\x{04FF}]+[A-Za-z_]*\b|\b[\x{0370}-\x{03FF}\x{0400}-\x{04FF}]+[A-Za-z_]+\b', says: "a word mixing Latin with look-alike Cyrillic or Greek letters, which reads as one name and is another"},
  {id: "evade-container", code: "E888", cat: "evasion", w: 0.5, re: '/proc/(1|self)/cgroup\b|/\.dockerenv\b|/run/\.containerenv\b|\bsystemd-detect-virt\b|/sys/class/dmi/id/(product_name|sys_vendor|board_vendor)\b|\bdmidecode\b[^\n]*-s\s+system-', says: "checks whether it runs in a container or a virtual machine, as code that behaves when watched does"},
  {id: "evade-sleep", code: "E888", cat: "evasion", w: 0.4, re: '(^|[;&|(\s])sleep\s+(\d{3,}|[3-9]\d)\b|\btime\.sleep\(\s*(\d{3,}|[3-9]\d)(\.\d+)?\s*\)|\bsetTimeout\([^\n]*,\s*\d{5,}\s*\)', says: "waits half a minute or more before it goes on, which outlasts a quick look"},
]

# A JavaScript line with what it builds at run time written out: char
# codes as the string they make, string pieces joined, an array of
# literals joined by a literal, the home folder as `~` (#80).
pull js_norm(line) {
  roll t = line
  roll guard = 0
  while guard < 12 {
    guard += 1
    roll before = t
    stick cc = text.captures(t, 'String\.fromCharCode\(\s*((?:\d+\s*,\s*)*\d+)\s*\)')
    if cc != null {
      roll str_ = ""
      for n in cc[1].split(",") {
        stick v = int(n.trim())
        if v >= 32 and v < 127 {
          str_ = str_ + byte_char(v)
        }
      }
      t = t.replace(cc[0], "'" + str_ + "'")
    }
    stick cat = text.captures(t, '(?:\x27([^\x27\\]*)\x27|"([^"\\]*)")\s*\+\s*(?:\x27([^\x27\\]*)\x27|"([^"\\]*)")')
    if cat != null {
      t = t.replace(cat[0], "'" + str(cat.get(1, null) ?? cat.get(2, null) ?? "") + str(cat.get(3, null) ?? cat.get(4, null) ?? "") + "'")
    }
    t = text.replace(t, '\b(?:\w+\.)?homedir\(\)|process\.env\.HOME\b', "'~'")
    stick arr = text.captures(t, '\[\s*((?:[\x27"][^\x27"]*[\x27"]|\d+)(?:\s*,\s*(?:[\x27"][^\x27"]*[\x27"]|\d+))*)\s*\]\.join\(\s*(?:\x27([^\x27]*)\x27|"([^"]*)")\s*\)')
    if arr != null {
      stick parts = text.find_all(arr[1], '[\x27"][^\x27"]*[\x27"]|\d+').map(pack(x) => x.replace("'", "").replace("\"", ""))
      t = t.replace(arr[0], "'" + parts.join(str(arr.get(2, null) ?? arr.get(3, null) ?? "")) + "'")
    }
    if t == before {
      break
    }
  }
  snuff t
}

# A raw address written as a literal next to a socket being opened: a call
# out the read can see once the pieces are joined.
stick CODE_RAWIP_RE = '[\x27"](?:\d{1,3}\.){3}\d{1,3}[\x27"][^\n]*\b(?:connect|createConnection|Socket|request|fetch|get)\s*\(|\b(?:connect|createConnection|Socket)\s*\([^\n]*[\x27"](?:\d{1,3}\.){3}\d{1,3}[\x27"]'

# One line of character for the top finding at a terminal; plain words
# everywhere else and under every headline. Rotated so the same code does
# not say the same thing twice in a row.
stick HEADLINES = {
  E871: ["going through your pockets", "fingers in the till"],
  E872: ["tried to pass it out the window", "calling someone it shouldn't"],
  E873: ["trying to move in", "left a lit one where it will be found again"],
  E874: ["rolling unknown leaf", "lighting whatever the server sends"],
  E875: ["can't read the label", "the wrapper hides the contents"],
  E876: ["these were your files once"],
  E877: ["torching the place"],
  E878: ["asking for the good stuff", "wants the keys to the cabinet"],
  E879: ["eyeing the tin", "going for the stash"],
  E881: ["one letter off the real one", "a draw that reads like the real pack"],
  E882: ["still warm from the press", "the ink is not dry on this one"],
  E883: ["new recipe, this batch", "a line this blend never carried before"],
  E884: ["no label on the pack", "no address on the carton"],
  E886: ["someone's whispering to your agent"],
  E887: ["fine print in invisible ink"],
  E888: ["checking for cops before it lights up"],
  E580: ["this one's on the bad batch list", "you said never again to this one"],
}
stick PLAIN = {E580: "on the blacklist", E871: "credential file named", E872: "exfiltration pattern", E873: "persistence", E874: "downloads and executes remote code", E875: "obfuscated code", E876: "ransomware shape", E877: "destructive command", E878: "privilege escalation", E879: "references cig's or cigo's own state", E886: "text addressed to AI agents", E887: "invisible or look-alike text", E888: "probes for a sandbox", E881: "a typosquat of a popular package", E882: "a recently published version", E883: "a new install script this version adds", E884: "no linked source repository"}
roll SAID = {}

pull guard_on() {
  snuff config().security != "off" and not flags.contains("--no-guard")
}

pull voice() {
  snuff attended() and not flags.contains("--plain") and not flags.contains("--json")
}

# `--flag` alone is "*", `--flag=value` is the value, absent is null.
pull guard_flag(name) {
  for f in flags {
    if f == name {
      snuff "*"
    }
    if f.starts_with(name + "=") {
      snuff f.slice(name.len() + 1)
    }
  }
  snuff null
}

pull task_cwd(t) {
  stick cwd = str(t.get("cwd", "."))
  snuff pick(cwd == "", ".", cwd)
}

pull task_dir(t) {
  stick cwd = task_cwd(t)
  snuff pick(cwd == ".", ROOT, path.join(ROOT, cwd))
}

# Every word a task's command is made of, as written in the manifest.
pull task_words(t) {
  roll words = []
  if t.has("cmd") {
    words = words + as_list(argv_of(t.cmd) ?? []).map(pack(w) => str(w))
  }
  if t.has("cmds") {
    for c in as_list(t.cmds) {
      words = words + as_list(argv_of(c) ?? []).map(pack(w) => str(w))
    }
  }
  if t.has("shell") {
    words = words + str(t.shell).split(" ")
  }
  snuff words
}

# The script files a task names that are here: part of what it is.
# Whether a word could name a file here. A URL (`curl https://example.invalid/x.sh | sh`) is a
# file nowhere, and on Windows a name with `:` past a drive letter, or with `<>|?*`, cannot even
# be looked at. Such a word is never looked at: a pass records every path its work looks at,
# there or not (cig-script#186), and a path Windows refuses to look at would stop the pass from
# being issued, so the approval would not be kept.
pull could_be_file(w) {
  if w.contains("://") {
    snuff false
  }
  if cig.os() == "windows" {
    roll rest = w
    if w.len() >= 2 and w.slice(1, 2) == ":" {
      rest = w.slice(2)
    }
    if rest.contains(":") or ["<", ">", "|", "?", "*"].any(pack(c) => rest.contains(c)) {
      snuff false
    }
  }
  snuff true
}

pull task_files(t) {
  roll files = []
  stick dir = task_dir(t)
  for w in task_words(t) {
    stick clean = w.replace('"', "").replace("'", "").replace(";", "")
    if SCRIPT_EXTS.any(pack(e) => clean.ends_with(e)) and could_be_file(clean) {
      stick p = pick(path.is_abs(clean), clean, path.join(dir, clean))
      if fs.is_file(p) and not files.contains(p) {
        files.push(p)
      }
    }
  }
  snuff files
}

# The lockfiles beside the task and at the project root: what a setup
# stage resolves to.
pull task_lockfiles(t) {
  roll found = []
  for dir in [task_dir(t), ROOT] {
    for name in LOCKFILES {
      stick p = path.join(dir, name)
      if fs.is_file(p) and not found.contains(p) {
        found.push(p)
      }
    }
  }
  snuff found
}

pull file_digest(p) {
  try {
    snuff hash.sha256(fs.read_text(p))
  } ashtray e {
    snuff "unreadable"
  }
}

# The trust key: what the task is, hashed. Its command as written, the
# names of its environment, the scripts it names, its lockfiles. One byte
# of any of them changes the key, so a version is checked once, never
# every run.
pull trust_key(t, name) {
  roll parts = ["cigo-trust-1", name]
  for k in ["cmd", "shell", "cmds", "cwd", "rm", "each", "stdin", "stdin_from"] {
    if t.has(k) {
      parts.push(k + "=" + json.stringify(t[k]))
    }
  }
  stick envs = t.get("env", {})
  if type_of(envs) == "map" {
    parts.push("env=" + envs.keys().sort().join(","))
  }
  for f in task_files(t) {
    parts.push("file:" + f + "=" + file_digest(f))
  }
  for f in task_lockfiles(t) {
    parts.push("lock:" + f + "=" + file_digest(f))
  }
  snuff hash.sha256(parts.join("\n"))
}

pull trust_files(key) {
  snuff {json: path.join(TRUST_DIR, key + ".json"), mac: path.join(TRUST_DIR, key + ".mac")}
}

# `cig tin mac`: a MAC under a subkey of the tin's key for cigo's label, or
# a check of one. Exit 0 is a MAC (or a match), 1 a mismatch, anything else
# a cig that cannot (before 1.11.0, or no key here).
pull tin_mac(file, check) {
  snuff tin_mac_as(file, check, TRUST_LABEL)
}

pull tin_mac_as(file, check, label) {
  roll words = ["tin", "mac", file, "--label", label]
  if check != null {
    words = words + ["--check", check]
  }
  roll r = null
  burn {
    try {
      r = proc.run("cig", words, {timeout_ms: 30000, reads: true})
    } ashtray e {
      r = {code: -1, out: "", err: e.message}
    }
  }
  snuff r
}

# The fields of a task an approval is about, each as JSON text: what
# trust_key hashes besides the files. The environment by its names alone.
pull trust_spec(t) {
  roll m = {}
  for k in ["cmd", "shell", "cmds", "cwd", "rm", "each", "stdin", "stdin_from"] {
    if t.has(k) {
      m[k] = json.stringify(t[k])
    }
  }
  stick envs = t.get("env", {})
  if type_of(envs) == "map" {
    m["env"] = json.stringify(envs.keys().sort())
  }
  snuff m
}

# Which approval: this task, in this project, as written. The files it names
# are not here: the approval's work reads them, so they are its pass's
# inputs, and a changed byte in any of them (a lockfile that appears too)
# stops it holding.
pull trust_subject(t, name) {
  snuff {v: "cigo-trust-2", task: name, root: ROOT, spec: trust_spec(t)}
}

# The work of an approval: read every file trust_key reads (the scripts the
# task names; whether each lockfile beside it and at the root is there, and
# the ones that are), and return trust_key's digest, the name an approval
# from before passes went by.
pull trust_work(s) {
  roll t = {}
  for k in s.spec.keys() {
    t[k] = json.parse(s.spec[k])
  }
  if t.has("env") {
    roll names = {}
    for n in as_list(t.env) {
      names[str(n)] = ""
    }
    t["env"] = names
  }
  for f in task_files(t) + task_lockfiles(t) {
    hash.sha256_file(f)
  }
  snuff {task: s.task, key: trust_key(t, s.task)}
}

# Approvals cigo has kept, for `cigo trust list`, `show` and `revoke`: one
# record a pass under TRUST_INDEX, with the pass's token. The pass decides;
# a record says what was approved and when, and grants nothing.
stick TRUST_INDEX = path.join(TRUST_DIR, "passes")

pull trust_index() {
  roll recs = []
  if fs.is_dir(TRUST_INDEX) {
    for f in fs.list(TRUST_INDEX).sort() {
      if f.ends_with(".json") {
        stick at = path.join(TRUST_INDEX, path.base(f))
        try {
          recs.push(json.parse(fs.read_text(at)).merge({_file: at}))
        } ashtray e {
        }
      }
    }
  }
  snuff recs
}

pull trust_index_add(p, rec) {
  stick id = str(p.get("id", null) ?? "")
  if id == "" {
    snuff
  }
  write_outside(path.join(TRUST_INDEX, id + ".json"), json.stringify(rec.merge({pass: id, token: str(p.get("token", null) ?? "")}), 2) + "\n")
}

# Take an approval back: its pass revoked, its record gone. A record is not
# signed, so its pass is revoked only when the record's token is an approval
# pass with the id the record names; the file removed is the record's own,
# never a path built from what it says. False when the revoke did not take
# (the record stays).
pull trust_index_revoke(rec) {
  stick id = str(rec.get("pass", ""))
  roll vouched = false
  if text.matches(id, '^[0-9a-f]{64}$') {
    try {
      stick sh = pass.show(str(rec.get("token", "")))
      vouched = sh.kind == "approval" and str(sh.id) == id
    } ashtray e {
    }
  }
  if vouched and not pass_revoke(id) {
    snuff false
  }
  remove_outside(str(rec.get("_file", "")))
  snuff true
}

# Does an approval's pass still hold? {ok, why}.
pull trust_holds(rec) {
  try {
    snuff pass.check(str(rec.get("token", "")))
  } ashtray e {
    snuff {ok: false, why: clip(str(e.message), 160)}
  }
}

pull trust_pass(t, name) {
  try {
    snuff pass.issue("approval", trust_subject(t, name), pack(s) => trust_work(s), PASS_OPTS)
  } ashtray e {
    log.warn("the approval of `${name}` was not kept: " + clip(str(e.message), 200))
    snuff null
  }
}

# Is this task approved as it is now? One lookup, in process: the newest
# approval pass for this task as written that still holds. An approval from
# before passes is honored, and moved onto a pass the first time.
pull trusted(t, name) {
  if config().trust == "off" or str(t.get("trust", "")) == "never" {
    snuff {trusted: false, key: trust_key(t, name)}
  }
  stick p = pass_found("approval", trust_subject(t, name))
  if p != null {
    snuff {trusted: true, key: str(dig(p, ["result", "key"]) ?? ""), pass: p.id}
  }
  snuff trusted_legacy(t, name)
}

# An approval from before passes: `<key>.json` beside `<key>.mac` in
# TRUST_DIR, signed by `cig tin mac`. One that verifies is moved onto a pass
# for the task as it is now, and the old files are put aside in
# TRUST_DIR/retired (never read again); one that does not is a forged
# approval (E889), ignored and said.
pull trusted_legacy(t, name) {
  stick key = trust_key(t, name)
  stick f = trust_files(key)
  if not fs.is_file(f.json) or not fs.is_file(f.mac) {
    snuff {trusted: false, key: key}
  }
  if legacy_moved(TRUST_LABEL, f.json) {
    log.warn("E889 ${tilde(f.json)} is an approval from before passes that already moved onto one, put back since; ignored (cigo trust revoke ${name} removes it)")
    snuff {trusted: false, key: key}
  }
  stick r = tin_mac(f.json, fs.read_text(f.mac).trim())
  if r.code == 1 {
    log.warn("E889 a forged approval: ${tilde(f.json)} is not signed by your key; ignored (cigo trust revoke ${name} removes it)")
    snuff {trusted: false, key: key}
  }
  if r.code != 0 {
    snuff {trusted: false, key: key}
  }
  roll old = {}
  try {
    old = json.parse(fs.read_text(f.json))
  } ashtray e {
  }
  stick p = trust_pass(t, name)
  if p == null {
    # Honored this once; the record stays until a pass can be made.
    snuff {trusted: true, key: key}
  }
  # The pass vouches for what its work read, the record for what trust_key
  # read a moment before: if they differ, the task moved in between, and
  # neither counts.
  if str(dig(p, ["result", "key"]) ?? "") != key {
    pass_revoke(p.get("id", null))
    snuff {trusted: false, key: key}
  }
  trust_index_add(p, {task: name, project: ROOT, at: str(old.get("at", time.now_iso())), by: str(old.get("by", "")), risk: str(old.get("risk", "")), findings: as_list(old.get("findings", [])), key: key})
  stick retired = path.join(TRUST_DIR, "retired")
  if mark_legacy_moved(TRUST_LABEL, f.json) and write_outside(path.join(retired, key + ".json"), fs.read_text(f.json)) {
    remove_outside(f.json)
    remove_outside(f.mac)
  }
  log.info("the approval of `${name}` moved onto a pass (${str(p.id ?? "").slice(0, 12)})")
  snuff {trusted: true, key: key, pass: p.id}
}

# Keep the approval, as a pass. False when it could not be kept: the run
# goes on, the approval is not kept.
pull approve(t, name, verdict) {
  stick p = trust_pass(t, name)
  if p == null {
    snuff false
  }
  stick key = str(dig(p, ["result", "key"]) ?? "")
  trust_index_add(p, {task: name, project: ROOT, at: time.now_iso(), by: "cig-orchestrator ${VERSION}", risk: verdict.risk, findings: verdict.findings.map(pack(x) => x.code + " " + x.where), key: key})
  log.info("approved `${name}` as it is now (pass ${str(p.id ?? "").slice(0, 12)}); a change to its command, scripts or lockfiles is checked again")
  snuff true
}

# The install hooks a setup stage would run: what the packages installed
# here declare (read after a first install; before it, the lockfile names
# them and the rehearsal, when it lands, sees them run), and the build
# scripts beside the component.
pull install_hooks(t) {
  roll hooks = []
  stick cwd = task_cwd(t)
  for rel in glob_under(cwd, "node_modules/*/package.json") + glob_under(cwd, "node_modules/@*/*/package.json") {
    try {
      stick pj = json.parse(unbom(fs.read_text(path.join(ROOT, rel))))
      stick scripts = pj.get("scripts", {})
      if type_of(scripts) == "map" {
        for k in ["preinstall", "install", "postinstall"] {
          if scripts.has(k) {
            hooks.push({where: str(pj.get("name", rel)) + " " + k, text: str(scripts[k]), hook: "npm", file: path.join(ROOT, rel)})
          }
        }
      }
    } ashtray e {
    }
  }
  for f in ["setup.py", "build.rs"] {
    stick p = path.join(task_dir(t), f)
    if fs.is_file(p) {
      try {
        hooks.push({where: f, text: fs.read_text(p), file: p})
      } ashtray e {
      }
    }
  }
  snuff hooks
}

# The docs each installed npm package carries, read for prompt injection:
# the README and the package.json's description. More and more installs are
# run by AI agents, and attackers have started hiding instructions aimed at
# the agent inside the package's own documentation. Only the prompt-injection
# rules read these; a README that quotes `curl | sh` is not a fetch-and-run.
# A doc file over READ_DOC_CAP bytes is read truncated: a long one would
# bury the few lines that matter.
stick READ_DOC_CAP = 65536
stick PACKAGE_README_NAMES = ["README", "readme", "README.md", "readme.md", "README.markdown", "README.rst", "README.txt", "Readme.md"]

pull package_docs(t) {
  roll docs = []
  stick cwd = task_cwd(t)
  for rel in glob_under(cwd, "node_modules/*/package.json") + glob_under(cwd, "node_modules/@*/*/package.json") {
    stick pj_file = path.join(ROOT, rel)
    stick pkg_dir = path.dir(pj_file)
    roll pj = null
    try {
      pj = json.parse(unbom(fs.read_text(pj_file)))
    } ashtray e {
      continue
    }
    stick name = str(pj.get("name", rel))
    stick desc = str(pj.get("description", ""))
    if desc != "" {
      docs.push({where: name + " description", text: desc, file: pj_file})
    }
    for n in PACKAGE_README_NAMES {
      stick rp = path.join(pkg_dir, n)
      if fs.is_file(rp) {
        try {
          roll body = fs.read_text(rp)
          if body.len() > READ_DOC_CAP {
            body = body.slice(0, READ_DOC_CAP)
          }
          docs.push({where: name + " " + n, text: body, file: rp})
        } ashtray e {
        }
        break
      }
    }
  }
  snuff docs
}

# The docs each installed PyPI distribution carries, read for prompt
# injection: the `.dist-info/METADATA` file pip extracts beside every
# installed package. METADATA is RFC-822 (headers to the first blank
# line, body after), so the `Summary` header is the short description
# and the body is the README the wheel shipped with. Scanned for `E886`
# and `E887` only, the way the npm scan is: a README that quotes
# `curl | sh` as an install example is not a fetch-and-run.
#
# A distribution with no METADATA on disk is silent: it means the install
# has not run yet, and we never fetch.
stick PYPI_DIST_INFO_GLOBS = [
  ".venv/lib/python*/site-packages/*.dist-info/METADATA",
  ".venv/lib/pypy*/site-packages/*.dist-info/METADATA",
  "venv/lib/python*/site-packages/*.dist-info/METADATA",
  "venv/lib/pypy*/site-packages/*.dist-info/METADATA",
  ".venv/Lib/site-packages/*.dist-info/METADATA",
  "venv/Lib/site-packages/*.dist-info/METADATA",
]

pull pypi_docs(t) {
  roll docs = []
  stick cwd = task_cwd(t)
  roll seen = []
  for glob in PYPI_DIST_INFO_GLOBS {
    for rel in glob_under(cwd, glob) {
      stick mf = path.join(ROOT, rel)
      if seen.contains(mf) {
        continue
      }
      seen.push(mf)
      roll body = ""
      try {
        body = unbom(fs.read_text(mf))
      } ashtray e {
        continue
      }
      stick dist = path.base(path.dir(mf))
      stick name = pypi_dist_name(dist)
      stick split = split_metadata(body)
      if split.summary != "" {
        docs.push({where: name + " Summary", text: split.summary, file: mf})
      }
      if split.body != "" {
        roll text_body = split.body
        if text_body.len() > READ_DOC_CAP {
          text_body = text_body.slice(0, READ_DOC_CAP)
        }
        docs.push({where: name + " METADATA", text: text_body, file: mf})
      }
    }
  }
  snuff docs
}

# A `.dist-info` folder's name is `{name}-{version}.dist-info` (PEP 376).
# Everything before the last hyphen is the distribution name, with
# underscores written back to hyphens so the report reads as the name
# pip knew the package by.
pull pypi_dist_name(dist) {
  stick c = text.captures(dist, '^(.+)-[^-]+\.dist-info$')
  if c != null {
    snuff c[1].replace("_", "-")
  }
  snuff dist
}

# METADATA's two parts: the `Summary` header (one line), and everything
# after the first blank line (the long description, usually the README).
# Headers are read case-insensitively; a continuation line (an indented
# line, or the RFC-822 `.` continuation) belongs to the previous header.
# Older METADATA puts the long description in a `Description:` header
# instead; that is used only when the body is empty.
pull split_metadata(body) {
  stick b = body.replace("\r\n", "\n")
  stick at = b.find("\n\n")
  stick head = pick(at < 0, b, b.slice(0, at))
  stick tail = pick(at < 0, "", b.slice(at + 2))
  roll summary = ""
  roll description_header = ""
  roll in_description = false
  for raw in head.lines() {
    if in_description {
      if raw.starts_with(" ") or raw.starts_with("\t") {
        stick cont = raw.trim_start()
        description_header = description_header + pick(cont == ".", "", cont) + "\n"
        continue
      }
      in_description = false
    }
    stick c = text.captures(raw, '^([A-Za-z][A-Za-z0-9-]*)\s*:\s*(.*)$')
    if c == null {
      continue
    }
    stick key = c[1].lower()
    if key == "summary" {
      summary = c[2]
    } else if key == "description" {
      description_header = c[2] + "\n"
      in_description = true
    }
  }
  roll out_body = tail
  if out_body.trim() == "" {
    out_body = description_header
  }
  snuff {summary: summary, body: out_body}
}

# Each vendored or packaged crate's docs, read for prompt injection: its
# `Cargo.toml`'s `[package] description` and the `README*` beside it.
# Two project-local places: `vendor/` (what `cargo vendor` writes, used
# by air-gapped builds) and `target/package/<name>-<version>/` (what
# `cargo package` writes). `~/.cargo/registry/src/` is a per-user cache;
# when a crate is not vendored or packaged, there is nothing a static
# read can say about it, and we never fetch.
stick CRATES_DOC_ROOTS = ["vendor/*/Cargo.toml", "target/package/*/Cargo.toml"]

pull crates_docs(t) {
  roll docs = []
  stick cwd = task_cwd(t)
  roll seen = []
  for glob in CRATES_DOC_ROOTS {
    for rel in glob_under(cwd, glob) {
      stick cf = path.join(ROOT, rel)
      if seen.contains(cf) {
        continue
      }
      seen.push(cf)
      roll ct = ""
      try {
        ct = unbom(fs.read_text(cf))
      } ashtray e {
        continue
      }
      stick info = parse_cargo_package(ct)
      stick pkg_dir = path.dir(cf)
      stick name = pick(info.name == "", path.base(pkg_dir), info.name)
      if info.description != "" {
        docs.push({where: name + " description", text: info.description, file: cf})
      }
      stick candidates = pick(info.readme == "", PACKAGE_README_NAMES, [info.readme])
      for n in candidates {
        stick rp = path.join(pkg_dir, n)
        if fs.is_file(rp) {
          try {
            roll rbody = fs.read_text(rp)
            if rbody.len() > READ_DOC_CAP {
              rbody = rbody.slice(0, READ_DOC_CAP)
            }
            docs.push({where: name + " " + n, text: rbody, file: rp})
          } ashtray e {
          }
          break
        }
      }
    }
  }
  snuff docs
}

# A Cargo.toml's `[package]` section's `name`, `description` and `readme`.
# A workspace-only manifest (no `[package]` section) returns empties, so
# nothing is scanned for it. CigScript's stdlib has no TOML parser; this
# is a line-by-line walk that reads `key = "value"` in the `[package]`
# section only. Values that span several lines (triple-quoted strings)
# are left empty on purpose; the README reader picks up the long form.
pull parse_cargo_package(src) {
  roll name = ""
  roll description = ""
  roll readme = ""
  roll in_pkg = false
  stick nb = src.replace("\r\n", "\n")
  for raw in nb.lines() {
    stick line = raw.trim_end()
    if line.starts_with("[") {
      in_pkg = line == "[package]"
      continue
    }
    if not in_pkg {
      continue
    }
    stick c = text.captures(line, '^\s*([a-zA-Z_][a-zA-Z0-9_-]*)\s*=\s*"([^"\n]*)"')
    if c == null {
      continue
    }
    stick k = c[1].lower()
    if k == "name" {
      name = c[2]
    } else if k == "description" {
      description = c[2]
    } else if k == "readme" {
      readme = c[2]
    }
  }
  snuff {name: name, description: description, readme: readme}
}

# A doc file's prompt-injection findings: only the pi-* rules, each over the
# whole body (not line by line, so a note spread across several lines reads
# as one). Comments and shell handling are left out: a README is not a shell
# script.
pull scan_docs(where, body) {
  roll out = []
  roll seen = []
  for rule in RULES {
    if rule.cat != "prompt-injection" {
      continue
    }
    if text.matches(body, rule.re) {
      if not seen.contains(rule.id) {
        seen.push(rule.id)
        out.push({code: rule.code, cat: rule.cat, w: rule.w, rule: rule.id, where: where, text: clip(body.trim(), 120), says: rule.says})
      }
    }
  }
  snuff out
}

# Where OSV is asked and its database kept (see "known-bad packages" below).
stick OSV_DIR = path.join(CIGO_HOME, "osv")
stick OSV_API = env.get("CIGO_OSV_API", "https://api.osv.dev")
stick OSV_DUMPS = env.get("CIGO_OSV_DUMPS", "https://osv-vulnerabilities.storage.googleapis.com")
# An answer naming advisories is kept a day; a clean one an hour, so a
# package reported malicious today is refused today.
stick OSV_CACHE_MS = 86400000
stick OSV_CLEAN_MS = 3600000
stick OSV_DETAIL_CAP = 200
stick OSV_ECOSYSTEMS = ["npm", "PyPI", "crates.io", "Go", "RubyGems", "Packagist", "Maven", "NuGet"]
roll OSV_NOTED = false
roll OSV_INDEXES = {}
roll OSV_PARSED = {}

# Registry metadata: where each ecosystem's own registry lives and how
# long an answer is kept (a day). A test points one at a file:// fixture
# directory, the way the OSV online test does with CIGO_OSV_API.
stick REGISTRY_NPM = env.get("CIGO_REGISTRY_NPM", "https://registry.npmjs.org")
stick REGISTRY_PYPI = env.get("CIGO_REGISTRY_PYPI", "https://pypi.org")
stick REGISTRY_CRATES = env.get("CIGO_REGISTRY_CRATES", "https://crates.io")
stick REGISTRY_DIR = path.join(CIGO_HOME, "registry")
stick REGISTRY_CACHE_MS = 86400000
stick REGISTRY_ECOSYSTEMS = ["npm", "PyPI", "crates.io"]
roll REGISTRY_NOTED = false
roll REGISTRY_CACHE_MEM = {}

# What the read decodes and how it reads shell (see "the read, harder to
# fool" below).
stick B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
stick HEXDIGITS = "0123456789abcdef"
stick ASCII = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
stick DECODE_DEPTH = 3
stick DECODE_CAP = 16384
stick DECODE_BUDGET = 65536
stick SHELL_EXTS = [".sh", ".bash", ".zsh"]
stick DECODER_RE = '(?i)base64\s+(-d|--decode|-D)\b|\bb64decode\b|\bfrombase64string\b|\batob\s*\(|buffer\.from\s*\([^)]*[\x27"](base64|hex)[\x27"]|\bxxd\s+[^\n]*-r|\bbytes\.fromhex\b|\bcodecs\.decode\b|\bunhexlify\b|printf\s+[^\n]*\\x[0-9a-fA-F]{2}'
stick ASSIGN_RE = '(?:^|[\s;&|(])(?:export\s+|local\s+|readonly\s+|declare\s+)?([A-Za-z_][A-Za-z0-9_]*)=((?:"[^"]*"|\x27[^\x27]*\x27|[^\s;&|)"\x27])*)'
stick NET_RE = '(?i)(^|[\s;&|(`$])(curl|wget|nc|ncat|socat|invoke-webrequest|iwr|invoke-restmethod|irm)(\s|$)'
stick URL_HOST_RE = '(?i)\b(?:https?|ftp)://([^\s/"\x27?#]+)'
stick UPLOAD_RE = '(?i)\bcurl\b[^\n]*(--data-binary|--data-raw|--data|\s-d|--upload-file|\s-T|\s-F|--form)\s*[\x27"]?[^\s\x27"]*@|\bwget\b[^\n]*--post-file'
stick DOTPACK_RE = '(?i)\b(tar|zip|7z|cp|rsync|scp|gzip)\b[^\n]*(~|\$HOME)/\.[A-Za-z0-9_-]'

# The static read: the task's own text, the scripts it names, and for a
# setup stage its install hooks, against the rules. Each hit is a finding
# with its code, where it was and the text that matched.
# A script and the files it runs from its own folder (`node ./x.js`,
# `python helper.py`, `sh ./y.sh`, `source ./z`), two levels deep: what a
# script hands its work to is read with it (#80).
pull script_sources(file) {
  roll out = []
  roll seen = []
  roll todo = [{f: file, depth: 0}]
  while not todo.is_empty() and out.len() < 12 {
    stick it = todo.first()
    todo = todo.slice(1)
    stick f = path.normalize(it.f)
    if seen.contains(f) {
      continue
    }
    seen.push(f)
    roll body = ""
    try {
      body = fs.read_text(f)
    } ashtray e {
      continue
    }
    out.push({where: tilde(f), text: body, file: f})
    if it.depth >= 2 {
      continue
    }
    stick dir = path.dir(f)
    for m in text.find_all(body, '\b(?:node|python3?|sh|bash|source|deno\s+run)\s+(?:-\S+\s+)*(?:\./)?[A-Za-z0-9_][A-Za-z0-9_.-]*\.(?:js|mjs|cjs|ts|py|sh|bash)\b|(?:^|[;&|]\s*|\s)\.\s+\./[A-Za-z0-9_.-]+') {
      stick name = text.captures(m, '([A-Za-z0-9_][A-Za-z0-9_.-]*\.(?:js|mjs|cjs|ts|py|sh|bash)|\./[A-Za-z0-9_.-]+)\s*$')
      if name != null {
        stick next = path.join(dir, name[1].replace("./", ""))
        if fs.is_file(next) and path.dir(path.normalize(next)) == path.normalize(dir) {
          todo.push({f: next, depth: it.depth + 1})
        }
      }
    }
  }
  snuff out
}

pull static_read(t, name) {
  roll sources = []
  if t.has("shell") {
    sources.push({where: "shell", text: str(t.shell)})
  }
  stick words = task_words(t)
  if not words.is_empty() and not t.has("shell") {
    sources.push({where: "cmd", text: words.join(" ")})
  }
  for f in task_files(t).filter(pack(p) => SCAN_EXTS.any(pack(e) => p.ends_with(e))) {
    for src in script_sources(f) {
      sources.push(src)
    }
  }
  roll hooks = []
  roll docs = []
  if str(t.get("stage", "")) == "setup" {
    hooks = install_hooks(t)
    for h in hooks {
      sources.push({where: h.where, text: h.text, hook: h.get("hook", ""), file: h.get("file", null)})
    }
    # npm (the package.json description and README), PyPI (the
    # `.dist-info/METADATA` Summary and body), and crates.io (vendored or
    # packaged `Cargo.toml` and README). Each reader runs where its
    # ecosystem's bytes land; glob misses are silent.
    docs = package_docs(t) + pypi_docs(t) + crates_docs(t)
  }
  roll findings = []
  stick budget = {left: DECODE_BUDGET}
  for s in sources {
    stick inline = s.where == "shell" or s.where == "cmd"
    # Shell text: the task's own, a shell script it names, an npm install
    # hook (npm runs those with sh).
    stick shellish = inline or SHELL_EXTS.any(pack(e) => s.where.ends_with(e)) or s.get("hook", "") == "npm"
    stick file = s.get("file", null)
    findings = findings + scan_text(s.where, s.text, shellish, not inline, 0, budget).map(pack(x) => x.merge({file: file}))
    if not shellish {
      findings = findings + taint_findings(s.where, s.text).map(pack(x) => x.merge({file: file}))
    }
  }
  # A package's own README and its package.json's description, read only for
  # prompt injection (E886, E887): hidden instructions aimed at AI agents.
  for d in docs {
    findings = findings + scan_docs(d.where, d.text).map(pack(x) => x.merge({file: d.get("file", null)}))
  }
  snuff {risk: risk_of(findings), findings: findings, hooks: hooks}
}

# ----- the read, harder to fool (#69) -----------------------------------------------
#
# Two cheap tricks got past the rules: a string split into pieces
# (`"$HOME/.s""sh"`, a host built from parts) and base64. Shell text is read
# twice: as written, and with the simple assignments made earlier in the
# same text folded in and the quotes that join pieces taken out. What a
# decoder is fed (base64, hex, `\x` escapes) is decoded and read the same
# way, three levels deep, within a size budget. Pure text work: nothing runs.

# One byte as text: printable ASCII as itself, a tab or a newline, anything
# else `?` (the rules look for words, not bytes).
pull byte_char(b) {
  if b == 10 {
    snuff "\n"
  }
  if b == 9 {
    snuff "\t"
  }
  if b >= 32 and b < 127 {
    snuff ASCII.slice(b - 32, b - 31)
  }
  snuff "?"
}

# Base64 (or its URL-safe alphabet) to text; null when it is not base64.
pull b64_decode(s) {
  roll out = ""
  roll buf = 0
  roll bits = 0
  for c in s.chars() {
    if c == "=" {
      break
    }
    roll v = B64.find(c)
    if c == "-" {
      v = 62
    }
    if c == "_" {
      v = 63
    }
    if v < 0 {
      if not [" ", "\n", "\r", "\t"].contains(c) {
        snuff null
      }
    } else {
      buf = buf * 64 + v
      bits += 6
      if bits >= 8 {
        bits -= 8
        stick p = int(math.pow(2, bits))
        stick b = int(math.floor(buf / p))
        out = out + byte_char(b)
        buf = buf - b * p
      }
    }
  }
  snuff out
}

# Hex digits to text; null when they are not.
pull hex_decode(s) {
  stick h = s.lower()
  if h.len() % 2 != 0 {
    snuff null
  }
  roll out = ""
  roll i = 0
  while i < h.len() {
    stick a = HEXDIGITS.find(h.slice(i, i + 1))
    stick b = HEXDIGITS.find(h.slice(i + 1, i + 2))
    if a < 0 or b < 0 {
      snuff null
    }
    out = out + byte_char(a * 16 + b)
    i += 2
  }
  snuff out
}

# Text a person could read: four characters or more, at most one in five
# not printable.
pull readable(d) {
  if d == null or d.len() < 4 {
    snuff false
  }
  roll bad = 0
  for c in d.chars() {
    if c == "?" {
      bad += 1
    }
  }
  snuff bad * 5 < d.len()
}

# ----- escapes, handed commands and secrets on their way out (#89) ---------------

# `printf` and `echo -e` escapes, and `$'…'` quoting, decoded: `\xNN`,
# `\NNN` and `\0NNN` (octal), `\uNNNN`, `\n` and `\t` (as spaces: the read
# looks at one line). A character past ASCII is `?`.
pull esc_decode(s) {
  stick cs = s.chars()
  stick n = cs.len()
  stick octal = "01234567"
  roll out = ""
  roll i = 0
  while i < n {
    stick c = cs[i]
    if c != "\\" or i + 1 >= n {
      out = out + c
      i += 1
      continue
    }
    stick k = cs[i + 1]
    if k == "x" or k == "u" {
      stick most = pick(k == "x", 2, 4)
      roll v = 0
      roll j = i + 2
      while j < n and j < i + 2 + most and HEXDIGITS.find(cs[j].lower()) >= 0 {
        v = v * 16 + HEXDIGITS.find(cs[j].lower())
        j += 1
      }
      if j == i + 2 {
        out = out + "\\" + k
        i += 2
        continue
      }
      out = out + pick(v < 128, byte_char(v), "?")
      i = j
    } else if octal.find(k) >= 0 {
      roll v = 0
      roll j = i + 1
      # `\0NNN` (echo -e) takes a leading zero and three more digits.
      stick most = pick(k == "0", 4, 3)
      while j < n and j < i + 1 + most and octal.find(cs[j]) >= 0 {
        v = v * 8 + octal.find(cs[j])
        j += 1
      }
      out = out + pick(v < 128, byte_char(v), "?")
      i = j
    } else if k == "n" or k == "t" {
      out = out + " "
      i += 2
    } else if k == "\\" {
      out = out + "\\"
      i += 2
    } else {
      out = out + "\\" + k
      i += 2
    }
  }
  snuff out.replace("\n", " ").replace("\t", " ")
}

# What `$(printf '…')`, `$(echo -e '…')`, their backtick forms and `$'…'`
# stand for, written in: `$(printf '\x63\x75\x72\x6c')` reads as `curl`
# (m21).
stick PRINTF_SUB_RE = '\$\(\s*(?:printf|echo\s+-e)\s+(?:\x27([^\x27]*)\x27|"([^"]*)")\s*\)|`\s*(?:printf|echo\s+-e)\s+(?:\x27([^\x27]*)\x27|"([^"]*)")\s*`|\$\x27([^\x27]*)\x27'

pull printf_norm(line) {
  if not line.contains("\\") {
    snuff line
  }
  roll t = line
  roll guard = 0
  while guard < 16 {
    guard += 1
    stick c = text.captures(t, PRINTF_SUB_RE)
    if c == null {
      break
    }
    stick raw = c.get(1, null) ?? c.get(2, null) ?? c.get(3, null) ?? c.get(4, null) ?? c.get(5, null) ?? ""
    t = t.replace(c[0], esc_decode(raw))
  }
  snuff t
}

# A string constant in JavaScript or Python, `const h='203.0.113.5'` or
# `h = "…"`, as the read folds it into what is built from it later.
stick CODE_ASSIGN_RE = '(?:\b(?:const|let|var)\s+)?\b([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(?:\x27([^\x27\\]*)\x27|"([^"\\]*)")'

pull code_consts(line, vars) {
  roll v = vars
  for m in text.find_all(line, CODE_ASSIGN_RE) {
    stick c = text.captures(m, CODE_ASSIGN_RE)
    if c != null {
      v[c[1]] = str(c.get(2, null) ?? c.get(3, null) ?? "")
    }
  }
  snuff v
}

# The first argument of a call, from just after its `(`: up to the comma or
# the closing parenthesis at its own depth, quotes respected.
pull first_arg(s) {
  stick cs = s.chars()
  roll q = ""
  roll depth = 0
  roll i = 0
  while i < cs.len() {
    stick c = cs[i]
    if q != "" {
      if c == q {
        q = ""
      }
    } else if c == "'" or c == "\"" or c == "`" {
      q = c
    } else if c == "(" or c == "[" or c == "{" {
      depth += 1
    } else if c == ")" or c == "]" or c == "}" {
      if depth == 0 {
        break
      }
      depth -= 1
    } else if c == "," and depth == 0 {
      break
    }
    i += 1
  }
  snuff cs.slice(0, i).join("")
}

# A string expression as the program would build it: its literals joined,
# `${x}` in a template and `{x}` in an f-string filled in, and each name
# with a known constant replaced by it. A name the read cannot know stays
# `$name`, so a host built from it reads as unseen. A list (`["sh", "-c",
# "…"]`) is its words joined by spaces.
# `${x}` (a template) or `{x}` (an f-string) filled in from the constants
# the read knows; one it does not know stays `$x`.
pull fill_names(s, open, vars) {
  roll out = s
  for m in text.find_all(s, open + '[A-Za-z_][A-Za-z0-9_]*\}') {
    stick name = text.captures(m, '([A-Za-z_][A-Za-z0-9_]*)\}$')[1]
    out = out.replace(m, str(vars.get(name, "$" + name)))
  }
  snuff out
}

pull string_expr(e, vars) {
  stick fill = pack(s, open) => fill_names(s, open, vars)
  stick lit = pack(tok) => pick(tok.starts_with("f'") or tok.starts_with("f\""), fill(tok.slice(2, tok.len() - 1), '\{'), pick(tok.starts_with("`"), fill(tok.slice(1, tok.len() - 1), '\$\{'), tok.slice(1, tok.len() - 1)))
  stick t = e.trim()
  stick literal = '\bf\x27[^\x27]*\x27|\bf"[^"]*"|\x27[^\x27]*\x27|"[^"]*"|`[^`]*`'
  if t.starts_with("[") {
    snuff text.find_all(t, literal).map(lit).join(" ")
  }
  roll out = ""
  for tok in text.find_all(t, literal + '|[A-Za-z_][A-Za-z0-9_.]*') {
    if tok.starts_with("'") or tok.starts_with("\"") or tok.starts_with("`") or tok.starts_with("f'") or tok.starts_with("f\"") {
      out = out + lit(tok)
    } else {
      out = out + str(vars.get(tok, "$" + tok))
    }
  }
  snuff out
}

# The commands a script hands to a shell or runs: child_process's exec and
# spawn, Python's subprocess and os.system, built the way the program
# builds them (m10). What comes back is read as shell.
stick HANDED_RE = '\b(?:exec|execSync|execFile|execFileSync|spawn|spawnSync)\s*\(|\bsubprocess\.(?:run|call|check_call|check_output|Popen|getoutput|getstatusoutput)\s*\(|\bos\.(?:system|popen|exec[lv]p?e?)\s*\('

pull handed_commands(line, vars) {
  roll out = []
  roll rest = line
  roll guard = 0
  while guard < 8 {
    guard += 1
    stick m = text.find(rest, HANDED_RE)
    if m == null {
      break
    }
    stick after = rest.slice(rest.find(m) + m.len())
    stick cmd = string_expr(first_arg(after), vars)
    if cmd.trim() != "" and not out.contains(cmd) {
      out.push(cmd)
    }
    rest = after
  }
  snuff out
}

# A secret from the environment or a credentials file on its way out to the
# network (m19): a variable set from `process.env.NPM_TOKEN`,
# `os.environ["…TOKEN…"]`, `os.getenv(…)` or the text of `~/.npmrc` and its
# kind, then used in a call that talks to the network. A token sent to its
# own service (`GITHUB_TOKEN` to github.com) is the token's job and is not
# a finding.
stick SECRET_NAME = '[A-Za-z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSWD|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|AUTH|CREDENTIAL|SESSION)[A-Za-z0-9_]*'
stick SECRET_SRC_RE = '(?i:process\.env)(?:\.|\[\s*[\x27"])(' + SECRET_NAME + ')|os\.environ(?:\.get)?\s*[\[(]\s*[\x27"](' + SECRET_NAME + ')|os\.getenv\s*\(\s*[\x27"](' + SECRET_NAME + ')|(?:readFileSync|readFile|open)\s*\([^)\n]*(\.npmrc|\.pypirc|\.netrc|\.git-credentials|\.aws[/\\]credentials|\.docker[/\\]config\.json)'
stick NET_SINK_RE = '\b(?:https?\.(?:get|request)|fetch|axios(?:\.(?:get|post|put|request))?|got(?:\.(?:get|post))?|needle|net\.(?:connect|createConnection)|dns\.(?:lookup|resolve\w*)|requests\.(?:get|post|put|patch|request)|urllib\.request\.(?:urlopen|Request)|urlopen|http\.client\.HTTPS?Connection|socket\.create_connection)\s*\('
stick TOKEN_HOMES = [
  {name: "GITHUB|GH_", hosts: ["github.com", "githubusercontent.com"]},
  {name: "NPM|NODE_AUTH", hosts: ["npmjs.org", "npmjs.com"]},
  {name: "PYPI|TWINE", hosts: ["pypi.org", "python.org"]},
  {name: "CARGO|CRATES", hosts: ["crates.io"]},
  {name: "DOCKER", hosts: ["docker.io", "docker.com"]},
  {name: "GITLAB", hosts: ["gitlab.com"]},
  {name: "SLACK", hosts: ["slack.com"]},
  {name: "OPENAI", hosts: ["openai.com"]},
  {name: "ANTHROPIC", hosts: ["anthropic.com"]},
  {name: "HF_|HUGGING", hosts: ["huggingface.co"]},
]

# Does a call's text send `secret` only to that secret's own service?
pull to_its_home(secret, call) {
  stick hosts = text.find_all(call, '(?i)https?://[^\s/"\x27`?#]+').map(pack(u) => u.split("://")[1].lower())
  if hosts.is_empty() {
    snuff false
  }
  for home in TOKEN_HOMES {
    if text.matches(secret.upper(), '^(?:' + home.name + ')') {
      snuff hosts.all(pack(h) => home.hosts.any(pack(d) => h == d or h.ends_with("." + d)))
    }
  }
  snuff false
}

pull taint_findings(where, body) {
  roll found = []
  roll tainted = {}
  roll n = 0
  for raw in body.lines() {
    n += 1
    stick line = js_norm(raw)
    stick at = where + ":" + str(n)
    for m in text.find_all(line, '\b([A-Za-z_][A-Za-z0-9_]*)\s*=\s*[^=;\n][^;\n]*') {
      stick c = text.captures(m, '^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*([^;\n]*)')
      if c != null {
        stick src = text.captures(c[2], SECRET_SRC_RE)
        if src != null {
          tainted[c[1]] = str(src.get(1, null) ?? src.get(2, null) ?? src.get(3, null) ?? src.get(4, null) ?? "a secret")
        } else {
          # A variable built from a tainted one is tainted too.
          for t in tainted {
            if text.matches(c[2], '\b' + t + '\b') {
              tainted[c[1]] = tainted[t]
            }
          }
        }
      }
    }
    roll rest = line
    roll guard = 0
    while guard < 8 {
      guard += 1
      stick m = text.find(rest, NET_SINK_RE)
      if m == null {
        break
      }
      stick after = rest.slice(rest.find(m) + m.len())
      stick call = m + after
      roll secret = null
      stick inline = text.captures(call, SECRET_SRC_RE)
      if inline != null {
        secret = str(inline.get(1, null) ?? inline.get(2, null) ?? inline.get(3, null) ?? inline.get(4, null) ?? "a secret")
      }
      for t in tainted {
        if secret == null and text.matches(after, '\b' + t + '\b') {
          secret = tainted[t]
        }
      }
      if secret != null and not to_its_home(secret, call) {
        found.push({code: "E871", cat: "credentials", w: 0.8, rule: "taint-secret", where: at, text: clip(line.trim(), 120), says: "reads " + secret + ", a secret, from the environment or a credentials file"})
        found.push({code: "E872", cat: "exfiltration", w: 0.9, rule: "taint-secret-net", where: at, text: clip(line.trim(), 120), says: "sends " + secret + " out over the network, to a host that is not its own service"})
        break
      }
      rest = after
    }
  }
  snuff found
}

# What a line feeds a decoder, decoded: `\x` escapes, then every long run
# of base64 or hex on it, each within the cap and the run's budget.
pull decoded_payloads(line, budget) {
  roll out = []
  if not text.matches(line, DECODER_RE) {
    snuff out
  }
  for e in text.find_all(line, '(\\x[0-9a-fA-F]{2}){4,}') {
    stick d = hex_decode(e.replace("\\x", ""))
    if readable(d) and not out.contains(d) {
      out.push(d)
    }
  }
  for tok in text.find_all(line, '[A-Za-z0-9+/_-]{16,}={0,2}') {
    if tok.len() <= DECODE_CAP and budget.left >= tok.len() and out.len() < 4 {
      budget.left = budget.left - tok.len()
      roll d = null
      if tok.len() % 2 == 0 and text.matches(tok, '^[0-9a-fA-F]+$') {
        d = hex_decode(tok)
      }
      if not readable(d) {
        d = b64_decode(tok)
      }
      if readable(d) and not out.contains(d) {
        out.push(d)
      }
    }
  }
  snuff out
}

# The quotes that join pieces taken out, and `${HOME}` written `$HOME`.
pull dequote(s) {
  snuff text.replace(text.replace(s, '["\x27]', ""), '\$\{HOME\}', "$$HOME")
}

# The known variables folded into a piece of shell: `$name` and `${name}`.
pull fold(s, vars) {
  roll out = s
  for k in vars {
    out = text.replace(out, '\$\{' + k + '\}|\$' + k + '\b', vars[k].replace("$", "$$"))
  }
  snuff out
}

# A shell line read the way the shell would join it: folded with what was
# known before it (`text`, what is shown), and with this line's own simple
# assignments taken in order too (`full`, so `d=…; tar "$d"` on one line is
# seen), its joining quotes taken out.
pull shell_norm(line, vars) {
  stick shown = dequote(fold(line, vars))
  roll v = vars
  for m in text.find_all(line, ASSIGN_RE) {
    stick c = text.captures(m, ASSIGN_RE)
    if c != null {
      v[c[1]] = dequote(fold(c[2], v))
    }
  }
  snuff {text: shown, full: dequote(fold(line, v)), vars: v}
}

# Does a network command on this (normalised) line go to a host the read
# cannot see? A URL whose host is still a variable, or a command whose
# target is one.
pull unseen_host(norm) {
  stick c = text.captures(norm, URL_HOST_RE)
  if c != null {
    snuff c[1].contains("$")
  }
  stick at = text.find(norm, NET_RE)
  if at == null {
    snuff false
  }
  snuff norm.slice(norm.find(at)).contains("$")
}

# Read one text against the rules: as written, and for shell normalised;
# what it feeds a decoder, decoded and read the same way.
pull scan_text(where, body, shellish, comments, depth, budget) {
  roll found = []
  roll seen = []
  roll vars = {}
  roll packed = false
  roll pack_said = false
  roll codevars = {}
  roll n = 0
  pull add(at, id, code, cat, w, said, says) {
    stick key = id + "@" + at
    if not seen.contains(key) {
      seen.push(key)
      found.push({code: code, cat: cat, w: w, rule: id, where: at, text: clip(said.trim(), 120), says: says})
    }
  }
  for line in body.lines() {
    n += 1
    stick at = pick(where == "shell" or where == "cmd", where, where + ":" + str(n))
    stick bare = line.trim()
    stick comment = comments and (bare.starts_with("#") or bare.starts_with("//"))
    if not comment {
      for rule in RULES {
        if text.matches(line, rule.re) {
          add(at, rule.id, rule.code, rule.cat, rule.w, line, rule.says)
        }
      }
      if shellish {
        stick pn = printf_norm(line)
        if pn != line {
          for rule in RULES {
            if text.matches(pn, rule.re) and not text.matches(line, rule.re) {
              add(at, rule.id, rule.code, rule.cat, rule.w, pn, rule.says + " (read with its printf escapes decoded)")
            }
          }
        }
        stick sn = shell_norm(pn, vars)
        vars = sn.vars
        stick norm = sn.full
        if norm != line {
          for rule in RULES {
            if text.matches(sn.text, rule.re) or text.matches(norm, rule.re) {
              add(at, rule.id, rule.code, rule.cat, rule.w, pick(text.matches(sn.text, rule.re), sn.text, norm), rule.says + " (read with its split pieces joined)")
            }
          }
        }
        stick net = text.matches(norm, NET_RE)
        if net and packed and not pack_said {
          pack_said = true
          add(at, "exfil-dotpack", "E872", "exfiltration", 0.8, norm, "packs up a hidden folder from your home, then talks to the network")
        }
        if text.matches(norm, DOTPACK_RE) {
          packed = true
        }
        if net and unseen_host(norm) {
          if text.matches(norm, UPLOAD_RE) {
            add(at, "exfil-upload-unseen", "E872", "exfiltration", 0.5, norm, "uploads a local file to a host the read cannot see")
          } else {
            add(at, "net-unseen", "E872", "exfiltration", 0.4, norm, "talks to a host the read cannot see")
          }
        }
      }
      stick jn = js_norm(line)
      if jn != line {
        for rule in RULES {
          if text.matches(jn, rule.re) and not text.matches(line, rule.re) {
            add(at, rule.id, rule.code, rule.cat, rule.w, jn, rule.says + " (read with its pieces joined)")
          }
        }
      }
      if text.matches(jn, CODE_RAWIP_RE) {
        add(at, "exfil-rawip-code", "E872", "exfiltration", 0.8, jn, "opens a connection to a raw address, built so it does not read as one")
      }
      codevars = code_consts(jn, codevars)
      if depth < DECODE_DEPTH {
        for cmd in handed_commands(jn, codevars) {
          for f in scan_text("run from " + at, cmd, true, true, depth + 1, budget) {
            add(f.where, f.rule, f.code, f.cat, f.w, f.text, f.says + " (the command it hands to a shell, as built)")
          }
        }
      }
      if depth < DECODE_DEPTH {
        for payload in decoded_payloads(line, budget) {
          for f in scan_text("decoded from " + at, payload, true, true, depth + 1, budget) {
            add(f.where, f.rule, f.code, f.cat, f.w, f.text, f.says)
          }
        }
      }
    }
  }
  snuff found
}

# The guard's read of a task: the static read, and its lockfiles' packages
# against OSV, the blacklist, the top-names list (typosquats, E881) and the
# ecosystem's own registry (metadata signals E882, E883, E884).
pull read_task(t, name) {
  stick v = static_read(t, name)
  stick known = osv_findings(t) + blacklist_findings(t) + typosquat_findings(t) + metadata_findings(t)
  if known.is_empty() {
    snuff v
  }
  stick all = v.findings + known
  snuff {risk: risk_of(all), findings: all, hooks: v.hooks}
}

# ----- known-bad packages: OSV (#55 step 3) --------------------------------------
#
# Every package a task's lockfiles name is checked against OSV: a malicious
# package (a MAL- advisory, or one whose weakness is embedded malicious code,
# CWE-506 or CWE-912) is critical and refused before anything is installed;
# a known vulnerability is reported, one line per package, and holds nothing.
# Online sends name@version alone, batched, and keeps the answers a day;
# offline reads the database `cigo audit --update-db` builds from OSV's own
# dumps, and nothing leaves the machine.

# A package's key, the way OSV matches it: PyPI names normalised (PEP 503),
# Go and Packagist versions without a leading v.
pull osv_key(p) {
  snuff p.eco + "|" + osv_name(p.eco, p.name) + "@" + osv_ver(p.eco, p.version)
}

pull osv_name(eco, name) {
  if eco == "PyPI" {
    snuff text.replace(str(name).lower(), "[-_.]+", "-")
  }
  snuff str(name)
}

pull osv_ver(eco, version) {
  stick v = str(version)
  if (eco == "Go" or eco == "Packagist") and v.starts_with("v") {
    snuff v.slice(1)
  }
  snuff v
}

pull pkg(eco, name, version, where) {
  snuff {eco: eco, name: str(name), version: str(version), where: where}
}

# The packages a lockfile names, each with its ecosystem; [] for a file this
# does not read (or cannot parse).
pull lock_packages(file) {
  roll body = ""
  try {
    body = unbom(fs.read_text(file))
  } ashtray e {
    snuff []
  }
  roll out = lock_packages_in(path.base(file), body, tilde(file))
  for p in out {
    p["file"] = file
  }
  snuff out
}

# The packages a lockfile's text names (its name says which format).
pull lock_packages_in(base, body, where) {
  roll out = []
  try {
    if base == "package-lock.json" or base == "npm-shrinkwrap.json" {
      stick j = json.parse(body)
      stick pk = j.get("packages", null)
      if type_of(pk) == "map" {
        for k in pk {
          stick e = pk[k]
          if k != "" and type_of(e) == "map" and e.has("version") and not e.get("link", false) {
            out.push(pkg("npm", k.split("node_modules/").last(), e.version, where).merge({integrity: str(e.get("integrity", ""))}))
          }
        }
      } else {
        pull walk(deps) {
          if type_of(deps) == "map" {
            for k in deps {
              stick e = deps[k]
              if type_of(e) == "map" and e.has("version") {
                out.push(pkg("npm", k, e.version, where))
                walk(e.get("dependencies", null))
              }
            }
          }
        }
        walk(j.get("dependencies", null))
      }
    } else if base == "yarn.lock" {
      roll name = null
      for line in body.lines() {
        if line != "" and not line.starts_with(" ") and not line.starts_with("#") and line.trim_end().ends_with(":") {
          stick head = line.trim_end()
          stick first = head.slice(0, head.len() - 1).split(",").first().trim().replace("\"", "")
          stick from = pick(first.starts_with("@"), 1, 0)
          stick at = first.slice(from).find("@")
          name = null
          if at >= 0 {
            name = first.slice(0, at + from)
          }
          if first.starts_with("__metadata") {
            name = null
          }
        } else if name != null {
          stick c = text.captures(line, '^\s+version:?\s+"?([^"\s]+)"?')
          if c != null {
            if not c[1].contains("-use.local") {
              out.push(pkg("npm", name, c[1], where))
            }
            name = null
          }
        }
      }
    } else if base == "pnpm-lock.yaml" {
      roll inside = false
      for line in body.lines() {
        if line != "" and not line.starts_with(" ") {
          inside = line.trim_end() == "packages:"
        } else if inside {
          stick c = text.captures(line, '^  [\x27"]?/?(@?[^@\s\x27"/(]+(?:/[^@\s\x27"(]+)?)@([0-9][^:(\x27"\s]*)')
          if c != null {
            out.push(pkg("npm", c[1], c[2], where))
          }
        }
      }
    } else if base == "bun.lock" {
      for m in text.find_all(body, '\["(@?[^"@\s]+(?:/[^"@\s]+)?)@([0-9][^"]*)"') {
        stick c = text.captures(m, '\["(@?[^"@\s]+(?:/[^"@\s]+)?)@([0-9][^"]*)"')
        out.push(pkg("npm", c[1], c[2], where))
      }
    } else if base == "Cargo.lock" or base == "uv.lock" or base == "poetry.lock" or base == "pdm.lock" {
      stick eco = pick(base == "Cargo.lock", "crates.io", "PyPI")
      roll cur = {}
      pull flush() {
        if cur.has("name") and cur.has("version") {
          stick src = str(cur.get("source", ""))
          stick from_registry = pick(base == "Cargo.lock" or base == "uv.lock", src.contains("registry"), not src.contains("path") and not src.contains("editable") and not src.contains("virtual"))
          if from_registry {
            out.push(pkg(eco, cur.name, cur.version, where).merge({integrity: str(cur.get("checksum", ""))}))
          }
        }
        cur = {}
      }
      for line in body.lines() {
        stick bare = line.trim()
        if bare == "[[package]]" {
          flush()
        } else {
          stick c = text.captures(line, '^(name|version|source|checksum)\s*=\s*(.+)$')
          if c != null {
            cur[c[1]] = c[2].trim().replace("\"", "")
          }
        }
      }
      flush()
    } else if base == "Pipfile.lock" {
      stick j = json.parse(body)
      for section in ["default", "develop"] {
        stick deps = j.get(section, {})
        if type_of(deps) == "map" {
          for k in deps {
            stick v = str(deps[k].get("version", ""))
            if v.starts_with("==") {
              out.push(pkg("PyPI", k, v.slice(2), where))
            }
          }
        }
      }
    } else if base == "requirements.txt" {
      for line in body.lines() {
        stick c = text.captures(line, '^\s*([A-Za-z0-9][A-Za-z0-9._-]*)(?:\[[^\]]*\])?\s*==\s*([^\s;#,]+)')
        if c != null {
          out.push(pkg("PyPI", c[1], c[2], where))
        }
      }
    } else if base == "go.sum" {
      roll seen = {}
      for line in body.lines() {
        stick c = text.captures(line, '^(\S+) (v[^\s/]+)(?:/go\.mod)? ')
        if c != null and not seen.has(c[1] + "@" + c[2]) {
          seen[c[1] + "@" + c[2]] = true
          out.push(pkg("Go", c[1], c[2], where))
        }
      }
    } else if base == "Gemfile.lock" {
      roll specs = false
      for line in body.lines() {
        if not line.starts_with(" ") {
          specs = false
        }
        if line.trim() == "specs:" {
          specs = true
        } else if specs {
          stick c = text.captures(line, '^    ([A-Za-z0-9_.-]+) \(([0-9][^\s)-]*)')
          if c != null {
            out.push(pkg("RubyGems", c[1], c[2], where))
          }
        }
      }
    } else if base == "composer.lock" {
      stick j = json.parse(body)
      for section in ["packages", "packages-dev"] {
        for e in j.get(section, []) {
          if type_of(e) == "map" and e.has("name") and e.has("version") {
            out.push(pkg("Packagist", e.name, e.version, where))
          }
        }
      }
    } else if base == "gradle.lockfile" {
      for line in body.lines() {
        stick c = text.captures(line, '^([^:#\s]+):([^:\s]+):([^=\s]+)=')
        if c != null {
          out.push(pkg("Maven", c[1] + ":" + c[2], c[3], where))
        }
      }
    } else if base == "packages.lock.json" {
      stick j = json.parse(body)
      stick fws = j.get("dependencies", {})
      if type_of(fws) == "map" {
        for fw in fws {
          stick deps = fws[fw]
          if type_of(deps) == "map" {
            for k in deps {
              stick r = deps[k].get("resolved", null)
              if r != null and str(deps[k].get("type", "")) != "Project" {
                out.push(pkg("NuGet", k, r, where))
              }
            }
          }
        }
      }
    }
  } ashtray e {
  }
  snuff out
}

# The packages a task's lockfiles name, each once.
pull task_packages(t) {
  roll out = []
  roll seen = {}
  for p in as_list(t.get("packages", [])) {
    stick k = osv_key(p)
    if not seen.has(k) {
      seen[k] = true
      out.push(p)
    }
  }
  for f in task_lockfiles(t) {
    stick key = f + "#" + file_digest(f)
    if not OSV_PARSED.has(key) {
      OSV_PARSED[key] = lock_packages(f)
    }
    for p in OSV_PARSED[key] {
      stick k = osv_key(p)
      if not seen.has(k) {
        seen[k] = true
        out.push(p)
      }
    }
  }
  snuff out
}

# A key of a map, or the fallback when it is not a map (an advisory's JSON
# is not ours to trust).
pull map_get(m, key, fallback) {
  if type_of(m) == "map" {
    snuff m.get(key, fallback)
  }
  snuff fallback
}

pull osv_note(said) {
  if not OSV_NOTED {
    OSV_NOTED = true
    log.warn(said)
  }
}

pull read_json_or(file, fallback) {
  if not fs.is_file(file) {
    snuff fallback
  }
  try {
    snuff json.parse(fs.read_text(file))
  } ashtray e {
    snuff fallback
  }
}

# Online: the advisories OSV names for each package, by key; null when OSV
# could not be asked. Only name, ecosystem and version are sent.
pull osv_online(pkgs) {
  stick cache_file = path.join(OSV_DIR, "online-cache.json")
  roll cache = read_json_or(cache_file, {})
  stick now = time.now_ms()
  roll out = {}
  roll need = []
  for p in pkgs {
    stick k = osv_key(p)
    stick c = cache.get(k, null)
    if type_of(c) == "map" and now - int(c.get("at", 0)) < osv_keep_ms(c) {
      out[k] = c.get("ids", [])
    } else {
      need.push(p)
    }
  }
  roll i = 0
  while i < need.len() {
    stick chunk = need.slice(i, math.min(i + 1000, need.len()))
    i += 1000
    stick body = json.stringify({queries: chunk.map(pack(p) => {package: {name: p.name, ecosystem: p.eco}, version: p.version})})
    roll r = null
    burn {
      try {
        r = proc.run("curl", ["-fsS", "--max-time", "60", "-X", "POST", OSV_API + "/v1/querybatch", "-H", "Content-Type: application/json", "--data-binary", "@-"], {stdin: body, timeout_ms: 90000})
      } ashtray e {
        r = {code: -1, out: "", err: e.message}
      }
    }
    if r.code != 0 {
      osv_note("known-bad packages were not checked: OSV could not be reached (" + clip(str(r.err).trim(), 120) + "); cigo audit --update-db builds a database to check offline")
      snuff null
    }
    # One answer per package asked, or none of it is believed: an error
    # page that parses is not a clean bill.
    roll results = null
    try {
      results = map_get(json.parse(r.out), "results", null)
    } ashtray e {
      results = null
    }
    if type_of(results) != "list" or results.len() != chunk.len() {
      osv_note("known-bad packages were not checked: OSV's answer could not be read")
      snuff null
    }
    roll j = 0
    for p in chunk {
      stick res = results.get(j, {})
      j += 1
      stick ids = as_list(map_get(res, "vulns", [])).map(pack(x) => str(map_get(x, "id", "")))
      out[osv_key(p)] = ids
      cache[osv_key(p)] = {ids: ids, at: now}
    }
  }
  if not need.is_empty() {
    roll kept = {}
    for k in cache {
      if type_of(cache[k]) == "map" and now - int(cache[k].get("at", 0)) < osv_keep_ms(cache[k]) {
        kept[k] = cache[k]
      }
    }
    write_outside(cache_file, json.stringify(kept) + "\n")
  }
  snuff out
}

# The versions an advisory says fix it, by package (`eco|name`), from its
# SEMVER and ECOSYSTEM ranges (a GIT range's fix is a commit, not a version).
pull osv_fixes(v) {
  roll out = {}
  for a in as_list(v.get("affected", [])) {
    stick pk = map_get(a, "package", {})
    stick eco = str(map_get(pk, "ecosystem", ""))
    stick key = eco + "|" + osv_name(eco, map_get(pk, "name", ""))
    for rg in as_list(map_get(a, "ranges", [])) {
      if ["SEMVER", "ECOSYSTEM"].contains(str(map_get(rg, "type", ""))) {
        for e in as_list(map_get(rg, "events", [])) {
          stick f = map_get(e, "fixed", null)
          if f != null {
            roll l = out.get(key, [])
            if not l.contains(str(f)) {
              l.push(str(f))
            }
            out[key] = l
          }
        }
      }
    }
  }
  snuff out
}

# How long a cached answer stands: a day when it names advisories, an hour
# when it is clean.
pull osv_keep_ms(c) {
  if as_list(c.get("ids", [])).is_empty() {
    snuff OSV_CLEAN_MS
  }
  snuff OSV_CACHE_MS
}

# Is this advisory a malicious package? MAL- ids are; otherwise its
# weakness is embedded malicious code or hidden functionality, or it says so.
pull osv_malware(id, v) {
  if id.starts_with("MAL-") {
    snuff true
  }
  stick cwes = map_get(v.get("database_specific", null), "cwe_ids", [])
  if type_of(cwes) == "list" and (cwes.contains("CWE-506") or cwes.contains("CWE-912")) {
    snuff true
  }
  snuff text.matches(str(v.get("summary", "")), '(?i)\bmalicious (code|package)|\bmalware\b')
}

# What each advisory is, online: {malware, severity, summary} by id, the
# details fetched once (in parallel, within a cap) and kept.
pull osv_details_online(ids) {
  stick cache_file = path.join(OSV_DIR, "advisories.json")
  roll cache = read_json_or(cache_file, {})
  roll out = {}
  roll need = []
  for id in ids {
    if id.starts_with("MAL-") {
      out[id] = {malware: true, severity: "", summary: "", fixed: {}}
    } else if type_of(cache.get(id, null)) == "map" and cache[id].has("fixed") {
      out[id] = cache[id]
    } else if need.len() < OSV_DETAIL_CAP and not need.contains(id) {
      need.push(id)
    }
  }
  if need.is_empty() {
    snuff out
  }
  stick tmp = path.join(OSV_DIR, "tmp-details")
  roll words = ["-fsS", "--max-time", "120", "--create-dirs", "--parallel", "--parallel-max", "16"]
  for id in need {
    words = words + ["-o", path.join(tmp, id + ".json"), OSV_API + "/v1/vulns/" + id]
  }
  burn {
    try {
      proc.run("curl", words, {timeout_ms: 180000})
    } ashtray e {
    }
  }
  for id in need {
    # The advisory asked for, or nothing: an error body is not an advisory.
    stick v = read_json_or(path.join(tmp, id + ".json"), null)
    if type_of(v) == "map" and str(v.get("id", "")) == id {
      stick d = {malware: osv_malware(id, v), severity: str(map_get(v.get("database_specific", null), "severity", "")), summary: clip(str(v.get("summary", "")), 120), fixed: osv_fixes(v)}
      out[id] = d
      cache[id] = d
    }
  }
  remove_tree_outside(tmp)
  write_outside(cache_file, json.stringify(cache) + "\n")
  snuff out
}

# Compare two versions: dotted parts numerically where they are numbers,
# a pre-release (`-rc1`, `1.0rc1`) before its release, build metadata
# ignored. Semver exactly (npm, crates.io, Go); close enough for the rest,
# whose own rules (PEP 440, Maven) the online check applies exactly.
pull ver_cmp(a, b) {
  stick pa = ver_parts(a)
  stick pb = ver_parts(b)
  roll i = 0
  while i < math.max(pa.main.len(), pb.main.len()) {
    stick x = pa.main.get(i, "0")
    stick y = pb.main.get(i, "0")
    stick nx = text.find(x, "^[0-9]+")
    stick ny = text.find(y, "^[0-9]+")
    if nx != null and ny != null and int(nx) != int(ny) {
      snuff pick(int(nx) < int(ny), -1, 1)
    }
    if x != y {
      # The same number, then whatever follows it: a suffix (rc1) comes first.
      if nx != null and ny != null {
        snuff pick(x.len() > y.len(), -1, 1)
      }
      snuff pick(x < y, -1, 1)
    }
    i += 1
  }
  if pa.pre == pb.pre {
    snuff 0
  }
  if pa.pre == "" {
    snuff 1
  }
  if pb.pre == "" {
    snuff -1
  }
  snuff pick(pa.pre < pb.pre, -1, 1)
}

pull ver_parts(v) {
  roll s = str(v)
  if s.starts_with("v") {
    s = s.slice(1)
  }
  stick plus = s.find("+")
  if plus >= 0 {
    s = s.slice(0, plus)
  }
  roll pre = ""
  stick dash = s.find("-")
  if dash >= 0 {
    pre = s.slice(dash + 1)
    s = s.slice(0, dash)
  }
  snuff {main: s.split("."), pre: pre}
}

# Is a version inside an OSV range ([kind, version] pairs in order)? In
# from an introduced at or below it, out again from a fixed at or below it
# or a last affected below it.
pull in_range(version, pairs) {
  roll inside = false
  for e in pairs {
    stick c = pick(e[1] == "0", 1, ver_cmp(version, e[1]))
    if e[0] == "i" and c >= 0 {
      inside = true
    } else if e[0] == "f" and c >= 0 {
      inside = false
    } else if e[0] == "l" and c > 0 {
      inside = false
    }
  }
  snuff inside
}

# Offline: the database `cigo audit --update-db` built, one per ecosystem.
pull osv_index(eco) {
  if not OSV_INDEXES.has(eco) {
    OSV_INDEXES[eco] = read_json_or(path.join(OSV_DIR, "db-" + slug(eco) + ".json"), null)
  }
  snuff OSV_INDEXES[eco]
}

pull osv_offline(pkgs) {
  roll out = {}
  roll missing = []
  for p in pkgs {
    stick idx = osv_index(p.eco)
    if idx == null {
      if not missing.contains(p.eco) {
        missing.push(p.eco)
      }
    } else {
      stick name = osv_name(p.eco, p.name)
      stick ver = osv_ver(p.eco, p.version)
      roll ids = idx.versions.get(name + "@" + ver, []) + idx.all.get(name, [])
      for r in map_get(idx, "ranges", {}).get(name, []) {
        if not ids.contains(r[0]) and in_range(ver, r[1]) {
          ids.push(r[0])
        }
      }
      out[osv_key(p)] = ids
    }
  }
  if not missing.is_empty() {
    osv_note("known-bad packages were not checked for " + missing.join(", ") + ": no offline database (cigo audit --update-db " + missing.join(" ") + ")")
  }
  snuff out
}

pull osv_details_offline(ids, pkgs) {
  roll out = {}
  for id in ids {
    roll d = null
    if id.starts_with("MAL-") {
      d = {malware: true, severity: "", summary: ""}
    }
    roll fixed = {}
    for p in pkgs {
      stick idx = osv_index(p.eco)
      if idx != null {
        if d == null and idx.meta.has(id) {
          stick m = idx.meta[id]
          d = {malware: m.get(0, 0) == 1, severity: str(m.get(1, "")), summary: str(m.get(2, ""))}
        }
        stick name = osv_name(p.eco, p.name)
        for r in map_get(idx, "ranges", {}).get(name, []) {
          if r[0] == id {
            for e in r[1] {
              if e[0] == "f" {
                stick key = p.eco + "|" + name
                roll l = fixed.get(key, [])
                if not l.contains(e[1]) {
                  l.push(e[1])
                }
                fixed[key] = l
              }
            }
          }
        }
      }
    }
    if d != null {
      d["fixed"] = fixed
      out[id] = d
    }
  }
  snuff out
}

# The OSV findings for a task: one per package, malicious (E870, critical)
# or known-vulnerable (E885, low; a little heavier at critical severity).
pull osv_findings(t) {
  stick mode = pick(flags.contains("--offline"), "offline", config().osv)
  if mode == "off" {
    snuff []
  }
  stick pkgs = task_packages(t)
  if pkgs.is_empty() {
    snuff []
  }
  # Not pick(): it evaluates both arms, and each asks somewhere else.
  roll hits = null
  if mode == "offline" {
    hits = osv_offline(pkgs)
  } else {
    hits = osv_online(pkgs)
  }
  if hits == null {
    snuff []
  }
  roll ids = []
  for k in hits {
    for id in hits[k] {
      if not ids.contains(id) {
        ids.push(id)
      }
    }
  }
  if ids.is_empty() {
    snuff []
  }
  roll about = {}
  if mode == "offline" {
    about = osv_details_offline(ids, pkgs)
  } else {
    about = osv_details_online(ids)
  }
  roll found = []
  for p in pkgs {
    stick these = hits.get(osv_key(p), [])
    if not these.is_empty() {
      stick bad = these.filter(pack(id) => about.get(id, {}).get("malware", false))
      stick vuln = these.filter(pack(id) => not about.get(id, {}).get("malware", false))
      stick named = p.name + "@" + p.version
      if not bad.is_empty() {
        found.push({code: "E870", cat: "known-bad", w: 1.0, rule: "osv-malware", where: p.where, file: p.get("file", null), pkg: p.name, text: named, says: "a known malicious package (" + bad.join(", ") + ")"})
      }
      if not vuln.is_empty() {
        stick sevs = vuln.map(pack(id) => str(about.get(id, {}).get("severity", "")))
        stick worst = pick(sevs.contains("CRITICAL"), "critical", pick(sevs.contains("HIGH"), "high", pick(sevs.contains("MODERATE") or sevs.contains("MEDIUM"), "moderate", pick(sevs.contains("LOW"), "low", ""))))
        stick shown = vuln.slice(0, math.min(4, vuln.len())).join(", ") + pick(vuln.len() > 4, " and " + str(vuln.len() - 4) + " more", "")
        found.push({code: "E885", cat: "vulnerable", w: pick(worst == "critical", 0.45, 0.3), rule: "osv-vuln", where: p.where, file: p.get("file", null), pkg: p.name, text: named, says: str(vuln.len()) + " known vulnerabilit" + pick(vuln.len() == 1, "y", "ies") + pick(worst == "", "", ", the worst " + worst) + " (" + shown + "); " + osv_fix_text(p, vuln, about)})
      }
    }
  }
  snuff found
}

# The version that fixes every advisory a package has: for each, the lowest
# fixed version above the one installed; the highest of those is the one
# to move to. An advisory with no fix named is counted, not guessed.
pull osv_fix_text(p, vuln, about) {
  stick key = p.eco + "|" + osv_name(p.eco, p.name)
  roll need_at = ""
  roll unfixed = 0
  for id in vuln {
    roll lowest = ""
    for f in as_list(map_get(map_get(about.get(id, {}), "fixed", {}), key, [])) {
      if ver_cmp(f, p.version) > 0 and (lowest == "" or ver_cmp(f, lowest) < 0) {
        lowest = f
      }
    }
    if lowest == "" {
      unfixed += 1
    } else if need_at == "" or ver_cmp(lowest, need_at) > 0 {
      need_at = lowest
    }
  }
  if unfixed == 0 {
    snuff "fixed in " + need_at
  }
  if unfixed == vuln.len() {
    snuff "no fixed version is named"
  }
  snuff "fixed in " + need_at + " for all but " + str(unfixed)
}

# Remove a folder outside the pack (a hop, as write_outside).
pull remove_tree_outside(dir) {
  burn {
    try {
      if which("rm") != null {
        proc.run("rm", ["-rf", "--", dir], {timeout_ms: 120000})
      } else if powershell() != null {
        proc.run(powershell(), ["-NoProfile", "-NonInteractive", "-Command", "Remove-Item -LiteralPath $env:CIGO_FILE -Recurse -Force -ErrorAction SilentlyContinue; exit 0"], {env: {CIGO_FILE: dir}, timeout_ms: 120000})
      }
    } ashtray e {
    }
  }
}

# `cigo audit --update-db [<ecosystem>...]`: OSV's dump for each ecosystem
# (the project's, by default) downloaded, read into a database of the
# versions each advisory names, and the dump thrown away.
pull do_update_db(g) {
  roll ecos = targets
  if ecos.is_empty() and g != null {
    roll seen = []
    for n in g.tasks {
      if not g.tasks[n].get("group", false) {
        for p in task_packages(g.tasks[n]) {
          if not seen.contains(p.eco) {
            seen.push(p.eco)
          }
        }
      }
    }
    ecos = seen
  }
  if ecos.is_empty() {
    ecos = OSV_ECOSYSTEMS
  }
  for eco in ecos {
    if not OSV_ECOSYSTEMS.contains(eco) {
      fail("no OSV ecosystem `${eco}` here; these are: ${OSV_ECOSYSTEMS.join(", ")}")
    }
  }
  for eco in ecos {
    stick url = OSV_DUMPS + "/" + eco + "/all.zip"
    stick tmp = path.join(OSV_DIR, "tmp-" + slug(eco))
    stick started = time.now_ms()
    exhale "osv: ${eco}: fetching ${url}"
    roll r = null
    burn {
      try {
        if which("sh") != null {
          r = proc.run("sh", ["-c", 'rm -rf "$1" && mkdir -p "$1/x" && curl -fsSL --max-time 1800 -o "$1/all.zip" "$2" && { unzip -q -o "$1/all.zip" -d "$1/x" 2>/dev/null || tar -xf "$1/all.zip" -C "$1/x"; }', "sh", tmp, url], {timeout_ms: 2400000})
        } else {
          r = proc.run(powershell(), ["-NoProfile", "-NonInteractive", "-Command", "$d = $env:CIGO_FILE; Remove-Item -LiteralPath $d -Recurse -Force -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Force -Path \"$d/x\" | Out-Null; Invoke-WebRequest -UseBasicParsing -Uri $env:CIGO_URL -OutFile \"$d/all.zip\"; Expand-Archive -Force -Path \"$d/all.zip\" -DestinationPath \"$d/x\""], {env: {CIGO_FILE: tmp, CIGO_URL: url}, timeout_ms: 2400000})
        }
      } ashtray e {
        r = {code: -1, err: e.message}
      }
    }
    if r.code != 0 {
      remove_tree_outside(tmp)
      fail("osv: ${eco}: the dump could not be fetched or unpacked: " + clip(str(r.err).trim(), 200))
    }
    roll versions = {}
    roll every = {}
    roll ranged = {}
    roll meta = {}
    roll n = 0
    for f in fs.list(path.join(tmp, "x")) {
      if f.ends_with(".json") {
        try {
          stick v = json.parse(fs.read_text(f))
          stick id = str(v.get("id", ""))
          n += 1
          if not id.starts_with("MAL-") {
            meta[id] = [pick(osv_malware(id, v), 1, 0), str(map_get(v.get("database_specific", null), "severity", "")), clip(str(v.get("summary", "")), 120)]
          }
          for a in v.get("affected", []) {
            stick pk = a.get("package", {})
            if str(pk.get("ecosystem", "")) == eco {
              stick name = osv_name(eco, pk.get("name", ""))
              for ver in a.get("versions", []) {
                stick nv = name + "@" + osv_ver(eco, ver)
                roll l = versions.get(nv, [])
                if not l.contains(id) {
                  l.push(id)
                }
                versions[nv] = l
              }
              for rg in a.get("ranges", []) {
                stick ev = as_list(map_get(rg, "events", []))
                stick from0 = ev.any(pack(e) => str(map_get(e, "introduced", "")) == "0")
                stick ends = ev.any(pack(e) => type_of(e) == "map" and (e.has("fixed") or e.has("last_affected") or e.has("limit")))
                if from0 and not ends {
                  roll l = every.get(name, [])
                  if not l.contains(id) {
                    l.push(id)
                  }
                  every[name] = l
                } else if ["SEMVER", "ECOSYSTEM"].contains(str(map_get(rg, "type", ""))) {
                  # The range itself, judged at lookup: [kind, version]
                  # pairs, i introduced, f fixed, l last affected.
                  roll pairs = []
                  for e in ev {
                    if type_of(e) == "map" {
                      if e.has("introduced") {
                        pairs.push(["i", osv_ver(eco, e.introduced)])
                      } else if e.has("fixed") {
                        pairs.push(["f", osv_ver(eco, e.fixed)])
                      } else if e.has("last_affected") {
                        pairs.push(["l", osv_ver(eco, e.last_affected)])
                      }
                    }
                  }
                  if not pairs.is_empty() {
                    roll l = ranged.get(name, [])
                    l.push([id, pairs])
                    ranged[name] = l
                  }
                }
              }
            }
          }
        } ashtray e {
        }
      }
    }
    if not write_outside(path.join(OSV_DIR, "db-" + slug(eco) + ".json"), json.stringify({ecosystem: eco, built: time.now_iso(), source: url, advisories: n, versions: versions, all: every, ranges: ranged, meta: meta}) + "\n") {
      remove_tree_outside(tmp)
      fail("osv: ${eco}: the database could not be written under ${tilde(OSV_DIR)}")
    }
    remove_tree_outside(tmp)
    exhale "osv: ${eco}: ${n} advisories: ${versions.len()} versions named, ${ranged.len()} packages by range, ${every.len()} bad in every version (${duration(time.now_ms() - started)})"
  }
}

# ----- typosquats and registry metadata (#55 step 2, codes E881..E884) -----------
#
# E881: the package's name is within a letter or two of a popular one in its
#   ecosystem. The list of popular names is bundled per ecosystem below.
# E882: this version was published in the last `metadata_young_days` days.
# E883: the previous version ran nothing at install; this one does.
# E884: no source repository is linked on the registry.
# The registry is asked once per name and the answer is kept a day.
#
# The top-names lists are chosen by hand from names that rank high in each
# registry's public download counts (npm's downloads, PyPI's
# top-pypi-packages, lib.rs's most-used crates): not a snapshot of today's
# ranking, and refreshed by hand. They are names only, which are facts,
# not the registries' content. Names kept here only for the typosquat
# check; a project adds its own by writing them into its toolchain's
# footprint if it needs to.

