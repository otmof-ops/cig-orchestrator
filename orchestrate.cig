    note: "never detected on its own: add a component with toolchain shell",
    stages: {
      # Tracked .sh and .bash files, and extensionless scripts whose shebang
      # names a shell (bin/deploy); symlinks are the files they point at.
      lint: [{when: ["tool:git", "os:unix"], shell: "git ls-files | while IFS= read -r f; do [ -L \"$f\" ] && continue; case \"\${f##*/}\" in *.sh|*.bash) printf '%s\\0' \"$f\" ;; *.*) ;; *) head -n1 -- \"$f\" 2>/dev/null | grep -qE '^#!.*[/ ](ba|da|k)?sh( |$)' && printf '%s\\0' \"$f\" ;; esac; done | xargs -0 -r shellcheck"},
        {each: {files: ["**/*.sh", "**/*.bash"], skip: ["node_modules", ".git", "vendor"]}, cmd: ["shellcheck", "{file}"]}],
