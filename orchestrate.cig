#!/usr/bin/env cig
# SPDX-FileCopyrightText: 2026 Jay Taylor (https://github.com/otmof-ops/cig-orchestrator)
# SPDX-License-Identifier: Apache-2.0
# cig >=1.4.2
# cig-orchestrator: every language in the project, one chain, no glue script.
#
# Most projects are several languages in a row: a Python step that makes
# data, a Go or Rust service, a TypeScript front end, a Dockerfile, a deploy
# script. Each language brings its own tool (npm, cargo, uv, gradle, go...),
# and the chain between them usually ends up in one more language: a
# Makefile or a bash script whose only job is gluing the others together.
#
# This is that glue, done once, in CigScript. It knows the standard workflow
# of each toolchain (setup, format, lint, check, build, test, package, clean),
# finds every language in the project, runs one stage across all of them in
# dependency order, and passes values between them: a task's stdout or named
# outputs become a later task's arguments, environment or stdin, whatever
# language either is written in. cig adds a dry run, rollback of what the
# scripts created, `cig unburn` to undo a run later, and compensations for
# what no journal can see.
#
#   cigo adopt [--write]          find every language here; propose cig-tasks.json
#   cigo list [--all]             components, stage groups and tasks
#   cigo run <task>...            `cigo run test` runs every language's tests
#   cigo plan | show | check | doctor | outputs | toolchains | help
#
# cig's own flags go first: `cigo --dry-run run ci`. Without the launcher:
# cig run path/to/orchestrate.cig -- <command> ...

pack { "." }

stick VERSION = "0.5.1"
# The cigs this version runs on; the header pin above says the same to cig itself.
stick CIG_NEEDS = ">=1.4.2"
stick REPO = "otmof-ops/cig-orchestrator"
stick MANIFEST = "cig-tasks.json"
stick STATE = ".cig-orchestrator"
stick ROOT = fs.cwd()
# The `versions` and `install` settings (the switch to pinned toolchain
# versions, below) and where the answer and the version probes are kept.
stick VERSION_SETTINGS = ["ask", "always", "never", "off"]
stick INSTALL_SETTINGS = ["ask", "always", "never"]
stick VERSIONS_FILE = path.join(STATE, "state", "versions.json")
# Set for the run by `apply_switches`: component -> the switches its tasks run under.
roll SWITCHES = {}

# ----- stages -----------------------------------------------------------------

# The stages every toolchain speaks, in the order a pipeline takes them.
stick STAGES = ["setup", "format", "format-check", "lint", "check", "build", "test", "package", "run", "clean"]
# A stage group runs its stage in every component; `run` stays per component.
stick GROUP_STAGES = ["setup", "format", "format-check", "lint", "check", "build", "test", "package", "clean"]
stick CI_STAGES = ["format-check", "lint", "check", "build", "test"]
# Inside one component, a stage waits for these, when the component has them.
stick STAGE_NEEDS = {
  setup: [], format: ["setup"], "format-check": ["setup"], lint: ["setup"], check: ["setup"],
  build: ["setup"], test: ["setup"], package: ["build"], run: ["build"], clean: [],
}

# The names projects give their stage scripts in package.json, composer.json,
# deno.json, justfiles and Taskfiles; the first one present wins.
stick SCRIPT_ALIASES = {
  setup: ["setup", "bootstrap", "deps"],
  format: ["format", "fmt", "format:fix", "fmt:fix", "prettier", "prettier:write"],
  "format-check": ["format:check", "format-check", "fmt:check", "fmt-check", "check-format", "check:format", "prettier:check", "lint:format"],
  lint: ["lint", "lint:all", "eslint"],
  check: ["typecheck", "type-check", "check-types", "types", "tsc", "check"],
  build: ["build", "compile"],
  test: ["test", "tests", "test:unit", "spec"],
  package: ["package", "pack", "dist"],
  run: ["run"],
  clean: ["clean"],
}
# make's own conventions: `all` builds, `check` runs the tests, and `install`
# installs into the system, which is not setup.
stick MAKE_ALIASES = {
  setup: ["setup", "bootstrap", "deps", "dependencies"],
  format: ["format", "fmt"],
  "format-check": ["format-check", "fmt-check", "check-format"],
  lint: ["lint"],
  check: ["typecheck", "vet"],
  build: ["build", "all", "compile"],
  test: ["test", "tests", "check"],
  package: ["package", "dist"],
  run: ["run"],
  clean: ["clean"],
}

# Directories adopt does not look inside for components: dependencies,
# caches and build outputs. Hidden directories are skipped as well.
stick WALK_SKIP = ["node_modules", "target", "dist", "build", "out", "vendor", "venv", "bin", "obj", "coverage", "deps", "_build", "zig-out", "Pods", "DerivedData", "tmp", "logs", "__pycache__",
  # test data: inputs for a test suite, often broken on purpose
  "fixtures", "__fixtures__", "testdata", "test-data", "corpus", "golden", "__snapshots__"]
# Inside a language's component, these folders are its own tests, not more components.
stick TEST_DIRS = ["test", "tests", "__tests__", "spec", "specs", "e2e", "benches"]
# Directories an inputs fingerprint does not read.
stick FINGERPRINT_SKIP = [".git", "node_modules", "target", ".venv", "venv", "__pycache__", ".cig-orchestrator", ".gradle", ".terraform"]

# What a stage may change, for the tin (cig 1.2): the files a format stage
# rewrites and the lockfiles a setup stage rewrites, by language family. cig
# keeps their before-bytes before the hop, so a formatter's edits or a
# lockfile a setup moved come back on rollback instead of being listed as
# irreversible. A toolchain sets its own under `touches`, a stage override
# its own, and a task its own; `**` means every file under the component.
stick FAMILY_TOUCHES = {
  python: {format: ["**/*.py", "**/*.pyi"], setup: ["uv.lock", "poetry.lock", "pdm.lock", "Pipfile.lock"]},
  node: {format: ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "**/*.json", "**/*.css", "**/*.scss", "**/*.less", "**/*.html", "**/*.vue", "**/*.svelte", "**/*.astro", "**/*.md", "**/*.mdx", "**/*.yml", "**/*.yaml", "**/*.graphql"],
    setup: ["package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb", "deno.lock"]},
  rust: {format: ["**/*.rs"], setup: ["Cargo.lock"]},
  go: {format: ["**/*.go"], setup: ["go.mod", "go.sum"]},
  jvm: {format: ["**/*.java", "**/*.kt", "**/*.kts", "**/*.groovy"], setup: ["gradle.lockfile", "**/gradle.lockfile", "gradle/verification-metadata.xml"]},
  scala: {format: ["**/*.scala", "**/*.sbt", "**/*.sc"]},
  clojure: {format: ["**/*.clj", "**/*.cljs", "**/*.cljc", "**/*.edn"]},
  dotnet: {format: ["**/*.cs", "**/*.fs", "**/*.vb", "**/*.razor", "**/*.cshtml"], setup: ["**/packages.lock.json"]},
  c: {format: ["**/*.c", "**/*.cc", "**/*.cpp", "**/*.cxx", "**/*.h", "**/*.hh", "**/*.hpp", "**/*.hxx", "**/*.m", "**/*.mm"]},
  shell: {format: ["**/*.sh", "**/*.bash"]},
  ruby: {format: ["**/*.rb", "**/*.rake", "**/*.gemspec", "Gemfile", "Rakefile"], setup: ["Gemfile.lock"]},
  php: {format: ["**/*.php"], setup: ["composer.lock"]},
  elixir: {format: ["**/*.ex", "**/*.exs", "**/*.heex"], setup: ["mix.lock"]},
  erlang: {format: ["**/*.erl", "**/*.hrl", "**/*.escript"], setup: ["rebar.lock"]},
  gleam: {format: ["**/*.gleam"], setup: ["manifest.toml"]},
  swift: {format: ["**/*.swift"], setup: ["Package.resolved", "**/Package.resolved"]},
  dart: {format: ["**/*.dart"], setup: ["pubspec.lock"]},
  zig: {format: ["**/*.zig", "**/*.zon"]},
  haskell: {format: ["**/*.hs", "**/*.lhs", "**/*.cabal"], setup: ["stack.yaml.lock", "cabal.project.freeze"]},
  ocaml: {format: ["**/*.ml", "**/*.mli", "**/dune", "dune-project"], setup: ["*.opam.locked"]},
  nim: {format: ["**/*.nim", "**/*.nims"]},
  lua: {format: ["**/*.lua"]},
  julia: {format: ["**/*.jl"], setup: ["Manifest.toml"]},
  crystal: {format: ["**/*.cr"], setup: ["shard.lock"]},
  perl: {format: ["**/*.pl", "**/*.pm", "**/*.t"], setup: ["cpanfile.snapshot"]},
  r: {format: ["**/*.R", "**/*.r", "**/*.Rmd"], setup: ["renv.lock"]},
  powershell: {format: ["**/*.ps1", "**/*.psm1", "**/*.psd1"]},
  fortran: {format: ["**/*.f90", "**/*.f95", "**/*.f03", "**/*.f08", "**/*.f", "**/*.for"]},
  solidity: {format: ["**/*.sol"]},
  terraform: {format: ["**/*.tf", "**/*.tfvars"], setup: [".terraform.lock.hcl"]},
  bazel: {format: ["**/BUILD", "**/BUILD.bazel", "**/WORKSPACE", "**/*.bzl", "MODULE.bazel"], setup: ["MODULE.bazel.lock"]},
  cigscript: {format: ["**/*.cig"]},
}

# Script folders, and how a script in one runs.
stick SCRIPT_DIRS = ["script", "scripts", "bin", "tools"]
stick LOOSE_SCRIPT_EXTS = pick(cig.os() == "windows", ["sh", "bash", "bat", "cmd", "ps1"], ["sh", "bash"])
# package.json lifecycle scripts run on their own around install, publish and
# pack; they are not tasks.
stick HOOK_SCRIPTS = ["prepare", "preinstall", "install", "postinstall", "prepublish", "prepublishOnly", "prepack", "postpack", "publish", "postpublish", "preversion", "version", "postversion", "dependencies"]
stick INTERPRETERS = {
  sh: ["sh"], bash: ["bash"], zsh: ["zsh"],
  bat: ["cmd", "/d", "/c"], cmd: ["cmd", "/d", "/c"],
  py: ["python3"],
  js: ["node"], mjs: ["node"], cjs: ["node"],
  rb: ["ruby"], pl: ["perl"], php: ["php"], lua: ["lua"], r: ["Rscript"],
  ps1: ["pwsh", "-NoProfile", "-File"],
  cig: ["cig", "run"],
}

# ----- the toolchains ---------------------------------------------------------
#
# What each toolchain is called, how to recognize it, and how it runs each
# stage. Conditions (`detect`, `workspace`, `when`) are checked in the
# component's directory; a list inside the list means "any of these":
#   file:X   dir:X   glob:PATTERN   grep:FILE:REGEX   json:FILE:key.path
#   tool:PROGRAM   not:CONDITION
# A stage is a list of alternatives and the first that applies wins: an argv
# list, {when: [...], cmd: [...]} or {when: [...], shell: "..."}. `{name}` in a
# command is a var; `{component}` and `{dir}` are always set. A project can
# override any of this, or add its own toolchains, under "toolchains" in
# cig-tasks.json.

stick PY_RUFF = ["file:ruff.toml", "file:.ruff.toml", 'grep:pyproject.toml:\bruff\b']
stick PY_BLACK = ['grep:pyproject.toml:\bblack\b', 'grep:requirements*.txt:(?m)^black\b']
stick PY_FLAKE8 = ["file:.flake8", 'grep:setup.cfg:\[flake8\]', 'grep:tox.ini:\[flake8\]']
stick PY_MYPY = ["file:mypy.ini", "file:.mypy.ini", 'grep:pyproject.toml:\bmypy\b', 'grep:setup.cfg:\[mypy']
stick PY_PYRIGHT = ["file:pyrightconfig.json", 'grep:pyproject.toml:\bpyright\b']
stick PY_PYTEST = ["file:pytest.ini", "file:conftest.py", 'grep:pyproject.toml:\bpytest\b', 'grep:setup.cfg:\[tool:pytest\]', 'grep:tox.ini:\[pytest\]', 'grep:requirements*.txt:(?m)^pytest\b']
stick PY_TOX = ["file:tox.ini", "file:tox.toml", 'grep:pyproject.toml:(?m)^\[tool\.tox', 'grep:setup.cfg:\[tox:tox\]']
stick PY_BUILDABLE = ['grep:pyproject.toml:(?m)^\[build-system\]', "file:setup.py"]
# A `dev` group (PEP 735) or extra, or a `test` or `tests` extra, in pyproject.toml:
# the header, then lines that do not open another table, then the name.
stick PY_DEV_GROUP = 'grep:pyproject.toml:(?m)^\[dependency-groups\]\r?\n(?:(?:[^\[\r\n][^\n]*)?\n)*?"?dev"?\s*='
stick PY_DEV_EXTRA = 'grep:pyproject.toml:(?m)^\[project\.optional-dependencies\]\r?\n(?:(?:[^\[\r\n][^\n]*)?\n)*?"?dev"?\s*='
stick PY_TEST_EXTRA = 'grep:pyproject.toml:(?m)^\[project\.optional-dependencies\]\r?\n(?:(?:[^\[\r\n][^\n]*)?\n)*?"?test"?\s*='
stick PY_TESTS_EXTRA = 'grep:pyproject.toml:(?m)^\[project\.optional-dependencies\]\r?\n(?:(?:[^\[\r\n][^\n]*)?\n)*?"?tests"?\s*='
stick PY_PINS = {python: [".python-version", ".tool-versions:python", "mise.toml:python"]}
# The Python this machine has: python3 (python on Windows, where python3
# may be the Store's alias), else the Windows launcher.
stick PY_PYTHON = [{when: ["os:windows", "tool:python"], value: "python"}, {when: ["tool:python3"], value: "python3"}, {when: ["tool:python"], value: "python"}, {value: ["py", "-3"]}]
stick NODE_PINS = {node: [".nvmrc", ".node-version", ".tool-versions:nodejs", "mise.toml:node"]}
stick JAVA_PINS = {java: [".java-version", ".sdkmanrc:java", ".tool-versions:java", "mise.toml:java"]}
stick JS_PRETTIER = ["glob:.prettierrc*", "glob:prettier.config.*", "json:package.json:prettier"]
stick JS_ESLINT = ["glob:eslint.config.*", "glob:.eslintrc*", "json:package.json:eslintConfig"]
stick JS_BIOME = ["file:biome.json", "file:biome.jsonc"]
stick YARN_BERRY = ["file:.yarnrc.yml", "grep:yarn.lock:__metadata:", 'grep:package.json:"packageManager"\s*:\s*"yarn@[2-9]']

# The Python stages, for a way of running tools inside the project's
# environment (`uv run --locked`, `poetry run`, a venv's python -m).
pull python_stages(tool, py) {
  snuff {
    format: [{when: [PY_RUFF], cmd: tool + ["ruff", "format", "."]}, {when: [PY_BLACK], cmd: tool + ["black", "."]}],
    "format-check": [{when: [PY_RUFF], cmd: tool + ["ruff", "format", "--check", "."]}, {when: [PY_BLACK], cmd: tool + ["black", "--check", "."]}],
    lint: [{when: [PY_RUFF], cmd: tool + ["ruff", "check", "."]}, {when: [PY_FLAKE8], cmd: tool + ["flake8"]}],
    check: [{when: [PY_MYPY], cmd: tool + ["mypy", "."]}, {when: [PY_PYRIGHT], cmd: tool + ["pyright"]}],
    test: [
      {when: [PY_TOX], cmd: ["tox"]},
      {when: ["file:noxfile.py"], cmd: ["nox"]},
      {when: [PY_PYTEST], cmd: tool + ["pytest"]},
      {when: [["dir:tests", "dir:test"]], cmd: py + ["-m", "unittest", "discover"]},
    ],
  }
}

# One JavaScript package manager. Stages come from package.json scripts first
# (SCRIPT_ALIASES); the formatter, linter and tsc a project configures are the
# fallback when it has no script for the stage.
pull node_manager(detect, run, exec, setup, packer, extra) {
  snuff {
    language: "JavaScript / TypeScript", short: "node", family: "node", priority: 30,
    detect: pick(detect == "file:package.json", ["file:package.json"], ["file:package.json", detect]),
    workspace: ["file:pnpm-workspace.yaml", "json:package.json:workspaces"],
    versions: {node: ["node", "--version"]},
    pins: NODE_PINS,
    scripts: {file: "package.json", key: "scripts", run: run},
    note: "dev, start, serve and watch scripts do not end on their own, so none of them is a stage",
    stages: {
      setup: setup,
      format: [{when: [JS_BIOME], cmd: exec + ["biome", "format", "--write", "."]}, {when: [JS_PRETTIER], cmd: exec + ["prettier", "--write", "."]}],
      "format-check": [{when: [JS_BIOME], cmd: exec + ["biome", "ci", "."]}, {when: [JS_PRETTIER], cmd: exec + ["prettier", "--check", "."]}],
      lint: [{when: [JS_BIOME], cmd: exec + ["biome", "lint", "."]}, {when: [JS_ESLINT], cmd: exec + ["eslint", "."]}],
      check: [{when: ["file:tsconfig.json"], cmd: exec + ["tsc", "--noEmit"]}],
      package: [{when: ["not:json:package.json:private"], cmd: packer}],
    },
  }.merge(extra)
}

stick TOOLCHAINS = {
  # --- JavaScript and TypeScript -------------------------------------------
  "node-npm": node_manager("file:package.json", ["npm", "run"], ["npm", "exec", "--no", "--"],
    [{when: [["file:package-lock.json", "file:npm-shrinkwrap.json"]], cmd: ["npm", "ci"]}, ["npm", "install"]],
    ["npm", "pack"],
    {priority: 10, tools: ["node", "npm"], install: "https://nodejs.org/en/download"}),
  "node-pnpm": node_manager(["file:pnpm-lock.yaml", 'grep:package.json:"packageManager"\s*:\s*"pnpm@'], ["pnpm", "run"], ["pnpm", "exec"],
    [["pnpm", "install", "--frozen-lockfile"]], ["pnpm", "pack"],
    {tools: ["node", "pnpm"], versions: {node: ["node", "--version"], pnpm: ["pnpm", "--version"]}, install: "https://pnpm.io/installation"}),
  "node-yarn": node_manager(["file:yarn.lock", 'grep:package.json:"packageManager"\s*:\s*"yarn@'], ["yarn", "run"], ["yarn", "run"],
    [{when: [YARN_BERRY], cmd: ["yarn", "install", "--immutable"]}, ["yarn", "install", "--frozen-lockfile", "--non-interactive"]],
    ["yarn", "pack"],
    {tools: ["node", "yarn"], versions: {node: ["node", "--version"], yarn: ["yarn", "--version"]}, install: "https://yarnpkg.com/getting-started/install"}),
  "node-bun": node_manager(["file:bun.lock", "file:bun.lockb", "file:bunfig.toml", 'grep:package.json:"packageManager"\s*:\s*"bun@'], ["bun", "run"], ["bun", "run"],
    [["bun", "install", "--frozen-lockfile"]], ["bun", "pm", "pack"],
    {tools: ["bun"], versions: {bun: ["bun", "--version"]}, pins: {bun: [".bun-version", ".tool-versions:bun", "mise.toml:bun"]},
     install: "https://bun.com/docs/installation"}),
  deno: {
    language: "JavaScript / TypeScript", short: "deno", family: "node", priority: 40,
    detect: [["file:deno.json", "file:deno.jsonc"]], workspace: ["json:deno.json:workspace"],
    tools: ["deno"], versions: {deno: ["deno", "--version"]}, pins: {deno: [".dvmrc", ".tool-versions:deno", "mise.toml:deno"]},
    install: "https://docs.deno.com/runtime/getting_started/installation/",
    scripts: {file: "deno.json", key: "tasks", run: ["deno", "task"]},
    note: "deno check needs entry files, so there is no check stage unless deno.json has a check task",
    stages: {
      setup: [{when: ["file:deno.lock"], cmd: ["deno", "install", "--frozen"]}, ["deno", "install"]],
      format: [["deno", "fmt"]], "format-check": [["deno", "fmt", "--check"]], lint: [["deno", "lint"]], test: [["deno", "test"]],
    },
  },

  # --- Python ---------------------------------------------------------------
  "python-uv": {
    language: "Python", short: "python", family: "python", priority: 40,
    detect: [["file:uv.lock", 'grep:pyproject.toml:(?m)^\[tool\.uv']],
    workspace: ['grep:pyproject.toml:(?m)^\[tool\.uv\.workspace\]'],
    tools: ["uv"], versions: {uv: ["uv", "--version"]},
    install: "https://docs.astral.sh/uv/getting-started/installation/",
    note: "uv reads .python-version itself, so no Python pin is checked here",
    vars: {uvrun: [{when: ["file:uv.lock"], value: ["uv", "run", "--locked"]}, {value: ["uv", "run"]}]},
    stages: python_stages(["{uvrun}"], ["{uvrun}", "python"]).merge({
      setup: [{when: ["file:uv.lock"], cmd: ["uv", "sync", "--locked"]}, ["uv", "sync"]],
      package: [{when: [PY_BUILDABLE], cmd: ["uv", "build"]}],
    }),
  },
  "python-poetry": {
    language: "Python", short: "python", family: "python", priority: 35,
    detect: [["file:poetry.lock", 'grep:pyproject.toml:(?m)^\[tool\.poetry', 'grep:pyproject.toml:poetry\.core\.masonry']],
    tools: ["poetry"], versions: {poetry: ["poetry", "--version"], python: ["{python}", "--version"]}, pins: PY_PINS,
    vars: {python: PY_PYTHON},
    install: "https://python-poetry.org/docs/#installation",
    stages: python_stages(["poetry", "run"], ["poetry", "run", "python"]).merge({
      setup: [["poetry", "install", "--no-interaction"]], package: [["poetry", "build", "--no-interaction"]],
    }),
  },
  "python-pdm": {
    language: "Python", short: "python", family: "python", priority: 35,
    detect: [["file:pdm.lock", 'grep:pyproject.toml:(?m)^\[tool\.pdm', 'grep:pyproject.toml:pdm\.backend']],
    tools: ["pdm"], versions: {pdm: ["pdm", "--version"], python: ["{python}", "--version"]}, pins: PY_PINS,
    vars: {python: PY_PYTHON},
    install: "https://pdm-project.org/latest/#installation",
    stages: python_stages(["pdm", "run"], ["pdm", "run", "python"]).merge({
      setup: [{when: ["file:pdm.lock"], cmd: ["pdm", "install", "--check"]}, ["pdm", "install"]], package: [["pdm", "build"]],
    }),
  },
  "python-hatch": {
    language: "Python", short: "python", family: "python", priority: 30,
    detect: [["file:hatch.toml", 'grep:pyproject.toml:(?m)^\[tool\.hatch\.envs']],
    tools: ["hatch"], versions: {hatch: ["hatch", "--version"]},
    install: "https://hatch.pypa.io/latest/install/",
    stages: {
      setup: [["hatch", "env", "create"]],
      format: [["hatch", "fmt", "--formatter"]], "format-check": [["hatch", "fmt", "--check", "--formatter"]],
      lint: [["hatch", "fmt", "--check", "--linter"]], test: [["hatch", "test"]],
      package: [["hatch", "build"]], clean: [["hatch", "clean"]],
    },
  },
  "python-pipenv": {
    language: "Python", short: "python", family: "python", priority: 30,
    detect: ["file:Pipfile"],
    tools: ["pipenv"], versions: {pipenv: ["pipenv", "--version"], python: ["{python}", "--version"]}, pins: PY_PINS,
    vars: {python: PY_PYTHON},
    install: "https://pipenv.pypa.io/en/latest/installation.html",
    stages: python_stages(["pipenv", "run"], ["pipenv", "run", "python"]).merge({
      setup: [{when: ["file:Pipfile.lock"], cmd: ["pipenv", "sync", "--dev"]}, ["pipenv", "install", "--dev"]],
    }),
  },
  "python-pip": {
    language: "Python", short: "python", family: "python", priority: 10,
    detect: [["file:requirements.txt", "file:pyproject.toml", "file:setup.py", "file:setup.cfg"]],
    tools: [], versions: {python: ["{python}", "--version"]}, pins: PY_PINS,
    install: "https://www.python.org/downloads/",
    note: "setup makes .venv with the project and its dev requirements (requirements-dev.txt, a dev dependency group, or a dev, test or tests extra); the other stages run inside it",
    vars: {
      python: PY_PYTHON,
      py: [{when: ["os:windows", ["file:requirements.txt", PY_BUILDABLE]], value: ".venv/Scripts/python.exe"}, {when: [["file:requirements.txt", PY_BUILDABLE]], value: ".venv/bin/python"}, {value: "{python}"}],
    },
    stages: python_stages(["{py}", "-m"], ["{py}"]).merge({
      # Two or three commands in a row, no shell between them: the venv, then
      # pip inside it. `{py}` is the venv's own python on every OS.
      setup: [
        {when: ["file:requirements.txt", "file:requirements-dev.txt"], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-r", "requirements.txt", "-r", "requirements-dev.txt"]]},
        {when: ["file:requirements.txt", "file:dev-requirements.txt"], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-r", "requirements.txt", "-r", "dev-requirements.txt"]]},
        {when: ["file:requirements.txt"], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-r", "requirements.txt"]]},
        # --group needs pip 25.1, newer than many system Pythons ship in a venv.
        {when: [PY_BUILDABLE, PY_DEV_GROUP], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-U", "pip"], ["{py}", "-m", "pip", "install", "-e", ".", "--group", "dev"]]},
        {when: [PY_BUILDABLE, PY_DEV_EXTRA], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-e", ".[dev]"]]},
        {when: [PY_BUILDABLE, PY_TEST_EXTRA], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-e", ".[test]"]]},
        {when: [PY_BUILDABLE, PY_TESTS_EXTRA], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-e", ".[tests]"]]},
        {when: [PY_BUILDABLE], cmds: [["{python}", "-m", "venv", ".venv"], ["{py}", "-m", "pip", "install", "-e", "."]]},
      ],
      package: [{when: [PY_BUILDABLE], cmd: ["{py}", "-m", "build"]}],
    }),
  },

  # --- Rust and Go -------------------------------------------------------------
  "rust-cargo": {
    language: "Rust", short: "rust", family: "rust", priority: 20,
    detect: ["file:Cargo.toml"], workspace: ['grep:Cargo.toml:(?m)^\[workspace\]'],
    tools: ["cargo"], versions: {rustc: ["rustc", "--version"], cargo: ["cargo", "--version"]},
    pins: {rustc: ["rust-toolchain.toml", "rust-toolchain", ".tool-versions:rust", "mise.toml:rust"]},
    install: "https://rustup.rs",
    note: "cig does not watch target/, so build outputs are not rolled back; --locked is used when Cargo.lock exists",
    vars: {locked: [{when: ["file:Cargo.lock"], value: ["--locked"]}, {value: []}], lockflag: [{when: ["file:Cargo.lock"], value: " --locked"}, {value: ""}]},
    stages: {
      setup: [{when: [["file:rust-toolchain.toml", "file:rust-toolchain"], "tool:rustup"], cmds: [["rustup", "toolchain", "install"], ["cargo", "fetch", "{locked}"]]}, ["cargo", "fetch", "{locked}"]],
      format: [["cargo", "fmt", "--all"]], "format-check": [["cargo", "fmt", "--all", "--check"]],
      lint: [["cargo", "clippy", "--workspace", "--all-targets", "{locked}", "--", "-D", "warnings"]],
      check: [["cargo", "check", "--workspace", "--all-targets", "{locked}"]],
      build: [["cargo", "build", "--workspace", "{locked}"]], test: [["cargo", "test", "--workspace", "{locked}"]],
      package: [["cargo", "build", "--release", "{locked}"]], run: [["cargo", "run", "{locked}"]], clean: [["cargo", "clean"]],
    },
  },
  go: {
    language: "Go", short: "go", family: "go", priority: 20,
    detect: ["file:go.mod"], workspace: ["file:go.work"],
    tools: ["go"], versions: {go: ["go", "version"]},
    pins: {go: ["go.mod:go", ".go-version", ".tool-versions:golang", "mise.toml:go"]},
    install: "https://go.dev/doc/install",
    vars: {go_files: [{files: ["**/*.go"], skip: ["vendor", "testdata"]}]},
    stages: {
      setup: [["go", "mod", "download"]],
      format: [["go", "fmt", "./..."]],
      "format-check": [{cmd: ["gofmt", "-l", "{go_files}"], fail_on_output: true}],
      lint: [{when: [["file:.golangci.yml", "file:.golangci.yaml", "file:.golangci.toml", "file:.golangci.json"]], cmd: ["golangci-lint", "run"]}],
      check: [["go", "vet", "./..."]], build: [["go", "build", "./..."]], test: [["go", "test", "./..."]],
      run: [{when: ["file:main.go"], cmd: ["go", "run", "."]}], clean: [["go", "clean"]],
    },
  },

  # --- JVM ----------------------------------------------------------------------
  "java-gradle": {
    language: "Java / Kotlin", short: "gradle", family: "jvm", priority: 20,
    detect: [["file:build.gradle", "file:build.gradle.kts", "file:settings.gradle", "file:settings.gradle.kts"]],
    workspace: ["file:settings.gradle", "file:settings.gradle.kts"],
    tools: ["java"], versions: {java: ["java", "-version"]}, pins: JAVA_PINS,
    install: "https://docs.gradle.org/current/userguide/installation.html",
    note: "a root task name runs in every subproject; formatter and linter tasks exist only when their plugin is applied",
    vars: {gradle: [{when: ["os:windows", "file:gradlew.bat"], value: "gradlew.bat"}, {when: ["file:gradlew"], value: "./gradlew"}, {value: "gradle"}]},
    stages: {
      format: [{when: ["grep:build.gradle*:spotless"], cmd: ["{gradle}", "--console=plain", "spotlessApply"]}, {when: ["grep:build.gradle*:ktlint"], cmd: ["{gradle}", "--console=plain", "ktlintFormat"]}],
      "format-check": [{when: ["grep:build.gradle*:spotless"], cmd: ["{gradle}", "--console=plain", "spotlessCheck"]}, {when: ["grep:build.gradle*:ktlint"], cmd: ["{gradle}", "--console=plain", "ktlintCheck"]}],
      lint: [{when: ["grep:build.gradle*:detekt"], cmd: ["{gradle}", "--console=plain", "detekt"]}, {when: ["grep:build.gradle*:(checkstyle|pmd|spotbugs)"], cmd: ["{gradle}", "--console=plain", "check", "-x", "test"]}],
      check: [["{gradle}", "--console=plain", "classes", "testClasses"]],
      build: [["{gradle}", "--console=plain", "assemble"]], test: [["{gradle}", "--console=plain", "test"]],
      package: [{when: ['grep:build.gradle*:(bootJar|org\.springframework\.boot)'], cmd: ["{gradle}", "--console=plain", "bootJar"]}, {when: ['grep:build.gradle*:\bapplication\b'], cmd: ["{gradle}", "--console=plain", "distZip"]}],
      run: [{when: ['grep:build.gradle*:\bapplication\b'], cmd: ["{gradle}", "--console=plain", "run"]}],
      clean: [["{gradle}", "--console=plain", "clean"]],
    },
  },
  "android-gradle": {
    language: "Android (Kotlin / Java)", short: "android", family: "jvm", priority: 25,
    detect: [["file:app/src/main/AndroidManifest.xml", "file:src/main/AndroidManifest.xml"], ["file:build.gradle", "file:build.gradle.kts", "file:settings.gradle", "file:settings.gradle.kts"]],
    workspace: ["file:settings.gradle", "file:settings.gradle.kts"],
    tools: ["java"], versions: {java: ["java", "-version"]}, pins: JAVA_PINS,
    install: "https://developer.android.com/build/building-cmdline",
    note: "needs the Android SDK (ANDROID_HOME or local.properties); device tests are left out",
    vars: {gradle: [{when: ["os:windows", "file:gradlew.bat"], value: "gradlew.bat"}, {when: ["file:gradlew"], value: "./gradlew"}, {value: "gradle"}]},
    stages: {
      lint: [["{gradle}", "--console=plain", "lint"]], check: [["{gradle}", "--console=plain", "compileDebugSources"]],
      build: [["{gradle}", "--console=plain", "assembleDebug"]], test: [["{gradle}", "--console=plain", "testDebugUnitTest"]],
      package: [["{gradle}", "--console=plain", "bundleRelease"]], clean: [["{gradle}", "--console=plain", "clean"]],
    },
  },
  "java-maven": {
    language: "Java / Kotlin", short: "maven", family: "jvm", priority: 20,
    detect: ["file:pom.xml"], workspace: ["grep:pom.xml:<(modules|subprojects)>"],
    tools: ["java"], versions: {java: ["java", "-version"]}, pins: JAVA_PINS,
    install: "https://maven.apache.org/install.html",
    note: "phases are cumulative (package runs the tests unless skipped); install writes to ~/.m2 and is not setup",
    vars: {mvn: [{when: ["os:windows", "file:mvnw.cmd"], value: "mvnw.cmd"}, {when: ["file:mvnw"], value: "./mvnw"}, {value: "mvn"}]},
    stages: {
      setup: [["{mvn}", "-B", "-ntp", "dependency:go-offline"]],
      format: [{when: ["grep:pom.xml:spotless"], cmd: ["{mvn}", "-B", "-ntp", "spotless:apply"]}],
      "format-check": [{when: ["grep:pom.xml:spotless"], cmd: ["{mvn}", "-B", "-ntp", "spotless:check"]}],
      lint: [{when: ["grep:pom.xml:checkstyle"], cmd: ["{mvn}", "-B", "-ntp", "checkstyle:check"]}],
      check: [["{mvn}", "-B", "-ntp", "test-compile"]], build: [["{mvn}", "-B", "-ntp", "package", "-DskipTests"]],
      test: [["{mvn}", "-B", "-ntp", "test"]], clean: [["{mvn}", "-B", "-ntp", "clean"]],
    },
  },
  "scala-sbt": {
    language: "Scala", short: "scala", family: "scala", priority: 20,
    detect: ["file:build.sbt"], tools: ["sbt"], versions: {java: ["java", "-version"]}, pins: JAVA_PINS,
    install: "https://www.scala-sbt.org/download/",
    note: "sbt 2 runs tests incrementally; add a stage override with testFull to run them all",
    stages: {
      setup: [["sbt", "--batch", "update"]],
      format: [{when: ["file:.scalafmt.conf"], cmd: ["sbt", "--batch", "scalafmtAll", "scalafmtSbt"]}],
      "format-check": [{when: ["file:.scalafmt.conf"], cmd: ["sbt", "--batch", "scalafmtCheckAll", "scalafmtSbtCheck"]}],
      check: [["sbt", "--batch", "Test/compile"]], build: [["sbt", "--batch", "compile"]], test: [["sbt", "--batch", "test"]],
      package: [["sbt", "--batch", "package"]], run: [["sbt", "--batch", "run"]], clean: [["sbt", "--batch", "clean"]],
    },
  },
  "scala-mill": {
    language: "Scala", short: "scala", family: "scala", priority: 15,
    detect: [["file:build.mill", "file:build.mill.yaml", "file:build.sc"]], tools: [],
    install: "https://mill-build.org/mill/cli/installation-ide.html",
    vars: {mill: [{when: ["os:windows", "file:mill.bat"], value: "mill.bat"}, {when: ["file:mill"], value: "./mill"}, {value: "mill"}]},
    stages: {
      format: [{when: ["file:.scalafmt.conf"], cmd: ["{mill}", "mill.scalalib.scalafmt/"]}],
      "format-check": [{when: ["file:.scalafmt.conf"], cmd: ["{mill}", "mill.scalalib.scalafmt/checkFormatAll"]}],
      check: [["{mill}", "__.compile"]], build: [["{mill}", "__.compile"]], test: [["{mill}", "__.test"]],
      package: [["{mill}", "__.assembly"]], clean: [["{mill}", "clean"]],
    },
  },
  "clojure-lein": {
    language: "Clojure", short: "clojure", family: "clojure", priority: 20,
    detect: ["file:project.clj"], tools: ["lein"], install: "https://leiningen.org/",
    stages: {
      setup: [["lein", "deps"]], check: [["lein", "check"]], build: [["lein", "compile"]], test: [["lein", "test"]],
      package: [["lein", "uberjar"]], run: [{when: ["grep:project.clj::main"], cmd: ["lein", "run"]}], clean: [["lein", "clean"]],
    },
  },
  "clojure-cli": {
    language: "Clojure", short: "clojure", family: "clojure", priority: 15,
    detect: ["file:deps.edn", "not:os:windows"], tools: ["clojure"], install: "https://clojure.org/guides/install_clojure",
    note: "on Windows the Clojure CLI is a PowerShell module, not a program, so this toolchain is not offered there",
    stages: {
      setup: [["clojure", "-P"]],
      test: [{when: ["grep:deps.edn::exec-fn"], cmd: ["clojure", "-X:test"]}, {when: ["grep:deps.edn::test"], cmd: ["clojure", "-M:test"]}],
      package: [{when: ["file:build.clj"], cmd: ["clojure", "-T:build", "uber"]}], clean: [{when: ["file:build.clj"], cmd: ["clojure", "-T:build", "clean"]}],
    },
  },

  # --- .NET -------------------------------------------------------------------
  dotnet: {
    language: "C# / F# / VB", short: "dotnet", family: "dotnet", priority: 20,
    detect: [["glob:*.sln", "glob:*.slnx", "glob:*.csproj", "glob:*.fsproj", "glob:*.vbproj"]],
    workspace: ["glob:*.sln", "glob:*.slnx"],
    tools: ["dotnet"], versions: {dotnet: ["dotnet", "--version"]}, pins: {dotnet: ["global.json:sdk.version"]},
    install: "https://learn.microsoft.com/en-us/dotnet/core/install/",
    note: "a folder with several solution or project files needs a stage override naming one",
    stages: {
      setup: [
        {when: ["file:.config/dotnet-tools.json", "file:packages.lock.json"], cmds: [["dotnet", "tool", "restore"], ["dotnet", "restore", "--locked-mode"]]},
        {when: ["file:.config/dotnet-tools.json"], cmds: [["dotnet", "tool", "restore"], ["dotnet", "restore"]]},
        {when: ["file:packages.lock.json"], cmd: ["dotnet", "restore", "--locked-mode"]},
        ["dotnet", "restore"],
      ],
      format: [["dotnet", "format"]], "format-check": [["dotnet", "format", "--verify-no-changes"]],
      build: [["dotnet", "build", "--no-restore"]], test: [["dotnet", "test", "--no-restore"]],
      package: [["dotnet", "publish", "--configuration", "Release"]], clean: [["dotnet", "clean"]],
    },
  },

  # --- C and C++ ----------------------------------------------------------------
  cmake: {
    language: "C / C++", short: "cmake", family: "c", priority: 20,
    detect: ["file:CMakeLists.txt"], tools: ["cmake"], versions: {cmake: ["cmake", "--version"]},
    install: "https://cmake.org/download/",
    note: "ctest --test-dir needs CMake 3.20; on Windows the Visual Studio generator is multi-config, so build and test take Debug unless a stage override says otherwise",
    order: {test: ["build"]},
    vars: {
      cfg: [{when: ["os:windows"], value: ["--config", "Debug"]}, {value: []}],
      tcfg: [{when: ["os:windows"], value: ["-C", "Debug"]}, {value: []}],
      clang_files: [{files: ["**/*.c", "**/*.cc", "**/*.cpp", "**/*.cxx", "**/*.h", "**/*.hh", "**/*.hpp", "**/*.hxx"], skip: ["build", "third_party", "vendor", "external", "node_modules"]}],
    },
    stages: {
      setup: [["cmake", "-S", ".", "-B", "build", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"]], build: [["cmake", "--build", "build", "--parallel", "{cfg}"]],
      test: [{when: ['grep:CMakeLists.txt:(enable_testing|add_test|include\(CTest\))'], cmd: ["ctest", "--test-dir", "build", "{tcfg}", "--output-on-failure"]}],
      package: [{when: ['grep:CMakeLists.txt:include\(CPack\)'], cmd: ["cpack", "--config", "build/CPackConfig.cmake"]}],
      clean: [["cmake", "--build", "build", "--target", "clean"]],
      format: [{when: [["file:.clang-format", "file:_clang-format"]], cmd: ["clang-format", "-i", "{clang_files}"]}],
      "format-check": [{when: [["file:.clang-format", "file:_clang-format"]], cmd: ["clang-format", "--dry-run", "--Werror", "{clang_files}"]}],
    },
  },
  meson: {
    language: "C / C++", short: "meson", family: "c", priority: 20,
    detect: ["file:meson.build"], tools: ["meson"], versions: {meson: ["meson", "--version"]},
    install: "https://mesonbuild.com/Getting-meson.html",
    order: {test: ["build"]},
    stages: {
      setup: [{when: ["dir:builddir"], cmd: ["meson", "setup", "--reconfigure", "builddir"]}, ["meson", "setup", "builddir"]],
      build: [["meson", "compile", "-C", "builddir"]], test: [["meson", "test", "-C", "builddir", "--print-errorlogs"]],
      clean: [["meson", "compile", "-C", "builddir", "--clean"]],
    },
  },
  bazel: {
    language: "any (Bazel)", short: "bazel", family: "bazel", priority: 50, claims_subtree: true,
    detect: [["file:MODULE.bazel", "file:WORKSPACE", "file:WORKSPACE.bazel"]],
    tools: [], install: "https://bazel.build/install/bazelisk",
    vars: {bazel: [{when: ["tool:bazelisk"], value: "bazelisk"}, {value: "bazel"}]},
    stages: {
      setup: [["{bazel}", "fetch", "//..."]], check: [["{bazel}", "build", "--nobuild", "//..."]],
      build: [["{bazel}", "build", "//..."]], test: [["{bazel}", "test", "//..."]], clean: [["{bazel}", "clean"]],
      format: [{when: ["tool:buildifier"], cmd: ["buildifier", "-r", "."]}], "format-check": [{when: ["tool:buildifier"], cmd: ["buildifier", "-mode=check", "-r", "."]}],
    },
  },
  buck2: {
    language: "any (Buck2)", short: "buck2", family: "bazel", priority: 45, claims_subtree: true,
    detect: ["file:.buckconfig"], tools: ["buck2"], install: "https://buck2.build/docs/getting_started/install/",
    stages: {build: [["buck2", "build", "//..."]], test: [["buck2", "test", "//..."]]},
  },
  pants: {
    language: "any (Pants)", short: "pants", family: "pants", priority: 50, claims_subtree: true,
    detect: ["file:pants.toml"], tools: ["pants"], install: "https://www.pantsbuild.org/stable/docs/getting-started/installing-pants",
    stages: {
      format: [["pants", "fmt", "::"]], "format-check": [["pants", "lint", "::"]], lint: [["pants", "lint", "::"]],
      check: [["pants", "check", "::"]], test: [["pants", "test", "::"]], package: [["pants", "package", "::"]],
    },
  },

  # --- Ruby and PHP ---------------------------------------------------------------
  "ruby-bundler": {
    language: "Ruby", short: "ruby", family: "ruby", priority: 20,
    detect: ["file:Gemfile"], tools: ["ruby", "bundle"], versions: {ruby: ["ruby", "--version"]},
    pins: {ruby: [".ruby-version", ".tool-versions:ruby", "mise.toml:ruby"]},
    install: "https://www.ruby-lang.org/en/documentation/installation/",
    note: "Bundler 4 dropped --frozen; setup sets BUNDLE_FROZEN when Gemfile.lock exists",
    targets: "rake", targets_run: ["bundle", "exec", "rake"],
    stages: {
      setup: [{when: ["file:Gemfile.lock"], cmd: ["bundle", "install"], env: {BUNDLE_FROZEN: "true"}}, ["bundle", "install"]],
      test: [{when: [["file:.rspec", "dir:spec"]], cmd: ["bundle", "exec", "rspec"]}, {when: ["file:bin/rails"], cmd: ["ruby", "bin/rails", "test"]}, {when: ["file:Rakefile"], cmd: ["bundle", "exec", "rake", "test"]}],
      lint: [{when: ["file:.standard.yml"], cmd: ["bundle", "exec", "standardrb"]}, {when: ["file:.rubocop.yml"], cmd: ["bundle", "exec", "rubocop"]}],
      format: [{when: ["file:.standard.yml"], cmd: ["bundle", "exec", "standardrb", "--fix"]}, {when: ["file:.rubocop.yml"], cmd: ["bundle", "exec", "rubocop", "-a"]}],
      check: [{when: ["dir:sorbet"], cmd: ["bundle", "exec", "srb", "tc"]}, {when: ["file:Steepfile"], cmd: ["bundle", "exec", "steep", "check"]}],
      package: [{when: ["glob:*.gemspec"], cmd: ["gem", "build", "{gemspec}"]}],
    },
  },
  "php-composer": {
    language: "PHP", short: "php", family: "php", priority: 20,
    detect: ["file:composer.json"], tools: ["php", "composer"], versions: {php: ["php", "--version"]},
    pins: {php: [".php-version", ".tool-versions:php", "mise.toml:php"]},
    install: "https://getcomposer.org/download/",
    scripts: {file: "composer.json", key: "scripts", run: ["composer", "run-script"]},
    stages: {
      setup: [["composer", "install", "--no-interaction", "--no-progress", "--prefer-dist"]],
      test: [{when: ["file:tests/Pest.php"], cmd: ["php", "vendor/bin/pest"]}, {when: [["file:phpunit.xml", "file:phpunit.xml.dist", "file:phpunit.dist.xml"]], cmd: ["php", "vendor/bin/phpunit"]}],
      lint: [{when: [["file:phpcs.xml", "file:phpcs.xml.dist", "file:.phpcs.xml"]], cmd: ["php", "vendor/bin/phpcs"]}],
      check: [{when: [["file:phpstan.neon", "file:phpstan.neon.dist", "file:phpstan.dist.neon"]], cmd: ["php", "vendor/bin/phpstan", "analyse", "--no-progress"]}, {when: [["file:psalm.xml", "file:psalm.xml.dist"]], cmd: ["php", "vendor/bin/psalm", "--no-progress"]}],
      format: [{when: [["file:pint.json", "grep:composer.json:laravel/pint"]], cmd: ["php", "vendor/bin/pint"]}, {when: [["file:.php-cs-fixer.php", "file:.php-cs-fixer.dist.php"]], cmd: ["php", "vendor/bin/php-cs-fixer", "fix"]}],
      "format-check": [{when: [["file:pint.json", "grep:composer.json:laravel/pint"]], cmd: ["php", "vendor/bin/pint", "--test"]}, {when: [["file:.php-cs-fixer.php", "file:.php-cs-fixer.dist.php"]], cmd: ["php", "vendor/bin/php-cs-fixer", "fix", "--dry-run", "--diff"]}],
    },
  },

  # --- BEAM -----------------------------------------------------------------------
  "elixir-mix": {
    language: "Elixir", short: "elixir", family: "elixir", priority: 20,
    detect: ["file:mix.exs"], workspace: ["grep:mix.exs:apps_path"],
    tools: ["mix"], versions: {elixir: ["elixir", "--version"]},
    pins: {elixir: [".tool-versions:elixir", "mise.toml:elixir"]},
    install: "https://elixir-lang.org/install.html",
    stages: {
      setup: [{cmds: [["mix", "local.hex", "--force", "--if-missing"], ["mix", "local.rebar", "--force", "--if-missing"], ["mix", "deps.get"]]}],
      format: [["mix", "format"]], "format-check": [["mix", "format", "--check-formatted"]],
      lint: [{when: ["grep:mix.exs::credo"], cmd: ["mix", "credo", "--strict"]}],
      check: [["mix", "compile", "--warnings-as-errors"]], build: [["mix", "compile"]], test: [["mix", "test"]],
      package: [{when: ["grep:mix.exs:releases"], cmd: ["mix", "release"], env: {MIX_ENV: "prod"}}], clean: [["mix", "clean"]],
    },
    extras: {dialyzer: [{when: ["grep:mix.exs::dialyxir"], cmd: ["mix", "dialyzer"]}]},
  },
  "erlang-rebar3": {
    language: "Erlang", short: "erlang", family: "erlang", priority: 20,
    detect: ["file:rebar.config"], tools: ["rebar3"], versions: {rebar3: ["rebar3", "version"]},
    install: "https://rebar3.org/docs/getting-started/",
    stages: {
      setup: [["rebar3", "get-deps"]],
      format: [{when: ["grep:rebar.config:erlfmt"], cmd: ["rebar3", "fmt", "--write"]}], "format-check": [{when: ["grep:rebar.config:erlfmt"], cmd: ["rebar3", "fmt", "--check"]}],
      lint: [["rebar3", "xref"]], check: [["rebar3", "dialyzer"]], build: [["rebar3", "compile"]], test: [["rebar3", "eunit"]],
      package: [{when: ["grep:rebar.config:relx"], cmd: ["rebar3", "as", "prod", "tar"]}], clean: [["rebar3", "clean", "--all"]],
    },
    extras: {ct: [{when: ["glob:*_SUITE.erl"], cmd: ["rebar3", "ct"]}]},
  },
  gleam: {
    language: "Gleam", short: "gleam", family: "gleam", priority: 20,
    detect: ["file:gleam.toml"], tools: ["gleam"], versions: {gleam: ["gleam", "--version"]},
    install: "https://gleam.run/getting-started/installing/",
    stages: {
      setup: [["gleam", "deps", "download"]], format: [["gleam", "format"]], "format-check": [["gleam", "format", "--check"]],
      check: [["gleam", "check"]], build: [["gleam", "build"]], test: [["gleam", "test"]],
      package: [["gleam", "export", "erlang-shipment"]], run: [["gleam", "run"]], clean: [["gleam", "clean"]],
    },
  },

  # --- Apple, Dart, Zig -------------------------------------------------------------
  "swift-spm": {
    language: "Swift", short: "swift", family: "swift", priority: 20,
    detect: ["file:Package.swift"], tools: ["swift"], versions: {swift: ["swift", "--version"]},
    pins: {swift: [".swift-version"]}, install: "https://www.swift.org/install/",
    note: "swift format ships with Swift 6; lint only fails with --strict",
    stages: {
      setup: [["swift", "package", "resolve"]],
      format: [{when: ["dir:Tests"], cmd: ["swift", "format", "--in-place", "--recursive", "Sources", "Tests", "Package.swift"]}, ["swift", "format", "--in-place", "--recursive", "Sources", "Package.swift"]],
      "format-check": [{when: ["dir:Tests"], cmd: ["swift", "format", "lint", "--strict", "--recursive", "Sources", "Tests", "Package.swift"]}, ["swift", "format", "lint", "--strict", "--recursive", "Sources", "Package.swift"]],
      lint: [{when: ["file:.swiftlint.yml"], cmd: ["swiftlint", "lint", "--strict"]}],
      check: [["swift", "build", "--build-tests"]], build: [["swift", "build"]], test: [["swift", "test"]],
      package: [["swift", "build", "-c", "release"]], run: [["swift", "run"]], clean: [["swift", "package", "clean"]],
    },
  },
  xcode: {
    language: "Swift / Objective-C (Xcode)", short: "xcode", family: "swift", priority: 10,
    detect: [["glob:*.xcworkspace", "glob:*.xcodeproj"], "os:macos"], tools: ["xcodebuild"],
    install: "https://developer.apple.com/xcode/",
    note: "xcodebuild needs a scheme for workspaces and tests: override the stages with -scheme <name> (xcodebuild -list shows them)",
    stages: {build: [["xcodebuild", "build"]], clean: [["xcodebuild", "clean"]]},
    extras: {schemes: [["xcodebuild", "-list", "-json"]]},
  },
  dart: {
    language: "Dart", short: "dart", family: "dart", priority: 20,
    detect: ["file:pubspec.yaml", 'not:grep:pubspec.yaml:(?m)^\s+sdk:\s*flutter'],
    tools: ["dart"], versions: {dart: ["dart", "--version"]}, install: "https://dart.dev/get-dart",
    stages: {
      setup: [{when: ["file:pubspec.lock"], cmd: ["dart", "pub", "get", "--enforce-lockfile"]}, ["dart", "pub", "get"]],
      format: [["dart", "format", "."]], "format-check": [["dart", "format", "--output=none", "--set-exit-if-changed", "."]],
      lint: [["dart", "analyze", "--fatal-infos"]], test: [{when: ["dir:test"], cmd: ["dart", "test"]}],
    },
  },
  flutter: {
    language: "Dart (Flutter)", short: "flutter", family: "dart", priority: 30,
    detect: ["file:pubspec.yaml", 'grep:pubspec.yaml:(?m)^\s+sdk:\s*flutter'],
    tools: ["flutter"], versions: {flutter: ["flutter", "--version"]}, pins: {flutter: [".fvmrc"]},
    install: "https://docs.flutter.dev/get-started/install",
    note: "builds are per platform (apk, appbundle, ios, web...): add a build stage override for yours",
    stages: {
      setup: [{when: ["file:pubspec.lock"], cmd: ["flutter", "pub", "get", "--enforce-lockfile"]}, ["flutter", "pub", "get"]],
      format: [["dart", "format", "."]], "format-check": [["dart", "format", "--output=none", "--set-exit-if-changed", "."]],
      lint: [["flutter", "analyze"]], test: [["flutter", "test"]], clean: [["flutter", "clean"]],
    },
  },
  zig: {
    language: "Zig", short: "zig", family: "zig", priority: 20,
    detect: ["file:build.zig"], tools: ["zig"], versions: {zig: ["zig", "version"]},
    pins: {zig: ["build.zig.zon:minimum_zig_version", ".zigversion", ".tool-versions:zig"]},
    install: "https://ziglang.org/download/",
    note: "test and run are steps build.zig defines, so they appear only when it does; minimum_zig_version is advisory, doctor checks it",
    stages: {
      setup: [{when: ["file:build.zig.zon"], cmd: ["zig", "build", "--fetch"]}],
      format: [["zig", "fmt", "."]], "format-check": [["zig", "fmt", "--check", "."]],
      build: [["zig", "build"]],
      test: [{when: ['grep:build.zig:step\(\s*"test"'], cmd: ["zig", "build", "test"]}],
      run: [{when: ['grep:build.zig:step\(\s*"run"'], cmd: ["zig", "build", "run"]}],
      clean: [{rm: ["zig-out", ".zig-cache", "zig-cache"]}],
    },
  },

  # --- Functional and scientific ----------------------------------------------------
  "haskell-stack": {
