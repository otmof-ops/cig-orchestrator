#!/usr/bin/env cig
# SPDX-FileCopyrightText: 2026 Jay Taylor (https://github.com/otmof-ops/cig-orchestrator)
# SPDX-License-Identifier: FSL-1.1-ALv2
# cig >=1.20.0
# How long cigo's commands take on this machine (#88, #90): now a wrapper for
# `cig bench`, which reads bench/bench.toml (cig-orchestrator#112). It keeps the
# commands the README has always given; they run the same cases, in a scratch home:
#
#   cig run scripts/bench.cig                        = cig bench
#   cig run scripts/bench.cig -- --samples 15 --per 10
#   cig run scripts/bench.cig -- --json              = cig --json bench
#   cig run scripts/bench.cig -- --only hook         the cases whose name says hook
#   cig run scripts/bench.cig -- --box               = cig bench bench/box.toml (makes boxes)
#
# Anything else is passed to `cig bench` as it is (`--timings`, `--against`,
# `--watch`, `--markdown`: cig bench --help). This wrapper is removed a release
# after the one that adds bench/bench.toml; run `cig bench` directly from then on.

pack { "./.bench-work" }

if not fs.is_file(path.join(fs.cwd(), "bench", "bench.toml")) {
  log.error("run this from the repository root: cig run scripts/bench.cig")
  exit(2)
}

roll words = []
roll global = []
roll manifest = []
for a in args {
  if a == "--json" {
    global = ["--json"]
  } else if a == "--box" {
    manifest = ["bench/box.toml"]
  } else {
    words.push(a)
  }
}

roll r = null
burn {
  r = proc.run("cig", global + ["bench"] + manifest + words, {stream: true, timeout_ms: 3600000})
}
if r.code != 0 and not r.get("simulated", false) {
  exit(r.code)
}
